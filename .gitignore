# Ignore .DS_Store files
.DS_Store

# Ignore temporary Visual Studio Code files
.vscode/

# Ignore build output directories
bin/
obj/

# Secrets - never commit real credentials
.env
appsettings.Local.json
appsettings.Development.json

# Ignore uploaded files (user uploads, PDFs, etc.)
wwwroot/uploads/
wwwroot/lib/
.aider*

# Agent harness — TRACKED (opencode.json, .opencode/prompts, .opencode/skills,
# .agent-guardrails/config.json + rules are project policy, not machine-specific)
# Only these specific ephemeral/secret sub-paths are ignored:
.opencode/node_modules/
.opencode/plugin/node_modules/
.opencode/plugins/node_modules/
.opencode/secrets/
.opencode/planning/
.opencode/reports/
.agent-guardrails/evidence/
.playwright-mcp/
opencode.json.bak*
*.bak_[0-9]*

# Local logs / generated / scratch
errors.jsonl
server.log
test-results/
analyze-errors.py
log-error.sh

# Local working docs (not committed project documentation)
Docs/PROJECT_STATE.md
Docs/PR_CHECKLIST.md
Docs/WORKFLOW.md
Docs/Invoice pvz/
