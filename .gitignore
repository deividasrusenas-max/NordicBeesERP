# Ignore .DS_Store files
.DS_Store

# Ignore temporary Visual Studio Code files
.vscode/

# Ignore build output directories
bin/
obj/

# Secrets - never commit real credentials
.env
appsettings.Local.json
appsettings.Development.json

# Ignore uploaded files (user uploads, PDFs, etc.)
wwwroot/uploads/
wwwroot/lib/
.aider*
kilo.jsonc.bak_*
.kilo/kilo.jsonc.bak_*
.env.bak_*
.opencode/secrets/

# AI agent stack config — local tooling setup, not project code.
# These are hardware/machine-specific (local model endpoints, MCP server
# paths, agent permission tuning) and should NOT be branch-dependent or
# reverted by git checkout/stash/branch-switch operations.
opencode.json
kilo.jsonc
.opencode/
.kilo/
.planning/
mempalace.yaml

# Kilo Code secrets - project-level config can't resolve {env:} references,
# so real keys live here instead. Never commit this directory.
.kilo/secrets/
