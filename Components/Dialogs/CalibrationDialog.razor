@using MudBlazor
@namespace NordicBeesERP.Components.Dialogs

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Registruoti kalibraciją</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div style="min-width:420px;">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">
                Stotis: <strong>@_stationName</strong>
            </MudText>

            @if (!string.IsNullOrEmpty(_validationError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">@_validationError</MudAlert>
            }

            <MudStack Spacing="3">
                <MudTextField @bind-Value="_calibrationDate"
                              Label="Kalibracijos data"
                              Type="date"
                              Required="@true"
                              Variant="Variant.Outlined"
                              HelperText="Data, kada atlikta kalibracija" />

                <MudTextField @bind-Value="_nextCalibrationDate"
                              Label="Kita kalibracija"
                              Type="date"
                              Required="@true"
                              Variant="Variant.Outlined"
                              HelperText="Planuojama kito kalibravimo data" />

                <MudTextField @bind-Value="_certNumber"
                              Label="Sertifikato numeris"
                              Variant="Variant.Outlined"
                              HelperText="Kalibravimo sertifikato numeris (nebūtinas)" />

                <MudTextField @bind-Value="_technician"
                              Label="Technikas / Įmonė"
                              Variant="Variant.Outlined"
                              Required="@true"
                              HelperText="Kas atliko kalibraciją" />

                <MudTextField @bind-Value="_notes"
                              Label="Pastabos"
                              Variant="Variant.Outlined"
                              Lines="3"
                              HelperText="Papildoma informacija apie kalibraciją" />
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="CancelAsync">Atšaukti</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none" OnClick="ConfirmAsync" StartIcon="@Icons.Material.Filled.CheckCircle">Išsaugoti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public record CalibrationResult(
        DateTime CalibrationDate,
        DateTime NextCalibrationDate,
        string? CertNumber,
        string Technician,
        string? Notes);

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int StationId { get; set; }
    [Parameter] public string StationName { get; set; } = string.Empty;
    [Parameter] public DateTime? ExistingNextCalibrationDate { get; set; }

    private string _stationName => StationName;
    private DateTime? _calibrationDate = DateTime.Today;
    private DateTime? _nextCalibrationDate;
    private string _certNumber = string.Empty;
    private string _technician = string.Empty;
    private string _notes = string.Empty;

    protected override void OnInitialized()
    {
        _nextCalibrationDate = ExistingNextCalibrationDate ?? DateTime.Today.AddMonths(6);
    }

    private void CancelAsync()
    {
        MudDialog.Cancel();
    }

    private void ConfirmAsync()
    {
        if (!_calibrationDate.HasValue)
        {
            _validationError = "Kalibracijos data yra privaloma";
            StateHasChanged();
            return;
        }
        if (!_nextCalibrationDate.HasValue)
        {
            _validationError = "Kitos kalibracijos data yra privaloma";
            StateHasChanged();
            return;
        }
        if (string.IsNullOrWhiteSpace(_technician))
        {
            _validationError = "Technikas / Įmonė yra privalomas";
            StateHasChanged();
            return;
        }
        if (_nextCalibrationDate <= _calibrationDate)
        {
            _validationError = "Kita kalibracija turi būti vėliau už dabartinę";
            StateHasChanged();
            return;
        }

        _validationError = null;

        var result = new CalibrationResult(
            _calibrationDate.Value,
            _nextCalibrationDate.Value,
            string.IsNullOrWhiteSpace(_certNumber) ? null : _certNumber.Trim(),
            _technician.Trim(),
            string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()
        );

        MudDialog.Close(DialogResult.Ok(result));
    }

    private string? _validationError;

    public static async Task<CalibrationResult?> ShowAsync(
        IDialogService dialogService,
        int stationId,
        string stationName,
        DateTime? existingNextCalibrationDate = null)
    {
        var parameters = new DialogParameters
        {
            [nameof(StationId)] = stationId,
            [nameof(StationName)] = stationName,
            [nameof(ExistingNextCalibrationDate)] = existingNextCalibrationDate,
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await dialogService.ShowAsync<CalibrationDialog>("Registruoti kalibraciją", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            return result?.Data as CalibrationResult;
        }
        return null;
    }
}
