@using NordicBeesERP.Models
@using MudBlazor
@inject IDialogService DialogService
@inject ICustomerService CustomerService

<MudDialog Options="@_dialogOptions">
    <DialogContent>
        <MudTextField T="string" @ref="_searchField" @bind-Value="_search"
                      Placeholder="Ieškoti pagal pavadinimą, kodą..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="@true"
                      Clearable="@true"
                      FullWidth="@true"
                      Margin="Margin.Dense"
                      Class="mb-3" />

        <MudTable T="Customer" Items="@FilteredCustomers" Dense="@true" Hover="@true" Striped="@true" Elevation="0"
                  OnRowClick="@((TableRowClickEventArgs<Customer> args) => SelectCustomer(args.Item))"
                  Style="cursor:pointer">
            <HeaderContent>
                <MudTh>Pavadinimas</MudTh>
                <MudTh>PVM kodas</MudTh>
                <MudTh>Mokėjimo terminas</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.VatCode</MudTd>
                <MudTd>@context.PaymentTermDays d.</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Color="Color.Secondary">Klientų nerasta</MudText>
            </NoRecordsContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="Cancel">Atšaukti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true };
    
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    
    [Parameter] public List<Customer> Customers { get; set; } = new();
    
    private MudTextField<string>? _searchField;
    private string? _search = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _searchField != null)
        {
            await Task.Delay(100);
            await _searchField.FocusAsync();
        }
    }

    private List<Customer> FilteredCustomers =>
        string.IsNullOrWhiteSpace(_search) 
            ? Customers 
            : Customers.Where(c =>
                c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (c.VatCode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();

    private void SelectCustomer(Customer customer)
    {
        MudDialog.Close(DialogResult.Ok(customer));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
