@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using MudBlazor
@inject IDialogService DialogService
@inject ICustomerService CustomerService
@inject ICompanyLookupService CompanyLookupService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(Customer?.Id > 0 ? "Redaguoti partnerį" : "Naujas partneris")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="string" @bind-Value="customer.PartnerType" Label="Partnerio tipas" Required="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("Customer")">Klientas</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Supplier")">Tiekėjas</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Both")">Abu (Klientas ir Tiekėjas)</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ExpenseSupplier")">Išlaidų tiekėjas</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12">
                <MudTextField @bind-Value="customer.Name" Label="Pavadinimas" Required="true"
                              MaxLength="255" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
             <MudItem xs="6">
                 <MudTextField T="string"
                               @bind-Value="customer.CompanyCode"
                               Label="Įmonės kodas"
                               MaxLength="20"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
                 @if (_lookupLoading)
                 {
                     <div class="d-flex align-center gap-1 mt-1">
                         <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                         <MudText Typo="Typo.caption" Color="Color.Secondary">Ieškoma...</MudText>
                     </div>
                 }
                 else if (_lookupResult != null && _lookupResult.Found && _lookupResult.Source == LookupSource.Jars)
                 {
                     <div class="d-flex align-center gap-1 mt-1">
                         <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                         <MudText Typo="Typo.caption" Style="color:#16a34a">@_lookupResult.StatusLabel</MudText>
                     </div>
                 }
                 else if (_lookupResult != null && !_lookupResult.Found && _lookupResult.Source == LookupSource.Jars)
                 {
                     <div class="d-flex align-center gap-1 mt-1">
                         <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Warning" Size="Size.Small" />
                         <MudText Typo="Typo.caption" Style="color:#d97706">Nerasta JARS registre</MudText>
                     </div>
                 }
             </MudItem>
            
            <MudItem xs="12" md="6">
                <MudTextField @key="@customer.VatCode" Value="@customer.VatCode"
                              ValueChanged="@(async (string v) => { customer.VatCode = v; await OnVatCodeChanged(); })"
                              Label="PVM mokėtojo kodas"
                              MaxLength="20"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="@(_lookupLoading ? Adornment.End : Adornment.None)"
                              AdornmentIcon="@Icons.Material.Filled.HourglassTop" />
                @if (_lookupLoading)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Ieškoma...</MudText>
                    </div>
                }
                else if (_lookupResult != null && _lookupResult.Source == LookupSource.Vies)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudIcon Icon="@(_lookupResult.Found ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                 Size="Size.Small"
                                 Style="@(_lookupResult.Found ? "color:#16a34a" : "color:#dc2626")" />
                        <MudChip T="string" Size="Size.Small"
                                 Color="Color.Info"
                                 Variant="Variant.Outlined"
                                 Style="height:18px;font-size:10px;padding:0 6px">
                            VIES
                        </MudChip>
                        <MudText Typo="Typo.caption" Style="color:#16a34a">@_lookupResult.StatusLabel</MudText>
                    </div>
                }
                else if (_lookupResult != null && !_lookupResult.Found && _lookupResult.Source == LookupSource.Vies)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Style="color:#dc2626">Nerasta</MudText>
                    </div>
                }
            </MudItem>
            
            <MudItem xs="12">
                <MudTextField @bind-Value="customer.Address" Label="Adresas" Lines="2"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField @bind-Value="customer.City" Label="Miestas" MaxLength="100"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField @bind-Value="customer.PostalCode" Label="Pašto kodas" MaxLength="20"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField @bind-Value="customer.Phone" Label="Telefonas" MaxLength="50"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField @bind-Value="customer.Email" Label="El. paštas" MaxLength="100"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField @bind-Value="customer.BankAccount" Label="Banko sąskaita" MaxLength="50"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="customer.PaymentTermDays" Label="Mokėjimo terminas (dienos)"
                                 Min="0" Max="365" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField T="string"
                              @key="@_vatRateKey"
                              Value="@(customer.DefaultVatRate.ToString("G29"))"
                              ValueChanged="@((string v) => { if (decimal.TryParse(v, out var d)) customer.DefaultVatRate = d; })"
                              Label="Numatytasis PVM (%)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudSelect T="string" @bind-Value="customer.DefaultLanguage" Label="Kalba"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("lt")">Lietuvių</MudSelectItem>
                    <MudSelectItem T="string" Value="@("lv")">Latviešu</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ee")">Eesti</MudSelectItem>
                    <MudSelectItem T="string" Value="@("en")">English</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ru")">Русский</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12">
                <MudTextField @bind-Value="customer.Notes" Label="Pastabos" Lines="3" MaxLength="1000"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12">
                <MudSwitch @bind-Value="customer.IsActive" Label="Aktyvus" Color="Color.Success" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="@CloseDialog">Atšaukti</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none" StartIcon="@Icons.Material.Filled.Save" OnClick="@SubmitForm">Išsaugoti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ISnackbar snackbar { get; set; } = default!;
    [CascadingParameter] public IMudDialogInstance? Dialog { get; set; }
    [Parameter] public Customer? Customer { get; set; }
    [Parameter] public EventCallback<Customer> OnCustomerCreated { get; set; }

    private Customer customer = new();
    private bool _lookupLoading = false;
    private CompanyLookupResult? _lookupResult = null;
    private string _lastCompanyCode = "";
    private int _vatRateKey = 0;

    protected override void OnParametersSet()
    {
        customer = Customer ?? new Customer
        {
            PartnerType = "Customer",
            PaymentTermDays = 30,
            DefaultVatRate = 21m,
            DefaultLanguage = "lt",
            CountryCode = "LT",
            Country = "Lietuva",
            City = "",
            Address = "",
            PostalCode = "",
            IsActive = true
        };
    }

    private async Task SubmitForm()
    {
        try
        {
            // Save the customer
            var savedCustomer = await CustomerService.SaveCustomerAsync(customer);
            
            // Close dialog with result
            Dialog?.Close(savedCustomer);
        }
        catch (Exception ex)
        {
            snackbar?.Add($"Klaida išsaugant klientą: {ex.Message}", Severity.Error);
        }
    }

    private void CloseDialog()
    {
        Dialog?.Close();
    }

    private async Task HandleValidSubmit()
    {
        // Check if name already exists
        var existingByName = await CustomerService.GetAllBusinessPartnersAsync();
        
        if (existingByName.Any(bp => bp.Name == customer.Name && bp.Id != customer.Id))
        {
            snackbar?.Add("Partneris su šiuo pavadinimu jau egzistuoja!", Severity.Warning);
            return;
        }
    }

      private async Task OnCompanyCodeChanged()
      {
          customer.CompanyCode = customer.CompanyCode?.Trim() ?? "";
          if (string.IsNullOrWhiteSpace(customer.CompanyCode) || customer.CompanyCode.Length < 6) return;
          _lookupLoading = true;
          StateHasChanged();
          _lookupResult = await CompanyLookupService.LookupByCompanyCodeAsync(customer.CompanyCode);
           if (_lookupResult.Found) await ApplyLookupResult(_lookupResult);
          _lookupLoading = false;
          StateHasChanged();
      }

     protected override async Task OnAfterRenderAsync(bool firstRender)
     {
         if (customer.CompanyCode != _lastCompanyCode && !string.IsNullOrWhiteSpace(customer.CompanyCode) && customer.CompanyCode.Length >= 6)
         {
             _lastCompanyCode = customer.CompanyCode;
             await OnCompanyCodeChanged();
         }
     }

private async Task OnVatCodeChanged()
{
    customer.VatCode = customer.VatCode?.Trim() ?? "";
    if (string.IsNullOrWhiteSpace(customer.VatCode) || customer.VatCode.Length < 4) return;
    _lookupLoading = true;
    StateHasChanged();
    var result = await CompanyLookupService.LookupByVatCodeAsync(customer.VatCode);
     if (result.Found)
     {
         _lookupResult = result;
         await ApplyLookupResult(result);
     }
    _lookupLoading = false;
    StateHasChanged();
}

private async Task ApplyLookupResult(CompanyLookupResult result)
{
    if (string.IsNullOrEmpty(customer.Name) && !string.IsNullOrEmpty(result.Name))
        customer.Name = result.Name;
    if (string.IsNullOrEmpty(customer.Address) && !string.IsNullOrEmpty(result.Address))
        customer.Address = result.Address;
    if (string.IsNullOrEmpty(customer.City) && !string.IsNullOrEmpty(result.City))
        customer.City = result.City;
    if (string.IsNullOrEmpty(customer.PostalCode) && !string.IsNullOrEmpty(result.PostalCode))
        customer.PostalCode = result.PostalCode;
    if (!string.IsNullOrEmpty(result.VatCode))
        customer.VatCode = result.VatCode;
    if (string.IsNullOrEmpty(customer.Email) && !string.IsNullOrEmpty(result.Email))
        customer.Email = result.Email;
    if (string.IsNullOrEmpty(customer.Phone) && !string.IsNullOrEmpty(result.Phone))
        customer.Phone = result.Phone;
    if (string.IsNullOrEmpty(customer.CountryCode) && !string.IsNullOrEmpty(result.CountryCode))
    {
        customer.CountryCode = result.CountryCode;
        customer.DefaultVatRate = result.CountryCode.ToUpper() == "LT" ? 21m : 0m;
        _vatRateKey++;
    }
    await InvokeAsync(StateHasChanged);
}
}
