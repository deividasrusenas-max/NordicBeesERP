@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using NordicBeesERP.Helpers
@using MudBlazor
@inject IDialogService DialogService
@inject ICustomerService CustomerService
@inject ICompanyLookupService CompanyLookupService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(Customer?.Id > 0 ? "Redaguoti partnerį" : "Naujas partneris")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <div class="d-flex flex-wrap gap-3">
                    <MudSwitch @bind-Value="customer.IsCustomer" Label="Klientas" Color="Color.Success" Variant="Variant.Outlined" />
                    <MudSwitch @bind-Value="customer.IsSupplier" Label="Tiekėjas" Color="Color.Success" Variant="Variant.Outlined" />
                    <MudSwitch @bind-Value="customer.IsExpenseSupplier" Label="Išlaidų tiekėjas" Color="Color.Success" Variant="Variant.Outlined" />
                    <MudSwitch @bind-Value="customer.IsIndividual" Label="Fizinis asmuo / ūkininkas" Color="Color.Success" Variant="Variant.Outlined" />
                </div>
            </MudItem>
            
            <MudItem xs="12">
                <MudTextField @bind-Value="customer.Name" Label="Pavadinimas" Required="true"
                              MaxLength="255" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
             <MudItem xs="6">
                 <MudTextField T="string"
                               @bind-Value="customer.CompanyCode"
                               Label="Įmonės kodas"
                               MaxLength="20"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
                 @if (_lookupLoading)
                 {
                     <div class="d-flex align-center gap-1 mt-1">
                         <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                         <MudText Typo="Typo.caption" Color="Color.Secondary">Ieškoma...</MudText>
                     </div>
                 }
                 else if (_lookupResult != null && _lookupResult.Found && _lookupResult.Source == LookupSource.Jars)
                 {
                     <div class="d-flex align-center gap-1 mt-1">
                         <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                         <MudText Typo="Typo.caption" Style="color:#16a34a">@_lookupResult.StatusLabel</MudText>
                     </div>
                 }
                 else if (_lookupResult != null && !_lookupResult.Found && _lookupResult.Source == LookupSource.Jars)
                 {
                     <div class="d-flex align-center gap-1 mt-1">
                         <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Warning" Size="Size.Small" />
                         <MudText Typo="Typo.caption" Style="color:#d97706">Nerasta JARS registre</MudText>
                     </div>
                 }
             </MudItem>
            
            <MudItem xs="12" md="6">
                <MudTextField @key="@customer.VatCode" Value="@customer.VatCode"
                              ValueChanged="@(async (string v) => { customer.VatCode = v; await OnVatCodeChanged(); })"
                              Label="PVM mokėtojo kodas"
                              MaxLength="20"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="@(_lookupLoading ? Adornment.End : Adornment.None)"
                              AdornmentIcon="@Icons.Material.Filled.HourglassTop" />
                @if (_lookupLoading)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Ieškoma...</MudText>
                    </div>
                }
                else if (_lookupResult != null && _lookupResult.Source == LookupSource.Vies)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudIcon Icon="@(_lookupResult.Found ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                 Size="Size.Small"
                                 Style="@(_lookupResult.Found ? "color:#16a34a" : "color:#dc2626")" />
                        <MudChip T="string" Size="Size.Small"
                                 Color="Color.Info"
                                 Variant="Variant.Outlined"
                                 Style="height:18px;font-size:10px;padding:0 6px">
                            VIES
                        </MudChip>
                        <MudText Typo="Typo.caption" Style="color:#16a34a">@_lookupResult.StatusLabel</MudText>
                    </div>
                }
                else if (_lookupResult != null && !_lookupResult.Found && _lookupResult.Source == LookupSource.Vies)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Style="color:#dc2626">Nerasta</MudText>
                    </div>
                }
                @if (_isCheckingVat)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Tikrinama VIES...</MudText>
                    </div>
                }
                else if (customer.VatVerified == true)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Style="height:18px;font-size:10px;padding:0 6px">VIES</MudChip>
                        <MudText Typo="Typo.caption" Style="color:#16a34a">PVM patikrintas VIES</MudText>
                    </div>
                }
                else if (customer.VatVerified == false)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Style="height:18px;font-size:10px;padding:0 6px">VIES</MudChip>
                        <MudText Typo="Typo.caption" Style="color:#dc2626">PVM kodas negalioja VIES</MudText>
                    </div>
                }
                else if (customer.VatVerified == null && !string.IsNullOrWhiteSpace(customer.VatCode))
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Default" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Netikrinta</MudText>
                    </div>
                }
            </MudItem>
            
            @if (!string.IsNullOrEmpty(_lookupResult?.RawAddress) && _lookupResult.Source == LookupSource.Jars)
            {
                <MudItem xs="12">
                    <MudPaper Elevation="0" Style="background:#eff6ff; border-radius:6px; padding:8px 12px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">JARS adresas (kopijuokite reikiamus laukus):</MudText>
                        <MudText Typo="Typo.body2" Style="font-family:monospace; user-select:all; cursor:text">
                            @_lookupResult.RawAddress
                        </MudText>
                    </MudPaper>
                </MudItem>
            }
            
            <MudItem xs="12">
                <MudTextField @key="@customer.Address" @bind-Value="customer.Address" Label="Adresas" Lines="2"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField @key="@customer.City" @bind-Value="customer.City" Label="Miestas" MaxLength="100"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField @key="@customer.PostalCode" @bind-Value="customer.PostalCode" Label="Pašto kodas" MaxLength="20"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField @key="@customer.Phone" @bind-Value="customer.Phone" Label="Telefonas" MaxLength="50"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField @key="@customer.Email" @bind-Value="customer.Email" Label="El. paštas" MaxLength="100"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField @bind-Value="customer.BankAccount" Label="Banko sąskaita" MaxLength="50"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="customer.PaymentTermDays" Label="Mokėjimo terminas (dienos)"
                                 Min="0" Max="365" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField T="string"
                              @key="@_vatRateKey"
                              Value="@(customer.DefaultVatRate.ToString("G29"))"
                              ValueChanged="@((string v) => { if (decimal.TryParse(v, out var d)) customer.DefaultVatRate = d; })"
                              Label="Numatytasis PVM (%)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="6">
                <MudSelect T="string" @bind-Value="customer.DefaultLanguage" Label="Kalba"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("lt")">Lietuvių</MudSelectItem>
                    <MudSelectItem T="string" Value="@("en")">English</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12">
                <MudTextField @bind-Value="customer.Notes" Label="Pastabos" Lines="3" MaxLength="1000"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12">
                <MudSwitch @bind-Value="customer.IsActive" Label="Aktyvus" Color="Color.Success" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="@CloseDialog">Atšaukti</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none" StartIcon="@Icons.Material.Filled.Save" OnClick="@SubmitForm">Išsaugoti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ISnackbar snackbar { get; set; } = default!;
    [Inject] private IViesService ViesService { get; set; } = default!;
    [CascadingParameter] public IMudDialogInstance? Dialog { get; set; }
    [Parameter] public Customer? Customer { get; set; }
    [Parameter] public EventCallback<Customer> OnCustomerCreated { get; set; }

    private Customer customer = new();
    private bool _lookupLoading = false;
    private CompanyLookupResult? _lookupResult = null;
    private string _lastCompanyCode = "";
    private int _vatRateKey = 0;
    private string? _originalVatCode = "";
    private bool _vatCheckStarted = false;
    private bool _isCheckingVat = false;

    protected override void OnParametersSet()
    {
        customer = Customer ?? new Customer
        {
            PartnerType = "Customer",
            IsCustomer = true,
            PaymentTermDays = 30,
            DefaultVatRate = 0m,
            DefaultLanguage = "lt",
            CountryCode = "",
            Country = "",
            City = "",
            Address = "",
            PostalCode = "",
            IsActive = true
        };
        // Užfiksuoti pradinį VAT kodą — VIES patikrai (palyginimui, ar pasikeitė)
        _originalVatCode = customer.VatCode;
        if (customer.Id == 0)
        {
            customer.DefaultVatRate = 0m;
            customer.CountryCode = "";
            customer.Country = "";
        }
    }

    private async Task SubmitForm()
    {
        try
        {
            // Check for duplicates before saving
            var allPartners = await CustomerService.GetAllBusinessPartnersAsync();
            var duplicates = allPartners.Where(p => p.Id != customer.Id && (
                // Check by company code
                (!string.IsNullOrEmpty(customer.CompanyCode) && !string.IsNullOrEmpty(p.CompanyCode) &&
                 p.CompanyCode.Trim().Equals(customer.CompanyCode.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                // Check by VAT code (strip country prefix for comparison)
                (!string.IsNullOrEmpty(customer.VatCode) && !string.IsNullOrEmpty(p.VatCode) &&
                 StripCountryPrefix(p.VatCode).Equals(StripCountryPrefix(customer.VatCode), StringComparison.OrdinalIgnoreCase)) ||
                // Check by name (strip legal form for comparison)
                (!string.IsNullOrEmpty(customer.Name) && !string.IsNullOrEmpty(p.Name) &&
                 StripLegalForm(p.Name).Trim().Equals(StripLegalForm(customer.Name).Trim(), StringComparison.OrdinalIgnoreCase))
            )).ToList();

            if (duplicates.Any())
            {
                var dupNames = string.Join(", ", duplicates.Select(d => d.Name).Take(3));
                var confirmed = await DialogService.ShowMessageBox(
                    "Galimas dublikatas",
                    $"Rastas panašus partneris: {dupNames}. Ar tikrai norite išsaugoti?",
                    yesText: "Taip, išsaugoti",
                    cancelText: "Atšaukti");
                if (confirmed != true) return;
            }

            // Save the customer
            var savedCustomer = await CustomerService.SaveCustomerAsync(customer);
            
            // Close dialog with result
            Dialog?.Close(savedCustomer);
        }
        catch (Exception ex)
        {
            snackbar?.Add($"Klaida išsaugant klientą: {ex.Message}", Severity.Error);
        }
    }

    private string StripCountryPrefix(string vatCode)
    {
        if (string.IsNullOrEmpty(vatCode)) return "";
        return vatCode.Length > 2 && char.IsLetter(vatCode[0]) && char.IsLetter(vatCode[1])
            ? vatCode.Substring(2)
            : vatCode;
    }

    private string StripLegalForm(string name)
    {
        if (string.IsNullOrEmpty(name)) return "";
        var prefixes = new[] { "UAB ", "AB ", "MB ", "IĮ ", "VšĮ ", "SIA ", "OÜ ", "AS ", "Sp. z o.o. ", "GmbH ", "s.r.o. ", "BV ", "NV ", "SRL ", "SA " };
        foreach (var prefix in prefixes)
            if (name.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                return name.Substring(prefix.Length).Trim('"', ' ', '\'');
        return name.Trim('"', ' ', '\'');
    }

    private void CloseDialog()
    {
        Dialog?.Close(DialogResult.Cancel());
    }

    private async Task HandleValidSubmit()
    {
        // Check if name already exists
        var existingByName = await CustomerService.GetAllBusinessPartnersAsync();
        
        if (existingByName.Any(bp => bp.Name == customer.Name && bp.Id != customer.Id))
        {
            snackbar?.Add("Partneris su šiuo pavadinimu jau egzistuoja!", Severity.Warning);
            return;
        }
    }

      private async Task OnCompanyCodeChanged()
      {
          customer.CompanyCode = customer.CompanyCode?.Trim() ?? "";
          if (string.IsNullOrWhiteSpace(customer.CompanyCode) || customer.CompanyCode.Length < 6) return;
          _lookupLoading = true;
          StateHasChanged();
          _lookupResult = await CompanyLookupService.LookupByCompanyCodeAsync(customer.CompanyCode);
           if (_lookupResult.Found) await ApplyLookupResult(_lookupResult);
          _lookupLoading = false;
          StateHasChanged();
      }

      protected override async Task OnAfterRenderAsync(bool firstRender)
      {
          // VIES patvirtinimo patikra atidarytam esamam partneriui (vieną kartą per dialogą)
          if (!_vatCheckStarted && customer.Id > 0 && !string.IsNullOrWhiteSpace(customer.VatCode))
          {
              _vatCheckStarted = true;
              await RunVatVerificationCheckAsync();
          }
          if (customer.Id > 0) return; // Don't auto-lookup for existing customers
          if (customer.CompanyCode != _lastCompanyCode && !string.IsNullOrWhiteSpace(customer.CompanyCode) && customer.CompanyCode.Length >= 6)
          {
              _lastCompanyCode = customer.CompanyCode;
              await OnCompanyCodeChanged();
          }
      }

 private async Task OnVatCodeChanged()
 {
     customer.VatCode = customer.VatCode?.Trim() ?? "";
     if (string.IsNullOrWhiteSpace(customer.VatCode) || customer.VatCode.Length < 4) return;
     // Auto-prefix PL NIP if user enters 10-digit number without PL prefix
     if (customer.VatCode.Length == 10 && customer.VatCode.All(char.IsDigit))
         customer.VatCode = "PL" + customer.VatCode;
     _lookupLoading = true;
     StateHasChanged();
     var result = await CompanyLookupService.LookupByVatCodeAsync(customer.VatCode);
      if (result.Found)
      {
          _lookupResult = result;
          await ApplyLookupResult(result);
      }
      _lookupLoading = false;
      StateHasChanged();
      // VIES patvirtinimo patikra — jei kodas pasikeitė arba dar nebuvo tikrintas
      if (VatVerificationHelper.ShouldVerifyVies(customer.IsIndividual, customer.VatCode, _originalVatCode, customer.VatVerified))
      {
          await RunVatVerificationCheckAsync();
      }
  }

      private async Task RunVatVerificationCheckAsync()
      {
          if (string.IsNullOrWhiteSpace(customer.VatCode) || customer.VatCode.Length < 4) return;
          _isCheckingVat = true; StateHasChanged();
          try
          {
              var result = await ViesService.LookupAsync(customer.VatCode);
              if (!result.ServiceAvailable)
              {
                  // VIES nepasiekiamas arba timeout — neištriname ankstesnio rezultato
                  snackbar?.Add("VIES nepasiekiamas, patikrinta vėliau", Severity.Warning);
                  return;
              }
              customer.VatVerified = result.IsValid;
              customer.VatVerifiedAt = DateTime.UtcNow;
              customer.VatVerifiedName = result.Name;
          }
          finally
          {
              _isCheckingVat = false; StateHasChanged();
          }
      }

       private async Task ApplyLookupResult(CompanyLookupResult result)
      {
          if (string.IsNullOrEmpty(customer.Name) && !string.IsNullOrEmpty(result.Name))
             customer.Name = result.Name;
        if (string.IsNullOrEmpty(customer.Address) && !string.IsNullOrEmpty(result.Address))
            customer.Address = result.Address;
        if (string.IsNullOrEmpty(customer.City) && !string.IsNullOrEmpty(result.City))
            customer.City = result.City;
        if (string.IsNullOrEmpty(customer.PostalCode) && !string.IsNullOrEmpty(result.PostalCode))
            customer.PostalCode = result.PostalCode;
        if (!string.IsNullOrEmpty(result.VatCode))
            customer.VatCode = result.VatCode;
        if (string.IsNullOrEmpty(customer.Email) && !string.IsNullOrEmpty(result.Email))
            customer.Email = result.Email;
        if (string.IsNullOrEmpty(customer.Phone) && !string.IsNullOrEmpty(result.Phone))
            customer.Phone = result.Phone;
        if (string.IsNullOrEmpty(customer.BankAccount) && !string.IsNullOrEmpty(result.BankAccount))
            customer.BankAccount = result.BankAccount;
        if (string.IsNullOrEmpty(customer.CountryCode) && !string.IsNullOrEmpty(result.CountryCode))
        {
            customer.CountryCode = result.CountryCode;
            customer.DefaultVatRate = result.CountryCode.ToUpper() == "LT" ? 21m : 0m;
            _vatRateKey++;
        }
        await InvokeAsync(StateHasChanged);
    }
}
