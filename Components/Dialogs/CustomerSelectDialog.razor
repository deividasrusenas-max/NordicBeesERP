@using NordicBeesERP.Models
@using MudBlazor
@namespace NordicBeesERP.Components.Dialogs

<MudDialog Options="@_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Pasirinkite klientą</MudText>
    </TitleContent>
    <DialogContent>
        <MudTable T="Customer" Items="@Customers" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Pavadinimas</MudTh>
                <MudTh Style="text-align:right">Veiksmas</MudTh>
            </HeaderContent>
            <RowTemplate Context="customer">
                <MudTd DataLabel="Pavadinimas">@customer.Name</MudTd>
                <MudTd Style="text-align:right">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               OnClick="@(() => MudDialog.Close(DialogResult.Ok(customer)))">
                        PASIRINKTI
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>
</MudDialog>

@code {
    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true };
    
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<Customer> Customers { get; set; } = new();
}
