@namespace NordicBeesERP.Components.Dialogs
@using MudBlazor
@using NordicBeesERP.Models

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="@Color.Primary" />
            <MudText Typo="Typo.h6">Sąskaitos išlaidos</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (DefaultSupplierId.HasValue && Suppliers?.Any(s => s.Id == DefaultSupplierId.Value) != true)
        {
            <MudAlert Severity="Severity.Warning" Dense Class="mb-4" >
                Šis ūkininkas neturi 6% PVM kodo — pasirinkite kitą tiekėją.
            </MudAlert>
        }

        <MudSelect T="int?" @bind-Value="_selectedSupplierId"
                   Label="Ūkininkas (6% PVM)"
                   Variant="Variant.Outlined"
                   FullWidth="@true"
                   Required="true"
                   Margin="Margin.Dense"
                   Placeholder="Pasirinkite ūkininką">
            @if (Suppliers != null)
            {
                @foreach (var s in Suppliers)
                {
                    <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                }
            }
        </MudSelect>

        <MudNumericField T="decimal"
                         @bind-Value="_transportCost"
                         Label="Transporto išlaidos, kurias skolingas tiekėjas (€)"
                         Variant="Variant.Outlined"
                         FullWidth="@true"
                         Format="F2"
                         Culture="@_ltCulture"
                         Margin="Margin.Dense"
                         Immediate="true" />
        <MudNumericField T="decimal"
                         @bind-Value="_barrelCost"
                         Label="Statinių/taros išlaidos, kurias skolingas tiekėjas (€)"
                         Variant="Variant.Outlined"
                         FullWidth="@true"
                         Format="F2"
                         Culture="@_ltCulture"
                         Margin="Margin.Dense"
                         Immediate="true" />
        <MudNumericField T="decimal"
                         @bind-Value="_otherCost"
                         Label="Kitos išlaidos (€)"
                         Variant="Variant.Outlined"
                         FullWidth="@true"
                         Format="F2"
                         Culture="@_ltCulture"
                         Margin="Margin.Dense"
                         Immediate="true" />

        <MudStack Spacing="1" Class="mt-4">
            <MudText Typo="Typo.body2">Vieneto kaina: @_previewUnitPrice.ToString("F2", _ltCulture) €</MudText>
            <MudText Typo="Typo.body2">Suma: @_previewTotal.ToString("F2", _ltCulture) €</MudText>
        </MudStack>

        @if (TotalAmount > 0 && _previewTotal < 0)
        {
            <MudAlert Severity="Severity.Warning" Dense Class="mt-4">
                Išskaičiavimai viršija bendrą sumą.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Style="text-transform:none"
                   OnClick="@Cancel">Atšaukti</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Style="text-transform:none"
                   Disabled="@(_selectedSupplierId == null || (TotalAmount > 0 && _previewTotal < 0))"
                   OnClick="@Confirm">Formuoti sąskaitą</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public decimal TotalAmount { get; set; }
    [Parameter] public decimal TotalNetWeight { get; set; }
    [Parameter] public List<BusinessPartner>? Suppliers { get; set; }
    [Parameter] public int? DefaultSupplierId { get; set; }

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private int? _selectedSupplierId;
    private decimal _transportCost = 0m;
    private decimal _barrelCost = 0m;
    private decimal _otherCost = 0m;

    private readonly System.Globalization.CultureInfo _ltCulture = new("lt-LT");

    private decimal _deductions => _transportCost + _barrelCost + _otherCost;

    private decimal _previewUnitPrice => TotalNetWeight > 0
        ? (TotalAmount - _deductions) / TotalNetWeight
        : 0m;

    private decimal _previewTotal => TotalAmount - _deductions;

    protected override void OnInitialized()
    {
        _selectedSupplierId = (DefaultSupplierId.HasValue
            && Suppliers?.Any(s => s.Id == DefaultSupplierId.Value) == true)
            ? DefaultSupplierId
            : null;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(new DeliveryInvoiceCostsResult
    {
        SupplierId = _selectedSupplierId,
        TransportCost = _transportCost,
        BarrelCost = _barrelCost,
        OtherCost = _otherCost
    }));

    public class DeliveryInvoiceCostsResult
    {
        public int? SupplierId { get; init; }
        public decimal TransportCost { get; init; }
        public decimal BarrelCost { get; init; }
        public decimal OtherCost { get; init; }

        public static async Task<DeliveryInvoiceCostsResult?> ShowAsync(
            IDialogService dialogService, decimal totalAmount, decimal totalNetWeight,
            List<BusinessPartner>? suppliers, int? defaultSupplierId)
        {
            var parameters = new DialogParameters<DeliveryInvoiceCostsDialog>
            {
                [nameof(TotalAmount)] = totalAmount,
                [nameof(TotalNetWeight)] = totalNetWeight,
                [nameof(Suppliers)] = suppliers,
                [nameof(DefaultSupplierId)] = defaultSupplierId
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
            var dialog = await dialogService.ShowAsync<DeliveryInvoiceCostsDialog>("Sąskaitos išskyrimas", parameters, options);
            var result = await dialog.Result;
            if (result == null || result.Canceled)
                return null;
            return result.Data as DeliveryInvoiceCostsResult;
        }
    }
}
