@using NordicBeesERP.Models.Expenses
@using NordicBeesERP.Services
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudPaper Elevation="1" Rounded="true" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">@(_isEditMode ? "Redaguoti kategoriją" : "Nauja kategorija")</MudText>
            
            <MudTextField T="string" @bind-Value="_category.Name" Label="Pavadinimas *" Dense="true" FullWidth="true" Required="true" />
            
            <MudTextField T="string" @bind-Value="_category.Code" Label="Kodas *" Dense="true" FullWidth="true" Required="true" />
            
            <MudSelect T="int?" @bind-Value="_category.ParentId" Label="Tėvinė kategorija" Dense="true" FullWidth="true">
                <MudSelectItem Value="(int?)null" Text="-- Netėvinė --" />
                @foreach (var parent in _parentOptions)
                {
                    <MudSelectItem Value="@parent.Id" Text="@parent.Name">@parent.Name</MudSelectItem>
                }
            </MudSelect>
            
            <MudSwitch T="bool" @bind-Value="_category.IsActive" Label="Aktyvi" Color="Color.Primary" />
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="SaveCategory" Color="Color.Primary" Variant="Variant.Filled">@(_isEditMode ? "Atnaujinti" : "Sukurti")</MudButton>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Atšaukti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public bool IsEditMode { get; set; } = false;
    [Parameter] public NordicBeesERP.Models.Expenses.ExpenseCategory? ExistingCategory { get; set; }

    private NordicBeesERP.Models.Expenses.ExpenseCategory _category = new();
    private List<NordicBeesERP.Models.Expenses.ExpenseCategory> _parentOptions = new();
    private bool _isEditMode;

    protected override async Task OnInitializedAsync()
    {
        _isEditMode = IsEditMode;
        
        var categories = await ExpenseService.GetCategoriesAsync();
        _parentOptions = categories.Where(c => c.ParentId == null).ToList();

        if (_isEditMode && ExistingCategory != null)
        {
            _category = new NordicBeesERP.Models.Expenses.ExpenseCategory
            {
                Id = ExistingCategory.Id,
                Name = ExistingCategory.Name,
                Code = ExistingCategory.Code,
                ParentId = ExistingCategory.ParentId,
                IsActive = ExistingCategory.IsActive
            };
            // Remove self from parent options to avoid circular reference
            _parentOptions = _parentOptions.Where(c => c.Id != ExistingCategory.Id).ToList();
        }
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(_category.Name) || string.IsNullOrWhiteSpace(_category.Code))
        {
            Snackbar.Add("Pavadinimas ir kodas yra privalomi!", Severity.Error);
            return;
        }

        try
        {
            if (_isEditMode)
            {
                await ExpenseService.UpdateCategoryAsync(_category);
                Snackbar.Add("Kategorija atnaujinta ✓", Severity.Success);
            }
            else
            {
                await ExpenseService.AddCategoryAsync(_category);
                Snackbar.Add("Kategorija sukurta ✓", Severity.Success);
            }

            MudDialog.Close();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klaida: " + ex.Message, Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    [Inject] private IExpenseService ExpenseService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
}