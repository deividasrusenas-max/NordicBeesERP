@using NordicBeesERP.Models.Expenses
@using NordicBeesERP.Services
@using NordicBeesERP.Helpers
@using MudBlazor
@using System.Globalization
@namespace NordicBeesERP.Components.Dialogs

@inject IDbContextFactory<NordicBeesERPContext> DbFactory
@inject IPaymentService PaymentService
@inject ISnackbar Snackbar
@inject NordicBeesERPContext Db

<MudDialog>
    <DialogContent>
        @if (_invoice is not null)
        {
            <MudPaper Elevation="0" Rounded="@true" Square="false" Class="pa-3">
                <!-- Invoice Summary -->
                <MudPaper Elevation="1" Rounded="@true" Square="false" Class="pa-3 mb-3 bg-light">
                    <MudGrid>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Tiekėjas</MudText>
                            <MudText Typo="Typo.body1" Style="font-weight:500">@SupplierName</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.body2" Color="Color.Default">Sąskaitos numeris</MudText>
                            <MudText Typo="Typo.h6">@_invoice.InvoiceNumber</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.body2" Color="Color.Default">Sąskaitos data</MudText>
                            <MudText Typo="Typo.h6">@_invoice.InvoiceDate.ToString("yyyy-MM-dd")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.body2" Color="Color.Default">Mokėjimo terminas</MudText>
                            <MudText Typo="Typo.h6">@_invoice.DueDate.ToString("yyyy-MM-dd")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.body2" Color="Color.Default">Būsena</MudText>
                            <MudChip T="string" Color="@ExpenseStatusHelper.GetColor(_invoice.Status)" Size="Size.Small">@ExpenseStatusHelper.GetLabel(_invoice.Status)</MudChip>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Invoice Financial Summary -->
                <MudPaper Elevation="1" Rounded="@true" Square="false" Class="pa-3 mb-3">
                    <MudGrid>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.body2">Suma be PVM</MudText>
                            <MudText Typo="Typo.h6">@_invoice.AmountExclVat.ToString("0.00") €</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.body2">PVM (@(_invoice.VatRate.ToString("0.00"))%)</MudText>
                            <MudText Typo="Typo.h6">@_invoice.VatAmount.ToString("0.00") €</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.body2">Suma su PVM</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Primary">@_invoice.AmountInclVat.ToString("0.00") €</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.body2">Sumokėta</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success">@_invoice.PaidAmount.ToString("0.00") €</MudText>
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="my-2" />
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText Typo="Typo.body2">Liko sumokėti</MudText>
                            <MudText Typo="Typo.h6" Color="@GetRemainingAmountColor">@GetRemainingAmountText</MudText>
                        </MudItem>
                        <MudItem xs="6" Class="text-right">
                            <MudText Typo="Typo.body2">Procentas</MudText>
                            <MudText Typo="Typo.h6">@PaymentPercent.ToString("F1") %</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Add Payment Form -->
                <MudPaper Elevation="1" Rounded="@true" Square="false" Class="pa-3 mb-3">
                    <MudText Typo="Typo.h6" Class="mb-2">Įvesti mokėjimą</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Mokėjimo data" Date="@_paymentDate" DateChanged="@((DateTime? d) => _paymentDate = d)" FullWidth="@true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="decimal" Label="Suma" @ref="_amountField" @bind-Value="_paymentAmount" FullWidth="@true" Type="TextFieldType.Number" @onclick="@(async () => { if (_amountField != null) await _amountField.SelectAsync(); })" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Label="Mokėjimo būdas" @bind-Value="_paymentMethod" FullWidth="@true">
                                <MudSelectItem T="string" Value="@("BANK")">Banko pavedimas</MudSelectItem>
                                <MudSelectItem T="string" Value="@("CASH")">Grynaisi</MudSelectItem>
                                <MudSelectItem T="string" Value="@("OTHER")">Kita</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Banko pavedimo Nr." @bind-Value="_paymentReference" FullWidth="@true" />
                    </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Pastabos" @bind-Value="_paymentNotes" FullWidth="@true" multiline="true" rows="2" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="AddPayment" Disabled="!CanAddPayment">
                                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-1" />
                                Pridėti mokėjimą
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Payment History -->
                <MudText Typo="Typo.h6" Class="mb-2">Mokėjimų istorija</MudText>
                @if (_payments?.Count > 0)
                {
                    <MudTable Items="@_payments" Elevation="1" Rounded="@true" Square="false" Class="mb-3">
                        <HeaderContent>
                            <MudTh>Data</MudTh>
                            <MudTh>Suma</MudTh>
                            <MudTh>Mokėjimo būdas</MudTh>
                            <MudTh>Referencė</MudTh>
                            <MudTh>Pastabos</MudTh>
                            <MudTh>Veiksmai</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @{
                                var payment = context as ExpensePayment;
                            }
                            <MudTd>@payment?.PaymentDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd>@payment?.Amount.ToString("0.00") €</MudTd>
                            <MudTd>@payment?.PaymentMethod</MudTd>
                            <MudTd>@payment?.Reference</MudTd>
                            <MudTd>@payment?.Notes</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small" Color="Color.Primary"
                                               Title="Redaguoti mokėjimą"
                                               OnClick="@(() => EditPaymentAsync(payment))" />
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                                               Size="Size.Small" Color="Color.Error"
                                               Title="Anuliuoti mokėjimą"
                                               OnClick="@(() => DeletePaymentAsync(payment.Id))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Warning">Mokėjimų istorija tuščia</MudText>
                }

            </MudPaper>
        }
        else
        {
            <MudText Typo="Typo.body1" Color="Color.Default">Įkeliamas informacija...</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Uždaryti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int InvoiceId { get; set; }

    [Parameter]
    public ExpenseInvoice? Invoice { get; set; }

    [Parameter]
    public string? SupplierName { get; set; }

    [Parameter]
    public IDialogService? DialogService { get; set; }

    [Inject]
    IExpenseService ExpenseService { get; set; } = default!;

    private ExpenseInvoice? _invoice;
    private List<ExpensePayment> _payments = new();
    private DateTime? _paymentDate = DateTime.Today;
    private decimal _paymentAmount;
    private string _paymentMethod = "BANK";
    private string _paymentReference = string.Empty;
    private string _paymentNotes = string.Empty;
    private decimal _totalPaid;
    private MudTextField<decimal>? _amountField;

    protected override async Task OnParametersSetAsync()
    {
        await LoadInvoiceAsync();
        await LoadPaymentsAsync();
    }

    private async Task LoadInvoiceAsync()
    {
        if (Invoice != null)
        {
            _invoice = Invoice;
        }
        else if (InvoiceId > 0)
        {
            _invoice = await ExpenseService.GetInvoiceWithDetailsAsync(InvoiceId);
        }
        StateHasChanged();
    }

    private async Task LoadPaymentsAsync()
    {
        var invoiceId = Invoice?.Id ?? InvoiceId;
        if (invoiceId > 0)
        {
            _payments = await ExpenseService.GetPaymentsAsync(invoiceId);
            _totalPaid = _payments.Sum(p => p.Amount);
            _paymentAmount = RemainingAmount > 0 ? RemainingAmount : 0;
            // Sync invoice paid amount with calculated total from payments
            if (_invoice != null)
            {
                _invoice.PaidAmount = _totalPaid;
            }
        }
        StateHasChanged();
    }

    private void Close()
    {
        MudDialog?.Close();
    }

    private bool CanAddPayment => _invoice is not null && _invoice.Status != "PAID" && _paymentAmount > 0 && _paymentAmount <= RemainingAmount;

    private async Task AddPayment()
    {
        if (_invoice is null || !CanAddPayment)
            return;

        Console.WriteLine($"Adding payment for invoice id: {Invoice?.Id}");
        var payment = new ExpensePayment
        {
            InvoiceId = Invoice!.Id,
            PaymentDate = _paymentDate.Value,
            Amount = _paymentAmount,
            PaymentMethod = _paymentMethod,
            Reference = _paymentReference,
            Notes = _paymentNotes,
            CreatedAt = DateTime.UtcNow
        };

        await ExpenseService.AddPaymentAsync(payment);

        // Reload invoice from DB to get fresh status
        var updatedInvoice = await ExpenseService.GetInvoiceAsync(Invoice!.Id);
        if (updatedInvoice != null)
        {
            _invoice!.Status = updatedInvoice.Status;
            _invoice.PaidAmount = updatedInvoice.PaidAmount;
        }

        await LoadPaymentsAsync();

        // Reload invoice from DB to get fresh status
        _invoice = await ExpenseService.GetInvoiceWithDetailsAsync(_invoice.Id);
        StateHasChanged();

        // Close dialog with success result to notify parent
        MudDialog?.Close(DialogResult.Ok(true));
    }

    private async Task EditPaymentAsync(ExpensePayment payment)
    {
        if (DialogService == null) return;

        var parameters = new DialogParameters { ["Payment"] = payment };
        var dialog = await DialogService.ShowAsync<EditExpensePaymentDialog>(
            "Redaguoti mokėjimą", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadPaymentsAsync();
            if (Invoice != null)
            {
                var updatedInvoice = await ExpenseService.GetInvoiceAsync(Invoice.Id);
                if (updatedInvoice != null)
                {
                    _invoice!.Status = updatedInvoice.Status;
                    _invoice.PaidAmount = updatedInvoice.PaidAmount;
                }
            }
        }
    }

    private async Task DeletePaymentAsync(int paymentId)
    {
        if (DialogService == null) return;

        var confirmed = await ConfirmDialog.ShowAsync(
            DialogService,
            "Anuliuoti mokėjimą?",
            "Mokėjimas bus ištrintas ir sąskaitos likutis perskaičiuotas.",
            confirmText: "Taip, anuliuoti");
        if (!confirmed) return;

        await ExpenseService.DeletePaymentAsync(paymentId);
        Snackbar.Add("Mokėjimas anuliuotas", Severity.Success);

        await LoadPaymentsAsync();

        // Reload invoice from DB to get fresh status
        _invoice = await ExpenseService.GetInvoiceWithDetailsAsync(_invoice.Id);
        StateHasChanged();
    }

    private async Task RemovePayment(int paymentId)
    {
        await DeletePaymentAsync(paymentId);
    }

    private decimal RemainingAmount => (_invoice?.AmountInclVat ?? 0) - _totalPaid;

    private double PaymentPercent => _invoice?.AmountInclVat > 0 ? Math.Min(100, (double)(_totalPaid / _invoice.AmountInclVat) * 100) : 0;

    private string GetRemainingAmountText
    {
        get
        {
            if (_totalPaid >= (_invoice?.AmountInclVat ?? 0))
                return "Sumokėta visiškai";
            else if (_totalPaid > 0)
                return $"Liko: {RemainingAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)} €";
            else
                return "Nesumokėta";
        }
    }

    private Color GetRemainingAmountColor
    {
        get
        {
            if (_totalPaid >= (_invoice?.AmountInclVat ?? 0))
                return Color.Success;
            else if (_totalPaid > 0)
                return Color.Warning;
            else
                return Color.Error;
        }
    }

    protected override void OnParametersSet()
    {
        // Sync invoice status after payment was added/removed
        if (_invoice != null)
        {
            _invoice.Status = ExpenseStatusHelper.Recalculate(_totalPaid, _invoice.AmountInclVat, _invoice.DueDate);
        }
    }
}