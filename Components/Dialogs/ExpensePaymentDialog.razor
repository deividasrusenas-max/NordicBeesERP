@using NordicBeesERP.Models.Expenses
@using NordicBeesERP.Services
@using NordicBeesERP.Helpers
@using MudBlazor
@using System.Globalization
@namespace NordicBeesERP.Components.Dialogs

@inject IDbContextFactory<NordicBeesERPContext> DbFactory
@inject IPaymentService PaymentService
@inject ISnackbar Snackbar
@inject NordicBeesERPContext Db

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Registruoti mokėjimą</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <!-- SECTION 1: Invoice Info Card -->
        <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px; margin-bottom:16px;">
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Tiekėjas / Klientas</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600">@SupplierName</MudText>
                </MudItem>
                <MudItem xs="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Nr.</MudText>
                    <MudText Typo="Typo.body2">@_invoice.InvoiceNumber</MudText>
                </MudItem>
                <MudItem xs="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Terminas</MudText>
                    <MudText Typo="Typo.body2" Style="@(_isOverdue ? "color:#dc2626;font-weight:600" : "")">@_invoice.DueDate.ToString("yyyy-MM-dd")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- SECTION 2: Amounts Summary -->
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Suma su PVM</MudText>
                <MudText Typo="Typo.body1" Style="font-weight:600">@_invoice.AmountInclVat.ToString("N2") €</MudText>
            </MudItem>
            <MudItem xs="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Sumokėta</MudText>
                <MudText Typo="Typo.body1" Style="color:#16a34a;font-weight:600">@_invoice.PaidAmount.ToString("N2") €</MudText>
            </MudItem>
            <MudItem xs="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Liko</MudText>
                <MudText Typo="Typo.body1" Style="color:#dc2626;font-weight:600">@GetRemainingAmountText</MudText>
            </MudItem>
            <MudItem xs="3">
                <MudChip T="string" Color="@ExpenseStatusHelper.GetColor(_invoice.Status)" Size="Size.Small">@ExpenseStatusHelper.GetLabel(_invoice.Status)</MudChip>
            </MudItem>
        </MudGrid>
        <MudDivider Class="mb-3" />

        <!-- SECTION 3: Payment Input Form -->
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Įvesti mokėjimą</MudText>
        <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px; margin-bottom:16px;">
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudDatePicker Label="Mokėjimo data" Date="_paymentDate" DateChanged="@((DateTime? d) => _paymentDate = d)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="decimal" Label="Suma (€)" @bind-Value="_paymentAmount" Min="0.01m" Max="999999999.99m" Format="F2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" Label="Mokėjimo būdas" @bind-Value="_paymentMethod" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@("BANK")">Banko pavedimas</MudSelectItem>
                        <MudSelectItem T="string" Value="@("CASH")">Grynaisi</MudSelectItem>
                        <MudSelectItem T="string" Value="@("OTHER")">Kita</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Label="Nuorodos nr." @bind-Value="_paymentReference" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Pastabos" @bind-Value="_paymentNotes" Variant="Variant.Outlined" Margin="Margin.Dense" multiline="true" Rows="2" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Payment History -->
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Mokėjimų istorija</MudText>
        <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px;">
            @if (_payments?.Count > 0)
            {
                <MudTable Items="@_payments" Dense="true" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Data</MudTh>
                        <MudTh>Suma</MudTh>
                        <MudTh>Mokėjimo būdas</MudTh>
                        <MudTh>Referencė</MudTh>
                        <MudTh>Pastabos</MudTh>
                        <MudTh>Veiksmai</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var payment = context as ExpensePayment;
                        }
                        <MudTd DataLabel="Data">@payment?.PaymentDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="Suma">@payment?.Amount.ToString("N2") €</MudTd>
                        <MudTd DataLabel="Mokėjimo būdas">@payment?.PaymentMethod</MudTd>
                        <MudTd DataLabel="Referencė">@payment?.Reference</MudTd>
                        <MudTd DataLabel="Pastabos">@payment?.Notes</MudTd>
                        <MudTd DataLabel="Veiksmai">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small" Color="Color.Primary"
                                           Title="Redaguoti mokėjimą"
                                           OnClick="@(() => EditPaymentAsync(payment))" />
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                                           Size="Size.Small" Color="Color.Error"
                                           Title="Anuliuoti mokėjimą"
                                           OnClick="@(() => DeletePaymentAsync(payment.Id))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Warning">Mokėjimų istorija tuščia</MudText>
            }
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none" StartIcon="@Icons.Material.Filled.Save" OnClick="AddPayment">Išsaugoti</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="Close">Atšaukti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int InvoiceId { get; set; }

    [Parameter]
    public ExpenseInvoice? Invoice { get; set; }

    [Parameter]
    public string? SupplierName { get; set; }

    [Parameter]
    public IDialogService? DialogService { get; set; }

    private bool _isOverdue => _invoice != null && _invoice.DueDate < DateTime.Today;

    [Inject]
    IExpenseService ExpenseService { get; set; } = default!;

    private ExpenseInvoice? _invoice;
    private List<ExpensePayment> _payments = new();
    private DateTime? _paymentDate = DateTime.Today;
    private decimal _paymentAmount;
    private string _paymentMethod = "BANK";
    private string _paymentReference = string.Empty;
    private string _paymentNotes = string.Empty;
    private decimal _totalPaid;
    private MudTextField<decimal>? _amountField;

    protected override async Task OnParametersSetAsync()
    {
        await LoadInvoiceAsync();
        await LoadPaymentsAsync();
    }

    private async Task LoadInvoiceAsync()
    {
        if (Invoice != null)
        {
            _invoice = Invoice;
        }
        else if (InvoiceId > 0)
        {
            _invoice = await ExpenseService.GetInvoiceWithDetailsAsync(InvoiceId);
        }
        StateHasChanged();
    }

    private async Task LoadPaymentsAsync()
    {
        var invoiceId = Invoice?.Id ?? InvoiceId;
        if (invoiceId > 0)
        {
            _payments = await ExpenseService.GetPaymentsAsync(invoiceId);
            _totalPaid = _payments.Sum(p => p.Amount);
            _paymentAmount = RemainingAmount > 0 ? RemainingAmount : 0;
            // Sync invoice paid amount with calculated total from payments
            if (_invoice != null)
            {
                _invoice.PaidAmount = _totalPaid;
            }
        }
        StateHasChanged();
    }

    private void Close()
    {
        MudDialog?.Close();
    }

    private bool CanAddPayment => _invoice is not null && _invoice.Status != "PAID" && _paymentAmount > 0 && _paymentAmount <= RemainingAmount;

    private async Task AddPayment()
    {
        if (_invoice is null || !CanAddPayment)
            return;

        Console.WriteLine($"Adding payment for invoice id: {Invoice?.Id}");
        var payment = new ExpensePayment
        {
            InvoiceId = Invoice!.Id,
            PaymentDate = _paymentDate.Value,
            Amount = _paymentAmount,
            PaymentMethod = _paymentMethod,
            Reference = _paymentReference,
            Notes = _paymentNotes,
            CreatedAt = DateTime.UtcNow
        };

        await ExpenseService.AddPaymentAsync(payment);

        // Reload invoice from DB to get fresh status
        var updatedInvoice = await ExpenseService.GetInvoiceAsync(Invoice!.Id);
        if (updatedInvoice != null)
        {
            _invoice!.Status = updatedInvoice.Status;
            _invoice.PaidAmount = updatedInvoice.PaidAmount;
        }

        await LoadPaymentsAsync();

        // Reload invoice from DB to get fresh status
        _invoice = await ExpenseService.GetInvoiceWithDetailsAsync(_invoice.Id);
        StateHasChanged();

        // Close dialog with success result to notify parent
        MudDialog?.Close(DialogResult.Ok(true));
    }

    private async Task EditPaymentAsync(ExpensePayment payment)
    {
        if (DialogService == null) return;

        var parameters = new DialogParameters { ["Payment"] = payment };
        var dialog = await DialogService.ShowAsync<EditExpensePaymentDialog>(
            "Redaguoti mokėjimą", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadPaymentsAsync();
            if (Invoice != null)
            {
                var updatedInvoice = await ExpenseService.GetInvoiceAsync(Invoice.Id);
                if (updatedInvoice != null)
                {
                    _invoice!.Status = updatedInvoice.Status;
                    _invoice.PaidAmount = updatedInvoice.PaidAmount;
                }
            }
        }
    }

    private async Task DeletePaymentAsync(int paymentId)
    {
        if (DialogService == null) return;

        var confirmed = await ConfirmDialog.ShowAsync(
            DialogService,
            "Anuliuoti mokėjimą?",
            "Mokėjimas bus ištrintas ir sąskaitos likutis perskaičiuotas.",
            confirmText: "Taip, anuliuoti");
        if (!confirmed) return;

        await ExpenseService.DeletePaymentAsync(paymentId);
        Snackbar.Add("Mokėjimas anuliuotas", Severity.Success);

        await LoadPaymentsAsync();

        // Reload invoice from DB to get fresh status
        _invoice = await ExpenseService.GetInvoiceWithDetailsAsync(_invoice.Id);
        StateHasChanged();
    }

    private async Task RemovePayment(int paymentId)
    {
        await DeletePaymentAsync(paymentId);
    }

    private decimal RemainingAmount => (_invoice?.AmountInclVat ?? 0) - _totalPaid;

    private double PaymentPercent => _invoice?.AmountInclVat > 0 ? Math.Min(100, (double)(_totalPaid / _invoice.AmountInclVat) * 100) : 0;

    private string GetRemainingAmountText
    {
        get
        {
            if (_totalPaid >= (_invoice?.AmountInclVat ?? 0))
                return "Sumokėta visiškai";
            else if (_totalPaid > 0)
                return $"Liko: {RemainingAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)} €";
            else
                return "Nesumokėta";
        }
    }

    private Color GetRemainingAmountColor
    {
        get
        {
            if (_totalPaid >= (_invoice?.AmountInclVat ?? 0))
                return Color.Success;
            else if (_totalPaid > 0)
                return Color.Warning;
            else
                return Color.Error;
        }
    }

    protected override void OnParametersSet()
    {
        // Sync invoice status after payment was added/removed
        if (_invoice != null)
        {
            _invoice.Status = ExpenseStatusHelper.Recalculate(_totalPaid, _invoice.AmountInclVat, _invoice.DueDate);
        }
    }
}