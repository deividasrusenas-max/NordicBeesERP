@using NordicBeesERP.Models.Expenses
@using NordicBeesERP.Services
@using NordicBeesERP.Helpers
@using MudBlazor
@namespace NordicBeesERP.Components.Dialogs

<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Rounded="true" Square="false" Class="pa-3">
            <!-- Header -->
            <MudPaper Elevation="1" Rounded="true" Square="false" Class="pa-3 mb-3">
                <MudText Typo="Typo.h6" Class="mb-2">Tiekėjo išlaidų istorija</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect Label="Metai" @bind-Value="_selectedYear" FullWidth="@true">
                            @foreach (var year in _years)
                            {
                                <MudSelectItem Value="@year">@year</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" Class="mt-2">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadHistory" Disabled="_loading">
                            <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-1" />
                            @(_loading ? "Kraunama..." : "Atnaujinti")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Summary Cards -->
            @if (_historyItems?.Count > 0)
            {
                <MudPaper Elevation="1" Rounded="true" Square="false" Class="mb-3">
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudPaper Elevation="0" Class="pa-3" Style="background:#e8f5e9; border-radius:8px">
                                <MudText Typo="Typo.body2" Color="Color.Success">Iš viso išleista</MudText>
                                <MudText Typo="Typo.h5" Color="Color.Success">@FormatAmountHelper.Trim(_totalSpent, 2) €</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudPaper Elevation="0" Class="pa-3" Style="background:#e3f2fd; border-radius:8px">
                                <MudText Typo="Typo.body2" Color="Color.Primary">Sąskaitų skaičius</MudText>
                                <MudText Typo="Typo.h5" Color="Color.Primary">@_invoiceCount</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudPaper Elevation="0" Class="pa-3" Style="background:#fff3e0; border-radius:8px">
                                <MudText Typo="Typo.body2" Color="Color.Warning">Vidutinė suma</MudText>
                                <MudText Typo="Typo.h5" Color="Color.Warning">@FormatAmountHelper.Trim(_averageAmount, 2) €</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- History Table -->
                <MudPaper Elevation="1" Rounded="true" Square="false" Class="mb-3">
                    <MudTable T="ExpenseInvoice" Items="@_historyItems" Elevation="0" Hover="true" Striped="true" Dense="true">
                        <HeaderContent>
                            <MudTh>Data</MudTh>
                            <MudTh>Sąskaitos numeris</MudTh>
                            <MudTh>Suma</MudTh>
                            <MudTh>Būsena</MudTh>
                            <MudTh>Veiksmai</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="invoice">
                            <MudTd>
                                <MudText>@invoice.InvoiceDate.ToString("yyyy-MM-dd")</MudText>
                            </MudTd>
                            <MudTd>
                                <MudText>@invoice.InvoiceNumber</MudText>
                            </MudTd>
                            <MudTd>
                                <MudText>@FormatAmountHelper.Trim(invoice.AmountInclVat, 2) €</MudText>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Color="@GetStatusColor(invoice.Status)" Size="Size.Small">
                                    @GetStatusText(invoice.Status)
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudButtonGroup Variant="Variant.Text">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                                   Color="Color.Primary" 
                                                   OnClick="() => ViewInvoice(invoice.Id)" />
                                </MudButtonGroup>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
            else if (_loading)
            {
                <MudPaper Elevation="1" Rounded="true" Square="false" Class="pa-5 text-center">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.body2" Class="mt-2">Kraunama istorijos...</MudText>
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="1" Rounded="true" Square="false" Class="pa-5 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="mb-2">Nerasta sąskaitų</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Pasirinkite kitus metus arba įkelkite naujas sąskaitas</MudText>
                </MudPaper>
            }
        </MudPaper>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public int SupplierId { get; set; }
    [Parameter] public string? SupplierName { get; set; }

    private MudDialog? _mudDialog;
    private List<ExpenseInvoice> _historyItems = new();
    private int _selectedYear = DateTime.Now.Year;
    private readonly List<int> _years = new();
    private bool _loading = false;

    [Inject] private IExpenseService ExpenseService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override void OnInitialized()
    {
        // Generate years (current year and previous 5 years)
        var currentYear = DateTime.Now.Year;
        for (int i = 0; i < 6; i++)
        {
            _years.Add(currentYear - i);
        }
        _selectedYear = currentYear;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _historyItems = await ExpenseService.GetSupplierHistoryAsync(SupplierId, _selectedYear);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida kraunant istoriją: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Color GetStatusColor(string status) => ExpenseStatusHelper.GetColor(status);

    private string GetStatusText(string status) => ExpenseStatusHelper.GetLabel(status);

    private async Task ViewInvoice(int invoiceId)
    {
        var parameters = new DialogParameters
        {
            { "InvoiceId", invoiceId }
        };

        var dialog = await DialogService.ShowAsync<ExpenseInvoiceDialog>("Sąskaitos informacija", parameters);
        await dialog.Result;
    }

    private decimal _totalSpent => _historyItems.Sum(i => i.AmountInclVat);
    private int _invoiceCount => _historyItems?.Count ?? 0;
    private decimal _averageAmount => _invoiceCount > 0 ? _historyItems.Average(i => i.AmountInclVat) : 0m;
}
