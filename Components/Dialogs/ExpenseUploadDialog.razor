@using NordicBeesERP.Services
@using NordicBeesERP.Services.Dtos
@using NordicBeesERP.Helpers
@using NordicBeesERP.Models
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using NordicBeesERP.Data
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ILogger<ExpenseUploadDialog> Logger
@inject IImageToPdfService ImageToPdfService
@inject NordicBeesERP.Data.NordicBeesERPContext Context
@implements IAsyncDisposable

<MudDialog>
    <DialogContent>
        <div class="d-flex flex-column" style="min-width: 400px; max-width: 700px;">

            <!-- PHASE: UPLOAD -->
            @if (_phase == "upload") {
                <div class="text-center">
                    <MudText Typo="Typo.h6" Class="mb-3">Įkelti sąskaitą-faktūrą</MudText>
                    
                    @if (_file == null)
                    {
                        <div id="expense-drop-zone"
                             style="border:2px dashed #bdbdbd; border-radius:12px; cursor:pointer; min-height:160px; background:#fafafa; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px;">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" Style="font-size:56px; pointer-events:none;" />
                            <MudText Style="pointer-events:none;" Class="mt-2">Nutempkite PDF arba paveiksliuką čia</MudText>
                            <MudText Typo="Typo.caption" Style="pointer-events:none;" Class="mt-1">PDF, JPG, PNG, WEBP, TIFF</MudText>
                            <MudText Typo="Typo.caption" Style="pointer-events:none;" Class="mt-1 mb-3">arba</MudText>
                            <MudFileUpload T="IBrowserFile" Accept=".pdf,.jpg,.jpeg,.png,.webp,.tiff,.tif" MaximumFileCount="1" FilesChanged="OnFileChanged">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen">
                                        Pasirinkti failą
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                        </div>
                    }
                    else
                    {
                        <MudPaper Elevation="0" Class="d-flex align-center pa-4 mb-3"
                                  Style="background:#f0fdf4; border:2px solid #86efac; border-radius:12px;">
                            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Success" Style="font-size:36px;" />
                            <div class="ml-3 flex-grow-1" style="text-align:left;">
                                <MudText Typo="Typo.body1" Style="font-weight:600;">@_file.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@GetFileSizeString()</MudText>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error"
                                           Size="Size.Small" OnClick="RemoveFile" />
                        </MudPaper>
                    }
                    
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                               Disabled="@(_file == null)" 
                               OnClick="AnalyzeAsync"
                               FullWidth="@true">
                        Analizuoti
                    </MudButton>
                </div>
            }

            <!-- PHASE: ERROR -->
            @if (_phase == "error") {
                <div class="text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Error" Style="font-size:64px;color:#dc2626" Class="mb-3"/>
                    <MudText Typo="Typo.h6" Color="Color.Error" Class="mb-3">OCR nepavyko</MudText>
                    <MudAlert Severity="Severity.Error" Class="mb-4" Style="text-align:left">
                        @if (_errorMessage.Contains('\n'))
                        {
                            @foreach (var line in _errorMessage.Split('\n'))
                            {
                                <div>@line</div>
                            }
                        }
                        else
                        {
                            <div>@_errorMessage</div>
                        }
                    </MudAlert>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        Patikrinkite ar visi serveriai veikia ir bandykite dar kartą.
                    </MudText>
                </div>
            }

            <!-- PHASE: PROCESSING -->
            @if (_phase == "processing") {
            <div>
                <style>
                    .pulsing { animation: pulse 1.5s ease-in-out infinite; }
                    @@keyframes pulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:0.6; transform:scale(0.9); } }
                </style>

                <div class="text-center mb-3">
                    <MudText Typo="Typo.h6" Color="Color.Primary">Apdorojama...</MudText>
                </div>

                <div class="d-flex justify-space-between align-center mb-4 px-2">
                    @{
                        var steps = new[] {
                            (Icons.Material.Filled.UploadFile, "Įkeltas"),
                            (Icons.Material.Filled.TextFields, "Skaitoma"),
                            (Icons.Material.Filled.AutoAwesome, "AI analizė"),
                            (Icons.Material.Filled.CheckCircle, "Baigta"),
                        };
                    }
                    @for (int i = 0; i < steps.Length; i++)
                    {
                        var idx = i;
                        var (icon, label) = steps[idx];
                        var isDone = _processingStep > idx;
                        var isActive = _processingStep == idx;
                        var color = isDone ? "#16a34a" : isActive ? "#2563eb" : "#d1d5db";
                        var bgColor = isDone ? "#dcfce7" : isActive ? "#dbeafe" : "#f3f4f6";

                        <div class="d-flex flex-column align-center" style="flex:1; display:flex; flex-direction:column; align-items:center; min-width:55px;">
                            <div style="width:48px;height:48px;border-radius:50%;background:@bgColor;display:flex;align-items:center;justify-content:center;transition:all 0.3s;@(isActive ? "box-shadow:0 0 0 4px #bfdbfe" : "")">
                                @if (isDone)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#16a34a;font-size:28px" />
                                }
                                else if (isActive)
                                {
                                    <MudIcon Icon="@icon" Style="color:#2563eb;font-size:28px" Class="pulsing" />
                                }
                                else
                                {
                                    <MudIcon Icon="@icon" Style="color:#9ca3af;font-size:28px" />
                                }
                            </div>
                            <MudText Typo="Typo.caption" Class="mt-1" Style="@($"color:{color};font-weight:{(isDone || isActive ? "600" : "400")};white-space:nowrap;font-size:0.7rem;")">@label</MudText>
                        </div>

                        @if (idx < steps.Length - 1)
                        {
                            var lineColor = _processingStep > idx ? "#16a34a" : "#e5e7eb";
                            <div style="flex:1;height:2px;background:@lineColor;margin-top:24px;transition:background 0.3s" />
                        }
                    }
                </div>

                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center mb-3">@_statusText</MudText>
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Rounded="true" />
            </div>
            }

            <!-- PHASE 3: REVIEW -->
            @if (_phase == "review") {
            <div>
                <!-- Confidence chip: green>=70, yellow>=50, red<50 -->
                <div class="text-center mb-3">
                        <MudChip T="string" Color="GetConfidenceColor(_confidence)" Size="Size.Small" Variant="Variant.Outlined">
                        Patikimumas @_confidence%
                    </MudChip>
                </div>

                <!-- WRONG_RECIPIENT alert -->
                @if (_ocrFlags.Contains("WRONG_RECIPIENT"))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">
                        Sąskaita ne MB Lakštenai
                    </MudAlert>
                }

                <!-- Flags chips -->
                @if (_ocrFlags.Any() || string.IsNullOrEmpty(_invoiceNumber))
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var flag in _ocrFlags)
                        {
                            <MudChip T="string" Color="ExpenseStatusHelper.GetFlagColor(flag)" Size="Size.Small" Variant="Variant.Outlined">
                                @ExpenseStatusHelper.GetFlagLabel(flag)
                            </MudChip>
                        }
                        @if (string.IsNullOrEmpty(_invoiceNumber) && !_ocrFlags.Contains(OcrFlag.MissingInvNumber))
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">
                                @ExpenseStatusHelper.GetFlagLabel(OcrFlag.MissingInvNumber)
                            </MudChip>
                        }
                    </div>
                }

                <!-- VIES section: yellow paper if ViesVerified, blue if not verified -->
                @if (!string.IsNullOrEmpty(_ocrResult?.SupplierVatCode))
                {
                    <MudPaper Elevation="1" Class="pa-3 mb-3" 
                              Style="@(_ocrResult.ViesVerified ? "background-color:#fff9c4" : "background-color:#e3f2fd")">
                        <div class="d-flex align-center gap-2">
                            @if (_ocrFlags.Contains("OWN_COMPANY"))
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Primary" />
                                <MudText Typo="Typo.body2">Išrašė: <strong>@_pendingSupplierName</strong></MudText>
                            }
                            else if (_ocrResult.ViesVerified)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" />
                                <MudText Typo="Typo.body2">VIES patvirtinta: <strong>@_ocrResult.ViesName</strong></MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                                <MudText Typo="Typo.body2">VIES nepatvirtinta (@_ocrResult.SupplierVatCode)</MudText>
                            }
                        </div>
                    </MudPaper>
                }

                <!-- Tiekėjas section (blue paper): found/not found message -- hidden for OWN_COMPANY invoices -->
                @if (!_ocrFlags.Contains("OWN_COMPANY"))
                {
                    <MudPaper Elevation="1" Class="pa-3 mb-3" Style="background-color:#e3f2fd">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">Tiekėjas</MudText>
                        <MudText Typo="Typo.body1">
                            @if (_supplierId > 0)
                            {
                                <span class="text-success">Rastas: @_supplierName</span>
                            }
                            else
                            {
                                <span class="text-error">Nerastas: @_pendingSupplierName (@_pendingSupplierVat)</span>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Sukurkite tiekėją vėliau arba pasirinkite kitą
                                </MudText>
                            }
                        </MudText>
                    </MudPaper>
                }

                <!-- Sąskaitos duomenys (blue paper) -->
                <MudPaper Elevation="1" Class="pa-3 mb-3" Style="background-color:#e3f2fd">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">Sąskaitos duomenys</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6" Class="mb-3 w-100">
                            <MudSelect T="string" @bind-Value="_invoiceType" Label="Sąskaitos tipas" Dense="true" Variant="Variant.Filled">
                                <MudSelectItem T="string" Value="@("STANDARD")"><MudText Typo="Typo.body2">Standartinė</MudText></MudSelectItem>
                                <MudSelectItem T="string" Value="@("ULAK")"><MudText Typo="Typo.body2">ULAK (bičių pirkimas)</MudText></MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="mb-3 w-100">
                            <MudSelect T="int?" @bind-Value="_categoryId" Label="Kategorija" Dense="true" Variant="Variant.Filled">
                                <MudSelectItem T="int?" Value="@((int?)null)"><MudText Typo="Typo.body2">— Nepriskirta —</MudText></MudSelectItem>
                                @foreach (var cat in _categories)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="mb-3 w-100">
                            <MudTextField Label="Sąskaitos nr." @bind-Value="_invoiceNumber" Variant="Variant.Filled" />
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="mb-3 w-100">
                            <MudDatePicker Label="Sąskaitos data" @bind-Date="_invoiceDate" Variant="Variant.Filled" />
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="mb-3 w-100">
                            <MudDatePicker Label="Mokėjimo terminas" @bind-Date="_dueDate" Variant="Variant.Filled" />
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-3" />

                    <MudGrid>
                        <MudItem xs="12" sm="4" Class="mb-3 w-100">
                            <MudTextField Label="Suma be PVM" @bind-Value="_amountExclVat" Format="N2" Variant="Variant.Filled" />
                        </MudItem>
                        <MudItem xs="12" sm="4" Class="mb-3 w-100">
                            <MudTextField Label="PVM % " @bind-Value="_vatRate" Format="N2" Variant="Variant.Filled" />
                        </MudItem>
                        <MudItem xs="12" sm="4" Class="mb-3 w-100">
                            <MudTextField Label="PVM suma" @bind-Value="_vatAmount" Format="N2" Variant="Variant.Filled" />
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="mb-3 w-100">
                            <MudTextField Label="Suma su PVM" @bind-Value="_amountInclVat" Format="N2" Variant="Variant.Filled" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Eilutės (editable) -->
                <MudPaper Elevation="1" Class="pa-3 mb-3" Style="background-color:#e3f2fd">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">Eilutės</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddLine" Style="text-transform:none">
                            Pridėti eilutę
                        </MudButton>
                    </div>

                    @if (_ocrFlags.Contains("AMOUNT_MISMATCH"))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                            Eilučių suma @_ocrLines.Sum(l => l.AmountExclVat).ToString("N2") ≠ sąskaitos suma @_amountExclVat.ToString("N2")
                        </MudAlert>
                    }

                    @for (int i = 0; i < _ocrLines.Count; i++)
                    {
                        var idx = i;
                        var line = _ocrLines[idx];
                        <div class="d-flex gap-2 align-center mb-2">
                            <MudTextField @bind-Value="line.Description"
                                         Label="Aprašymas" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Style="flex:3" />
                            <MudTextField @bind-Value="_lineQuantities[idx]"
                                         Label="Kiekis" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Style="flex:1"
                                         @onblur="@(() => UpdateLineFromString(idx))" />
                            <MudTextField @bind-Value="_lineAmounts[idx]"
                                         Label="Be PVM" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Style="flex:1"
                                         @onblur="@(() => UpdateLineFromString(idx))" />
                            <MudTextField @bind-Value="_lineVatRates[idx]"
                                         Label="PVM%" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Style="flex:1"
                                         @onblur="@(() => UpdateLineFromString(idx))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => RemoveLine(idx))" />
                        </div>
                    }

                    <MudDivider Class="mt-2 mb-1" />
                    <MudText Typo="Typo.body2" Class="text-right">
                        Iš viso be PVM: <strong>@_ocrLines.Sum(l => l.AmountExclVat).ToString("N2") €</strong>
                    </MudText>
                </MudPaper>

                <!-- Error message in review phase -->
                @if (!string.IsNullOrEmpty(_errorMessage) && _phase == "review")
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
                }

                <!-- DialogActions: [Atšaukti Text/Default] [Išsaugoti Filled/Primary Save icon] -->
                <div class="d-flex gap-2 mt-4">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseDialog" FullWidth="@true">
                        Atšaukti
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" FullWidth="@true" StartIcon="@Icons.Material.Filled.Save">
                        Išsaugoti
                    </MudButton>
                </div>
            </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (_phase == "error")
        {
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseDialog">Uždaryti</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [Inject] IExpenseOcrService ExpenseOcrService { get; set; } = default!;
    [Inject] IExpenseService ExpenseService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? ExistingFilePath { get; set; }
    [Parameter] public int ExistingInvoiceId { get; set; }

    private DotNetObjectReference<ExpenseUploadDialog>? _dotNetRef;
    private string _phase = "upload";
    private IBrowserFile? _file;
    private int _processingStep = 0;
    private OcrResultDto? _ocrResult;
    private string _errorMessage = "";
    private string _invoiceType = "STANDARD";
    private int? _categoryId;
    private List<NordicBeesERP.Models.Expenses.ExpenseCategory> _categories = new();

    // OCR result fields (for HTML binding)
    private string _supplierName = "";
    private string _invoiceNumber = "";
    private DateTime? _invoiceDate = null;
    private DateTime? _dueDate = null;
    private decimal _amountExclVat = 0;
    private decimal _vatRate = 21;
    private decimal _vatAmount = 0;
    private decimal _amountInclVat = 0;
    private int _supplierId = 0;
    private int _confidence = 0;
    private string _supplierMatchType = "";
    private string _pendingSupplierName = "";
    private string _pendingSupplierVat = "";
    private string _statusText = "";
    private bool _isSaving = false;
    private List<string> _confidenceIssues = new();
    private List<string> _ocrFlags = new();
    private List<OcrLineDto> _ocrLines = new();
    private string _pdfBase64 = "";
    private string _convertedFileName = "";

    protected override async Task OnInitializedAsync()
    {
        _categories = await Context.ExpenseCategories
            .Where(c => c.IsActive)
            .OrderBy(c => c.SortOrder)
            .ToListAsync();

        if (!string.IsNullOrEmpty(ExistingFilePath) && ExistingInvoiceId > 0)
        {
            await AnalyzeFromPathAsync(ExistingFilePath);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            for (int i = 0; i < 5; i++)
            {
                await Task.Delay(200);
                try
                {
                    await JS.InvokeVoidAsync("setupDropZone", _dotNetRef, "expense-drop-zone");
                    break;
                }
                catch { }
            }
        }
    }

    private async Task OnFileChanged(IBrowserFile? file)
    {
        _file = file;
        _pdfBase64 = "";
        _convertedFileName = "";
        if (file != null)
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _pdfBase64 = Convert.ToBase64String(ms.ToArray());

            if (ImageToPdfService.IsImage(file.Name))
            {
                var imageBytes = Convert.FromBase64String(_pdfBase64);
                var pdfBytes = await ImageToPdfService.ConvertToPdfAsync(imageBytes, ImageToPdfService.GetMimeType(file.Name));
                _pdfBase64 = Convert.ToBase64String(pdfBytes);
                _convertedFileName = Path.GetFileNameWithoutExtension(file.Name) + ".pdf";
            }
            else
            {
                _convertedFileName = file.Name;
            }
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeAsync(true);
        GC.SuppressFinalize(this);
    }

    private async ValueTask DisposeAsync(bool disposing)
    {
        if (disposing)
        {
            _dotNetRef?.Dispose();
        }
    }
    
    private void RemoveFile()
    {
        _file = null;
        _pdfBase64 = "";
        _convertedFileName = "";
        _supplierName = "";
        _invoiceNumber = "";
        _invoiceDate = null;
        _dueDate = null;
        _amountExclVat = 0;
        _vatRate = 21;
        _vatAmount = 0;
        _amountInclVat = 0;
        _confidence = 0;
        _supplierId = 0;
        StateHasChanged();
    }

    private string GetFileSizeString()
    {
        if (_file == null) return "";
        var size = _file.Size;
        if (size < 1024 * 1024)
            return $"{size / 1024:0.00} KB";
        return $"{size / (1024 * 1024):0.00} MB";
    }

    private async Task AnalyzeFromPathAsync(string filePath)
    {
        try
        {
            _phase = "processing";
            _processingStep = 0;
            _statusText = "Failas nuskaitomas...";
            _errorMessage = "";
            StateHasChanged();
            await Task.Delay(300);

            // Step 1: Skaitoma - read file from wwwroot as base64
            _processingStep = 1;
            _statusText = "Failas nuskaitomas...";
            StateHasChanged();

            var full_path = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", filePath);
            byte[] fileBytes = await File.ReadAllBytesAsync(full_path);
            string base64 = Convert.ToBase64String(fileBytes);
            _pdfBase64 = base64;

            // Step 2: AI analizė
            _processingStep = 2;
            _statusText = "AI analizuoja...";
            StateHasChanged();

            var result = await ExpenseOcrService.ProcessAsync(base64, Path.GetFileName(filePath));

            // Step 3: Baigta
            _processingStep = 3;
            _statusText = "Baigta";
            StateHasChanged();
            await Task.Delay(400);

            var errors = new List<string>();
            if (!string.IsNullOrEmpty(result.Diagnostics.AzureError))
                errors.Add($"Azure DI: {result.Diagnostics.AzureError}");

            var isOcrFailed = string.IsNullOrEmpty(result.InvoiceNumber) &&
                              result.AmountInclVat == 0 &&
                              string.IsNullOrEmpty(result.SupplierName);

            if (isOcrFailed && errors.Count > 0)
            {
                _phase = "error";
                _errorMessage = "OCR nepavyko. Serverių būsena:\n" + string.Join("\n", errors);
                StateHasChanged();
                return;
            }

            if (errors.Count > 0)
            {
                _errorMessage = "⚠️ Įspėjimai: " + string.Join("; ", errors);
            }

            await ProcessOcrResultAsync(result);
        }
        catch (ObjectDisposedException ex)
        {
            Logger?.LogError(ex, "ObjectDisposedException in AnalyzeFromPathAsync");
            _statusText = "Klaida";
            _errorMessage = $"Failas nebegalioja: {ex.Message}. Bandykite įkelti failą iš naujo.";
            _phase = "error";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Error in AnalyzeFromPathAsync");
            _statusText = "Klaida";
            _errorMessage = $"Nepavyko nuskaityti dokumento: {ex.Message}";
            _phase = "error";
            StateHasChanged();
        }
    }

    private async Task ProcessOcrResultAsync(OcrResultDto result)
    {
        try
        {
            if (result != null)
            {
                _categoryId = result.CategoryId;
                _supplierName = result.SupplierName ?? "";
                _invoiceNumber = result.InvoiceNumber ?? "";
                
                if (DateTime.TryParse(result.InvoiceDate, out var invDate))
                    _invoiceDate = invDate;
                if (DateTime.TryParse(result.DueDate, out var dueDate))
                    _dueDate = dueDate;

                Logger.LogDebug("[DATE PARSE] InvoiceDate={InvoiceDate} parsed={Parsed} _invoiceDate={InvDate}", result.InvoiceDate, DateTime.TryParse(result.InvoiceDate, out _), _invoiceDate);
                
                _amountExclVat = result.AmountExclVat;
                _vatRate = result.VatRate;
                _vatAmount = result.VatAmount;
                _amountInclVat = result.AmountInclVat;
                
                var azureOverall = result.Confidence.Overall;
                int confidence = azureOverall > 0 ? azureOverall : 100;
                var confidenceIssues = new List<string>();

                if (result.Confidence.InvoiceNumber > 0 && result.Confidence.InvoiceNumber < 70)
                    confidenceIssues.Add($"Sąskaitos numeris: žemas tikslumas ({result.Confidence.InvoiceNumber}%)");
                if (result.Confidence.SupplierName > 0 && result.Confidence.SupplierName < 70)
                    confidenceIssues.Add($"Tiekėjo pavadinimas: žemas tikslumas ({result.Confidence.SupplierName}%)");
                if (result.Confidence.Amounts > 0 && result.Confidence.Amounts < 70)
                    confidenceIssues.Add($"Sumos: žemas tikslumas ({result.Confidence.Amounts}%)");

                var (foundSupplierId, foundDefaultCategoryId) = await ExpenseOcrService.FindSupplierIdAsync(
                    result.SupplierName ?? "",
                    result.SupplierVatCode ?? "");

                if (foundSupplierId.HasValue)
                {
                    _supplierId = foundSupplierId.Value;
                    _supplierMatchType = "vat";
                    _pendingSupplierName = "";
                    _pendingSupplierVat = "";
                }
                else
                {
                    _supplierId = 0;
                    _supplierMatchType = "unknown";
                    _pendingSupplierName = result.SupplierName ?? "";
                    _pendingSupplierVat = result.SupplierVatCode ?? "";
                }

                var ocrFlags = new List<string>();
                if (_supplierId == 0)
                    ocrFlags.Add(OcrFlag.VendorNotFound);
                if (string.IsNullOrEmpty(result.InvoiceNumber))
                    ocrFlags.Add(OcrFlag.MissingInvNumber);
                if (string.IsNullOrEmpty(result.DueDate))
                    ocrFlags.Add(OcrFlag.MissingDueDate);
                if (result.AmountInclVat == 0)
                    ocrFlags.Add(OcrFlag.MissingAmount);

                var duplicateId = await ExpenseService.CheckDuplicateAsync(
                    _supplierId > 0 ? _supplierId : null,
                    _pendingSupplierVat,
                    _invoiceNumber,
                    _amountInclVat,
                    ExistingInvoiceId);

                if (duplicateId.HasValue)
                    ocrFlags.Add(OcrFlag.Duplicate);
                if (result.VatRate == 0 && result.AmountInclVat > 0)
                    ocrFlags.Add(OcrFlag.ZeroVat);
                if (result.Lines.Count == 0)
                    ocrFlags.Add(OcrFlag.LinesNotFound);
                if (result.Lines.Count > 0 && result.AmountExclVat > 0)
                {
                    var linesSum = result.Lines.Sum(l => l.AmountExclVat);
                    if (Math.Abs(linesSum - result.AmountExclVat) > 0.01m)
                        ocrFlags.Add(OcrFlag.AmountMismatch);
                }
                if (result.Confidence.Overall > 0 && result.Confidence.Overall < 50)
                    ocrFlags.Add(OcrFlag.LowConfidence);

                // Add any flags from OCR service that we didn't generate locally (e.g. WRONG_RECIPIENT)
                foreach (var flag in result.Flags)
                {
                    if (!ocrFlags.Contains(flag))
                        ocrFlags.Add(flag);
                }
                _ocrFlags = ocrFlags;

                // Ensure _pendingSupplierName is set regardless of OCR flags
                // For OWN_COMPANY: result.PendingSupplierName is set by OCR service
                // For VENDOR_NOT_FOUND: fall back to result.SupplierName
                if (!string.IsNullOrEmpty(result.PendingSupplierName))
                    _pendingSupplierName = result.PendingSupplierName;
                else if (_supplierId == 0 && !string.IsNullOrEmpty(result.SupplierName))
                    _pendingSupplierName = result.SupplierName;
                Logger.LogDebug("[UPLOAD] pendingSupplierName={Name} flags={Flags}", _pendingSupplierName, string.Join(",", _ocrFlags));

                if (_supplierId == 0)
                {
                    confidence -= 15;
                    confidenceIssues.Add("Tiekėjas nerastas sistemoje");
                }
                if (result.VatRate == 0)
                {
                    confidence -= 15;
                    confidenceIssues.Add("PVM tarifas = 0% (patikrinkite)");
                }
                if (result.AmountExclVat == 0)
                {
                    confidence -= 15;
                    confidenceIssues.Add("Suma be PVM = 0");
                }
                if (string.IsNullOrEmpty(result.InvoiceNumber))
                {
                    confidence -= 10;
                    confidenceIssues.Add("Sąskaitos numeris nerastas");
                }
                if (string.IsNullOrEmpty(result.DueDate))
                {
                    confidence -= 10;
                    confidenceIssues.Add("Mokėjimo terminas nerastas");
                }
                if (result.Lines.Count == 0)
                {
                    confidence -= 10;
                    confidenceIssues.Add("Eilutės nerastos");
                }
                if (result.Lines.Count > 0 && result.AmountExclVat > 0)
                {
                    var linesSum = result.Lines.Sum(l => l.AmountExclVat);
                    if (Math.Abs(linesSum - result.AmountExclVat) > 0.01m)
                    {
                        confidence -= 5;
                        confidenceIssues.Add($"Eilučių suma ({linesSum:F2}) ≠ antraštės sumai ({result.AmountExclVat:F2})");
                    }
                }

                _confidence = Math.Max(0, confidence);
                _confidenceIssues = confidenceIssues;
            }

            _ocrResult = result;
            _ocrLines = result?.Lines ?? new List<OcrLineDto>();

            SyncLineStrings();
            
            _phase = "review";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _statusText = "Klaida";
            _errorMessage = $"Nepavyko apdoroti OCR rezultato: {ex.Message}";
            _phase = "review";
            StateHasChanged();
        }
    }

    private async Task AnalyzeAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(_pdfBase64)) { Snackbar.Add("Failas nepasirinktas arba nepavyko nuskaityti", Severity.Warning); return; }
            string base64 = _pdfBase64;

            // Step 1: Switch to processing phase (base64 already read in OnFileChanged)
            _phase = "processing";
            _processingStep = 0;
            _statusText = "Failas nuskaitomas...";
            StateHasChanged();
            await Task.Delay(300);

            // Step 2: Skaitoma - file already read, just update UI
            _processingStep = 1;
            _statusText = "Failas nuskaitomas...";
            StateHasChanged();

            // Step 3: AI analizė
            _processingStep = 2;
            _statusText = "AI analizuoja...";
            StateHasChanged();

            var result = await ExpenseOcrService.ProcessAsync(base64, _file.Name);

            // Step 4: Baigta
            _processingStep = 3;
            _statusText = "Baigta";
            StateHasChanged();
            await Task.Delay(400);

            var errors = new List<string>();
            if (!string.IsNullOrEmpty(result.Diagnostics.AzureError))
                errors.Add($"Azure DI: {result.Diagnostics.AzureError}");

            var isOcrFailed = string.IsNullOrEmpty(result.InvoiceNumber) &&
                              result.AmountInclVat == 0 &&
                              string.IsNullOrEmpty(result.SupplierName);

            if (isOcrFailed && errors.Count > 0)
            {
                _phase = "error";
                _errorMessage = "OCR nepavyko. Serverių būsena:\n" + string.Join("\n", errors);
                StateHasChanged();
                return;
            }

            if (errors.Count > 0)
            {
                _errorMessage = "⚠️ Įspėjimai: " + string.Join("; ", errors);
            }

            await ProcessOcrResultAsync(result);
        }
        catch (ObjectDisposedException ex)
        {
            Logger?.LogError(ex, "ObjectDisposedException in AnalyzeAsync");
            _statusText = "Klaida";
            _errorMessage = $"Failas nebegalioja: {ex.Message}. Bandykite įkelti failą iš naujo.";
            _phase = "error";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Error in AnalyzeAsync");
            _statusText = "Klaida";
            _errorMessage = $"Nepavyko nuskaityti dokumento: {ex.Message}";
            _phase = "error";
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            // Validate invoice number is not empty
            if (string.IsNullOrWhiteSpace(_invoiceNumber))
            {
                _errorMessage = "Sąskaitos numeris negali būti tuščias. Įveskite numerį rankiniu būdu.";
                if (!_ocrFlags.Contains(OcrFlag.MissingInvNumber))
                    _ocrFlags.Add(OcrFlag.MissingInvNumber);
                StateHasChanged();
                return;
            }

            if (_ocrResult == null)
            {
                Snackbar.Add("OCR rezultatai nepasiekiami", Severity.Error);
                return;
            }

            if (ExistingInvoiceId > 0)
            {
                // Update existing invoice - use ExistingFilePath only if not null or empty
                _ocrResult.OriginalFilePath = !string.IsNullOrEmpty(ExistingFilePath)
                    ? ExistingFilePath
                    : (_ocrResult.OriginalFilePath ?? "");
                _ocrResult.OriginalFilename = _ocrResult.OriginalFilename ?? "";
                await ExpenseService.UpdateFromOcrAsync(ExistingInvoiceId, _ocrResult);
                Snackbar.Add("Sąskaita atnaujinta sėkmingai", Severity.Success);
                MudDialog?.Close(DialogResult.Ok(ExistingInvoiceId));
            }
            else
            {
                // Create new invoice
            // Sync UI fields back to ocrResult before saving
                _ocrResult.InvoiceNumber = _invoiceNumber;
                _ocrResult.AmountExclVat = _amountExclVat;
                _ocrResult.VatRate = _vatRate;
                _ocrResult.VatAmount = _vatAmount;
                _ocrResult.AmountInclVat = _amountInclVat;
                _ocrResult.InvoiceDate = _invoiceDate?.ToString("yyyy-MM-dd") ?? "";
                _ocrResult.DueDate = _dueDate?.ToString("yyyy-MM-dd") ?? "";
                _ocrResult.SupplierId = _supplierId > 0 ? _supplierId : null;
                _ocrResult.PendingSupplierName = _pendingSupplierName;
                _ocrResult.SupplierVatCode = _pendingSupplierVat;
                _ocrResult.CategoryId = _categoryId;
                _ocrResult.Flags = _ocrFlags;

                var pdfBytes = Convert.FromBase64String(_pdfBase64);
                var uploadsDir = Path.Combine("wwwroot", "uploads", "invoices",
                    DateTime.Now.Year.ToString(), DateTime.Now.Month.ToString("00"));
                Directory.CreateDirectory(uploadsDir);
                var safeFileName = $"{DateTime.Now:yyyyMMdd_HHmmss}_{Path.GetFileNameWithoutExtension(_convertedFileName)}.pdf";
                var filePath = Path.Combine(uploadsDir, safeFileName);
                await File.WriteAllBytesAsync(filePath, pdfBytes);
                
                _ocrResult.OriginalFilePath = $"uploads/invoices/{DateTime.Now.Year}/{DateTime.Now.Month:00}/{safeFileName}";
                _ocrResult.OriginalFilename = safeFileName;

                Logger.LogDebug("[SAVE] CategoryId={Cat} SupplierId={Sup} InvoiceNumber={Inv}", _ocrResult.CategoryId, _ocrResult.SupplierId, _ocrResult.InvoiceNumber);
                
                var invoice = await ExpenseService.CreateFromOcrAsync(_ocrResult, "MANUAL");

                Snackbar.Add("Sąskaita išsaugota sėkmingai", Severity.Success);
                MudDialog?.Close(DialogResult.Ok(invoice.Id));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klaida išsaugant: " + ex.Message, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

