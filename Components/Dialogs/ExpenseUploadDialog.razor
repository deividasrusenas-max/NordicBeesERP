    private string NormalizeName(string name) =>
        name.ToLowerInvariant()
            .Replace("uab", "").Replace("mb", "").Replace("ab", "")
            .Replace("„", "").Replace("\"", "").Replace("\"", "")
            .Trim();

    private Color GetConfidenceColor(int confidence) => confidence switch
    {
        >= 70 => Color.Success,
        >= 50 => Color.Warning,
        _ => Color.Error
    };


    private List<string> _lineQuantities = new();
    private List<string> _lineAmounts = new();
    private List<string> _lineVatRates = new();

    private void SyncLineStrings()
    {
        _lineQuantities = _ocrLines.Select(l => l.Quantity?.ToString("N2") ?? "1").ToList();
        _lineAmounts = _ocrLines.Select(l => l.AmountExclVat.ToString("N2")).ToList();
        _lineVatRates = _ocrLines.Select(l => l.VatRate.ToString("N0")).ToList();
    }

    private void UpdateLineFromString(int idx)
    {
        if (idx >= _ocrLines.Count) return;
        if (decimal.TryParse(_lineQuantities[idx].Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var qty))
            _ocrLines[idx].Quantity = qty;
        if (decimal.TryParse(_lineAmounts[idx].Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var amt))
            _ocrLines[idx].AmountExclVat = amt;
        if (decimal.TryParse(_lineVatRates[idx].Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var vat))
            _ocrLines[idx].VatRate = vat;
        _ocrLines[idx].AmountInclVat = _ocrLines[idx].AmountExclVat * (1 + _ocrLines[idx].VatRate / 100);
        StateHasChanged();
    }

    private void AddLine()
    {
        _ocrLines.Add(new OcrLineDto { Description = "", Quantity = 1, AmountExclVat = 0, VatRate = 21, AmountInclVat = 0 });
        _lineQuantities.Add("1");
        _lineAmounts.Add("0,00");
        _lineVatRates.Add("21");
        StateHasChanged();
    }

    private void RemoveLine(int idx)
    {
        if (idx < _ocrLines.Count) _ocrLines.RemoveAt(idx);
        if (idx < _lineQuantities.Count) _lineQuantities.RemoveAt(idx);
        if (idx < _lineAmounts.Count) _lineAmounts.RemoveAt(idx);
        if (idx < _lineVatRates.Count) _lineVatRates.RemoveAt(idx);
        StateHasChanged();
    }

