@namespace NordicBeesERP.Components.Dialogs
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Sąskaitų išrašymo data</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@ContentText</MudText>
        <MudDatePicker @bind-Date="_date" Label="Išrašymo data" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Style="text-transform:none" OnClick="@(() => MudDialog.Cancel())">Atšaukti</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none"
                   Disabled="@(_date == null)" OnClick="@(() => MudDialog.Close(DialogResult.Ok(_date!.Value.Date)))">Išrašyti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string ContentText { get; set; } = "";

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private DateTime? _date = AppClock.TodayLt;
}
