    private async Task OpenDuplicateDialog()
    {
        if (_invoice == null) return;

        // Get DuplicateOfId from invoice or find original
        int originalId = _invoice.DuplicateOfId ?? _duplicateOfId ?? 0;
        if (originalId == 0)
        {
            await using var ctx = DbFactory.CreateDbContext();

            if (_invoice.SupplierId.HasValue && _invoice.SupplierId.Value > 0)
            {
                // Match by invoice_number + supplier_id
                originalId = await ctx.ExpenseInvoices
                    .Where(i => i.InvoiceNumber == _invoice.InvoiceNumber
                             && i.SupplierId == _invoice.SupplierId
                             && i.Id != _invoice.Id
                             && i.Status != "DUPLICATE_PENDING"
                             && i.Status != "CANCELLED")
                    .OrderBy(i => i.Id)
                    .Select(i => i.Id)
                    .FirstOrDefaultAsync();
            }
            else
            {
                // Match by invoice_number only (supplier_id is null)
                originalId = await ctx.ExpenseInvoices
                    .Where(i => i.InvoiceNumber == _invoice.InvoiceNumber
                             && i.Id != _invoice.Id
                             && i.Status != "DUPLICATE_PENDING"
                             && i.Status != "CANCELLED")
                    .OrderBy(i => i.Id)
                    .Select(i => i.Id)
                    .FirstOrDefaultAsync();
            }

            Logger.LogInformation("[DUPLICATE] Looking for original of {Number} supplier={SupplierId}, found={FoundId}",
                _invoice.InvoiceNumber,
                _invoice.SupplierId ?? 0,
                originalId);

            if (originalId == 0)
            {
                Snackbar.Add("Nerastas dublikato originalas", Severity.Warning);
                return;
            }
            _duplicateOfId = originalId;
        }

        var parameters = new DialogParameters
        {
            { nameof(DuplicateInvoiceDialog.ThisInvoiceId), _invoice.Id },
            { nameof(DuplicateInvoiceDialog.OriginalInvoiceId), originalId }
        };
        var dialog = await DialogService.ShowAsync<DuplicateInvoiceDialog>(
            "Spręsti dublikatą",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        // Handle different result types from DuplicateInvoiceDialog
        if (result.Data is string strResult)
        {
            if (strResult == "deleted")
            {
                // Dublikatas pašalintas - uždaryti šią sąskaitos detalę
                MudDialog.Close();
            }
            else if (strResult == "different")
            {
                // Tai ne dublikatas - perkrauti sąskaitą
                _loadedInvoiceId = 0;
                await OnParametersSetAsync();
                StateHasChanged();
            }
        }
        else if (result.Data is int invoiceId && invoiceId > 0)
        {
            // Nurodyta kita sąskaita - atidaryti ją
            OpenInvoiceDialog(invoiceId);
        }
    }

    private void OpenInvoiceDialog(int invoiceId)
    {
        InvoiceId = invoiceId;
        _loadedInvoiceId = 0;
        _ = InvokeAsync(async () =>
        {
            await OnParametersSetAsync();
            StateHasChanged();
        });
    }

    private async Task RerunOcrAsync()
    {
        if (_invoice == null || string.IsNullOrEmpty(_invoice.OriginalFilePath)) return;
        try
        {
            var parameters = new DialogParameters
            {
                { nameof(ExpenseUploadDialog.ExistingFilePath), _invoice.OriginalFilePath },
                { nameof(ExpenseUploadDialog.ExistingInvoiceId), _invoice.Id }
            };
            var dialog = await DialogService.ShowAsync<ExpenseUploadDialog>(
                "Pakartotinis OCR nuskaitymas",
                parameters);
            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                _loadedInvoiceId = 0;
                await OnParametersSetAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klaida: " + ex.Message, Severity.Error);
        }
    }

    private void EnterEditMode()
    {
        _editMode = true;
        InitializeEditFields();
    }

    private void InitializeEditFields()
    {
        if (_invoice == null) return;
        _editInvoiceDate = _invoice.InvoiceDate == default ? (DateTime?)null : _invoice.InvoiceDate.Date;
        _editDueDate = _invoice.DueDate == default ? (DateTime?)null : _invoice.DueDate.Date;
        _editVatRateLocal = (int)_invoice.VatRate;
        _invoice.VatRate = _editVatRateLocal;
        _editCategoryId = _invoice.CategoryId;
        SyncLineStrings();
    }

    private void SyncLineStrings()
    {
        _lineDescriptions = _lines.Select(l => l.Description ?? "").ToList();
        _lineQuantities = _lines.Select(l => l.Quantity?.ToString("G29") ?? "1").ToList();
        _lineAmounts = _lines.Select(l => l.AmountExclVat.ToString("N2")).ToList();
        _lineVatRates = _lines.Select(l => ((int)l.VatRate).ToString()).ToList();
    }

    private void UpdateLineFromString(int idx)
    {
        if (idx >= _lines.Count) return;
        _lines[idx].Description = _lineDescriptions[idx];
        if (decimal.TryParse(_lineQuantities[idx].Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var qty))
            _lines[idx].Quantity = qty;
        if (decimal.TryParse(_lineAmounts[idx].Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var amt))
            _lines[idx].AmountExclVat = amt;
        if (decimal.TryParse(_lineVatRates[idx].Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var vat))
            _lines[idx].VatRate = vat;
        _lines[idx].AmountInclVat = _lines[idx].AmountExclVat * (1 + _lines[idx].VatRate / 100);
        StateHasChanged();
    }

    private void AddEditLine()
    {
        _lines.Add(new ExpenseInvoiceLine { InvoiceId = InvoiceId, Description = "", Quantity = 1, AmountExclVat = 0, VatRate = 21, AmountInclVat = 0 });
        _lineDescriptions.Add("");
        _lineQuantities.Add("1");
        _lineAmounts.Add("0,00");
        _lineVatRates.Add("21");
        StateHasChanged();
    }

    private void RemoveEditLine(int idx)
    {
        if (idx < _lines.Count) _lines.RemoveAt(idx);
        if (idx < _lineDescriptions.Count) _lineDescriptions.RemoveAt(idx);
        if (idx < _lineQuantities.Count) _lineQuantities.RemoveAt(idx);
        if (idx < _lineAmounts.Count) _lineAmounts.RemoveAt(idx);
        if (idx < _lineVatRates.Count) _lineVatRates.RemoveAt(idx);
        StateHasChanged();
    }


    private void RestoreEditModeFields()
    {
        if (_invoice != null)
        {
            _editInvoiceNumber = _invoice.InvoiceNumber;
            _editInvoiceDate = _invoice.InvoiceDate;
            _editDueDate = _invoice.DueDate;
            _editVatRate = _invoice.VatRate;
            _editVatAmount = _invoice.VatAmount;
            _editAmountInclVat = _invoice.AmountInclVat;
            _editNotes = _invoice.Notes ?? "";
            _editSelectedSupplier = _invoice.Supplier != null ? new BusinessPartner { Id = _invoice.Supplier.Id, Name = _invoice.Supplier.Name, VatCode = _invoice.Supplier.VatCode } : null;
        }
    }
