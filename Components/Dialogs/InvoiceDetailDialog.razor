    // VAT calculation direction: true = calculate from AmountExclVat, false = calculate from AmountInclVat
    private bool _calculateFromExclVat = true;

    private void SetCalculationDirection(bool fromExclVat)
    {
        _calculateFromExclVat = fromExclVat;
        StateHasChanged();
    }

    private void OnAmountExclVatChanged(decimal newValue)
    {
        if (_invoice == null) return;
        _invoice.AmountExclVat = newValue;
        RecalculateFromExclVat();
    }

    private void OnVatRateChanged(decimal newValue)
    {
        if (_invoice == null) return;
        _invoice.VatRate = (int)newValue;
        if (_calculateFromExclVat)
            RecalculateFromExclVat();
        else
            RecalculateFromInclVat();
    }

    private void OnAmountInclVatChanged(decimal newValue)
    {
        if (_invoice == null) return;
        _invoice.AmountInclVat = newValue;
        RecalculateFromInclVat();
    }

    private void RecalculateFromExclVat()
    {
        if (_invoice == null) return;
        var exclVat = _invoice.AmountExclVat;
        var vatRate = _invoice.VatRate;
        _invoice.VatAmount = Math.Round(exclVat * vatRate / 100m, 2);
        _invoice.AmountInclVat = Math.Round(exclVat + _invoice.VatAmount, 2);
    }

    private void RecalculateFromInclVat()
    {
        if (_invoice == null) return;
        var inclVat = _invoice.AmountInclVat;
        var vatRate = _invoice.VatRate;
        if (vatRate > 0)
        {
            _invoice.AmountExclVat = Math.Round(inclVat / (1 + vatRate / 100m), 2);
        }
        else
        {
            _invoice.AmountExclVat = inclVat;
        }
        _invoice.VatAmount = Math.Round(inclVat - _invoice.AmountExclVat, 2);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Load categories ALWAYS — needed for edit mode, category selector, and display
        await using var categoriesCtx = DbFactory.CreateDbContext();
        _categories = await categoriesCtx.Set<NordicBeesERP.Models.Expenses.ExpenseCategory>()
            .Where(c => c.IsActive)
            .OrderBy(c => c.SortOrder)
            .ToListAsync();

        if (_loadedInvoiceId == InvoiceId) return;
        _loadedInvoiceId = InvoiceId;
        _isLoading = true;
        _companyName = (await CompanySettingsService.GetSettingsAsync()).CompanyName;

        _invoice = await ExpenseService.GetInvoiceWithDetailsAsync(InvoiceId);
        if (_invoice == null)
        {
            _isLoading = false;
            return;
        }
        var existingFlags = ExpenseStatusHelper.ParseFlags(_invoice?.OcrFlags);
        _wrongRecipientDismissed = !existingFlags.Contains(OcrFlag.WrongRecipient);
        _lines = await ExpenseService.GetInvoiceLinesAsync(InvoiceId);
        if (_invoice?.Status == "PENDING_SUPPLIER")
        {
            await using var dbContext = DbFactory.CreateDbContext();
            _suppliers = await dbContext.BusinessPartners
                .AsNoTracking()
                .Where(b => b.IsActive)
                .OrderBy(b => b.Name).ToListAsync();
        }

        if (_invoice?.SupplierId.HasValue == true && _invoice.SupplierId.Value > 0)
        {
            _supplierFound = true;
            await using var dbContext2 = DbFactory.CreateDbContext();
            var supplier = await dbContext2.BusinessPartners
                .AsNoTracking()
                .Where(b => b.Id == _invoice.SupplierId.Value)
                .Select(b => new { b.Name, b.VatCode })
                .FirstOrDefaultAsync();
            if (supplier != null)
            {
                _supplierName = supplier.Name;
                _supplierVat = supplier.VatCode;
            }
            else
            {
                _supplierName = $"ID: {_invoice.SupplierId.Value}";
            }
        }
        else if (!string.IsNullOrEmpty(_invoice?.PendingSupplierName))
        {
            _supplierFound = false;
            _supplierName = _invoice.PendingSupplierName;
        }

        // Load payment history
        _payments = await ExpenseService.GetPaymentsAsync(InvoiceId);

        _isLoading = false;
    }

    private async Task DismissWrongRecipientAsync()
    {
        if (_invoice == null) return;
        try
        {
            var flags = ExpenseStatusHelper.ParseFlags(_invoice.OcrFlags);
            flags.Remove(OcrFlag.WrongRecipient);
            _invoice.OcrFlags = flags.Any()
                ? System.Text.Json.JsonSerializer.Serialize(flags)
                : null;
            if (_invoice.Status == "REJECTED" && _invoice.RejectedReason?.StartsWith("Sąskaita ne ") == true)
            {
                _invoice.Status = "NEEDS_REVIEW";
                _invoice.RejectedReason = null;
            }
            await ExpenseService.UpdateInvoiceAsync(_invoice, flags);
            Snackbar.Add("Gavėjas patvirtintas", Severity.Success);
            _loadedInvoiceId = 0;
            await OnParametersSetAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            // Copy edit date fields back to invoice
            if (_editInvoiceDate.HasValue) _invoice!.InvoiceDate = _editInvoiceDate.Value;
            if (_editDueDate.HasValue) _invoice!.DueDate = _editDueDate.Value;
            _invoice!.CategoryId = _editCategoryId;

            await ExpenseService.UpdateInvoiceAsync(_invoice!);

            // Save lines
            foreach (var line in _lines)
            {
                if (line.Id > 0)
                    await ExpenseService.UpdateInvoiceLineAsync(line);
                else
                    await ExpenseService.AddInvoiceLineAsync(line);
            }
            await ExpenseService.RecalculateInvoiceTotalsAsync(InvoiceId);

            Snackbar.Add("Sąskaita atnaujinta sėkmingai", Severity.Success);
            _editMode = false;
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klaida: " + ex.Message, Severity.Error);
        }
    }

