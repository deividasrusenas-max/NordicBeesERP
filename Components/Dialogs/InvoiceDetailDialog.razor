    private async Task SearchSupplierAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredSuppliers = _suppliers.ToList();
        }
        else
        {
            var term = _searchTerm.ToLower();
            _filteredSuppliers = _suppliers.Where(s =>
                s.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (s.VatCode != null && s.VatCode.Contains(term, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
        StateHasChanged();
    }

