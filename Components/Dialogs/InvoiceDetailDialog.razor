@using NordicBeesERP.Data
@using NordicBeesERP.Models
@using NordicBeesERP.Models.Expenses
@using ExpenseCategory = NordicBeesERP.Models.Expenses.ExpenseCategory
@using NordicBeesERP.Helpers
@using NordicBeesERP.Services.Dtos
@using MudBlazor
@using NordicBeesERP.Components.Dialogs
@using Microsoft.Extensions.Logging

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" />
        </div>
    </TitleContent>

    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center align-center pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else
        {
            @if (!_isLoading && _invoice != null)
            {
                <div class="mb-3">
                    <MudText Typo="Typo.h6" Style="font-weight:600">@_invoice.InvoiceNumber &nbsp;·&nbsp; @_supplierName</MudText>
                </div>
            }
            <MudTabs Class="mt-2" DefaultPanelIndex="0" FollowOnScroll="false" KeepPanelsAlive="true" @bind-ActivePanelIndex="_activeTab">
                <MudTabPanel Text="Sąskaita">
                            <MudGrid Spacing="3">
                                <!-- RIGHT COLUMN: Sections -->
                                <MudItem md="12">
                                    <div>
                                    <!-- Status Section -->
                                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Būsena</MudText>
                                    <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background:#e3f2fd; border-radius:8px">
                                        <MudChip T="string" Color="@ExpenseStatusHelper.GetColor(_invoice?.Status)" Size="Size.Small">
                                            @ExpenseStatusHelper.GetLabel(_invoice?.Status)
                                        </MudChip>
                                        @foreach (var flag in ExpenseStatusHelper.ParseFlags(_invoice?.OcrFlags))
                                        {
                                            @if (!(flag == "VENDOR_NOT_FOUND" && _invoice?.Status == "PENDING_SUPPLIER"))
                                            {
                                                <MudChip T="string" Color="@ExpenseStatusHelper.GetFlagColor(flag)" Size="Size.Small" Variant="Variant.Outlined" Class="ml-2">
                                                    @ExpenseStatusHelper.GetFlagLabel(flag)
                                                </MudChip>
                                            }
                                        }
                                        @if (_invoice?.Status == "REJECTED" && !string.IsNullOrEmpty(_invoice.RejectedReason))
                                        {
                                            <MudDivider Class="my-2" />
                                            <div class="d-flex align-center gap-1 mt-2">
                                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                                                <MudText Typo="Typo.body2" Color="Color.Error">@_invoice.RejectedReason</MudText>
                                            </div>
                                        }
                                    </MudPaper>

                                    @if (ExpenseStatusHelper.ParseFlags(_invoice?.OcrFlags).Contains("WRONG_RECIPIENT"))
                                    {
                                        <MudPaper Elevation="0" Class="mb-3 pa-3 d-flex align-center justify-space-between"
                                                  Style="background:#fff3e0; border-left:4px solid #f59e0b; border-radius:6px;">
                                            <div class="d-flex align-center gap-2">
                                                <MudIcon Icon="@Icons.Material.Filled.Warning" Style="color:#f59e0b;" />
                                                <MudText Typo="Typo.body2">Sistema mano kad sąskaita ne @_companyName</MudText>
                                            </div>
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                                       OnClick="@DismissWrongRecipientAsync"
                                                       Style="text-transform:none;white-space:nowrap;margin-left:12px;">
                                                ✓ Lakštenai
                                            </MudButton>
                                        </MudPaper>
                                    }

                                    <!-- Invoice Information Section -->
                                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-1">Sąskaitos informacija</MudText>
                                    <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2">
                                        @if (!_editMode)
                                        {
                                            <MudGrid Spacing="2">
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Numeris</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-weight:600">@_invoice.InvoiceNumber</MudText>
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Tipas</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-weight:600">@_invoice.InvoiceType</MudText>
                                                </MudItem>
                                                <MudItem xs="12">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Tiekėjas</MudText>
                                                    @if (_invoice?.Status == "PENDING_SUPPLIER" && !_supplierFound)
                                                    {
                                                        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-2">
                                                            <MudText Typo="Typo.body2" Style="font-weight:600; color:#f57c00">⚠ Tiekėjas nerastas sistemoje</MudText>
                                                            <div class="d-flex gap-1 flex-wrap align-center">
                                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateSupplierAsync" Margin="Margin.Dense">
                                                                    Sukurti tiekėją
                                                                </MudButton>
                                                                @if (!_showAssignSupplier)
                                                                {
                                                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ToggleAssignSupplier" Margin="Margin.Dense">
                                                                        Priskirti esamam
                                                                    </MudButton>
                                                                }
                                                                else
                                                                {
                                                                    <MudTextField T="string"
                                                                                  @bind-Value="_searchTerm"
                                                                                  Variant="Variant.Outlined"
                                                                                  Margin="Margin.Dense"
                                                                                  Placeholder="Ieškoti tiekėjo..."
                                                                                  OnKeyDown="OnSearchKeyDown"
                                                                                  Style="min-width:160px;" />
                                                                    @if (_filteredSuppliers.Any())
                                                                    {
                                                                        <MudSelect T="BusinessPartner?"
                                                                                   @bind-Value="_selectedSupplier"
                                                                                   Variant="Variant.Outlined"
                                                                                   Margin="Margin.Dense"
                                                                                   Clearable="true"
                                                                                   OnClear="(() => { _selectedSupplier = null; StateHasChanged(); })"
                                                                                   Style="min-width:200px;">
                                                                             @foreach (var sp in _filteredSuppliers)
                                                                             {
                                                                                 <MudSelectItem T="BusinessPartner?" Value="sp">@sp.Name (@sp.VatCode)</MudSelectItem>
                                                                             }
                                                                        </MudSelect>
                                                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ConfirmExistingSupplierAsync" Disabled="_selectedSupplier == null" Margin="Margin.Dense">
                                                                            Priskirti
                                                                        </MudButton>
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <MudText Typo="Typo.body2" Style="font-weight:600">@(_supplierName ?? "---")</MudText>
                                                    }
                                                </MudItem>
                                                @if (!string.IsNullOrEmpty(_supplierVat))
                                                {
                                                    <MudItem xs="6">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">PVM kodas</MudText>
                                                        <MudText Typo="Typo.body2" Style="font-weight:600">@_supplierVat</MudText>
                                                    </MudItem>
                                                }
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Data</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-weight:600">@_invoice.InvoiceDate.ToString("yyyy-MM-dd")</MudText>
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Terminas</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-weight:600">@_invoice.DueDate.ToString("yyyy-MM-dd")</MudText>
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Kategorija</MudText>
                                                    <MudText Typo="Typo.body2">@(_categories.FirstOrDefault(c => c.Id == _invoice.CategoryId)?.Name ?? "—")</MudText>
                                                </MudItem>
                                            </MudGrid>
                                        }
                                        else
                                        {
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12">
                                                    <MudTextField @bind-Value="_invoice!.InvoiceNumber" Label="Nr." Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="12">
                                                    <MudTextField Value="@_supplierName" ReadOnly="true" Label="Tiekėjas" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                  Style="opacity:0.8" />
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudDatePicker @bind-Date="_editInvoiceDate" Label="Data" Variant="Variant.Outlined" />
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudDatePicker @bind-Date="_editDueDate" Label="Terminas" Variant="Variant.Outlined" />
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudSelect @bind-Value="_editCategoryId" Label="Kategorija" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                        <MudSelectItem T="int?" Value="@((int?)null)">— Nepriskirta —</MudSelectItem>
                                                        @foreach (var cat in _categories)
                                                        {
                                                            <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="12">
                                                    <MudTextField @bind-Value="_invoice!.Notes" Label="Pastabos" Variant="Variant.Outlined" Lines="2" />
                                                </MudItem>
                                            </MudGrid>
                                        }
                                    </MudPaper>

                                    <!-- Amounts Section -->
                                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-1">Sumos</MudText>
                                    <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2">
                                        @if (!_editMode)
                                        {
                                            <MudGrid Spacing="2">
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Suma be PVM</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-weight:600">@FormatAmountHelper.Trim(_invoice.AmountExclVat, 2) €</MudText>
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">PVM%</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-weight:600">@((int)_invoice.VatRate)%</MudText>
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">PVM suma</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-weight:600">@FormatAmountHelper.Trim(_invoice.VatAmount, 2) €</MudText>
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Suma su PVM</MudText>
                                                    <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#1976d2">@FormatAmountHelper.Trim(_invoice.AmountInclVat, 2) €</MudText>
                                                </MudItem>
                                            </MudGrid>
                                        }
                                        else
                                        {
                                            <div>
                                                <div class="d-flex align-center gap-2 mb-2">
                                                    @{
                                                        var activeBg = _calculateFromExclVat ? "#e3f2fd" : "transparent";
                                                        var inactiveBg = _calculateFromExclVat ? "transparent" : "#e3f2fd";
                                                    }
                                                    <MudButton Size="Size.Small"
                                                               Variant="Variant.Text"
                                                               Color="Color.Primary"
                                                               OnClick="(() => SetCalculationDirection(true))"
                                                               Style=@($"background:{activeBg};font-weight:600;")>
                                                         Skaičiuoti iš be PVM
                                                     </MudButton>
                                                     <MudButton Size="Size.Small"
                                                               Variant="Variant.Text"
                                                               Color="Color.Primary"
                                                               OnClick="(() => SetCalculationDirection(false))"
                                                               Style=@($"background:{inactiveBg};font-weight:600;")>
                                                         Skaičiuoti iš su PVM
                                                    </MudButton>
                                                </div>
                                                <MudGrid Spacing="2">
                                                    <MudItem xs="6">
                                                        <MudNumericField T="decimal"
                                                                         Value="_invoice!.AmountExclVat"
                                                                         ValueChanged="@(v => OnAmountExclVatChanged(v))"
                                                                         Format="N2"
                                                                         Label="Be PVM"
                                                                         Variant="Variant.Outlined" />
                                                    </MudItem>
                                                    <MudItem xs="6">
                                                        <MudNumericField T="int"
                                                                         Value="_editVatRateLocal"
                                                                         Label="PVM %"
                                                                         Variant="Variant.Outlined"
                                                                         Format="N0"
                                                                         Min="0" Max="100"
                                                                         ValueChanged="@(v => { _editVatRateLocal = v; _invoice!.VatRate = v; OnVatRateChanged((decimal)v); })" />
                                                    </MudItem>
                                                    <MudItem xs="6">
                                                        <MudNumericField T="decimal"
                                                                         Value="_invoice!.VatAmount"
                                                                         ValueChanged="@(v => { })"
                                                                         ReadOnly="true"
                                                                         Label="PVM suma"
                                                                         Variant="Variant.Outlined"
                                                                         Format="N2"
                                                                         Disabled="true" />
                                                    </MudItem>
                                                    <MudItem xs="6">
                                                        <MudNumericField T="decimal"
                                                                         Value="_invoice!.AmountInclVat"
                                                                         ValueChanged="@(v => OnAmountInclVatChanged(v))"
                                                                         Format="N2"
                                                                         Label="Su PVM"
                                                                         Variant="Variant.Outlined" />
                                                    </MudItem>
                                                </MudGrid>
                                            </div>
                                        }
                                        <MudDivider Class="my-2" />
                                        <MudText Typo="Typo.caption" Style="font-weight:600; color:#1976d2">
                                            Sumokėta: @FormatAmountHelper.Trim(_invoice.PaidAmount, 2) € | Liko: @FormatAmountHelper.Trim((_invoice.AmountInclVat - _invoice.PaidAmount), 2) €
                                        </MudText>
                                    </MudPaper>

                                    @if (_payments.Count > 0)
                                    {
                                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-3 mb-1">Mokėjimai</MudText>
                                        <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2">
                                            @foreach (var p in _payments)
                                            {
                                                <div class="d-flex justify-space-between mb-1">
                                                    <MudText Typo="Typo.body2">@p.PaymentDate.ToString("yyyy-MM-dd") — @p.PaymentMethod</MudText>
                                                    <MudText Typo="Typo.body2" Style="font-weight:600">@p.Amount.ToString("N2") €</MudText>
                                                </div>
                                            }
                                        </MudPaper>
                                    }

                                    <!-- Eilutės Section -->
                                    @if (_editMode)
                                    {
                                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-3 mb-1">Eilutės</MudText>
                                        <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2">
                                            <div class="d-flex justify-space-between align-center mb-2">
                                                <MudText Typo="Typo.body2" Style="font-weight:600">Eilutės</MudText>
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.Add"
                                                           OnClick="AddEditLine" Style="text-transform:none">
                                                    Pridėti eilutę
                                                </MudButton>
                                            </div>
                                            @for (int i = 0; i < _lines.Count; i++)
                                            {
                                                var idx = i;
                                                <div class="d-flex gap-2 align-center mb-2">
                                                    <MudTextField @bind-Value="_lineDescriptions[idx]"
                                                                 Label="Aprašymas" Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense" Style="flex:3"
                                                                 @onblur="@(() => UpdateLineFromString(idx))" />
                                                    <MudTextField @bind-Value="_lineQuantities[idx]"
                                                                 Label="Kiekis" Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense" Style="flex:1"
                                                                 @onblur="@(() => UpdateLineFromString(idx))" />
                                                    <MudTextField @bind-Value="_lineAmounts[idx]"
                                                                 Label="Be PVM" Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense" Style="flex:1"
                                                                 @onblur="@(() => UpdateLineFromString(idx))" />
                                                    <MudTextField @bind-Value="_lineVatRates[idx]"
                                                                 Label="PVM%" Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense" Style="flex:1"
                                                                 @onblur="@(() => UpdateLineFromString(idx))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Color="Color.Error" Size="Size.Small"
                                                                   OnClick="@(() => RemoveEditLine(idx))" />
                                                </div>
                                            }
                                            <MudDivider Class="mt-1 mb-1" />
                                            <MudText Typo="Typo.body2" Class="text-right">
                                                Iš viso be PVM: <strong>@_lines.Sum(l => l.AmountExclVat).ToString("N2") €</strong>
                                            </MudText>
                                        </MudPaper>
                                    }
                                    else
                                    {
                                        @if (_lines.Any())
                                        {
                                            @if (!LinesMatchHeader)
                                            {
                                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                                    Eilučių suma (@GetLinesTotal().ToString("N2") €) nesutampa su sąskaitos suma (@_invoice?.AmountInclVat.ToString("N2") €)
                                                </MudAlert>
                                            }
                                            <table style="width:100%;font-size:0.83rem;border-collapse:collapse;">
                                                <thead style="background:#f0f4ff;">
                                                    <tr>
                                                        <th style="padding:4px 8px;text-align:left;">Aprašymas</th>
                                                        <th style="padding:4px 8px;text-align:right;">Kiekis</th>
                                                        <th style="padding:4px 8px;text-align:right;">Be PVM</th>
                                                        <th style="padding:4px 8px;text-align:right;">PVM%</th>
                                                        <th style="padding:4px 8px;text-align:right;">Su PVM</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var line in _lines)
                                                    {
                                                        <tr style="border-bottom:1px solid #e5e7eb;">
                                                            <td style="padding:4px 8px;">@line.Description</td>
                                                            <td style="padding:4px 8px;text-align:right;">@(line.Quantity.HasValue ? line.Quantity.Value.ToString("G29") : "")</td>
                                                            <td style="padding:4px 8px;text-align:right;">@line.AmountExclVat.ToString("N2")</td>
                                                            <td style="padding:4px 8px;text-align:right;">@((int)line.VatRate)%</td>
                                                            <td style="padding:4px 8px;text-align:right;">@line.AmountInclVat.ToString("N2")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot style="font-weight:600;background:#f8fafc;">
                                                    <tr>
                                                        <td colspan="4" style="padding:4px 8px;">Viso:</td>
                                                        <td style="padding:4px 8px;text-align:right;">@GetLinesTotal().ToString("N2") €</td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Eilutės nerastos</MudText>
                                        }
                                    }


                                    </div>
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        <MudTabPanel Text="PDF dokumentas">
                            @if (!string.IsNullOrEmpty(_invoice?.OriginalFilePath))
                            {
                                <iframe src="/@_invoice.OriginalFilePath" style="width:100%;height:75vh;border:none;border-radius:4px" />
                            }
                            else
                            {
                                <div class="d-flex flex-column align-center justify-center gap-2" style="height:75vh;">
                                    <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Large" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">PDF failas nepridėtas</MudText>
                                </div>
                            }
                        </MudTabPanel>
                    </MudTabs>
        }
    </DialogContent>

    <DialogActions>
        @if (_editMode)
        {
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">Atšaukti</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" StartIcon="@Icons.Material.Filled.Save">Išsaugoti</MudButton>
        }
        else
        {
            @* Left side: Text/Outlined buttons *@
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelAsync">UŽDARYTI</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EnterEditMode">REDAGUOTI</MudButton>
            @if (!string.IsNullOrEmpty(_invoice?.OriginalFilePath) && new[] { "NEEDS_REVIEW", "PENDING", "PENDING_SUPPLIER" }.Contains(_invoice.Status))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="RerunOcrAsync"
                           Disabled="_isRerunningOcr">PAKARTOTI OCR</MudButton>
            }

            @* Right side: Filled buttons for unconfirmed invoices *@
            @if (!string.IsNullOrEmpty(_invoice?.Status) && new[] { "NEEDS_REVIEW", "DUPLICATE_PENDING", "PENDING_SUPPLIER" }.Contains(_invoice.Status))
            {
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ShowRejectConfirmAsync">ATMESTI</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ApproveAsync">PATVIRTINTI</MudButton>
            }

            @* Right side: Filled button for payment-eligible statuses *@
            @if (!string.IsNullOrEmpty(_invoice?.Status) && new[] { "PENDING", "PARTIAL", "OVERDUE" }.Contains(_invoice.Status))
            {
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payments" OnClick="RegisterPaymentAsync">REGISTRUOTI MOKĖJIMĄ</MudButton>
            }

            @* PAID status: Show payments button *@
            @if (!string.IsNullOrEmpty(_invoice?.Status) && _invoice.Status == "PAID")
            {
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Payments" OnClick="ShowPaymentsAsync">MOKĖJIMAI</MudButton>
            }
        }
    </DialogActions>
</MudDialog>

@code {
    [Inject] IExpenseService ExpenseService { get; set; } = default!;
    [Inject] IAuthService AuthService { get; set; } = default!;
    [Inject] IDialogService DialogService { get; set; } = default!;
    [Inject] IDbContextFactory<NordicBeesERPContext> DbFactory { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    [Inject] ILogger<InvoiceDetailDialog> Logger { get; set; } = default!;
    [Inject] ICompanySettingsService CompanySettingsService { get; set; } = default!;
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int InvoiceId { get; set; }

    private int? _duplicateOfId;
    private string _companyName = string.Empty;

    private ExpenseInvoice? _invoice;
    private List<ExpenseInvoiceLine> _lines = new();
    private List<BusinessPartner> _suppliers = new();
    private BusinessPartner? _selectedSupplier;
    private bool _isLoading = true;
    private bool _editMode = false;
    private string _rejectReason = "";
