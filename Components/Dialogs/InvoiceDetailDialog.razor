    private async Task CreateSupplierAsync()
    {
        try
        {
            var parameters = new DialogParameters();
            if (_invoice != null)
            {
                parameters.Add(nameof(SupplierCreateDialog.PrefilledName), _invoice.PendingSupplierName);
                parameters.Add(nameof(SupplierCreateDialog.PrefilledVatCode), _invoice.PendingSupplierVat);
                parameters.Add(nameof(SupplierCreateDialog.PrefilledAddress), _invoice.PendingSupplierAddress);
                parameters.Add(nameof(SupplierCreateDialog.PrefilledCity), _invoice.PendingSupplierCity);
                parameters.Add(nameof(SupplierCreateDialog.PrefilledPostalCode), _invoice.PendingSupplierPostalCode);
                parameters.Add(nameof(SupplierCreateDialog.PrefilledCountryCode), _invoice.PendingSupplierCountryCode);
                parameters.Add(nameof(SupplierCreateDialog.PrefilledCompanyCode), _invoice.PendingSupplierCompanyCode);
                parameters.Add(nameof(SupplierCreateDialog.PrefilledBankAccount), _invoice.PendingSupplierBankAccount);
            }
            var dialog = await DialogService.ShowAsync<SupplierCreateDialog>("Sukurti tiekėją", parameters);
            var result = await dialog.Result;
            if (result is { Canceled: false } && result.Data is Supplier newSupplier && newSupplier.Id > 0)
            {
                // Auto-assign this supplier to all PENDING_SUPPLIER invoices with matching VAT code or name
                await ExpenseService.AutoAssignSupplierAsync(_invoice.PendingSupplierVat, _invoice.PendingSupplierName, newSupplier.Id);

                _loadedInvoiceId = 0;
                await OnParametersSetAsync();
                Snackbar.Add("Tiekėjas sukurtas ir priskirtas", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klaida kuriant tiekėją: " + ex.Message, Severity.Error);
        }
    }

