@using NordicBeesERP.Models
@using NordicBeesERP.Services.Dtos
@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Mokėjimas: @InvoiceNumber</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <!-- SECTION 1: Invoice Info Card -->
        <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:12px; margin-bottom:12px;">
            <MudGrid Spacing="1">
                <MudItem xs="8">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Sąskaita</MudText>
                    <MudText Typo="Typo.body1" Style="font-weight:600">@InvoiceNumber</MudText>
                </MudItem>
                <MudItem xs="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Liko sumokėti</MudText>
                    <MudText Typo="Typo.body1" Style="color:#dc2626; font-weight:600">@RemainingAmount.ToString("N2") €</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- SECTION 2: Payment Input Form -->
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Įvesti mokėjimą</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="6">
                <MudNumericField T="decimal" Label="Suma (€)" Value="_amount" ValueChanged="@((decimal v) => _amount = v)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.01m" Required="@true" />
            </MudItem>
            <MudItem xs="6">
                <MudDatePicker Label="Data" Date="_date" DateChanged="@((DateTime? d) => _date = d)" DateFormat="yyyy-MM-dd" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudSelect T="string" @bind-Value="_method" Label="Mokėjimo būdas" Variant="Variant.Outlined" Margin="Margin.Dense" Required="@true">
                    <MudSelectItem T="string" Value="@("bank_transfer")">Banko pavedimas</MudSelectItem>
                    <MudSelectItem T="string" Value="@("cash")">Grynais</MudSelectItem>
                    <MudSelectItem T="string" Value="@("other")">Užskaita</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="_reference" Label="Nuorodos nr." Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Pastabos" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
            </MudItem>
        </MudGrid>

        <!-- SECTION 3: Payment History -->
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-1">Mokėjimų istorija</MudText>
        @if (ExistingPayments?.Any() == true)
        {
            <MudTable T="PaymentHistoryItem" Items="@ExistingPayments" Dense="@true" Hover="@true" Striped="@true" Elevation="0">
                <HeaderContent>
                    <MudTh>Data</MudTh>
                    <MudTh>Suma</MudTh>
                    <MudTh>Būdas</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Data">@context.Date.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Suma">@context.Amount.ToString("N2") €</MudTd>
                    <MudTd DataLabel="Būdas">@GetPaymentMethodLabel(context.Method)</MudTd>
                    <MudTd>
                        <div @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeletePayment(context.PaymentId))" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Mokėjimų nėra</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none" StartIcon="@Icons.Material.Filled.Save" OnClick="@SavePayment">Išsaugoti</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="@CancelDialog">Atšaukti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private IPaymentService PaymentService { get; set; } = default!;
    [Inject] private IAuthService AuthService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [CascadingParameter] public IMudDialogInstance? MudDialogInstance { get; set; }

    [Parameter] public int InvoiceId { get; set; }
    [Parameter] public string InvoiceNumber { get; set; } = string.Empty;
    [Parameter] public decimal RemainingAmount { get; set; }
    [Parameter] public List<PaymentHistoryItem>? ExistingPayments { get; set; }

    private decimal _amount;
    private DateTime? _date = DateTime.Today;
    private string _method = "bank_transfer";
    private string _reference = string.Empty;
    private string _notes = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _amount = RemainingAmount;
        _date = DateTime.Today;
        _method = "bank_transfer";
        await Task.Delay(1);
        StateHasChanged();
    }

    private async Task SavePayment()
    {
        try
        {
            // Validate amount does not exceed remaining balance
            if (_amount > RemainingAmount)
            {
                var confirmed = await DialogService.ShowMessageBox(
                    "Patvirtinimas",
                    $"Įvedėte {_amount:N2} €, bet likutis tik {RemainingAmount:N2} €. Ar tikrai norite registruoti permokėjimą?",
                    yesText: "Taip, registruoti", cancelText: "Atšaukti");
                if (confirmed != true) return;
            }

            var userId = await AuthService.GetUserIdAsync();
            if (!userId.HasValue)
            {
                Snackbar.Add("Nepavyko nustatyti vartotojo", Severity.Error);
                return;
            }
            await PaymentService.RegisterPaymentAsync(
                invoiceIds: new List<int> { InvoiceId },
                _amount, _date ?? DateTime.Today, _method, _reference, _notes, userId.Value);
            MudDialogInstance?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida registruojant mokėjimą: {ex.Message}", Severity.Error);
        }
    }

    private void CancelDialog()
    {
        MudDialogInstance?.Close(DialogResult.Cancel());
    }

    private async Task DeletePayment(int paymentId)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Ištrinti mokėjimą?",
            "Ar tikrai norite ištrinti šį mokėjimą?",
            yesText: "Ištrinti",
            cancelText: "Atšaukti");
        if (confirmed != true) return;
        
        var userId = await AuthService.GetUserIdAsync();
        await PaymentService.DeletePaymentAsync(paymentId, userId!.Value);
        
        if (ExistingPayments != null)
        {
            ExistingPayments.RemoveAll(p => p.PaymentId == paymentId);
        }
        
        MudDialogInstance?.Close(DialogResult.Ok(true));
    }

    private string GetPaymentMethodLabel(string method)
    {
        return method switch {
            "BankTransfer" or "bank_transfer" => "Banko pavedimas",
            "Cash" or "cash" => "Grynais",
            "Card" or "card" => "Kortelė",
            "Other" or "other" => "Užskaita",
            _ => method
        };
    }
}