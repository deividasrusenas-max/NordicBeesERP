@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using NordicBeesERP.Services.Dtos
@using MudBlazor
@namespace NordicBeesERP.Components.Dialogs

@inject IPaymentService PaymentService
@inject IDbContextFactory<NordicBeesERPContext> DbFactory
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Registruoti mokėjimą</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <!-- SECTION 1: Invoice Info Card -->
        <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px; margin-bottom:16px;">
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Tiekėjas / Klientas</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600">@_partnerName</MudText>
                </MudItem>
                <MudItem xs="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Nr.</MudText>
                    <MudText Typo="Typo.body2">@_invoiceNumber</MudText>
                </MudItem>
                <MudItem xs="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Terminas</MudText>
                    <MudText Typo="Typo.body2" Style="@(_isOverdue ? "color:#dc2626;font-weight:600" : "")">@_dueDate</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- SECTION 2: Amounts Summary -->
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Suma su PVM</MudText>
                <MudText Typo="Typo.body1" Style="font-weight:600">@_totalAmount.ToString("N2") €</MudText>
            </MudItem>
            <MudItem xs="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Sumokėta</MudText>
                <MudText Typo="Typo.body1" Style="color:#16a34a;font-weight:600">@_paidAmount.ToString("N2") €</MudText>
            </MudItem>
            <MudItem xs="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Liko</MudText>
                <MudText Typo="Typo.body1" Style="color:#dc2626;font-weight:600">@_remainingAmount.ToString("N2") €</MudText>
            </MudItem>
            <MudItem xs="3">
                <MudChip T="string" Color="@_statusColor" Size="Size.Small">@_statusLabel</MudChip>
            </MudItem>
        </MudGrid>
        <MudDivider Class="mb-3" />

        <!-- SECTION 3: Payment Input Form -->
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Įvesti mokėjimą</MudText>
        <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px; margin-bottom:16px;">
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudDatePicker Label="Mokėjimo data" Date="_paymentDate" DateChanged="@((DateTime? d) => _paymentDate = d)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="decimal" Label="Suma (€)" @bind-Value="_paymentAmount" Min="0.01m" Max="999999999.99m" Format="F2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" Label="Mokėjimo būdas" Value="_paymentMethod" ValueChanged="OnPaymentMethodChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@("BANK")">Banko pavedimas</MudSelectItem>
                        <MudSelectItem T="string" Value="@("CASH")">Grynaisi</MudSelectItem>
                        <MudSelectItem T="string" Value="@("OTHER")">Kita</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Label="Nuorodos nr." @bind-Value="_referenceNumber" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Pastabos" @bind-Value="_notes" Variant="Variant.Outlined" Margin="Margin.Dense" multiline="true" Rows="2" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Pasirinkti sąskaitas</MudText>
        <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px; margin-bottom:16px;">
            @if (_invoices.Any())
            {
                <MudTable T="InvoiceWithPaymentInfo" Items="@_invoices" Hover="true" Dense="true" Striped="true" SelectionChanged="OnInvoiceSelected">
                    <HeaderContent>
                        <MudTh><MudCheckBox T="bool" Checked="_selectAll" CheckedChanged="OnSelectAllChanged" /></MudTh>
                        <MudTh>Sąskaitos nr.</MudTh>
                        <MudTh>Klientas</MudTh>
                        <MudTh>Data</MudTh>
                        <MudTh>Terminas</MudTh>
                        <MudTh Style="text-align:right">Suma (€)</MudTh>
                        <MudTh Style="text-align:right">Sumokėta (€)</MudTh>
                        <MudTh Style="text-align:right">Likęs mokėjimas (€)</MudTh>
                        <MudTh Style="text-align:right">Skirtumas (€)</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="invoice">
                        <MudTd DataLabel="Pasirinkti">
                            <MudCheckBox T="bool" Checked="_selectedInvoices.TryGetValue(invoice.Id, out var amount)" CheckedChanged="val => OnCheckboxChanged(invoice.Id, val)" />
                        </MudTd>
                        <MudTd DataLabel="Sąskaitos nr.">@invoice.InvoiceNumber</MudTd>
                        <MudTd DataLabel="Klientas">@invoice.CustomerName</MudTd>
                        <MudTd DataLabel="Data">@invoice.InvoiceDate.ToShortDateString()</MudTd>
                        <MudTd DataLabel="Terminas">@invoice.DueDate?.ToShortDateString()</MudTd>
                        <MudTd DataLabel="Suma" Style="text-align:right">@invoice.TotalInclVat.ToString("N2")</MudTd>
                        <MudTd DataLabel="Sumokėta" Style="text-align:right">@invoice.PaidAmount.ToString("N2")</MudTd>
                        <MudTd DataLabel="Likęs mokėjimas" Style="text-align:right">@invoice.RemainingAmount.ToString("N2")</MudTd>
                        <MudTd DataLabel="Skirtumas" Style="text-align:right; font-weight:600">
                            @GetAllocationAmount(invoice.Id).ToString("N2")
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary">Nėra nepamokėtų sąskaitų</MudText>
            }
        </MudPaper>

        <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px; margin-bottom:16px;">
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Iš viso pasirinkta</MudText>
                    <MudText Typo="Typo.body1">@_totalAllocated.ToString("N2") €</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Mokėjimo suma</MudText>
                    <MudText Typo="Typo.body1" Style="color:#2563eb">@_paymentAmount.ToString("N2") €</MudText>
                </MudItem>
            </MudGrid>
            @if (_totalAllocated > _paymentAmount)
            {
                <MudAlert T="Alert" Severity="Severity.Warning" Class="mt-2">
                    Pasirinktų sąskaitų suma (@_totalAllocated.ToString("N2") €) viršija mokėjimo sumą (@_paymentAmount.ToString("N2") €).
                </MudAlert>
            }
            else if (_totalAllocated < _paymentAmount)
            {
                <MudAlert T="Alert" Severity="Severity.Info" Class="mt-2">
                    Mokėjimo suma (@_paymentAmount.ToString("N2") €) yra didesnė už pasirinktų sąskaitų sumą (@_totalAllocated.ToString("N2") €).
                </MudAlert>
            }
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="CloseDialog">Atšaukti</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none" StartIcon="@Icons.Material.Filled.Save" OnClick="RegisterPayment">Išsaugoti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private DateTime? _paymentDate = DateTime.Today;
    private string _paymentMethod = "BANK";
    private string? _referenceNumber;
    private string? _notes;
    private decimal _paymentAmount = 0m;
    
    private List<InvoiceWithPaymentInfo> _invoices = new();
    private Dictionary<int, decimal> _selectedInvoices = new();
    private decimal _totalAllocated = 0m;
    private bool _selectAll = false;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public int? InvoiceId { get; set; }

    // Invoice info fields
    private string? _partnerName = "";
    private string? _invoiceNumber = "";
    private DateTime? _dueDate;
    private bool _isOverdue;
    private decimal _totalAmount = 0m;
    private decimal _paidAmount = 0m;
    private decimal _remainingAmount = 0m;
    private string _statusLabel = "";
    private Color _statusColor;

    private bool _disposed = false;

    protected override void OnParametersSet()
    {
        _disposed = false;
        _ = LoadInvoicesAsync();
    }

    private async Task LoadInvoicesAsync()
    {
        _invoices = await PaymentService.GetUnpaidInvoicesAsync(
            customerId: null,
            status: "unpaid",
            fromDate: null,
            toDate: null
        );
        
        // Initialize selected invoices with full remaining amount
        foreach (var invoice in _invoices)
        {
            _selectedInvoices[invoice.Id] = invoice.RemainingAmount;
        }
        
        // If InvoiceId is provided, pre-select it
        if (InvoiceId.HasValue && _selectedInvoices.ContainsKey(InvoiceId.Value))
        {
            _paymentAmount = _selectedInvoices[InvoiceId.Value];
        }
    }

    private void OnInvoiceSelected(InvoiceWithPaymentInfo invoice)
    {
        if (_selectedInvoices.ContainsKey(invoice.Id))
        {
            _selectedInvoices.Remove(invoice.Id);
        }
        else
        {
            _selectedInvoices[invoice.Id] = invoice.RemainingAmount;
        }
        CalculateTotal();
    }

    private void OnSelectAllChanged(bool value)
    {
        if (value)
        {
            foreach (var invoice in _invoices)
            {
                if (!_selectedInvoices.ContainsKey(invoice.Id))
                {
                    _selectedInvoices[invoice.Id] = invoice.RemainingAmount;
                }
            }
        }
        else
        {
            _selectedInvoices.Clear();
        }
        CalculateTotal();
    }

    private void OnPaymentMethodChanged(string method)
    {
        _paymentMethod = method;
    }

    private decimal GetAllocationAmount(int invoiceId)
    {
        return _selectedInvoices.TryGetValue(invoiceId, out var amount) ? amount : 0m;
    }

    private void CalculateTotal()
    {
        _totalAllocated = _selectedInvoices.Values.Sum();
    }

    private async Task RegisterPayment()
    {
        if (_disposed) return;

        if (!_selectedInvoices.Any())
        {
            Snackbar.Add("Pasirinkite bent vieną sąskaitą", Severity.Error, options => {
                options.Icon = Icons.Material.Filled.Error;
            });
            return;
        }

        if (_paymentAmount <= 0)
        {
            Snackbar.Add("Įveskite mokėjimo sumą", Severity.Error, options => {
                options.Icon = Icons.Material.Filled.Error;
            });
            return;
        }

        try
        {
            var invoiceIds = _selectedInvoices.Keys.ToList();
            var userId = 1; // TODO: Get actual user ID from authentication
            
            await PaymentService.RegisterPaymentAsync(
                invoiceIds: invoiceIds,
                amount: _paymentAmount,
                paymentDate: _paymentDate.Value,
                method: _paymentMethod,
                reference: _referenceNumber,
                notes: _notes,
                userId: userId
            );

            Snackbar.Add("Mokėjimas sėkmingai registruotas", Severity.Success, options => {
                options.Icon = Icons.Material.Filled.CheckCircle;
            });
            MudDialog?.Close();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Snackbar.Add("Klaida registruojant mokėjimą", Severity.Error, options => {
                options.Icon = Icons.Material.Filled.Error;
            });
        }
    }

    private void CloseDialog()
    {
        MudDialog?.Cancel();
    }
}
