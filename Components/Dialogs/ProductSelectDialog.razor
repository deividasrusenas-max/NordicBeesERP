@using NordicBeesERP.Models
@using MudBlazor
@namespace NordicBeesERP.Components.Dialogs

<MudDialog>
    <TitleContent>
        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" />
        <MudText Typo="Typo.h6">Pasirinkite produktą</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_search"
                      Placeholder="Ieškoti pagal pavadinimą..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="@true"
                      Clearable="@true"
                      FullWidth="@true"
                      Margin="Margin.Dense"
                      Class="mb-3" />

        <MudTable Items="@FilteredProducts"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Elevation="0"
                  OnRowClick="@(async (TableRowClickEventArgs<Product> args) => await SelectProduct(args.Item))"
                  Style="cursor:pointer">
            <HeaderContent>
                <MudTh>Kodas</MudTh>
                <MudTh>Pavadinimas</MudTh>
                <MudTh>Vnt.</MudTh>
                <MudTh>Kaina</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Unit</MudTd>
                <MudTd>@context.SalePrice.ToString("N2") €</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Color="Color.Secondary">Produktų nerasta</MudText>
            </NoRecordsContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="Cancel">Atšaukti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _search = "";

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<Product> Products { get; set; } = new();

    private void Cancel() => MudDialog.Cancel();

    private List<Product> FilteredProducts => Products
        .Where(p => string.IsNullOrEmpty(_search) || 
                    p.Name?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true)
        .ToList();

    private Task SelectProduct(Product product)
    {
        MudDialog.Close(DialogResult.Ok(product));
        return Task.CompletedTask;
    }
}