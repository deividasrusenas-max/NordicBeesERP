@inject IErpUserService ErpUserService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Warning" />
            <MudText Typo="Typo.h6">Keisti slaptažodį</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div style="min-width:380px;">
            <MudText Class="mb-3">Vartotojas: <b>@UserFullName</b></MudText>
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_password" Label="Naujas slaptažodis" Variant="Variant.Outlined"
                    InputType="InputType.Password" />
                <MudTextField @bind-Value="_passwordConfirm" Label="Pakartoti slaptažodį" Variant="Variant.Outlined"
                    InputType="InputType.Password" />
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Atšaukti</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="SaveAsync"
            StartIcon="@Icons.Material.Filled.LockReset">Keisti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int UserId { get; set; }
    [Parameter] public string UserFullName { get; set; } = "";

    private string _password = "";
    private string _passwordConfirm = "";

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("Slaptažodis privalomas", Severity.Warning);
            return;
        }
        if (_password != _passwordConfirm)
        {
            Snackbar.Add("Slaptažodžiai nesutampa", Severity.Warning);
            return;
        }
        try
        {
            await ErpUserService.ResetPasswordAsync(UserId, _password);
            Snackbar.Add("Slaptažodis pakeistas sėkmingai", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida: {ex.Message}", Severity.Error);
        }
    }
}
