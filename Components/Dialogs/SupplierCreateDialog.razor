@using NordicBeesERP.Models
@using NordicBeesERP.Models.Expenses
@using NordicBeesERP.Data
@using MudBlazor
@using NordicBeesERP.Helpers
@using NordicBeesERP.Services
@inject IDialogService DialogService
@inject ISupplierService SupplierService
@inject IGooglePlacesService GooglePlaces
@inject NordicBeesERP.Data.NordicBeesERPContext context

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" />
            <MudText Typo="Typo.h6">
                @(string.IsNullOrEmpty(PrefilledName) ? "Sukurti tiekėją" : "Sukurti tiekėją iš OCR")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div style="min-width:500px">
            <EditForm FormName="SupplierCreateForm" Model="@supplier" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(PrefilledName))
                {
                    <MudText Typo="Typo.overline" Style="color:#6b7280; font-size:0.7rem; letter-spacing:0.08em" Class="mb-1">OCR aptikti duomenys</MudText>
                    <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background:#fff8e1; border-radius:8px; border-left:4px solid #f9a825">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" Style="color:#f9a825" />
                            <div>
                                <MudText Typo="Typo.body1" Style="font-weight:500">@PrefilledName</MudText>
                                @if (!string.IsNullOrEmpty(PrefilledVatCode))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">PVM kodas: @PrefilledVatCode</MudText>
                                }
                            </div>
                        </div>
                    </MudPaper>
                }

                <MudText Typo="Typo.overline" Style="color:#6b7280; font-size:0.7rem; letter-spacing:0.08em" Class="mb-1">Pagrindinė informacija</MudText>
                <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2">
                    <MudGrid>
                        @if (string.IsNullOrEmpty(PrefilledName))
                        {
                            <MudItem xs="12">
                                <div class="d-flex flex-wrap gap-3">
                                    <MudSwitch @bind-Value="supplier.IsCustomer" Label="Klientas" Color="Color.Success" Variant="Variant.Outlined" />
                                    <MudSwitch @bind-Value="supplier.IsSupplier" Label="Tiekėjas" Color="Color.Success" Variant="Variant.Outlined" />
                                    <MudSwitch @bind-Value="supplier.IsExpenseSupplier" Label="Išlaidų tiekėjas" Color="Color.Success" Variant="Variant.Outlined" />
                                    <MudSwitch @bind-Value="supplier.IsIndividual" Label="Fizinis asmuo / ūkininkas" Color="Color.Success" Variant="Variant.Outlined" />
                                </div>
                            </MudItem>
                        }
                        @if (!supplier.IsIndividual)
                        {
                            <MudItem xs="12">
                                <MudTextField @bind-Value="supplier.Name" Label="Pavadinimas" Required="true"
                                              Variant="Variant.Outlined" MaxLength="255" />
                            </MudItem>
                        }
                        @if (!supplier.IsIndividual)
                        {
                            <MudItem xs="6">
                                <MudTextField @bind-Value="supplier.CompanyCode" Label="Įmonės kodas"
                                              Variant="Variant.Outlined" MaxLength="20" />
                            </MudItem>
                        }
                        @if (supplier.IsIndividual)
                        {
                            <MudItem xs="6">
                                <MudTextField @bind-Value="supplier.SupplierFirstName" Label="Vardas"
                                              Variant="Variant.Outlined" MaxLength="100" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField @bind-Value="supplier.SupplierLastName" Label="Pavardė"
                                              Variant="Variant.Outlined" MaxLength="100" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="supplier.NationalIdNumber" Label="Asmens kodas"
                                              Variant="Variant.Outlined" MaxLength="20" />
                            </MudItem>
                            @if (_vatRate != 0)
                            {
                                <MudItem xs="12">
                                    <MudTextField @key="@FarmerCodeKey"
                                                  Value="@(_vatRate == 6 ? supplier.CompensationVatCode : supplier.VatCode)"
                                                  ValueChanged="@(async (string v) => { if (_vatRate == 6) { supplier.CompensationVatCode = v; } else { supplier.VatCode = v; } })"
                                                  Label="@(_vatRate == 6 ? "Kompensacinio PVM tarifo kodas" : "PVM mokėtojo kodas")"
                                                   Variant="Variant.Outlined" MaxLength="20" />
                                    @{ var compCode = supplier.CompensationVatCode; }
                                    @if (_vatRate == 6)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(compCode))
                                        {
                                            @if (CompensationVatCodeValidator.IsObsoleteFormat(compCode))
                                            {
                                                <div class="d-flex align-center gap-1 mt-1">
                                                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                                                    <MudText Typo="Typo.caption" Style="color:#dc2626">Pasenęs 13 skaitmenų formatas — reikia perregistruoti VMI</MudText>
                                                </div>
                                            }
                                            else if (!CompensationVatCodeValidator.IsValid(compCode))
                                            {
                                                <div class="d-flex align-center gap-1 mt-1">
                                                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                                                    <MudText Typo="Typo.caption" Style="color:#dc2626">Neteisingas kompensacinio PVM tarifo kodas</MudText>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-center gap-1 mt-1">
                                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                                    <MudText Typo="Typo.caption" Style="color:#16a34a">Kodas patvirtintas (kontrolinis skaitmuo teisingas)</MudText>
                                                </div>
                                            }
                                        }
                                    }
                                </MudItem>
                            }
                        }
                    </MudGrid>
                </MudPaper>

                <MudText Typo="Typo.overline" Style="color:#6b7280; font-size:0.7rem; letter-spacing:0.08em" Class="mb-1">Finansai</MudText>
                <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="supplier.BankAccount" Label="Banko sąskaita"
                                          Variant="Variant.Outlined" MaxLength="50" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" @bind-Value="supplier.PaymentTermDays"
                                             Label="Mokėjimo terminas (d.)"
                                             Variant="Variant.Outlined" Min="0" Max="365" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudSelect T="int" @bind-Value="_vatRate" Label="PVM tarifas %" Variant="Variant.Outlined">
                                @foreach (var rate in new[]{ 0, 5, 6, 7, 8, 9, 10, 12, 13, 14, 15, 17, 18, 19, 20, 21, 22, 23, 24, 25, 27 })
                                {
                                    <MudSelectItem T="int" Value="@rate">@rate%</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="supplier.DefaultExpenseCategoryId" T="int?" Label="Numatyta išlaidų kategorija" Variant="Variant.Outlined" Clearable="true">
                                @foreach (var cat in _categories)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudSelect T="string" @bind-Value="supplier.DefaultLanguage" Label="Kalba" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@("lt")">Lietuvių</MudSelectItem>
                                <MudSelectItem T="string" Value="@("en")">English</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudText Typo="Typo.overline" Style="color:#6b7280; font-size:0.7rem; letter-spacing:0.08em" Class="mb-1">Kontaktai</MudText>
                <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudAutocomplete T="string"
                                             @bind-Value="supplier.Address"
                                             Label="Adresas"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             SearchFunc="@SearchPlaces"
                                             ToStringFunc="@(s => s)"
                                             Strict="false"
                                             CoerceText="false"
                                             ResetValueOnEmptyText="false"
                                             MinCharacters="3"
                                             ShowProgressIndicator="@_placesLoading"
                                             OnValueChanged="(string? selected) => OnPlaceSelectedAsync(selected)" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="supplier.City" Label="Miestas"
                                          Variant="Variant.Outlined" MaxLength="100" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="supplier.PostalCode" Label="Pašto kodas"
                                          Variant="Variant.Outlined" MaxLength="20" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="supplier.CountryCode" Label="Šalies kodas"
                                          Required="true" Variant="Variant.Outlined" MaxLength="2"
                                          Placeholder="LT" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="supplier.Country" Label="Šalis"
                                          Variant="Variant.Outlined" MaxLength="100" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="supplier.Phone" Label="Telefonas"
                                          Variant="Variant.Outlined" MaxLength="50" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="supplier.Email" Label="El. paštas"
                                          Variant="Variant.Outlined" MaxLength="100" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudText Typo="Typo.overline" Style="color:#6b7280; font-size:0.7rem; letter-spacing:0.08em" Class="mb-1">Kita</MudText>
                <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2">
                    <MudTextField @bind-Value="supplier.Notes" Label="Pastabos"
                                  Variant="Variant.Outlined" Lines="3" MaxLength="1000" Class="mb-2" />
                    <MudSwitch @bind-Value="supplier.IsActive" Label="Aktyvus" Color="Color.Success" />
                </MudPaper>

            </EditForm>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@CloseDialog">
            Atšaukti
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SubmitForm"
                   StartIcon="@Icons.Material.Filled.Save">
            Išsaugoti
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ISnackbar snackbar { get; set; } = default!;
    [CascadingParameter] public IMudDialogInstance? Dialog { get; set; }
    [Parameter] public Supplier? Supplier { get; set; }
    [Parameter] public EventCallback<Supplier> OnSupplierCreated { get; set; }
    [Parameter] public string? PrefilledName { get; set; }
    [Parameter] public string? PrefilledVatCode { get; set; }
    [Parameter] public string? PrefilledAddress { get; set; }
    [Parameter] public string? PrefilledCity { get; set; }
    [Parameter] public string? PrefilledPostalCode { get; set; }
    [Parameter] public string? PrefilledCountryCode { get; set; }
    [Parameter] public string? PrefilledCompanyCode { get; set; }
    [Parameter] public string? PrefilledBankAccount { get; set; }

    private Supplier supplier = new();
    private int _vatRate = 21;

    private string _sessionToken = "";
    private readonly Dictionary<string, string> _descriptionToPlaceId = new();
    private bool _placesLoading = false;

    private string FarmerCodeKey => _vatRate == 6 ? "comp" : "vat";
    private List<NordicBeesERP.Models.Expenses.ExpenseCategory> _categories = new();

    private static string CountryFromCode(string code)
    {
        if (string.IsNullOrEmpty(code)) return "";
        try
        {
            var region = new System.Globalization.RegionInfo(code.ToUpper());
            return region.DisplayName;
        }
        catch
        {
            return code;
        }
    }

    protected override async Task OnInitializedAsync()
    {
                _categories = await context.Set<NordicBeesERP.Models.Expenses.ExpenseCategory>()
                    .Where(c => c.IsActive)
                    .OrderBy(c => c.SortOrder)
                    .ToListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _sessionToken = Guid.NewGuid().ToString();

        if (!string.IsNullOrEmpty(supplier.Name) && supplier.Name == PrefilledName) return;

        if (!string.IsNullOrEmpty(PrefilledName))
        {
            var countryCode = (PrefilledCountryCode ?? "LT").ToUpper();
            supplier = new Supplier
            {
                Name = PrefilledName,
                VatCode = PrefilledVatCode,
                Address = PrefilledAddress ?? "",
                City = PrefilledCity ?? "",
                PostalCode = PrefilledPostalCode ?? "",
                CountryCode = countryCode,
                Country = CountryFromCode(countryCode),
                CompanyCode = PrefilledCompanyCode ?? "",
                BankAccount = PrefilledBankAccount ?? "",
                PartnerType = PartnerType.ExpenseSupplier,
                IsExpenseSupplier = true,
                IsSupplier = false,
                IsCustomer = false,
                IsIndividual = false,
                PaymentTermDays = 30,
                DefaultVatRate = 21m,
                DefaultLanguage = "lt",
                IsActive = true
            };
        }
        else
        {
            supplier = Supplier ?? new Supplier
            {
                PartnerType = PartnerType.Supplier,
                IsSupplier = true,
                PaymentTermDays = 30,
                DefaultVatRate = 21m,
                DefaultLanguage = "lt",
                CountryCode = "LT",
                Country = CountryFromCode("LT"),
                IsActive = true
            };
        }
        _vatRate = (int)supplier.DefaultVatRate;
    }

    private async Task SubmitForm()
    {
        try
        {
            supplier.DefaultVatRate = _vatRate;
            // Auto-fill country name from code if empty
            if (string.IsNullOrEmpty(supplier.Country) && !string.IsNullOrEmpty(supplier.CountryCode))
                supplier.Country = CountryFromCode(supplier.CountryCode.ToUpper());

            var savedSupplier = await SupplierService.SaveSupplierAsync(supplier);

            // Show any farmer-completeness warnings (save never blocked), then close
            if (savedSupplier.SaveWarnings is { Count: > 0 })
            {
                foreach (var warning in savedSupplier.SaveWarnings)
                    snackbar?.Add(warning, Severity.Warning);
            }

            // Close dialog with result
            Dialog?.Close(savedSupplier);
        }
        catch (Exception ex)
        {
            snackbar?.Add($"Klaida išsaugant tiekėją: {ex.Message}", Severity.Error);
        }
    }

    private async Task<IEnumerable<string>> SearchPlaces(string? input, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(input) || input.Trim().Length < 3)
            return Array.Empty<string>();

        _placesLoading = true;
        try
        {
            var suggestions = await GooglePlaces.AutocompleteAsync(input.Trim(), _sessionToken);
            _descriptionToPlaceId.Clear();
            foreach (var s in suggestions)
                _descriptionToPlaceId[s.Description] = s.PlaceId;
            return suggestions.Select(s => s.Description);
        }
        catch
        {
            return Array.Empty<string>();
        }
        finally
        {
            _placesLoading = false;
        }
    }

    private async Task OnPlaceSelectedAsync(string? selectedDescription)
    {
        if (string.IsNullOrWhiteSpace(selectedDescription)) return;
        if (!_descriptionToPlaceId.TryGetValue(selectedDescription, out var placeId)) return;

        PlaceAddressDetails? details;
        try
        {
            details = await GooglePlaces.GetPlaceDetailsAsync(placeId, _sessionToken);
        }
        catch
        {
            details = null;
        }

        // Session terminated after details call — start a fresh one for any further lookups
        _sessionToken = Guid.NewGuid().ToString();

        // MudAutocomplete's @bind-Value has ALREADY written the clicked suggestion
        // description into supplier.Address before this handler runs. Never allow
        // that value to be replaced with an empty string: locality-level places
        // (no "route"/"street_number" address component) resolve to an empty
        // StreetAddress, which used to wipe the stored address on save.
        if (details is null)
        {
            _descriptionToPlaceId.Clear();
            snackbar?.Add("Nepavyko gauti adreso detalių — paliktas pasirinktas adresas", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(details.StreetAddress))
        {
            // No street component (e.g. a village/municipality): keep the clicked
            // description as the address instead of overwriting it with "".
            snackbar?.Add("Nerasta gatvės adreso dalis — įrašytas pasirinktas vietovės pavadinimas", Severity.Warning);
        }
        else
        {
            supplier.Address = details.StreetAddress;
        }

        // Fill only what the lookup actually returned — never clear existing values.
        if (!string.IsNullOrWhiteSpace(details.City)) supplier.City = details.City;
        if (!string.IsNullOrWhiteSpace(details.PostalCode)) supplier.PostalCode = details.PostalCode;
        if (!string.IsNullOrWhiteSpace(details.Country)) supplier.Country = details.Country;
        if (!string.IsNullOrWhiteSpace(details.CountryCode)) supplier.CountryCode = details.CountryCode;
        _descriptionToPlaceId.Clear();
    }

    private void CloseDialog()
    {
        Dialog?.Cancel();
    }

    private async Task HandleValidSubmit()
    {
        var existingByName = await SupplierService.GetAllSuppliersAsync();
        if (existingByName.Any(bp => bp.Name == supplier.Name && bp.Id != supplier.Id))
        {
            snackbar?.Add("Tiekėjas su šiuo pavadinimu jau egzistuoja!", Severity.Warning);
            return;
        }
    }
}
