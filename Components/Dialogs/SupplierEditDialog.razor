@using NordicBeesERP.Models
@using NordicBeesERP.Models.Expenses
@using NordicBeesERP.Data
@using MudBlazor
@inject IDialogService DialogService
@inject ISupplierService SupplierService
@inject IDbContextFactory<NordicBeesERPContext> DbFactory
@inject ICompanyLookupService CompanyLookupService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(supplier.Id > 0 ? "Redaguoti partnerį" : "Naujas partneris")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="PartnerType" @bind-Value="supplier.PartnerType" Label="Partnerio tipas" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="PartnerType" Value="@PartnerType.Supplier">Tiekėjas</MudSelectItem>
                    <MudSelectItem T="PartnerType" Value="@PartnerType.Customer">Klientas</MudSelectItem>
                    <MudSelectItem T="PartnerType" Value="@PartnerType.Both">Tiekėjas ir Klientas</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12">
                <MudTextField @bind-Value="supplier.Name" Label="Pavadinimas" Required="true" 
                             MaxLength="255" Variant="Variant.Outlined" Margin="Margin.Dense" @key="supplier.Name" />
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="supplier.CompanyCode" Label="Įmonės kodas" 
                             MaxLength="20" Variant="Variant.Outlined" Margin="Margin.Dense" @key="supplier.CompanyCode" />
                @if (_lookupLoading)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Ieškoma...</MudText>
                    </div>
                }
                else if (_lookupResult != null && _lookupResult.Found)
                {
                    <div class="d-flex align-center gap-1 mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        <MudChip T="string" Size="Size.Small" Color="@(_lookupResult.Source == LookupSource.Jars ? Color.Primary : Color.Info)" Variant="Variant.Outlined" Style="height:18px;font-size:10px;padding:0 6px">@_lookupResult.Source.ToString().ToUpper()</MudChip>
                        <MudText Typo="Typo.caption" Style="color:#16a34a">@_lookupResult.StatusLabel</MudText>
                    </div>
                }
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudTextField @key="@supplier.VatCode"
                              Value="@supplier.VatCode"
                              ValueChanged="@(async (string v) => { supplier.VatCode = v; await OnVatCodeChanged(); })"
                              Label="PVM mokėtojo kodas"
                              MaxLength="20"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12">
                <MudTextField @bind-Value="supplier.Address" Label="Adresas" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="supplier.City" Label="Miestas" MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="supplier.PostalCode" Label="Pašto kodas" MaxLength="20" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="supplier.Phone" Label="Telefonas" MaxLength="50" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="supplier.Email" Label="El. paštas" MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="supplier.BankAccount" Label="Banko sąskaita" MaxLength="50" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudNumericField T="int" @bind-Value="supplier.PaymentTermDays" Label="Mokėjimo terminas (dienos)" 
                                 Min="0" Max="365" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudSelect T="int" @key="@_vatRate" @bind-Value="_vatRate" Label="PVM tarifas %" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="0">0%</MudSelectItem>
                    <MudSelectItem Value="6">6%</MudSelectItem>
                    <MudSelectItem Value="21">21%</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <MudSelect T="int?" @bind-Value="supplier.DefaultExpenseCategoryId" Label="Numatyta išlaidų kategorija" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem T="int?" Value="@((int?)null)">— Nepriskirta —</MudSelectItem>
                    @foreach (var cat in _categories)
                    {
                        <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12">
                <MudSelect T="string" @bind-Value="supplier.DefaultLanguage" Label="Kalba" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("lt")">Lietuvių</MudSelectItem>
                    <MudSelectItem T="string" Value="@("lv")">Latviešu</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ee")">Eesti</MudSelectItem>
                    <MudSelectItem T="string" Value="@("en")">English</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ru")">Русский</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12">
                <MudTextField @bind-Value="supplier.Notes" Label="Pastabos" Lines="3" MaxLength="1000" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12">
                <MudSwitch @bind-Value="supplier.IsActive" Label="Aktyvus" Color="Color.Success" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@CloseDialog">
            Atšaukti
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SubmitForm" StartIcon="@Icons.Material.Filled.Save" Style="text-transform:none">
            Išsaugoti
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ISnackbar snackbar { get; set; } = default!;
    [CascadingParameter] public IMudDialogInstance? Dialog { get; set; }
    [Parameter] public Supplier? Supplier { get; set; }
    [Parameter] public EventCallback<Supplier> OnSupplierUpdated { get; set; }

    private Supplier supplier = new();
    private int _vatRate = 0;
    private List<NordicBeesERP.Models.Expenses.ExpenseCategory> _categories = new();
    private bool _lookupLoading = false;
    private CompanyLookupResult? _lookupResult = null;
    private string _lastCompanyCode = "";

    protected override async Task OnInitializedAsync()
    {
        await using var ctx = DbFactory.CreateDbContext();
        _categories = await ctx.Set<NordicBeesERP.Models.Expenses.ExpenseCategory>()
            .Where(c => c.IsActive)
            .OrderBy(c => c.SortOrder)
            .ToListAsync();
    }

    protected override void OnParametersSet()
    {
        supplier = Supplier ?? new Supplier
        {
            PartnerType = PartnerType.Supplier,
            PaymentTermDays = 30,
            DefaultVatRate = 0m,
            DefaultLanguage = "lt",
            CountryCode = "LT",
            Country = "Lietuva",
            City = "",
            Address = "",
            PostalCode = "",
            IsActive = true
        };
        
        // Initialize _vatRate from supplier.DefaultVatRate
        _vatRate = (int)supplier.DefaultVatRate;
        
        // Initialize defaults for new supplier
        if (supplier.Id == 0)
        {
            supplier.DefaultVatRate = 0m;
            supplier.CountryCode = "";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (supplier.Id > 0) return;
        if (supplier.CompanyCode != _lastCompanyCode && !string.IsNullOrWhiteSpace(supplier.CompanyCode) && supplier.CompanyCode.Length >= 6)
        {
            _lastCompanyCode = supplier.CompanyCode;
            await OnCompanyCodeChanged();
        }
    }

    private async Task OnCompanyCodeChanged()
    {
        supplier.CompanyCode = supplier.CompanyCode?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(supplier.CompanyCode) || supplier.CompanyCode.Length < 6) return;
        _lookupLoading = true; StateHasChanged();
        _lookupResult = await CompanyLookupService.LookupByCompanyCodeAsync(supplier.CompanyCode);
        if (_lookupResult.Found) await ApplyLookupResult(_lookupResult);
        _lookupLoading = false; StateHasChanged();
    }

    private async Task OnVatCodeChanged()
    {
        supplier.VatCode = supplier.VatCode?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(supplier.VatCode) || supplier.VatCode.Length < 4) return;
        _lookupLoading = true; StateHasChanged();
        var result = await CompanyLookupService.LookupByVatCodeAsync(supplier.VatCode);
        if (result.Found) { _lookupResult = result; await ApplyLookupResult(result); }
        _lookupLoading = false; StateHasChanged();
    }

    private async Task ApplyLookupResult(CompanyLookupResult result)
    {
        if (string.IsNullOrEmpty(supplier.Name) && !string.IsNullOrEmpty(result.Name)) supplier.Name = result.Name;
        if (string.IsNullOrEmpty(supplier.Address) && !string.IsNullOrEmpty(result.Address)) supplier.Address = result.Address;
        if (string.IsNullOrEmpty(supplier.City) && !string.IsNullOrEmpty(result.City)) supplier.City = result.City;
        if (string.IsNullOrEmpty(supplier.PostalCode) && !string.IsNullOrEmpty(result.PostalCode)) supplier.PostalCode = result.PostalCode;
        if (!string.IsNullOrEmpty(result.VatCode)) supplier.VatCode = result.VatCode;
        if (string.IsNullOrEmpty(supplier.Email) && !string.IsNullOrEmpty(result.Email)) supplier.Email = result.Email;
        if (string.IsNullOrEmpty(supplier.Phone) && !string.IsNullOrEmpty(result.Phone)) supplier.Phone = result.Phone;
        if (!string.IsNullOrEmpty(result.CountryCode))
        {
            supplier.CountryCode = result.CountryCode;
            supplier.DefaultVatRate = result.CountryCode.ToUpper() == "LT" ? 21m : 0m;
            _vatRate = (int)supplier.DefaultVatRate;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitForm()
    {
        try
        {
            // Set supplier.DefaultVatRate from _vatRate
            supplier.DefaultVatRate = _vatRate;
            
            // Save the supplier
            var savedSupplier = await SupplierService.SaveSupplierAsync(supplier);
            
            // Close dialog with result
            Dialog?.Close(savedSupplier);
        }
        catch (Exception ex)
        {
            snackbar?.Add($"Klaida išsaugant tiekėją: {ex.Message}", Severity.Error);
        }
    }

    private void CloseDialog()
    {
        Dialog?.Close(DialogResult.Cancel());
    }

    private async Task HandleValidSubmit()
    {
        // Check if name already exists (excluding current supplier)
        var existingByName = await SupplierService.GetAllSuppliersAsync();
        
        if (existingByName.Any(bp => bp.Name == supplier.Name && bp.Id != supplier.Id))
        {
            snackbar?.Add("Tiekėjas su šiuo pavadinimu jau egzistuoja!", Severity.Warning);
            return;
        }
    }
}