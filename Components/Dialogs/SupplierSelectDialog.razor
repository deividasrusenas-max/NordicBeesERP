@using NordicBeesERP.Models
@using MudBlazor
@namespace NordicBeesERP.Components.Dialogs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Pasirinkite tiekėją</MudText>
    </TitleContent>
    <DialogContent>
        <MudTable T="Supplier" Items="@Suppliers" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Pavadinimas</MudTh>
                <MudTh style="text-align:right">Veiksmas</MudTh>
            </HeaderContent>
            <RowTemplate Context="supplier">
                <MudTd DataLabel="Pavadinimas">@supplier.Name</MudTd>
                <MudTd Style="text-align:right">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               OnClick="@(() => MudDialog.Close(DialogResult.Ok(supplier)))">
                        PASIRINKTI
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<Supplier> Suppliers { get; set; } = new();
}