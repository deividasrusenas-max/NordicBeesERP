@inherits LayoutComponentBase
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using NordicBeesERP.Services
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject ICompanySettingsService CompanySettingsService

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider MaxDisplayedSnackbars="3" />

<CascadingAuthenticationState>
<MudLayout>
    <MudDrawer @bind-Open="sidebarOpen" Elevation="0" Width="250px" 
        Style="background:var(--lakstena-surface); border-right:1px solid var(--lakstena-border)">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Style="background:var(--lakstena-bg)">
        <div style="position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:18px;padding:16px 32px;background:rgba(239,236,230,.86);backdrop-filter:blur(12px);border-bottom:1px solid rgba(27,25,23,.07);color:#1b1917">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleSidebar" />
            <TopHeader />
        </div>
        <div style="padding:0">
            @Body
            <MudPaper Elevation="0" Class="pa-3 mt-4" Style="background:var(--lakstena-surface); border-top:1px solid var(--lakstena-border); text-align:center;">
                <MudText Typo="Typo.caption" Style="color:var(--lakstena-text-secondary)">© 2026 @_companyName · NordicBeesERP v@_version</MudText>
            </MudPaper>
        </div>
    </MudMainContent>
</MudLayout>
</CascadingAuthenticationState>

@code {
    private bool sidebarOpen = true;

    private string _version => Configuration["AppVersion"] ?? "0.9.0";
    private string _companyName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var s = await CompanySettingsService.GetSettingsAsync();
            _companyName = s.CompanyName;
        }
        catch
        {
            // Company settings unavailable (e.g. row missing) — keep footer neutral instead of crashing the circuit.
        }
    }

    private MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#c47a10",
            Secondary = "#7fb685",
            AppbarBackground = "#fbfaf7",
            AppbarText = "#1b1917",
            DrawerBackground = "#fbfaf7",
            DrawerText = "#1b1917",
            Background = "#efece6",
            Surface = "#ffffff",
            TextPrimary = "#1b1917",
            TextSecondary = "rgba(27,25,23,.6)",
            Error = "#b3402f",
            Success = "#5f8f7f",
            Divider = "rgba(27,25,23,.09)"
        }
    };

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }
}