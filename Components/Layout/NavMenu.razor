@using MudBlazor
@inject AuthenticationStateProvider AuthStateProvider
@inject IPaymentService PaymentService
@inject NavigationManager Navigation
@using NordicBeesERP.Services
@using NordicBeesERP.Services.Dtos
@implements IDisposable

@* Sidebar markup/CSS ported 1:1 from .opencode/planning/design-reference/dashboard-mockup.dc.html
   (colors, spacing, radii, fonts — see that file's top comment block for the source values).
   Styles live in wwwroot/app.css under "Lakštena sidebar" (global, not scoped — most rows are
   rendered by the built-in <NavLink> child component, which scoped CSS can't reach). *@

<div class="lb-sidebar">
@if (_isDesigner && !_isAdmin)
{
    <div class="lb-logo">
        <div class="lb-logo-mark">L</div>
        <div class="lb-logo-text">
            <span class="lb-logo-title">Lakštena ERP</span>
            <span class="lb-logo-subtitle">medaus apskaita</span>
        </div>
    </div>

    <div class="lb-top-items">
        <NavLink href="/artwork/gallery" Match="NavLinkMatch.Prefix" class="lb-row" ActiveClass="lb-row-active">
            <span class="lb-row-label">Galerija</span>
        </NavLink>
        <NavLink href="/artwork" Match="NavLinkMatch.All" class="lb-row" ActiveClass="lb-row-active">
            <span class="lb-row-label">Brand Dashboard</span>
        </NavLink>
    </div>

    <div class="lb-group">
        <button type="button" class="lb-group-header @(_designerSettingsOpen ? "lb-group-header-open" : "")" @onclick="() => _designerSettingsOpen = !_designerSettingsOpen">
            <span class="lb-group-icon">⚙</span>
            <span class="lb-group-title">Nustatymai</span>
        </button>
        @if (_designerSettingsOpen)
        {
            <div class="lb-sublist">
                <NavLink href="/settings/artwork-brands" class="lb-sublink">Prekių ženklai</NavLink>
                <NavLink href="/settings/artwork-label-types" class="lb-sublink">Etikečių tipai</NavLink>
            </div>
        }
    </div>
}
else
{
    <div class="lb-logo">
        <div class="lb-logo-mark">L</div>
        <div class="lb-logo-text">
            <span class="lb-logo-title">Lakštena ERP</span>
            <span class="lb-logo-subtitle">medaus apskaita</span>
        </div>
    </div>

    <div class="lb-top-items">
        <NavLink href="/" Match="NavLinkMatch.All" class="lb-row" ActiveClass="lb-row-active">
            <span class="lb-row-label">Pradžia</span>
        </NavLink>

        @foreach (var topSection in _topSections)
        {
            <button type="button" class="lb-row @(IsSectionActive(topSection) ? "lb-row-active" : "")" @onclick="() => Toggle(topSection)">
                <span class="lb-row-label">@topSection.Title</span>
            </button>
            @if (topSection.Expanded)
            {
                <div class="lb-sublist">
                    @foreach (var item in topSection.Items)
                    {
                        <NavLink href="@item.Href" Match="NavLinkMatch.Prefix" class="lb-sublink">
                            <span>@item.Label</span>
                            @if (item.Count > 0)
                            {
                                <span class="lb-count">@item.Count</span>
                            }
                        </NavLink>
                    }
                </div>
            }
        }
    </div>

    @foreach (var group in _groupedSections)
    {
        <div class="lb-group">
            <div class="lb-group-label">@group.GroupLabel</div>
            <button type="button" class="lb-group-header @(group.Section.Expanded ? "lb-group-header-open" : "")" @onclick="() => Toggle(group.Section)">
                <span class="lb-group-icon">@group.Icon</span>
                <span class="lb-group-title">@group.Section.Title</span>
                <span class="lb-group-count">@group.Section.Items.Count</span>
            </button>
            @if (group.Section.Expanded)
            {
                <div class="lb-sublist">
                    @foreach (var item in group.Section.Items)
                    {
                        <NavLink href="@item.Href" Match="NavLinkMatch.Prefix" class="lb-sublink">
                            <span>@item.Label</span>
                            @if (item.Danger && item.Count > 0)
                            {
                                <span class="lb-alert-pill">@item.Count</span>
                            }
                            else if (item.Count > 0)
                            {
                                <span class="lb-count">@item.Count</span>
                            }
                        </NavLink>
                    }
                </div>
            }
        </div>
    }

    <div class="lb-footer">
        <div class="lb-group-label">Sistema</div>
        <button type="button" class="lb-group-header @(_settingsOpen ? "lb-group-header-open" : "")" @onclick="() => _settingsOpen = !_settingsOpen">
            <span class="lb-group-icon">⚙</span>
            <span class="lb-group-title">Nustatymai</span>
        </button>
        @if (_settingsOpen)
        {
            <div class="lb-sublist">
                @if (_isAdmin)
                {
                    <NavLink href="/app-settings" Match="NavLinkMatch.Prefix" class="lb-sublink">Pagrindiniai nustatymai</NavLink>
                    <NavLink href="/settings/company" Match="NavLinkMatch.Prefix" class="lb-sublink">Įmonės rekvizitai</NavLink>
                    <NavLink href="/admin/users" Match="NavLinkMatch.Prefix" class="lb-sublink">Vartotojai</NavLink>
                }
                <NavLink href="/settings/honey-types" Match="NavLinkMatch.Prefix" class="lb-sublink">Medaus rūšys</NavLink>
                <NavLink href="/settings/raw-materials" Match="NavLinkMatch.Prefix" class="lb-sublink">Žaliavų tipai</NavLink>
                <NavLink href="/warehouses" Match="NavLinkMatch.Prefix" class="lb-sublink">Sandėliai</NavLink>
                @if (_isAdmin || _isManager)
                {
                    <NavLink href="/settings/expense-categories" Match="NavLinkMatch.Prefix" class="lb-sublink">Išlaidų kategorijos</NavLink>
                }
                @if (_isAdmin || _isDesigner || _isManager)
                {
                    <NavLink href="/settings/artwork-brands" Match="NavLinkMatch.Prefix" class="lb-sublink">Prekių ženklai</NavLink>
                    <NavLink href="/settings/artwork-label-types" Match="NavLinkMatch.Prefix" class="lb-sublink">Etikečių tipai</NavLink>
                }
            </div>
        }
    </div>
}
</div>

@code {
    private bool _isAdmin;
    private bool _isManager;
    private bool _isWarehouse;
    private bool _isDesigner;
    private bool _designerSettingsOpen = true;
    private bool _settingsOpen = true;

    private NavBadgeCounts _badgeCounts = new();
    private string _currentPath = "/";

    private sealed class NavItem
    {
        public string Href { get; init; } = string.Empty;
        public string Label { get; init; } = string.Empty;
        public int? Count { get; init; }
        public bool Danger { get; init; }
    }

    private sealed class NavSection
    {
        public string Title { get; init; } = string.Empty;
        public List<NavItem> Items { get; init; } = new();
        public bool DefaultExpanded { get; init; }
        public bool Expanded { get; set; }
    }

    private sealed class NavGroup
    {
        public string GroupLabel { get; init; } = string.Empty;
        public string Icon { get; init; } = string.Empty;
        public NavSection Section { get; init; } = new();
    }

    private List<NavSection> _topSections = new();
    private List<NavGroup> _groupedSections = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = auth.User.IsInRole("Admin");
        _isManager = auth.User.IsInRole("Manager");
        _isWarehouse = auth.User.IsInRole("Warehouse");
        _isDesigner = auth.User.IsInRole("Designer");

        try { _badgeCounts = await PaymentService.GetNavBadgeCountsAsync(); }
        catch { _badgeCounts = new NavBadgeCounts(); }

        BuildNav();

        _currentPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];
        AutoExpandActiveSections();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void BuildNav()
    {
        _topSections = new List<NavSection>();

        var warehouseItems = new List<NavItem> { new() { Href = "/warehouse/deliveries/new", Label = "Naujas pristatymas" } };
        if (!_isManager)
        {
            warehouseItems.Add(new NavItem { Href = "/warehouse/deliveries", Label = "Pristatymai", Count = _badgeCounts.UnpricedDeliveries });
        }
        if (_isAdmin || _isManager)
        {
            warehouseItems.Add(new NavItem { Href = "/warehouse/delivery-pricing", Label = "Kainos ir mokėjimai" });
            warehouseItems.Add(new NavItem { Href = "/warehouse/supplier-debts", Label = "Skolos tiekėjams" });
        }
        warehouseItems.Add(new NavItem { Href = "/warehouse/stock", Label = "Sandėlio likučiai" });
        warehouseItems.Add(new NavItem { Href = "/warehouse/write-off", Label = "Nurašymas" });
        warehouseItems.Add(new NavItem { Href = "/warehouse/write-off-history", Label = "Nurašymų istorija" });
        warehouseItems.Add(new NavItem { Href = "/warehouse/transfers", Label = "Perkėlimai" });
        _topSections.Add(new NavSection { Title = "Sandėlis", Items = warehouseItems, DefaultExpanded = false });

        _topSections.Add(new NavSection
        {
            Title = "Produkcija",
            Items = new List<NavItem> { new() { Href = "/products", Label = "Produktai" } },
            DefaultExpanded = true
        });

        if (_isAdmin || _isManager || _isWarehouse)
        {
            var orderItems = new List<NavItem> { new() { Href = "/orders", Label = "Užsakymų sąrašas" } };
            if (_isAdmin || _isManager)
            {
                orderItems.Add(new NavItem { Href = "/orders/create", Label = "Naujas užsakymas" });
            }
            _topSections.Add(new NavSection { Title = "Užsakymai", Items = orderItems, DefaultExpanded = true });

            _topSections.Add(new NavSection
            {
                Title = "Tiekėjai ir klientai",
                Items = new List<NavItem>
                {
                    new() { Href = "/suppliers", Label = "Tiekėjai" },
                    new() { Href = "/customers", Label = "Klientai" }
                },
                DefaultExpanded = true
            });
        }

        if (_isAdmin || _isManager)
        {
            _topSections.Add(new NavSection
            {
                Title = "Išlaidos",
                Items = new List<NavItem>
                {
                    new() { Href = "/expenses", Label = "Suvestinė" },
                    new() { Href = "/expense-invoices", Label = "Sąskaitos" },
                    new() { Href = "/expense-payments", Label = "Mokėjimai" },
                    new() { Href = "/expenses/forecast", Label = "Išlaidų prognozė" },
                    new() { Href = "/bank-import?type=expense", Label = "Banko importas" }
                },
                DefaultExpanded = false
            });
        }

        foreach (var section in _topSections)
        {
            section.Expanded = section.DefaultExpanded;
        }

        _groupedSections = new List<NavGroup>();

        if (_isAdmin || _isManager)
        {
            var salesSection = new NavSection
            {
                Title = "Pardavimai",
                Items = new List<NavItem>
                {
                    new() { Href = "/invoices/sales", Label = "Pardavimų sąskaitos", Count = _badgeCounts.OverdueInvoices, Danger = true },
                    new() { Href = "/payments", Label = "Skolų valdymas" },
                    new() { Href = "/payments/forecast", Label = "Įplaukų prognozė" },
                    new() { Href = "/payments/history", Label = "Įplaukų istorija" },
                    new() { Href = "/bank-import?type=income", Label = "Banko importas" }
                },
                DefaultExpanded = true
            };
            salesSection.Expanded = salesSection.DefaultExpanded;
            _groupedSections.Add(new NavGroup { GroupLabel = "Finansai", Icon = "€", Section = salesSection });
        }

        if (_isAdmin || _isManager)
        {
            var statsSection = new NavSection
            {
                Title = "Statistika",
                Items = new List<NavItem>
                {
                    new() { Href = "/statistics", Label = "Pirkimai" },
                    new() { Href = "/statistics/sales", Label = "Pardavimai" },
                    new() { Href = "/reports/debt-reconciliation", Label = "Skolų suderinimo aktas" },
                    new() { Href = "/reports/sales-by-customer", Label = "Prekių pardavimo suvestinė" }
                },
                DefaultExpanded = false
            };
            statsSection.Expanded = statsSection.DefaultExpanded;
            _groupedSections.Add(new NavGroup { GroupLabel = "Analitika", Icon = "◲", Section = statsSection });
        }

        if (_isAdmin || _isDesigner || _isManager)
        {
            var artworkSection = new NavSection
            {
                Title = "Artwork",
                Items = new List<NavItem>
                {
                    new() { Href = "/artwork", Label = "Brand Dashboard" },
                    new() { Href = "/artwork/gallery", Label = "Galerija" }
                },
                DefaultExpanded = true
            };
            artworkSection.Expanded = artworkSection.DefaultExpanded;
            _groupedSections.Add(new NavGroup { GroupLabel = "Gamyba", Icon = "◑", Section = artworkSection });
        }
    }

    private void AutoExpandActiveSections()
    {
        foreach (var section in _topSections)
        {
            if (SectionContainsCurrentPath(section)) section.Expanded = true;
        }
        foreach (var group in _groupedSections)
        {
            if (SectionContainsCurrentPath(group.Section)) group.Section.Expanded = true;
        }
    }

    private bool SectionContainsCurrentPath(NavSection section)
        => section.Items.Any(i => _currentPath.StartsWith(i.Href.Split('?')[0], StringComparison.OrdinalIgnoreCase));

    private bool IsSectionActive(NavSection section) => SectionContainsCurrentPath(section);

    private void Toggle(NavSection section)
    {
        section.Expanded = !section.Expanded;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = "/" + Navigation.ToBaseRelativePath(e.Location).Split('?')[0];
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
