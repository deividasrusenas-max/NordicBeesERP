@using MudBlazor
@inject AuthenticationStateProvider AuthStateProvider
@inject IPaymentService PaymentService
@using NordicBeesERP.Services
@using NordicBeesERP.Services.Dtos

<MudNavMenu Style="display:flex; flex-direction:column; height:100%">
    @if (_isDesigner && !_isAdmin)
    {
        <MudNavLink Href="/artwork/gallery" Icon="@Icons.Material.Filled.GridView">Galerija</MudNavLink>
        <MudNavLink Href="/artwork" Icon="@Icons.Material.Filled.Palette">Brand Dashboard</MudNavLink>
        <MudNavGroup Title="Nustatymai" Icon="@Icons.Material.Filled.Settings">
            <MudNavLink Href="/settings/artwork-brands" Icon="@Icons.Material.Filled.Palette">Prekių ženklai</MudNavLink>
            <MudNavLink Href="/settings/artwork-label-types" Icon="@Icons.Material.Filled.Label">Etikečių tipai</MudNavLink>
        </MudNavGroup>
    }
    else
    {
        @* Sidebar top block: logo + brand name *@
        <div class="d-flex align-center pa-3 pb-2" style="border-bottom:1px solid var(--lakstena-border)">
            <img src="/logo.png" style="height:28px; margin-right:10px;" alt="Lakštena" />
            <div>
                <div style="font-weight:700; color:var(--lakstena-text); font-size:0.95rem; line-height:1.2">Lakštena ERP</div>
                <div class="lakstena-mono" style="font-size:0.6rem; text-transform:uppercase; letter-spacing:0.14em; color:var(--lakstena-text-secondary)">MEDAUS APSKAITA</div>
            </div>
        </div>

        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Pradžia</MudNavLink>

        <MudNavGroup Title="Sandėlis" Icon="@Icons.Material.Filled.Warehouse" Expanded="false">
            <MudNavLink Href="/warehouse/deliveries/new" Icon="@Icons.Material.Filled.Add">Naujas pristatymas</MudNavLink>
            @if (!_isManager)
            {
                <MudNavLink Href="/warehouse/deliveries" Icon="@Icons.Material.Filled.LocalShipping">
                    Pristatymai
                    @if (_badgeCounts.UnpricedDeliveries > 0)
                    {
                        <span class="nav-count-pill" style="background:var(--lakstena-accent); color:#fff; border-radius:10px; padding:0 8px; font-size:0.7rem; margin-left:6px">@_badgeCounts.UnpricedDeliveries</span>
                    }
                </MudNavLink>
            }
            @if (_isAdmin || _isManager)
            {
                <MudNavLink Href="/warehouse/delivery-pricing" Icon="@Icons.Material.Filled.PriceCheck">Kainos ir mokėjimai</MudNavLink>
                <MudNavLink Href="/warehouse/supplier-debts" Icon="@Icons.Material.Filled.AccountBalance">Skolos tiekėjams</MudNavLink>
            }
            <MudNavLink Href="/warehouse/stock" Icon="@Icons.Material.Filled.Inventory">Sandėlio likučiai</MudNavLink>
            <MudNavLink Href="/warehouse/write-off" Icon="@Icons.Material.Filled.DeleteForever">Nurašymas</MudNavLink>
            <MudNavLink Href="/warehouse/write-off-history" Icon="@Icons.Material.Filled.History">Nurašymų istorija</MudNavLink>
            <MudNavLink Href="/warehouse/transfers" Icon="@Icons.Material.Filled.SwapHoriz">Perkėlimai</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Produkcija" Icon="@Icons.Material.Filled.Agriculture">
            <MudNavLink Href="/products" Icon="@Icons.Material.Filled.Inventory">Produktai</MudNavLink>
        </MudNavGroup>

        @if (_isAdmin || _isManager || _isWarehouse)
        {
            <MudNavGroup Title="Užsakymai" Icon="@Icons.Material.Filled.ShoppingCart">
                <MudNavLink Href="/orders" Icon="@Icons.Material.Filled.List">Užsakymų sąrašas</MudNavLink>
                @if (_isAdmin || _isManager)
                {
                    <MudNavLink Href="/orders/create" Icon="@Icons.Material.Filled.Add">Naujas užsakymas</MudNavLink>
                }
            </MudNavGroup>
        }

        @if (_isAdmin || _isManager || _isWarehouse)
        {
            <MudNavGroup Title="Tiekėjai" Icon="@Icons.Material.Filled.People">
                <MudNavLink Href="/suppliers" Icon="@Icons.Material.Filled.LocalShipping">Tiekėjai</MudNavLink>
                <MudNavLink Href="/customers" Icon="@Icons.Material.Filled.Person">Klientai</MudNavLink>
            </MudNavGroup>
        }

        @if (_isAdmin || _isManager)
        {
            <MudNavGroup Title="Išlaidos" Icon="@Icons.Material.Filled.Receipt" Expanded="false">
                <MudNavLink Href="/expenses" Icon="@Icons.Material.Filled.Dashboard">Suvestinė</MudNavLink>
                <MudNavLink Href="/expense-invoices" Icon="@Icons.Material.Filled.Receipt">Sąskaitos</MudNavLink>
                <MudNavLink Href="/expense-payments" Icon="@Icons.Material.Filled.History">Mokėjimai</MudNavLink>
                <MudNavLink Href="/expenses/forecast" Icon="@Icons.Material.Filled.TrendingDown">Išlaidų prognozė</MudNavLink>
                <MudNavLink Href="/bank-import?type=expense" Icon="@Icons.Material.Filled.FileUpload">Banko importas</MudNavLink>
            </MudNavGroup>
        }

        @* Section header: FINANSAI *@
        <div class="lakstena-mono" style="padding:12px 16px 4px; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--lakstena-text-secondary)">FINANSAI</div>

        @if (_isAdmin || _isManager)
        {
            <MudNavGroup Title="Pardavimai" Icon="@Icons.Material.Filled.AccountBalance">
                <MudNavLink Href="/invoices/sales" Icon="@Icons.Material.Filled.Receipt">
                    Pardavimų sąskaitos
                    @if (_badgeCounts.OverdueInvoices > 0)
                    {
                        <span style="background:var(--lakstena-danger); color:#fff; border-radius:10px; padding:0 8px; font-size:0.7rem; margin-left:6px">@_badgeCounts.OverdueInvoices</span>
                    }
                </MudNavLink>
                <MudNavLink Href="/payments" Icon="@Icons.Material.Filled.Dashboard">Skolų valdymas</MudNavLink>
                <MudNavLink Href="/payments/forecast" Icon="@Icons.Material.Filled.TrendingUp">Įplaukų prognozė</MudNavLink>
                <MudNavLink Href="/payments/history" Icon="@Icons.Material.Filled.History">Įplaukų istorija</MudNavLink>
                <MudNavLink Href="/bank-import?type=income" Icon="@Icons.Material.Filled.FileUpload">Banko importas</MudNavLink>
            </MudNavGroup>
            @* Hidden 2026-08-19 pending decision on this section's purpose *@
            @*<MudNavGroup Title="Medaus pirkimai" Icon="@Icons.Material.Filled.Hive" Expanded="false">
                <MudNavLink Href="/invoices/purchases" Icon="@Icons.Material.Filled.Receipt">Pirkimų sąskaitos</MudNavLink>
            </MudNavGroup>*@
        }

        @* Section header: ANALITIKA *@
        <div class="lakstena-mono" style="padding:12px 16px 4px; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--lakstena-text-secondary)">ANALITIKA</div>

        @if (_isAdmin || _isManager)
        {
            <MudNavGroup Title="Statistika" Icon="@Icons.Material.Filled.BarChart" Expanded="false">
                <MudNavLink Href="/statistics" Icon="@Icons.Material.Filled.ShoppingCart">Pirkimai</MudNavLink>
                <MudNavLink Href="/statistics/sales" Icon="@Icons.Material.Filled.PointOfSale">Pardavimai</MudNavLink>
                <MudNavLink Href="/reports/debt-reconciliation" Icon="@Icons.Material.Filled.Description">Skolų suderinimo aktas</MudNavLink>
                <MudNavLink Href="/reports/sales-by-customer" Icon="@Icons.Material.Filled.PointOfSale">Prekių pardavimo suvestinė</MudNavLink>
            </MudNavGroup>
        }

        @* Section header: GAMYBA (Artwork) *@
        @if (_isAdmin || _isDesigner || _isManager)
        {
            <div class="lakstena-mono" style="padding:12px 16px 4px; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--lakstena-text-secondary)">GAMYBA</div>
            <MudNavGroup Title="Artwork" Icon="@Icons.Material.Filled.Palette">
                <MudNavLink Href="/artwork" Icon="@Icons.Material.Filled.Palette">Brand Dashboard</MudNavLink>
                <MudNavLink Href="/artwork/gallery" Icon="@Icons.Material.Filled.GridView">Galerija</MudNavLink>
            </MudNavGroup>
        }

        @* Section header: SISTEMA *@
        <div class="lakstena-mono" style="padding:12px 16px 4px; font-size:0.65rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--lakstena-text-secondary)">SISTEMA</div>

        <MudNavGroup Title="Nustatymai" Icon="@Icons.Material.Filled.Settings">
            @if (_isAdmin)
            {
                <MudNavLink Href="/app-settings" Icon="@Icons.Material.Filled.Settings">Pagrindiniai nustatymai</MudNavLink>
                <MudNavLink Href="/settings/company" Icon="@Icons.Material.Filled.Business">Įmonės rekvizitai</MudNavLink>
                <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.People">Vartotojai</MudNavLink>
            }
            <MudNavLink Href="/settings/honey-types" Icon="@Icons.Material.Filled.Hive">Medaus rūšys</MudNavLink>
            <MudNavLink Href="/settings/raw-materials" Icon="@Icons.Material.Filled.Category">Žaliavų tipai</MudNavLink>
            <MudNavLink Href="/warehouses" Icon="@Icons.Material.Filled.Warehouse">Sandėliai</MudNavLink>
            @if (_isAdmin || _isManager)
            {
                <MudNavLink Href="/settings/expense-categories" Icon="@Icons.Material.Filled.Category">Išlaidų kategorijos</MudNavLink>
            }
            @if (_isAdmin || _isDesigner || _isManager)
            {
                <MudNavLink Href="/settings/artwork-brands" Icon="@Icons.Material.Filled.Palette">Prekių ženklai</MudNavLink>
                <MudNavLink Href="/settings/artwork-label-types" Icon="@Icons.Material.Filled.Label">Etikečių tipai</MudNavLink>
            }
        </MudNavGroup>

    }
</MudNavMenu>

@code {
    private bool _isAdmin;
    private bool _isManager;
    private bool _isWarehouse;
    private bool _isDesigner;

    private NavBadgeCounts _badgeCounts = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = auth.User.IsInRole("Admin");
        _isManager = auth.User.IsInRole("Manager");
        _isWarehouse = auth.User.IsInRole("Warehouse");
        _isDesigner = auth.User.IsInRole("Designer");

        try { _badgeCounts = await PaymentService.GetNavBadgeCountsAsync(); }
        catch { _badgeCounts = new NavBadgeCounts(); }
    }
}
