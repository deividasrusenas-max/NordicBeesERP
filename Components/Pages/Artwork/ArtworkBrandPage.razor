@page "/artwork/brand/{BrandId:int}"
@rendermode InteractiveServer
@using NordicBeesERP.Services.Artwork
@using NordicBeesERP.Components.Dialogs
@using MudBlazor
@inject IArtworkService ArtworkService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject IDialogService DialogService

<PageTitle>@_brandName</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">@_brandName</MudText>
        <MudButton OnClick="OpenCreateAsset" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary">
            Naujas asset'as
        </MudButton>
    </div>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }
    else
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
            <MudGrid>
                @foreach (var asset in _assets)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <div @onclick="@(async () => await NavigateToAsset(asset.Id))" style="cursor:pointer">
                            <MudPaper Class="pa-3 mb-3" Elevation="1" Style="@GetAssetCardStyle(asset)">
                                @if (asset.HasThumbnail && asset.ActualVersionId.HasValue)
                                {
                                    <img src="@($"/artwork/preview/{asset.ActualVersionId}")"
                                         style="width:60px; height:60px; object-fit:cover; border-radius:4px; margin-bottom:8px"
                                         class="d-block mx-auto" />
                                }
                                <div class="d-flex justify-space-between align-start">
                                    <MudText Typo="Typo.h6">@asset.Name</MudText>
                                    @if (asset.HasPendingVersion)
                                    {
                                        <MudChip T="bool" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                                            Laukia
                                        </MudChip>
                                    }
                                    @if (asset.Status == "archived")
                                    {
                                        <MudChip T="bool" Color="Color.Default" Variant="Variant.Filled" Size="Size.Small">
                                            Archyvuotas
                                        </MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="mt-1">
                                    @GetAssetTypeLabel(asset.AssetType) — @($"v{asset.ActualVersionNumber}")
                                </MudText>
                            </MudPaper>
                        </div>
                        @if (asset.Status == "archived" && _isAdmin)
                        {
                            <div @onclick:stopPropagation="true">
                                <MudButton StartIcon="@Icons.Material.Filled.Restore" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                    OnClick="@(async () => await RestoreAsset(asset.Id, asset.Name))">
                                    Atkurti
                                </MudButton>
                            </div>
                        }
                    </MudItem>
                }
                @if (!_assets.Any())
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.body1" Class="pa-4" Style="color:#9ca3af">
                            Nėra asset'ų. Sukurkite pirmąjį paspaudę "Naujas asset'as".
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-3" Elevation="0" Style="background:#f8fafc; border-radius:8px">
            <div class="d-flex align-center gap-2">
                <MudSwitch @bind-value="_showArchived" Color="Color.Default" Label="Rodyti archyvuotus" />
            </div>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public int BrandId { get; set; }
    private string _brandName = "";
    private List<ArtworkAssetWithSummary> _assets = new();
    private bool _isLoading = true;
    private bool _showArchived = false;
    private bool _prevShowArchived = false;
    private bool _isAdmin;

    protected override async Task OnParametersSetAsync()
    {
        var user = await AuthService.GetAuthenticatedUserAsync();
        _isAdmin = user?.Role == "Admin";
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _showArchived != _prevShowArchived)
        {
            _prevShowArchived = _showArchived;
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var brand = await ArtworkService.GetBrandByIdAsync(BrandId);
            _brandName = brand?.Name ?? "Nežinoma";
            _assets = await ArtworkService.GetAssetsByBrandAsync(BrandId, _showArchived);
            _prevShowArchived = _showArchived;
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klaida įkeliant įrašus: " + ex.Message, Severity.Error);
        }
        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task NavigateToAsset(int id)
    {
        NavigationManager.NavigateTo($"/artwork/asset/{id}");
    }

    private async Task OpenCreateAsset()
    {
        var result = await DialogService.ShowAsync<AssetCreateDialog>(
            "Naujas asset'as",
            new DialogParameters { { "BrandId", BrandId } },
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true, MaxWidth = MaxWidth.Small });

        var dialogResult = await result.Result;
        if (dialogResult?.Data is int assetId)
        {
            await LoadDataAsync();
            NavigationManager.NavigateTo($"/artwork/asset/{assetId}");
        }
        else
        {
            await LoadDataAsync();
        }
    }

    private async Task RestoreAsset(int assetId, string assetName)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Patvirtinti atkūrimą",
            $"Ar tikrai norite atkurti \"{assetName}\"? Jis vėl bus rodomas galerijoje ir brand puslapyje.",
            yesText: "Atkurti",
            cancelText: "Atšaukti");

        if (confirmed != true) return;

        var userId = await AuthService.GetUserIdAsync();
        if (userId.HasValue)
        {
            await ArtworkService.RestoreAssetAsync(assetId, userId.Value);
            Snackbar.Add($"\"{assetName}\" sėkmingai atkurtas", Severity.Success);
            await LoadDataAsync();
        }
    }


    private string GetAssetCardStyle(ArtworkAssetWithSummary asset)
    {
        if (asset.Status == "archived")
            return "border-radius:12px; background:#f3f4f6; opacity:0.7;";
        return "border-radius:12px;";
    }

    private string GetAssetTypeLabel(string? type) => type switch
    {
        "label" => "Etiketė",
        "brochure" => "Brošiūra",
        "box" => "Dėžė",
        "sticker" => "Lipdukas",
        _ => type ?? "Kitas"
    };
}
