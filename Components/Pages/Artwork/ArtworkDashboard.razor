@page "/artwork"
@rendermode InteractiveServer
@using NordicBeesERP.Services.Artwork
@using MudBlazor
@inject IArtworkService ArtworkService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Artwork</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">Artwork modulis</MudText>
    </div>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }
    else
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
            <MudGrid>
                @foreach (var brand in _brands)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <div @onclick="@(async () => await NavigateToBrand(brand.Id))" style="cursor:pointer">
                            <MudPaper Class="pa-3 mb-3" Elevation="1" Style="border-radius:12px">
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.h6">@brand.Name</MudText>
                                    @if (brand.PendingCount > 0)
                                    {
                                        <MudChip T="int" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                                            @brand.PendingCount
                                        </MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="mt-1">
                                    @brand.AssetsCount įrašai
                                </MudText>
                            </MudPaper>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

@code {
    private List<ArtworkBrandWithCounts> _brands = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            _brands = await ArtworkService.GetBrandsWithCountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klaida įkeliant prekių ženklus: " + ex.Message, Severity.Error);
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task NavigateToBrand(int id)
    {
        NavigationManager.NavigateTo($"/artwork/brand/{id}");
    }
}
