@using Microsoft.JSInterop
@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" />
            <MudText Typo="Typo.h6">Atmetimo komentaras</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @ref="_commentField" @bind-Value="@_comment"
                      Label="Priežastis"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      MinRows="3"
                      MaxRows="6"
                      AdornmentIcon="@Icons.Material.Filled.Edit"
                      Adornment="Adornment.Start"
                      @onkeydown="HandleKeyDown" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelAsync">Atšaukti</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmAsync" StartIcon="@Icons.Material.Filled.Send">Siųsti</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string InitialComment { get; set; } = "";
    
    private MudTextField<string> _commentField = default!;
    private string _comment = "";
    private bool _isFirstRender = true;

    protected override void OnParametersSet()
    {
        _comment = InitialComment;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _isFirstRender)
        {
            _isFirstRender = false;
            await Task.Delay(100);
            await _commentField.FocusAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e?.Key == "Enter" && !e.ShiftKey)
        {
            await JSRuntime.InvokeVoidAsync("eval", "event.preventDefault()");
            ConfirmAsync();
        }
        else if (e?.Key == "Escape")
        {
            await JSRuntime.InvokeVoidAsync("eval", "event.preventDefault()");
            CancelAsync();
        }
    }

    private void ConfirmAsync()
    {
        MudDialog.Close(DialogResult.Ok(_comment));
    }

    private void CancelAsync()
    {
        MudDialog.Cancel();
    }
}
