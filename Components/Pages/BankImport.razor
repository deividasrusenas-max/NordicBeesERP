@page "/bank-import"
@rendermode InteractiveServer
@inject IPaymentService PaymentService
@inject IExpenseService ExpenseService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDbContextFactory<NordicBeesERPContext> DbContextFactory
@using NordicBeesERP.Services
@using NordicBeesERP.Services.Dtos
@using NordicBeesERP.Models
@using NordicBeesERP.Data
@using NordicBeesERP.Helpers
@using MudBlazor
@implements IDisposable

<PageTitle>Įplaukų banko importas</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.h5" Class="mb-4">Įplaukų banko importas</MudText>
        
        @if (_showList)
        {
            <MudTable T="BankImportViewModel" Items="@_bankImports" Hover="true" Dense="true" Loading="@_loading" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh>Data</MudTh>
                    <MudTh>Failas</MudTh>
                    <MudTh>Iš viso</MudTh>
                    <MudTh>Susieta</MudTh>
                    <MudTh>Nesusieta</MudTh>
                    <MudTh>Statusas</MudTh>
                    <MudTh>Veiksmai</MudTh>
                </HeaderContent>
                <RowTemplate Context="import">
                    <MudTd DataLabel="Data">@import.ImportDate.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd DataLabel="Failas">@import.FileName</MudTd>
                    <MudTd DataLabel="Iš viso">@import.TotalRows</MudTd>
                    <MudTd DataLabel="Susieta">@import.MatchedRows</MudTd>
                    <MudTd DataLabel="Nesusieta">@import.UnmatchedRows</MudTd>
                    <MudTd DataLabel="Statusas">
                        <MudChip T="string" Color="@StatusDisplayHelper.GetColor((import.Status ?? "").ToLower(), _statusDisplay)" Size="Size.Small">@StatusDisplayHelper.GetLabel((import.Status ?? "").ToLower(), _statusDisplay)</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Veiksmai">
                        <MudTooltip Text="Peržiūrėti">
                            <MudIconButton OnClick="@(async () => await ViewImport(import.Id))" Color="Color.Secondary" Icon="@Icons.Material.Filled.Visibility" />
                        </MudTooltip>
                        @if (import.Status == "pending" || import.Status == "processing")
                        {
                            <MudTooltip Text="Tęsti">
                                <MudIconButton OnClick="@(async () => await ContinueImport(import.Id))" Color="Color.Primary" Icon="@Icons.Material.Filled.Edit" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="async () => await StartImport()" Icon="@Icons.Material.Filled.FileUpload">Importuoti naują</MudButton>
            </MudStack>
        }
        else if (_showWizard)
        {
            <InputFile id="bankFileInput" OnChange="OnInputFileChange" accept=".xml" style="display:none" />
            @if (_wizardStep == 0)
            {
                <MudText Typo="Typo.h6" Class="mb-3">1 žingsnis: Failo įkėlimas</MudText>
                <MudText Class="mb-3">Įkelkite banko išrašų CAMT053 XML failą</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AttachFile"
                           OnClick="@(() => JS.InvokeVoidAsync("triggerClick", "bankFileInput"))">
                    @(_selectedFile != null ? _importFileName : "Pasirinkti failą")
                </MudButton>
                @if (_selectedFile is not null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-2">
                        ✓ @_selectedFile.Name (@FormatFileSize(_selectedFile.Size))
                    </MudText>
                }
                <MudTextField @bind-Value="_importDescription" Label="Aprašymas (neprivaloma)"
                              Variant="Variant.Outlined" Class="mt-3" />
                <MudStack Row="true" Class="mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="async () => await UploadFile()"
                               Disabled="@(_selectedFile == null)">Tęsti →</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="CancelWizard">Atšaukti</MudButton>
                </MudStack>
            }
            else if (_wizardStep == 1)
            {
                <MudText Typo="Typo.h6" Class="mb-3">2 žingsnis: Susiejimas</MudText>
                <MudText Class="mb-3">Susiekite banko išrašus su sąskaitomis</MudText>
                @if (_bankImportType != "expense")
                {
                    <MudTable T="BankImportRowViewModel" Items="@(_importRows.Where(r => r.Amount > 0).ToList())" Hover="true" Dense="true" Loading="@_rowsLoading">
                        <HeaderContent>
                            <MudTh>Sąskaita</MudTh>
                            <MudTh>Data</MudTh>
                            <MudTh>Tipas</MudTh>
                            <MudTh>Suma</MudTh>
                            <MudTh>Aprašymas</MudTh>
                            <MudTh>Referencė</MudTh>
                            <MudTh>Klientas</MudTh>
                            <MudTh>Susieti</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd DataLabel="Sąskaita">@row.Id</MudTd>
                            <MudTd DataLabel="Data">@row.RowDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="Tipas">@row.Description</MudTd>
                            <MudTd DataLabel="Suma" Style="@(row.Amount > 0 ? "color:green;font-weight:bold" : "color:red;font-weight:bold")">@row.Amount.ToString("N2") €</MudTd>
                            <MudTd DataLabel="Aprašymas">@row.Description</MudTd>
                            <MudTd DataLabel="Referencė">@row.Reference</MudTd>
                            <MudTd DataLabel="Klientas">@row.PayerName</MudTd>
                            <MudTd DataLabel="Susieti">
                                <MudAutocomplete T="InvoiceWithPaymentInfo" Label="Sąskaita"
                                    Value="@(FindInvoiceById(row.MatchedInvoiceId))"
                                    SearchFunc="@SearchUnmatchedInvoices"
                                    ToStringFunc="@(i => i == null ? "" : $"{i.InvoiceNumber} - {i.CustomerName} ({i.RemainingAmount:N2} €)")"
                                    ValueChanged="@(async (InvoiceWithPaymentInfo? inv) => await OnRowMatchChanged(row, inv))"
                                    Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                    ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="false"
                                    MinCharacters="1" DebounceInterval="300" Clearable="true" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                @if (_bankImportType != "income")
                {
                    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Išlaidos (debetinės operacijos)</MudText>
                    @if (_importRows.Any(r => r.Amount < 0))
                    {
                        <MudTable T="BankImportRowViewModel" Items="@(_importRows.Where(r => r.Amount < 0).ToList())" Hover="true" Dense="true">
                            <HeaderContent>
                                <MudTh>Data</MudTh>
                                <MudTh>Suma</MudTh>
                                <MudTh>Aprašymas</MudTh>
                                <MudTh>Referencė</MudTh>
                                <MudTh>Gavėjas</MudTh>
                                <MudTh>Susieti su išlaidų sąskaita</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="expRow">
                                <MudTd DataLabel="Data">@expRow.RowDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd DataLabel="Suma" Style="color:red;font-weight:bold">@expRow.Amount.ToString("N2") €</MudTd>
                                <MudTd DataLabel="Aprašymas">@expRow.Description</MudTd>
                                <MudTd DataLabel="Referencė">@expRow.Reference</MudTd>
                                <MudTd DataLabel="Gavėjas">@expRow.PayerName</MudTd>
                                <MudTd DataLabel="Susieti su išlaidų sąskaita">
                                    <MudAutocomplete T="NordicBeesERP.Models.Expenses.ExpenseInvoice" Label="Išlaidų sąskaita"
                                        Value="@(FindExpenseInvoiceById(expRow.MatchedExpenseInvoiceId))"
                                        SearchFunc="@SearchUnmatchedExpenseInvoices"
                                        ToStringFunc="@(i => i == null ? "" : $"{i.InvoiceNumber} — {(i.PendingSupplierName ?? "Tiekėjas")} ({i.AmountInclVat:N2} €)")"
                                        ValueChanged="@(async (NordicBeesERP.Models.Expenses.ExpenseInvoice? inv) => await OnExpenseRowMatchChanged(expRow, inv?.Id))"
                                        Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                        ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="false"
                                        MinCharacters="1" DebounceInterval="300" Clearable="true" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Nėra debetinių operacijų šiame faile</MudText>
                    }
                }
            }
            else if (_wizardStep == 2)
            {
                <MudText Typo="Typo.h6" Class="mb-3">3 žingsnis: Mokėjimų kūrimas</MudText>
                <MudText Class="mb-3">Sukurti mokėjimus iš sutapdintų išrašų</MudText>
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    Bus sukurti mokėjimai tik tiems išrašams, kurie sėkmingai sutapdyti su sąskaitomis.
                </MudAlert>
                <MudPaper Class="pa-3 mb-3" Elevation="0" Style="background:#f8fafc; border-radius:8px">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText Typo="Typo.body2">Sutapdyta eilučių:</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.body2" TextAlignment="TextAlignment.Right">@_visibleMatchedRowsCount</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.body2">Bus sukurtų mokėjimų:</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.body2" TextAlignment="TextAlignment.Right">@_visibleMatchedRowsCount</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
                <MudStack Row="true" Class="mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               OnClick="async () => await CreatePayments()" Disabled="@_creatingPayments">
                        Sukurti mokėjimus
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="CancelWizard">Atšaukti</MudButton>
                </MudStack>
            }
        }
        else if (_showView)
        {
            <MudPaper Class="pa-3 mb-3" Elevation="0" Style="background:#f8fafc; border-radius:8px">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body2">Importo data:</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body2" TextAlignment="TextAlignment.Right">@_currentImport?.ImportDate.ToString("yyyy-MM-dd HH:mm")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body2">Failas:</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body2" TextAlignment="TextAlignment.Right">@_currentImport?.FileName</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body2">Būsena:</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body2" TextAlignment="TextAlignment.Right">
                            <MudChip T="string" Color="@StatusDisplayHelper.GetColor((_currentImport?.Status ?? "").ToLower(), _statusDisplay)" Size="Size.Small">@StatusDisplayHelper.GetLabel((_currentImport?.Status ?? "").ToLower(), _statusDisplay)</MudChip>
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            
            <MudTable T="BankImportRowViewModel" Items="@_importRows" Hover="true" Dense="true" Loading="@_rowsLoading">
                <HeaderContent>
                    <MudTh>Sąskaita</MudTh>
                    <MudTh>Data</MudTh>
                    <MudTh>Suma</MudTh>
                    <MudTh>Aprašymas</MudTh>
                    <MudTh>Referencė</MudTh>
                    <MudTh>Klientas</MudTh>
                    <MudTh>Sutapdinta</MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd DataLabel="Sąskaita">@row.Id</MudTd>
                    <MudTd DataLabel="Data">@row.RowDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Suma">@row.Amount.ToString("N2") €</MudTd>
                    <MudTd DataLabel="Aprašymas">@(row.Description ?? "")</MudTd>
                    <MudTd DataLabel="Referencė">@(row.Reference ?? "")</MudTd>
                    <MudTd DataLabel="Klientas">@(row.PayerName ?? "")</MudTd>
                    <MudTd DataLabel="Sutapdinta">
                        @if (row.MatchedInvoiceId.HasValue)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">@row.MatchedInvoiceNumber</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="async () => await ShowListAsync()">Grįžti į sąrašą</MudButton>
            </MudStack>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _showList = true;
    private bool _showWizard = false;
    private bool _showView = false;
    private int _wizardStep = 0;
    private bool _disposed = false;
    
    private List<BankImportViewModel> _bankImports = new();
    private List<BankImportRowViewModel> _importRows = new();
    private List<BankImportRowViewModel> _parsedRows = new();
    private List<InvoiceWithPaymentInfo> _unmatchedInvoices = new();
    private List<InvoiceWithPaymentInfo> _searchableInvoices = new();
    private List<NordicBeesERP.Models.Expenses.ExpenseInvoice> _unmatchedExpenseInvoices = new();
    private string? _pendingHash;
    
    private BankImportViewModel? _currentImport;
    private IBrowserFile? _selectedFile;
    private string? _importDescription;
    private string? _importFileName;
    private int _importId;
    
    private bool _loading = true;
    private bool _rowsLoading = false;
    private bool _savingMatches = false;
    private bool _creatingPayments = false;
    
    private int _matchedRowsCount = 0;
    
    // URL query-string parameter for entry-point filtering
    [SupplyParameterFromQuery(Name = "type")]
    public string? BankImportType { get; set; }
    
    private string? _bankImportType;
    
    private int _visibleMatchedRowsCount => _bankImportType switch
    {
        "income" => _importRows.Count(r => r.Amount > 0 && r.MatchedInvoiceId.HasValue),
        "expense" => _importRows.Count(r => r.Amount < 0 && r.MatchedExpenseInvoiceId.HasValue),
        _ => _matchedRowsCount
    };
    
    protected override async Task OnInitializedAsync()
    {
        await LoadImportsAsync();
    }
    
    protected override void OnParametersSet()
    {
        _disposed = false;
        _bankImportType = BankImportType;
    }
    
    public void Dispose()
    {
        _disposed = true;
    }
    
    private async Task LoadImportsAsync()
    {
        _loading = true;
        try
        {
            var imports = await PaymentService.GetBankImportsAsync();
            _bankImports = imports.Select(i => new BankImportViewModel
            {
                Id = i.Id,
                ImportDate = i.ImportDate,
                FileName = i.FileName,
                TotalRows = i.TotalRows,
                MatchedRows = i.MatchedRows,
                UnmatchedRows = i.UnmatchedRows,
                ProcessedRows = i.ProcessedRows,
                Status = i.Status,
                 CreatedByName = i.CreatedBy.ToString(),
                CreatedAt = i.CreatedAt
            }).ToList();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Snackbar.Add("Klaida įkeliant banko išrašus", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
    
    private static readonly Dictionary<string, (string Label, Color Color)> _statusDisplay = new()
    {
        ["pending"] = ("Laukiama", Color.Info),
        ["completed"] = ("Atlikta", Color.Success),
        ["failed"] = ("Klaida", Color.Error),
        ["processing"] = ("Vykdoma", Color.Warning),
        ["needs_review"] = ("Reikia peržiūrėti", Color.Warning),
    };
    
    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
    
    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _importFileName = e.File.Name;
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task UploadFile()
    {
        if (_selectedFile is null)
        {
            Snackbar.Add("Pasirinkite failą", Severity.Warning);
            return;
        }

        _rowsLoading = true;
        try
        {
            using var memStream = new MemoryStream();
            using (var fileStream = _selectedFile.OpenReadStream(1024 * 1024 * 10))
            {
                await fileStream.CopyToAsync(memStream);
            }
            var bytes = memStream.ToArray();

            using var sha256 = System.Security.Cryptography.SHA256.Create();
            _pendingHash = Convert.ToHexString(sha256.ComputeHash(bytes)).ToLowerInvariant();

            using var ctxCheck = DbContextFactory.CreateDbContext();
            var existing = await ctxCheck.BankImports.FirstOrDefaultAsync(b => b.FileHash == _pendingHash);
            if (existing != null)
            {
                Snackbar.Add($"Šis failas jau importuotas {existing.ImportDate:yyyy-MM-dd}", Severity.Warning);
                return;
            }

            memStream.Position = 0;
            _parsedRows = Camt053BankStatementParser.Parse(memStream, _selectedFile.Name);

            if (_parsedRows.Count == 0)
            {
                Snackbar.Add("Faile nerasta eilučių", Severity.Warning);
                return;
            }

            _unmatchedInvoices = await PaymentService.GetUnpaidInvoicesAsync();

            using var ctxExp = DbContextFactory.CreateDbContext();
            _unmatchedExpenseInvoices = await ctxExp.ExpenseInvoices
                .Where(e => e.Status != "PAID" && e.Status != "APPROVED_PAID" && e.Status != "PENDING_SUPPLIER")
                .OrderBy(e => e.DueDate)
                .ToListAsync();

            int matchedCount = 0;
            foreach (var row in _parsedRows.Where(r => r.Reference != null &&
                (r.Reference.StartsWith("LAK", StringComparison.OrdinalIgnoreCase) ||
                 r.Reference.StartsWith("ULAK", StringComparison.OrdinalIgnoreCase))))
            {
                var refNormalized = row.Reference.Trim();
                var matchedInvoice = _unmatchedInvoices
                    .FirstOrDefault(i => i.InvoiceNumber.Trim().Equals(refNormalized, StringComparison.OrdinalIgnoreCase));
                if (matchedInvoice != null)
                {
                    row.MatchedInvoiceId = matchedInvoice.Id;
                    row.MatchedInvoiceNumber = matchedInvoice.InvoiceNumber;
                    row.MatchStatus = "auto_match_pending";
                    matchedCount++;
                }
            }

            _matchedRowsCount = matchedCount;
            _importRows = _parsedRows;
            _wizardStep = 1;
            _showWizard = true;
            _showList = false;
            await InvokeAsync(StateHasChanged);
            Snackbar.Add($"Failas sėkmingai įkeltas ({_parsedRows.Count} įrašų)", Severity.Success);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Snackbar.Add($"Klaida įkeliant failą: {ex.Message}", Severity.Error);
        }
        finally
        {
            _rowsLoading = false;
        }
    }


    private async Task SaveBankImportRowAsync(BankImportRowViewModel rowViewModel)
    {
        using var context = DbContextFactory.CreateDbContext();
        
        var row = new BankImportRow
        {
            ImportId = _importId,
            RowDate = rowViewModel.RowDate,
            Amount = rowViewModel.Amount,
            Description = rowViewModel.Description,
            Reference = rowViewModel.Reference,
            PayerName = rowViewModel.PayerName,
            PayerAccount = rowViewModel.PayerAccount,
            BankRef = rowViewModel.BankRef,
            MatchStatus = rowViewModel.MatchStatus,
            CreatedAt = DateTime.UtcNow
        };
        
        context.BankImportRows.Add(row);
        await context.SaveChangesAsync();
        
        rowViewModel.Id = row.Id;
    }
    
    private async Task OnRowMatchChanged(BankImportRowViewModel row, InvoiceWithPaymentInfo? inv)
    {
        if (inv != null)
        {
            row.MatchedInvoiceId = inv.Id;
            row.MatchedInvoiceNumber = inv.InvoiceNumber;
            row.MatchStatus = "manual_match";
            _matchedRowsCount++;
        }
        else
        {
            row.MatchedInvoiceId = null;
            row.MatchedInvoiceNumber = null;
            row.MatchStatus = "unmatched";
            _matchedRowsCount--;
        }
    }

    private async Task OnExpenseRowMatchChanged(BankImportRowViewModel row, int? invoiceId)
    {
        row.MatchedExpenseInvoiceId = invoiceId;
        row.MatchStatus = invoiceId.HasValue ? "manual_match_expense" : "unmatched";
        await InvokeAsync(StateHasChanged);
    }

    private InvoiceWithPaymentInfo? FindInvoiceById(int? id)
    {
        if (!id.HasValue) return null;
        return _unmatchedInvoices.FirstOrDefault(i => i.Id == id.Value)
            ?? _searchableInvoices.FirstOrDefault(i => i.Id == id.Value);
    }

    private async Task<IEnumerable<InvoiceWithPaymentInfo>> SearchUnmatchedInvoices(string term, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(term))
            return _unmatchedInvoices.Take(20);

        var results = await PaymentService.SearchAllInvoicesAsync(term, 20);
        foreach (var inv in results)
        {
            if (!_searchableInvoices.Any(x => x.Id == inv.Id))
                _searchableInvoices.Add(inv);
        }
        return results;
    }

    private NordicBeesERP.Models.Expenses.ExpenseInvoice? FindExpenseInvoiceById(int? id)
    {
        if (!id.HasValue) return null;
        return _unmatchedExpenseInvoices.FirstOrDefault(i => i.Id == id.Value);
    }

    private Task<IEnumerable<NordicBeesERP.Models.Expenses.ExpenseInvoice>> SearchUnmatchedExpenseInvoices(string term, CancellationToken ct)
    {
        IEnumerable<NordicBeesERP.Models.Expenses.ExpenseInvoice> result;
        if (string.IsNullOrWhiteSpace(term))
            result = _unmatchedExpenseInvoices.Take(20);
        else
            result = _unmatchedExpenseInvoices
                .Where(i => i.InvoiceNumber.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                             (i.PendingSupplierName != null && i.PendingSupplierName.Contains(term, StringComparison.OrdinalIgnoreCase)))
                .Take(20);
        return Task.FromResult(result);
    }
    
    private async Task SaveMatches()
    {
        _savingMatches = true;
        try
        {
            // Persist to DB now that user confirmed
            _importId = await PaymentService.CreateBankImportAsync(
                _importFileName ?? string.Empty,
                _pendingHash ?? string.Empty,
                _parsedRows.Count,
                1
            );

            // --- Transaction-level dedup: skip rows whose bank_ref already exists ---
            var dedupBankRefs = _parsedRows
                .Where(r => !string.IsNullOrEmpty(r.BankRef))
                .Select(r => r.BankRef!)
                .Distinct()
                .ToList();

            var existingBankRefs = new HashSet<string>();
            if (dedupBankRefs.Count > 0)
            {
                using var ctxDedup = DbContextFactory.CreateDbContext();
                var existingRows = await ctxDedup.BankImportRows
                    .Where(r => r.BankRef != null && dedupBankRefs.Contains(r.BankRef))
                    .Select(r => r.BankRef!)
                    .ToListAsync();
                existingBankRefs = new HashSet<string>(existingRows);
            }

            // Fallback: for rows with null BankRef, check date+amount+payer_account
            var duplicateIndices = new HashSet<int>();
            using (var ctxFallbackDedup = DbContextFactory.CreateDbContext())
            {
                for (int i = 0; i < _parsedRows.Count; i++)
                {
                    var r = _parsedRows[i];
                    if (!string.IsNullOrEmpty(r.BankRef))
                    {
                        // Primary dedup: bank_ref match
                        if (existingBankRefs.Contains(r.BankRef))
                            duplicateIndices.Add(i);
                    }
                    else
                    {
                        // Fallback dedup: date+amount+payer_account
                        var fallbackMatch = await ctxFallbackDedup.BankImportRows.AnyAsync(x =>
                            x.RowDate == r.RowDate &&
                            x.Amount == r.Amount &&
                            x.PayerAccount == r.PayerAccount &&
                            x.PayerAccount != null);
                        if (fallbackMatch)
                            duplicateIndices.Add(i);
                    }
                }
            }

            int skippedDuplicates = duplicateIndices.Count;

            int insertedCount = 0;
            for (int i = 0; i < _parsedRows.Count; i++)
            {
                if (duplicateIndices.Contains(i))
                    continue;

                _parsedRows[i].ImportId = _importId;
                await SaveBankImportRowAsync(_parsedRows[i]);
                insertedCount++;
            }

            // Write all matches (auto + manual) to DB and finalize status
            int matchedCount = 0;
            using var ctxMatch = DbContextFactory.CreateDbContext();
            foreach (var row in _parsedRows.Where(r => r.MatchedInvoiceId.HasValue && r.Id > 0))
            {
                // Don't overwrite needs_review status set by cross-check logic
                await ctxMatch.Database.ExecuteSqlRawAsync(
                    "UPDATE bank_import_rows SET matched_invoice_id = {0} WHERE id = {1} AND match_status != 'needs_review'",
                    row.MatchedInvoiceId!.Value, row.Id);
                matchedCount++;
            }

            using var ctxUpdate = DbContextFactory.CreateDbContext();
            await ctxUpdate.Database.ExecuteSqlRawAsync(
                "UPDATE bank_imports SET total_rows={0}, matched_rows={1}, unmatched_rows={2} WHERE id={3}",
                insertedCount,
                matchedCount,
                insertedCount - matchedCount,
                _importId);

            // Create expense payments for matched expense rows (with cross-check for existing manual payments)
            foreach (var row in _parsedRows.Where(r => r.MatchedExpenseInvoiceId.HasValue && r.Id > 0))
            {
                using var ctxExpDedup = DbContextFactory.CreateDbContext();
                var existingManualExpensePayments = await ctxExpDedup.ExpensePayments
                    .Where(p => p.InvoiceId == row.MatchedExpenseInvoiceId!.Value
                             && p.Source == "manual"
                             && p.BankConfirmed == false)
                    .ToListAsync();

                if (existingManualExpensePayments.Count == 1)
                {
                    var existing = existingManualExpensePayments[0];
                    if (existing.Amount == Math.Abs(row.Amount))
                    {
                        // CASE 1: Link to existing manual payment
                        await ctxExpDedup.Database.ExecuteSqlRawAsync(
                            "UPDATE expense_payments SET bank_confirmed = 1, bank_import_row_id = {0}, bank_import_id = {1} WHERE id = {2}",
                            row.Id, _importId, existing.Id);

                        // Recalculate expense invoice status (confirmed in ExpenseService: RecalculateInvoiceStatusAsync)
                        await ExpenseService.RecalculateInvoiceStatusAsync(existing.InvoiceId);
                        continue;
                    }
                    else
                    {
                        // CASE 2: Amount mismatch → needs_review
                        await ctxExpDedup.Database.ExecuteSqlRawAsync(
                            "UPDATE bank_import_rows SET match_status = {0}, updated_at = CURRENT_TIMESTAMP WHERE id = {1}",
                            "needs_review", row.Id);
                        continue;
                    }
                }
                else if (existingManualExpensePayments.Count > 1)
                {
                    // CASE 4: Ambiguous → needs_review
                    await ctxExpDedup.Database.ExecuteSqlRawAsync(
                        "UPDATE bank_import_rows SET match_status = {0}, updated_at = CURRENT_TIMESTAMP WHERE id = {1}",
                        "needs_review", row.Id);
                    continue;
                }

                // CASE 3: No matching manual payments → create new bank_import payment (existing behavior)
                var payment = new NordicBeesERP.Models.Expenses.ExpensePayment
                {
                    InvoiceId = row.MatchedExpenseInvoiceId!.Value,
                    PaymentDate = row.RowDate,
                    Amount = Math.Abs(row.Amount),
                    PaymentMethod = "BANK",
                    Source = "bank_import",
                    BankImportRowId = row.Id,
                    Reference = row.Reference ?? "",
                    Notes = $"Banko importas: {row.Description}"
                };
                await ExpenseService.AddPaymentAsync(payment);
            }

            _matchedRowsCount = matchedCount;
            _wizardStep = 2;
            var dedupMsg = skippedDuplicates > 0
                ? $", {skippedDuplicates} dublikatai praleisti"
                : "";
            Snackbar.Add($"Susiejimai išsaugoti ({insertedCount} eilutės{dedupMsg})", Severity.Success);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Snackbar.Add("Klaida išsaugant sutapdinimus", Severity.Error);
        }
        finally
        {
            _savingMatches = false;
        }
    }
    
    private async Task CreatePayments()
    {
        _creatingPayments = true;
        try
        {
            int paymentsCreated = 0;
            int errors = 0;
            
            // If _importId lost, find latest import
            if (_importId == 0)
            {
                using var ctx2 = DbContextFactory.CreateDbContext();
                var latest = await ctx2.BankImports.OrderByDescending(b => b.Id).FirstOrDefaultAsync();
                if (latest != null) _importId = latest.Id;
            }
            
            // Read matched rows directly from DB
            using var context = DbContextFactory.CreateDbContext();
            var matchedRows = await context.BankImportRows
                .Where(r => r.ImportId == _importId && r.MatchedInvoiceId != null)
                .ToListAsync();
            
            Snackbar.Add($"_importId={_importId}, matched={matchedRows.Count}", Severity.Info);
            
            foreach (var row in matchedRows)
            {
                try
                {
                    await PaymentService.CreatePaymentFromBankImportAsync(row.Id, 1);
                    paymentsCreated++;
                }
                catch (InvalidOperationException ex) when (ex.Message.Contains("jau apmokėta iš banko importo"))
                {
                    // Invoice already paid - skip without counting as error
                    Snackbar.Add($"Sąskaita jau apmokėta - praleidžiama", Severity.Info);
                    continue;
                }
                catch (NeedsReviewException ex)
                {
                    // needs_review — flagged by cross-check, needs manual review
                    Snackbar.Add($"Sąskaitai {ex.InvoiceId} reikia rankinio patikrinimo ({ex.ManualPaymentCount} mokėjimas(-ai))", Severity.Warning);
                    continue;
                }
                catch (Exception ex)
                {
                    errors++;
                    Snackbar.Add($"Klaida: {ex.Message}", Severity.Warning);
                }
            }
            
            // Refresh import data
            await LoadImportsAsync();
            
            // Update bank_imports status to completed after payments created
            using var ctxDone = DbContextFactory.CreateDbContext();
            await ctxDone.Database.ExecuteSqlRawAsync(
                "UPDATE bank_imports SET status='completed', processed_rows={0}, matched_rows={1} WHERE id={2}",
                paymentsCreated,
                paymentsCreated,
                _importId);
            
            await ShowListAsync();
            Snackbar.Add($"Sukurta {paymentsCreated} mokėjimų", Severity.Success);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Snackbar.Add("Klaida kuriant mokėjimus", Severity.Error);
        }
        finally
        {
            _creatingPayments = false;
        }
    }
    
    private async Task ShowListAsync()
    {
        _showList = true;
        _showWizard = false;
        _showView = false;
        _wizardStep = 0;
        _importRows.Clear();
        _currentImport = null;
        var imports = await PaymentService.GetBankImportsAsync();
        _bankImports = imports.Select(i => new BankImportViewModel
        {
            Id = i.Id,
            ImportDate = i.ImportDate,
            FileName = i.FileName,
            TotalRows = i.TotalRows,
            MatchedRows = i.MatchedRows,
            UnmatchedRows = i.UnmatchedRows,
            ProcessedRows = i.ProcessedRows,
            Status = i.Status,
             CreatedByName = i.CreatedBy.ToString(),
            CreatedAt = i.CreatedAt
        }).ToList();
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task ViewImport(int importId)
    {
        _showView = true;
        _showList = false;
        _showWizard = false;
        
        try
        {
            var import = await PaymentService.GetBankImportWithRowsAsync(importId);
            if (import is not null)
            {
                _currentImport = new BankImportViewModel
                {
                    Id = import.Id,
                    ImportDate = import.ImportDate,
                    FileName = import.FileName,
                    TotalRows = import.TotalRows,
                    MatchedRows = import.MatchedRows,
                    UnmatchedRows = import.UnmatchedRows,
                    ProcessedRows = import.ProcessedRows,
                    Status = import.Status,
                     CreatedByName = import.CreatedBy.ToString(),
                    CreatedAt = import.CreatedAt
                };
                
                _importRows = import.Rows.Select(r => new BankImportRowViewModel
                {
                    Id = r.Id,
                    ImportId = r.ImportId,
                    RowDate = r.RowDate,
                    Amount = r.Amount,
                    Currency = r.Currency,
                    Description = r.Description,
                    Reference = r.Reference,
                    PayerName = r.PayerName,
                    PayerAccount = r.PayerAccount,
                    MatchStatus = r.MatchStatus,
                    MatchedInvoiceId = r.MatchedInvoiceId,
                    MatchedInvoiceNumber = r.MatchedInvoiceId.HasValue ? $"S-{r.MatchedInvoiceId.Value}" : null
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Snackbar.Add("Klaida įkeliant importo duomenis", Severity.Error);
        }
    }
    
    private async Task ContinueImport(int importId)
    {
        try
        {
            await ViewImport(importId);
            
            // Load unmatched invoices for matching
            _unmatchedInvoices = await PaymentService.GetUnpaidInvoicesAsync();
            _searchableInvoices = new List<InvoiceWithPaymentInfo>();
            
            _wizardStep = 1;
            _showWizard = true;
            _showView = false;
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Snackbar.Add("Klaida tęsiant importą", Severity.Error);
        }
    }
    
    private async Task CancelWizard()
    {
        if (_importId > 0)
        {
            using var ctx = DbContextFactory.CreateDbContext();
            await ctx.Database.ExecuteSqlRawAsync(
                "DELETE FROM bank_import_rows WHERE import_id = {0}", _importId);
            await ctx.Database.ExecuteSqlRawAsync(
                "DELETE FROM bank_imports WHERE id = {0}", _importId);
            _importId = 0;
        }
        _parsedRows.Clear();
        _showWizard = false;
        _showList = true;
        _wizardStep = 0;
        _importRows.Clear();
        _currentImport = null;
    }
    
    private async Task StartImport()
    {
        _selectedFile = null;
        _importFileName = null;
        _importDescription = string.Empty;
        _importRows = new List<BankImportRowViewModel>();
        _parsedRows = new List<BankImportRowViewModel>();
        _unmatchedInvoices = new List<InvoiceWithPaymentInfo>();
        _searchableInvoices = new List<InvoiceWithPaymentInfo>();
        _matchedRowsCount = 0;
        _importId = 0;
        _pendingHash = null;
        _wizardStep = 0;
        _showWizard = true;
        _showList = false;
    }
}
