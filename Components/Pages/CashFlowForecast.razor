@page "/payments/forecast"
@rendermode InteractiveServer
@inject IPaymentService PaymentService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using NordicBeesERP.Services
@using NordicBeesERP.Services.Dtos
@using NordicBeesERP.Components.Dialogs
@using Dtos = NordicBeesERP.Services.Dtos
@using MudBlazor
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Įplaukų srautas</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <MudText Typo="Typo.h5" Class="mb-4">Įplaukų srautas</MudText>

    <!-- Toggle buttons row -->
    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="mb-4">
        <MudButton Color="@(_days==7?Color.Primary:Color.Default)" OnClick="@(()=>SetDays(7))">7 dienų</MudButton>
        <MudButton Color="@(_days==30?Color.Primary:Color.Default)" OnClick="@(()=>SetDays(30))">30 dienų</MudButton>
        <MudButton Color="@(_days==90?Color.Primary:Color.Default)" OnClick="@(()=>SetDays(90))">90 dienų</MudButton>
    </MudButtonGroup>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <!-- 3 KPI Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="1" Class="pa-4" Style="background:#dcfce7; border-radius:12px; cursor:pointer" @onclick="OpenThisWeekDetail">
                    <MudText Typo="Typo.caption">Per @_days dienų</MudText>
                    <MudText Typo="Typo.h4">@_nextPeriodExclVat.ToString("N2") €</MudText>
                    <MudText Typo="Typo.caption">PVM: @_nextPeriodVat.ToString("N2") €</MudText>
                    <MudText Typo="Typo.caption">Su PVM: @_nextPeriodInclVat.ToString("N2") €</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="1" Class="pa-4" Style="background:#fee2e2; border-radius:12px; cursor:pointer" @onclick="OpenOverdueDetail">
                    <MudText Typo="Typo.caption" Color="Color.Error">Pradelsta</MudText>
                    <MudText Typo="Typo.h4">@_overdueExclVat.ToString("N2") €</MudText>
                    <MudText Typo="Typo.caption">PVM: @_overdueVat.ToString("N2") €</MudText>
                    <MudText Typo="Typo.caption">Su PVM: @_overdueInclVat.ToString("N2") €</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="1" Class="pa-4" Style="background:#dbeafe; border-radius:12px; cursor:pointer" @onclick="OpenAllDetail">
                    <MudText Typo="Typo.caption">Viso laukiama</MudText>
                    <MudText Typo="Typo.h4">@_totalExpectedExclVat.ToString("N2") €</MudText>
                    <MudText Typo="Typo.caption">PVM: @_totalExpectedVat.ToString("N2") €</MudText>
                    <MudText Typo="Typo.caption">Su PVM: @_totalExpectedInclVat.ToString("N2") €</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Chart.js Bar Chart -->
        @if (_chartData.Count > 0)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Laukiamų įplaukų grafikas</MudText>
                <canvas id="cashFlowChart" style="max-height:280px;width:100%"></canvas>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-2 mb-4">
                <MudStack Row="true" Class="mt-2" Justify="Justify.Center">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <div style="width:12px;height:12px;background:#ef4444;border-radius:2px"></div>
                        <MudText Typo="Typo.caption">Pradelsta</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <div style="width:12px;height:12px;background:#2563eb;border-radius:2px"></div>
                        <MudText Typo="Typo.caption">Ši savaitė</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <div style="width:12px;height:12px;background:#93c5fd;border-radius:2px"></div>
                        <MudText Typo="Typo.caption">Ateitis</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        <!-- Upcoming invoices table -->
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Artimiausi mokėjimai</MudText>
        <MudPaper Elevation="1" Class="pa-0">
        <MudTable T="InvoiceWithPaymentInfo" Items="@_upcomingInvoices.Take(10).ToList()" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>Sąskaita</MudTh>
                <MudTh>Klientas</MudTh>
                <MudTh Style="text-align:right">Suma (€)</MudTh>
                <MudTh Style="text-align:center">Terminas</MudTh>
                <MudTh Style="text-align:center">Liko</MudTh>
            </HeaderContent>
            <RowTemplate Context="inv">
                <MudTd><MudLink Href="@($"/invoices/{inv.Id}")">@inv.InvoiceNumber</MudLink></MudTd>
                <MudTd>@inv.CustomerName</MudTd>
                <MudTd Style="text-align:right">@inv.RemainingAmount.ToString("N2") €</MudTd>
                <MudTd Style="text-align:center">@(inv.DueDate.HasValue ? inv.DueDate.Value.ToString("yyyy-MM-dd") : "-")</MudTd>
                <MudTd Style="text-align:center">
                @{
                    var d = inv.DueDate.HasValue ? (inv.DueDate.Value.Date - DateTime.Today).Days : (int?)null;
                    var lbl = d == null ? "-" : d == 0 ? "Šiandien" : d > 0 ? $"-{d}d." : $"+{Math.Abs(d.Value)}d.";
                    var clr = d == null ? "#9ca3af" : d < 0 ? "#ef4444" : d <= 7 ? "#f97316" : "#16a34a";
                }
                <MudText Style="@($"color:{clr};font-weight:600")">@lbl</MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
        </MudPaper>
    }

    <div style="height:48px"></div>
</MudContainer>

@code {
    private int _days = 30;
    private decimal _nextPeriodExclVat = 0m;
    private decimal _nextPeriodVat = 0m;
    private decimal _nextPeriodInclVat = 0m;
    private decimal _overdueExclVat = 0m;
    private decimal _overdueVat = 0m;
    private decimal _overdueInclVat = 0m;
    private decimal _totalExpectedExclVat = 0m;
    private decimal _totalExpectedVat = 0m;
    private decimal _totalExpectedInclVat = 0m;
    private List<Dtos.InvoiceWithPaymentInfo> _upcomingInvoices = new List<Dtos.InvoiceWithPaymentInfo>();
    private List<Dtos.InvoiceWithPaymentInfo> _overdueInvoices = new List<Dtos.InvoiceWithPaymentInfo>();
    private List<Dtos.InvoiceWithPaymentInfo> _allUnpaidInvoices = new List<Dtos.InvoiceWithPaymentInfo>();
    private List<(string Label, decimal Amount, bool IsPast, bool IsCurrentWeek)> _chartData = new();
    private bool _loading = true;
    private bool _disposed = false;
    private int _chartWidth = 800;
    private int _chartHeight = 200;
    private int _barWidth = 50;
    private double _maxAmount = 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartData.Any())
            await JS.InvokeVoidAsync("renderCashFlowChart",
                _chartData.Select(d => d.Label).ToArray(),
                _chartData.Select(d => (double)d.Amount).ToArray(),
                _chartData.Select(d => d.IsPast ? "#ef4444" : d.IsCurrentWeek ? "#2563eb" : "#93c5fd").ToArray());
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override void OnParametersSet()
    {
        _disposed = false;
    }

    public void Dispose()
    {
        _disposed = true;
    }

    private async Task SetDays(int days)
    {
        _days = days;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var today = DateTime.Today;
            var futureDate = today.AddDays(_days);
            
            // Calculate chart dimensions
            _maxAmount = _chartData.Any() ? (double)_chartData.Max(d => d.Amount) : 1;
            _chartWidth = 800;
            _chartHeight = 200;
            _barWidth = _chartData.Count > 0 ? (_chartWidth - 60) / _chartData.Count - 8 : 50;

            // Get all unpaid invoices for KPI calculation (includes future AND overdue)
            _allUnpaidInvoices = (await PaymentService.GetUnpaidInvoicesAsync())
                .Where(i => i.RemainingAmount > 0 && i.PaymentStatus != "paid")
                .ToList();

            // Get all unpaid invoices for display
            var allInvoices = await PaymentService.GetSalesInvoicesAsync();
            _upcomingInvoices = allInvoices.Invoices
                .Where(i => i.PaymentStatus != "paid")
                .ToList();

            // FIX 2: Load overdue invoices if null or empty
            if (_overdueInvoices == null || _overdueInvoices.Count == 0)
            {
                _overdueInvoices = (await PaymentService.GetUnpaidInvoicesAsync())
                    .Where(i => i.DueDate.HasValue && i.DueDate.Value.Date < DateTime.Today)
                    .ToList();
            }

            // Card 1: Per @_days dienų - use proportional SubtotalExclVat and TotalVat from allUnpaidInvoices filtered by date range
            var rangeEnd = today.AddDays(_days);
            var nextPeriodInvoices = _allUnpaidInvoices
                .Where(i => i.DueDate.HasValue 
                    && i.DueDate.Value.Date >= today 
                    && i.DueDate.Value.Date <= rangeEnd)
                .ToList();
            _nextPeriodExclVat = nextPeriodInvoices.Sum(i => 
                i.TotalInclVat > 0 ? i.RemainingAmount * i.SubtotalExclVat / i.TotalInclVat : 0);
            _nextPeriodVat = nextPeriodInvoices.Sum(i => 
                i.TotalInclVat > 0 ? i.RemainingAmount * i.TotalVat / i.TotalInclVat : 0);
            _nextPeriodInclVat = nextPeriodInvoices.Sum(i => i.RemainingAmount);

            // Card 2: Pradelsta - use proportional SubtotalExclVat and TotalVat from overdueInvoices
            _overdueExclVat = _overdueInvoices.Sum(i => 
                i.TotalInclVat > 0 ? i.RemainingAmount * i.SubtotalExclVat / i.TotalInclVat : 0);
            _overdueVat = _overdueInvoices.Sum(i => 
                i.TotalInclVat > 0 ? i.RemainingAmount * i.TotalVat / i.TotalInclVat : 0);
            _overdueInclVat = _overdueInvoices.Sum(i => i.RemainingAmount);

            // Card 3: Viso laukiama - use proportional SubtotalExclVat and TotalVat from all unpaid invoices ONLY
            var allExcl = _allUnpaidInvoices.Sum(i => i.TotalInclVat > 0 ? i.RemainingAmount * i.SubtotalExclVat / i.TotalInclVat : 0);
            var allVat = _allUnpaidInvoices.Sum(i => i.TotalInclVat > 0 ? i.RemainingAmount * i.TotalVat / i.TotalInclVat : 0);
            var allIncl = _allUnpaidInvoices.Sum(i => i.RemainingAmount);
            _totalExpectedExclVat = allExcl;
            _totalExpectedVat = allVat;
            _totalExpectedInclVat = allIncl;

            // Build chart data
            _chartData = new();

            // Add overdue bar
            var overdueSum = _overdueInvoices?.Sum(i => i.RemainingAmount) ?? 0;
            if (overdueSum > 0)
                _chartData.Add(("Pradelsta", overdueSum, true, false));

            // Group future invoices by week
            for (int w = 0; w < (_days / 7) + 1; w++)
            {
                var weekStart = today.AddDays(w * 7);
                var weekEnd = weekStart.AddDays(6);
                var label = weekStart.ToString("dd.MM") + "-" + weekEnd.ToString("dd.MM");
                var sum = _upcomingInvoices
                    .Where(i => i.DueDate.HasValue && i.DueDate.Value.Date >= weekStart && i.DueDate.Value.Date <= weekEnd)
                    .Sum(i => i.RemainingAmount);
                _chartData.Add((label, sum, false, w == 0));
            }
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Snackbar.Add($"Klaida įkeliant mokėjimų srautą: {ex.Message}", Severity.Error);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenThisWeekDetail()
    {
        var invoices = _upcomingInvoices
            .Where(i => i.DueDate.HasValue && i.DueDate.Value.Date >= DateTime.Today && i.DueDate.Value.Date <= DateTime.Today.AddDays(_days))
            .ToList();
        var parameters = new DialogParameters
        {
            ["BucketLabel"] = $"Per {_days} dienų",
            ["Invoices"] = invoices
        };
        await DialogService.ShowAsync<AgingDetailDialog>("Skolos", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = true });
    }

    private async Task OpenOverdueDetail()
    {
        var parameters = new DialogParameters
        {
            ["BucketLabel"] = "Pradelsta",
            ["Invoices"] = _overdueInvoices ?? new()
        };
        await DialogService.ShowAsync<AgingDetailDialog>("Skolos", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = true });
    }

    private async Task OpenAllDetail()
    {
        var all = _allUnpaidInvoices ?? new();
        var parameters = new DialogParameters
        {
            ["BucketLabel"] = "Viso laukiama",
            ["Invoices"] = all
        };
        await DialogService.ShowAsync<AgingDetailDialog>("Skolos", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = true });
    }
}