@page "/credit-notes/new"
@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using NordicBeesERP.Services.Dtos
@using MudBlazor
@inject ICreditNoteService _creditNoteService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IAuthService _authService
@inject IInvoiceService InvoiceService

<PageTitle>Nauja kreditinė sąskaita</PageTitle>

<!-- HEADER (sticky, outside MudContainer) -->
<div style="position:sticky; top:64px; z-index:100; background:#ffffff; padding:12px 0; border-bottom:1px solid #e2e8f0;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="d-flex justify-space-between align-center">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight:600">@_creditNoteNumber</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Nauja kreditinė sąskaita</MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none" StartIcon="@Icons.Material.Filled.Save" OnClick="@SaveCreditNote" Disabled="@_invoiceFullyCredited">Išsaugoti</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Style="text-transform:none" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="@SaveAndGeneratePdf" Disabled="@_invoiceFullyCredited">Išsaugoti + PDF</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="@Cancel">Atšaukti</MudButton>
        </div>
    </MudContainer>
</div>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@(_errorMessage ?? "")</MudAlert>
    }

    @if (_selectedInvoice != null && _invoiceFullyCredited)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Ši sąskaita jau yra visiškai sucreditinta. Negalima sukurti naujos kreditinės sąskaitos.
        </MudAlert>
    }
    else if (_selectedInvoice != null && _lines.Any(l => l.AlreadyCredited > 0))
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">
            Ši sąskaita yra dalinai sucreditinta. Rodomas likęs kiekis, kuris dar gali būti creditintas.
        </MudAlert>
    }

    <!-- PAGRINDINĖ INFORMACIJA section -->
    <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px" Class="mb-4">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Pagrindinė informacija</MudText>
        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudTextField T="string" Label="Kreditinės sąskaitos numeris *" Value="@_creditNoteNumber"
                              ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Data *" Date="@_creditDate" Editable="true" DateFormat="yyyy-MM-dd"
                               Variant="Variant.Outlined" Required="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudAutocomplete T="InvoiceSelectDto" Label="Originali sąskaita *" Value="@_selectedInvoice"
                                 SearchFunc="@SearchInvoices" ToStringFunc="@(i => i == null ? "" : $"{i.InvoiceNumber} ({i.InvoiceDate:yyyy-MM-dd}) - {i.TotalInclVat:F2}€")"
                                 ValueChanged="@OnInvoiceSelected"
                                 Variant="Variant.Outlined" Required="true" Clearable="true"
                                 Placeholder="Pasirinkite sąskaitą..." Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField T="string" Label="Klientas" @bind-Value="_customerName"
                              Variant="Variant.Outlined" ReadOnly="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="Kalba" @bind-Value="_language" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("LT")">LT</MudSelectItem>
                    <MudSelectItem T="string" Value="@("EN")">EN</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- EILUČIŲ LENTELĖ section -->
    <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px" Class="mb-4">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Eilutės</MudText>
        <MudTable T="CreditNoteLineModel" Items="@_lines" Hover="true" Dense="true" Bordered="true">
            <HeaderContent>
                <MudTh Style="width: 5%;">Nr.</MudTh>
                <MudTh Style="width: 30%;">Aprašymas</MudTh>
                <MudTh Style="width: 9%;">Orig.kiekis</MudTh>
                <MudTh Style="width: 10%;">Jau kredituota</MudTh>
                <MudTh Style="width: 12%;">Kreditinis kiekis</MudTh>
                <MudTh Style="width: 12%;">Kaina (be PVM)</MudTh>
                <MudTh Style="width: 8%;">PVM %</MudTh>
                <MudTh Style="width: 12%;">Suma</MudTh>
            </HeaderContent>
            <RowTemplate Context="line">
                <MudTd DataLabel="Nr.">@(_lines.IndexOf(line) + 1)</MudTd>
                <MudTd DataLabel="Aprašymas">
                    <MudTextField T="string" Value="@line.Description" Variant="Variant.Text"
                                  Margin="Margin.Dense" ReadOnly="true" />
                </MudTd>
                <MudTd DataLabel="Orig.kiekis">
                    <MudText>@(line.OriginalQuantity % 1 == 0 ? ((int)line.OriginalQuantity).ToString() : line.OriginalQuantity.ToString("F2"))</MudText>
                </MudTd>
                <MudTd DataLabel="Jau kredituota">
                    <MudText>@(line.AlreadyCredited % 1 == 0 ? ((int)line.AlreadyCredited).ToString() : line.AlreadyCredited.ToString("F2"))</MudText>
                </MudTd>
                <MudTd DataLabel="Kreditinis kiekis">
                    <MudNumericField T="decimal" Value="@line.CreditQuantity" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Min="0" Max="@line.RemainingQuantity" Step="0.001M" Format="0.####" HideSpinButtons="true"
                                     ValueChanged="@((decimal val) => { line.CreditQuantity = Math.Min(val, line.RemainingQuantity); line.IsChecked = line.CreditQuantity > 0; CalculateLine(line); })" />
                </MudTd>
                <MudTd DataLabel="Kaina (be PVM)">
                    <MudNumericField T="decimal" Value="@line.PriceExclVat" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Step="0.01M" Format="0.####"
                                     ValueChanged="@((decimal val) => { line.PriceExclVat = val; line.IsChecked = true; CalculateLine(line); })" />
                </MudTd>
                <MudTd DataLabel="PVM %">
                    <MudNumericField T="decimal" Value="@line.VatRate" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Min="0" Step="1M" Format="F0"
                                     ValueChanged="@((decimal val) => { line.VatRate = val; line.IsChecked = true; CalculateLine(line); })" />
                </MudTd>
                <MudTd DataLabel="Suma">
                    <MudTextField T="string" Value="@FormatAmountHelper.FormatSignedAmount(line.LineTotal)" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" @key="(line, 2)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <!-- TOTALS section -->
    <div style="display:flex; justify-content:flex-end; margin-top:8px;">
        <div style="background:#eff6ff; border-radius:8px; padding:16px; min-width:280px;">
            <div class="d-flex justify-space-between gap-4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Suma be PVM:</MudText>
                <MudText Typo="Typo.body2">@FormatAmountHelper.FormatSignedAmount(_subtotalExclVat) €</MudText>
            </div>
            <div class="d-flex justify-space-between gap-4 mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">PVM:</MudText>
                <MudText Typo="Typo.body2">@FormatAmountHelper.FormatSignedAmount(_totalVat) €</MudText>
            </div>
            <MudDivider Class="my-2" />
            <div class="d-flex justify-space-between gap-4">
                <MudText Typo="Typo.body1" Style="font-weight:600">Iš viso:</MudText>
                <MudText Typo="Typo.body1" Style="font-weight:600">@FormatAmountHelper.FormatSignedAmount(_totalInclVat) €</MudText>
            </div>
        </div>
    </div>

</MudContainer>

@code {
    private List<InvoiceSelectDto> _invoices = new();
    private List<CreditNoteLineModel> _lines = new();
    
    private string _creditNoteNumber = string.Empty;
    private DateTime _creditDate = DateTime.Today;
    private InvoiceSelectDto? _selectedInvoice;
    private string _customerName = string.Empty;
    private string _language = "LT";
    private decimal _subtotalExclVat;
    private decimal _totalVat;
    private decimal _totalInclVat;
    
    private string? _errorMessage;
    private bool _invoiceFullyCredited;

    [SupplyParameterFromQuery(Name = "invoiceId")]
    public int? InvoiceId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Generate default credit note number
            _creditNoteNumber = await _creditNoteService.GetNextCreditNoteNumberAsync(_creditDate);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Klaida kraunant duomenis: {ex.Message}";
        }

        // Prefill from ?invoiceId=<id> if provided
        if (InvoiceId.HasValue)
        {
            try
            {
                var invoice = await InvoiceService.GetInvoiceWithDetailsAsync(InvoiceId.Value);
                if (invoice != null)
                {
                    var dto = new InvoiceSelectDto
                    {
                        Id = invoice.Id,
                        InvoiceNumber = invoice.InvoiceNumber,
                        InvoiceDate = invoice.InvoiceDate,
                        TotalInclVat = invoice.TotalInclVat,
                        RemainingBalance = invoice.TotalInclVat - invoice.PaidAmount,
                        CustomerName = invoice.Customer?.Name ?? string.Empty,
                        CustomerId = invoice.CustomerId,
                        CustomerDefaultLanguage = invoice.Customer?.DefaultLanguage
                    };
                    await OnInvoiceSelected(dto);
                }
            }
            catch
            {
                // Fail silently - user can still pick an invoice manually
            }
        }
    }

    private async Task<IEnumerable<InvoiceSelectDto>> SearchInvoices(string term, CancellationToken cancellationToken)
    {
        return await _creditNoteService.SearchInvoicesForCreditNoteAsync(term, 0, 20, cancellationToken);
    }

    private async Task OnInvoiceSelected(InvoiceSelectDto? invoice)
    {
        if (invoice == null)
        {
            _lines.Clear();
            _subtotalExclVat = 0;
            _totalVat = 0;
            _totalInclVat = 0;
            _customerName = string.Empty;
            StateHasChanged();
            return;
        }

        _selectedInvoice = invoice;
        _customerName = invoice.CustomerName ?? string.Empty;
        // Auto-select credit note language from customer default (mirrors InvoiceCreate.razor OnClientSelected)
        var lang = invoice.CustomerDefaultLanguage?.Trim().ToUpperInvariant();
        if (lang is "LT" or "EN")
        {
            _language = lang;
        }
        // Get invoice lines
        var lines = await _creditNoteService.GetInvoiceLinesAsync(invoice.Id);
        var creditedQuantities = await _creditNoteService.GetCreditedQuantitiesByInvoiceLineAsync(invoice.Id);

        _lines = lines.Select(l =>
        {
            var alreadyCredited = creditedQuantities.TryGetValue(l.Id, out var qty) ? qty : 0m;
            var remaining = Math.Max(0m, l.Quantity - alreadyCredited);
            return new CreditNoteLineModel
            {
                InvoiceLineId = l.Id,
                Description = l.Description,
                OriginalQuantity = l.Quantity,
                AlreadyCredited = alreadyCredited,
                CreditQuantity = remaining,
                PriceExclVat = l.PriceExclVat == 0m ? 0m : -l.PriceExclVat,
                VatRate = l.VatRate,
                LineTotal = l.LineTotal == 0m ? 0m : -l.LineTotal,
                IsChecked = remaining > 0
            };
        }).ToList();

        _invoiceFullyCredited = _lines.All(l => l.RemainingQuantity <= 0);

        CalculateTotals();

        StateHasChanged();
    }

    private void CalculateLine(CreditNoteLineModel line)
    {
        var subtotal = line.CreditQuantity * line.PriceExclVat;
        var vatAmount = subtotal * (line.VatRate / 100m);
        line.LineTotal = subtotal + vatAmount;
        
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        _subtotalExclVat = _lines.Where(l => l.IsChecked).Sum(l => l.CreditQuantity * l.PriceExclVat);
        _totalVat = _lines.Where(l => l.IsChecked).Sum(l => l.CreditQuantity * l.PriceExclVat * (l.VatRate / 100m));
        _totalInclVat = _subtotalExclVat + _totalVat;
    }

    private async Task SaveCreditNote()
    {
        if (_selectedInvoice == null)
        {
            _errorMessage = "Pasirinkite originalią sąskaitą";
            return;
        }

        if (!_lines.Any())
        {
            _errorMessage = "Pridėkite bent vieną eilutę";
            return;
        }

        var request = new CreateCreditNoteRequest
        {
            OriginalInvoiceId = _selectedInvoice.Id,
            CreditDate = _creditDate,
            Language = _language,
            Lines = _lines.Where(l => l.IsChecked).Select(l => new CreditNoteLineRequest
            {
                InvoiceLineId = l.InvoiceLineId,
                Quantity = l.CreditQuantity
            }).ToList()
        };

        try
        {
            var userId = await _authService.GetUserIdAsync();
            var creditNote = await _creditNoteService.CreateCreditNoteAsync(request, userId!.Value);
            Snackbar.Add("Kreditinė sąskaita išsaugota", Severity.Success);
            Navigation.NavigateTo($"/credit-notes/{creditNote.Id}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Klaida: {ex.Message}";
        }
    }

    private async Task SaveAndGeneratePdf()
    {
        if (_selectedInvoice == null)
        {
            _errorMessage = "Pasirinkite originalią sąskaitą";
            return;
        }

        if (!_lines.Any())
        {
            _errorMessage = "Pridėkite bent vieną eilutę";
            return;
        }

        var request = new CreateCreditNoteRequest
        {
            OriginalInvoiceId = _selectedInvoice.Id,
            CreditDate = _creditDate,
            Language = _language,
            Lines = _lines.Where(l => l.IsChecked).Select(l => new CreditNoteLineRequest
            {
                InvoiceLineId = l.InvoiceLineId,
                Quantity = l.CreditQuantity
            }).ToList()
        };

        try
        {
            var userId = await _authService.GetUserIdAsync();
            var creditNote = await _creditNoteService.CreateCreditNoteAsync(request, userId!.Value);

            Snackbar.Add("Kreditinė sąskaita išsaugota ir PDF generuojamas", Severity.Success);
            Navigation.NavigateTo($"/credit-notes/pdf/{creditNote.Id}", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Klaida: {ex.Message}";
        }
    }

    private void Cancel()
    {
        if (InvoiceId.HasValue)
        {
            Navigation.NavigateTo($"/invoices/{InvoiceId.Value}");
        }
        else
        {
            Navigation.NavigateTo("/invoices/sales?type=KLAK");
        }
    }

    private string GetQuantityFormat(decimal quantity)
    {
        return quantity % 1 == 0 ? "F0" : "F2";
    }

    public class CreditNoteLineModel
    {
        public int InvoiceLineId { get; set; }
        public string Description { get; set; } = string.Empty;
        public decimal OriginalQuantity { get; set; }
        public decimal AlreadyCredited { get; set; }
        public decimal CreditQuantity { get; set; }
        public decimal PriceExclVat { get; set; }
        public decimal VatRate { get; set; }
        public decimal LineTotal { get; set; }
        public bool IsChecked { get; set; } = true;

        public decimal RemainingQuantity => Math.Max(0m, OriginalQuantity - AlreadyCredited);
    }
}
