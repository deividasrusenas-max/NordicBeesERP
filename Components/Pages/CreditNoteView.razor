@page "/credit-notes/{Id:int}"

@using NordicBeesERP.Services.Dtos
@using NordicBeesERP.Helpers

@* =====================================================
   NORDIC BEES ERP - VIEW CREDIT NOTE PAGE
   Framework: .NET 10
   Modern Clean ERP Style (Xero/QuickBooks inspired)
   ===================================================== *@
@inject ICreditNoteService CreditNoteService
@inject IAuthService _authService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Sąskaitos peržiūra</PageTitle>

<!-- HEADER SECTION -->
<div style="position:sticky; top:0; z-index:100; background:#ffffff; padding:16px 0 12px 0; border-bottom:1px solid #e2e8f0; margin-bottom:16px;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <div class="d-flex flex-column gap-3">
            <!-- One line: credit note number (Typo.h5, Color.Primary, font-weight:600) + status chip inline -->
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudText Typo="Typo.h5" Style="font-weight:600" Color="Color.Primary">@_creditNote?.CreditNoteNumber</MudText>
                @if (_creditNote is not null)
                {
                    <MudChip T="string" Color="StatusDisplayHelper.GetColor(_creditNote.Status.ToString(), _statusDisplay)" Variant="Variant.Outlined">@StatusDisplayHelper.GetLabel(_creditNote.Status.ToString(), _statusDisplay)</MudChip>
                }
            </div>

            <!-- Second line: customer name (Typo.body1, Color.Secondary) -->
            @if (_creditNote is not null)
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary">Klientas: @_creditNote.CustomerName</MudText>
            }

            <!-- Action buttons row -->
            <div class="d-flex flex-wrap gap-2 align-center">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@HandleBack" Style="text-transform:none">
                    Atgal
                </MudButton>
                @if (_creditNote?.Status == CreditNoteStatus.Draft)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@NavigateToEditCreditNote" Style="text-transform:none">
                        Redaguoti
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@HandleDeleteCreditNote" StartIcon="@Icons.Material.Filled.Delete" Style="text-transform:none">
                        Trinti
                    </MudButton>
                }

                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@NavigateToPdf" StartIcon="@Icons.Material.Filled.Print" Style="text-transform:none">
                    Spausdinti
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@HandleCopy" StartIcon="@Icons.Material.Filled.ContentCopy" Style="text-transform:none">
                    Kopijuoti
                </MudButton>
            </div>
        </div>
    </MudContainer>
</div>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @if (_creditNote is not null)
    {
        <!-- INFO CARDS -->
        <MudGrid Class="mt-4" Spacing="3" Style="align-items:stretch;">
            <!-- Left card: Customer Information -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-4"
                          Style="background:#eff6ff; border-radius:8px; border-left:4px solid #2563eb; padding:16px; height:100%;">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3" Style="font-weight:600">Klientas</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Klientas:</MudText>
                        </MudItem>
                        <MudItem xs="7">
                            <MudText Typo="Typo.body1">@(_creditNote?.CustomerName ?? "")</MudText>
                        </MudItem>
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">El. paštas:</MudText>
                        </MudItem>
                        <MudItem xs="7">
                            <MudText Typo="Typo.body1">@(_creditNote?.CustomerEmail ?? "")</MudText>
                        </MudItem>
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Telefonas:</MudText>
                        </MudItem>
                        <MudItem xs="7">
                            <MudText Typo="Typo.body1">@(_creditNote?.CustomerPhone ?? "")</MudText>
                        </MudItem>
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Adresas:</MudText>
                        </MudItem>
                        <MudItem xs="7">
                            <MudText Typo="Typo.body1">@(_creditNote?.CustomerAddress ?? "")</MudText>
                        </MudItem>
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Mokėjimo sąlygos:</MudText>
                        </MudItem>
                        <MudItem xs="7">
                            <MudText Typo="Typo.body1">@((_creditNote?.PaymentTermDays ?? 0) > 0 ? $"{_creditNote?.PaymentTermDays} dienų" : "-")</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <!-- Right card: Credit Note Details -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-4"
                          Style="background:#f5f3ff; border-radius:8px; border-left:4px solid #7c3aed; padding:16px; height:100%;">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3" Style="font-weight:600">Kreditinės sąskaitos duomenys</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Kreditinės sąskaitos data:</MudText>
                        </MudItem>
                        <MudItem xs="7">
                            <MudText Typo="Typo.body1">@(_creditNote?.CreditDate.ToString("yyyy-MM-dd") ?? "")</MudText>
                        </MudItem>
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Kredituojama sąskaita:</MudText>
                        </MudItem>
                        <MudItem xs="7">
                            <MudText Typo="Typo.body1">@(_creditNote?.OriginalInvoiceNumber ?? "")</MudText>
                        </MudItem>
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Valiuta:</MudText>
                        </MudItem>
                        <MudItem xs="7">
                            <MudText Typo="Typo.body1">EUR</MudText>
                        </MudItem>
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">PVM reverse charge:</MudText>
                        </MudItem>
                        <MudItem xs="7">
                            <MudText Typo="Typo.body1">@((_creditNote?.ReverseCharge ?? false) ? "Taikoma" : "Ne")</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- CREDIT NOTE LINES TABLE -->
        <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-3 pa-3"
                  Style="background:#f8fafc; border-radius:8px;">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1" Style="font-weight:600">Prekių sąrašas</MudText>

            @if (_creditNoteLines is not null && _creditNoteLines.Any())
            {
                <MudTable T="CreditNoteLineDto" Items="@_creditNoteLines" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Nr</MudTh>
                        <MudTh>Aprašymas</MudTh>
                        <MudTh Class="text-center">Kiekis</MudTh>
                        <MudTh Class="text-center">Vnt</MudTh>
                        <MudTh Class="text-right">Kaina</MudTh>
                        <MudTh Class="text-center">PVM%</MudTh>
                        <MudTh Class="text-right">Suma</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="line">
                         <MudTd>@line.LineNumber</MudTd>
                        <MudTd>
                             @(line?.Description ?? line?.ProductCode ?? "")
                        </MudTd>
                         <MudTd Class="text-center">@(line?.Quantity ?? 0)</MudTd>
                         <MudTd Class="text-center">@(line?.Unit ?? "")</MudTd>
                          <MudTd Class="text-right">@FormatAmountHelper.FormatAmount(line?.PriceExclVat ?? 0m)</MudTd>
                         <MudTd Class="text-center">@((line?.VatRate ?? 0m).ToString("F1"))%</MudTd>
                          <MudTd Class="text-right">@FormatAmountHelper.FormatAmount(line?.LineTotal ?? 0m)</MudTd>
                    </RowTemplate>
                </MudTable>
                <div class="d-flex flex-column align-end pa-4" style="gap:4px;">
                    <div class="d-flex gap-4">
                        <MudText Typo="Typo.body2" Class="font-weight-bold">Suma be PVM:</MudText>
                        <MudText Typo="Typo.body2" Class="font-weight-bold" Style="min-width:100px; text-align:right;">@FormatAmountHelper.FormatAmount(-(_creditNote?.SubtotalExclVat ?? 0m)) €</MudText>
                    </div>
                    <div class="d-flex gap-4">
                        <MudText Typo="Typo.body2" Class="font-weight-bold">PVM:</MudText>
                        <MudText Typo="Typo.body2" Class="font-weight-bold" Style="min-width:100px; text-align:right;">@FormatAmountHelper.FormatAmount(-(_creditNote?.TotalVat ?? 0m)) €</MudText>
                    </div>
                     <MudDivider Class="my-1" Style="width:250px;" />
                     <div class="d-flex gap-4">
                         <MudText Typo="Typo.h6" Class="font-weight-bold">Iš viso:</MudText>
                         <MudText Typo="Typo.h6" Class="font-weight-bold" Style="min-width:100px; text-align:right;">@FormatAmountHelper.FormatAmount(-(_creditNote?.TotalInclVat ?? 0m)) €</MudText>
                     </div>
                </div>
            }
            else
            {
                <div class="pa-4 text-center">
                    <MudText Color="Color.Secondary">Prekių sąrašas yra tuščias</MudText>
                </div>
            }
        </MudPaper>
    }
    else
    {
        <div class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" />
            <MudText Class="mt-2" Typo="Typo.subtitle1">Kreditinė sąskaita nerasta</MudText>
            <MudText Color="Color.Secondary">Kreditinės sąskaitos su ID @(_creditNote?.Id ?? Id) neaptikta</MudText>
            <MudButton OnClick='@(() => Navigation.NavigateTo("/invoices/sales?type=KLAK"))' Variant="Variant.Outlined" Color="Color.Default" Class="mt-3">
                Grįžti į kreditines sąskaitas
            </MudButton>
        </div>
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private CreditNoteDetailDto? _creditNote;
    private List<CreditNoteLineDto> _creditNoteLines = new List<CreditNoteLineDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadCreditNoteAsync();
    }

    private async Task LoadCreditNoteAsync()
    {
        _creditNote = await CreditNoteService.GetCreditNoteAsync(Id);
        if (_creditNote is not null)
        {
            _creditNoteLines = _creditNote.Lines;
        }
    }

    private static readonly Dictionary<string, (string Label, Color Color)> _statusDisplay = new()
    {
        ["Draft"] = ("Juodraštis", Color.Default),
        ["Printed"] = ("Atspausdinta", Color.Primary)
    };

    private void HandleBack()
    {
        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            Navigation.NavigateTo(Uri.UnescapeDataString(ReturnUrl));
        }
        else if (_creditNote?.OriginalInvoiceId.HasValue == true)
        {
            Navigation.NavigateTo($"/invoices/{_creditNote.OriginalInvoiceId}");
        }
        else
        {
            Navigation.NavigateTo("/invoices/sales?type=KLAK");
        }
    }


    private async Task HandleDeleteCreditNote()
    {
        await CreditNoteService.DeleteCreditNoteAsync(Id);
        Snackbar.Add("Kreditinė sąskaita pašalinta", Severity.Success);
        Navigation.NavigateTo("/credit-notes");
    }

    private void NavigateToEditCreditNote()
    {
        Navigation.NavigateTo($"/credit-notes/{Id}/edit", forceLoad: true);
    }

    private async Task NavigateToPdf()
    {
        // Mark as Printed before navigating to PDF page
        if (_creditNote?.Status == CreditNoteStatus.Draft)
        {
            await CreditNoteService.SetPrintedAsync(Id);
            _creditNote.Status = CreditNoteStatus.Printed;
            await InvokeAsync(StateHasChanged);
        }
        Navigation.NavigateTo($"/credit-notes/pdf/{Id}", forceLoad: true);
    }

    private async Task HandleCopy()
    {
        if (_creditNote is null) return;

        var source = await CreditNoteService.GetCreditNoteAsync(Id);
        if (source == null) return;

        var userId = await _authService.GetUserIdAsync();
        if (!userId.HasValue) return;

        // Create a new credit note request with the copied data
        var request = new CreateCreditNoteRequest
        {
            OriginalInvoiceId = source.OriginalInvoiceId ?? 0,
            CreditDate = DateTime.Now,
            Language = source.Language,
            Lines = source.Lines.Select(l => new CreditNoteLineRequest
            {
                InvoiceLineId = l.InvoiceLineId ?? 0,
                Quantity = l.Quantity
            }).ToList()
        };

        // Create a new credit note
        var newCreditNote = await CreditNoteService.CreateCreditNoteAsync(request, userId.Value);
        Navigation.NavigateTo($"/credit-notes/edit/{newCreditNote.Id}");
    }
}
