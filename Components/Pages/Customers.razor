@page "/customers"
@rendermode InteractiveServer
@inject ICustomerService CustomerService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NordicBeesERP.Components.Dialogs

<PageTitle>Klientai</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">Klientai</MudText>
        <MudButton OnClick="OpenCreateDialog"
                   StartIcon="@Icons.Material.Filled.Add"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Naujas klientas
        </MudButton>
    </div>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }
    else
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField Value="@_filterSearch"
                                  ValueChanged="@(async (string val) => { _filterSearch = val; await LoadCustomers(); })"
                                  Label="Paieška pagal pavadinimą arba kodą"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  FullWidth="true"
                                  Clearable="true"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Adornment="Adornment.Start" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
            @if (_customers == null || !_customers.Any())
            {
                <MudText Class="text-center py-4">Klientų nėra</MudText>
            }
            else
            {
                <MudTable Items="@FilteredCustomers"
                          Dense="true"
                          Hover="true"
                          Striped="true"
                          RowsPerPage="25"
                          Elevation="0"
                          Style="cursor:pointer"
                          OnRowClick="@(async (TableRowClickEventArgs<Customer> args) => await OnRowClick(args.Item))">
                    <HeaderContent>
                        <MudTh>Pavadinimas</MudTh>
                        <MudTh>Kodas</MudTh>
                        <MudTh>Miestas</MudTh>
                        <MudTh>Adresas</MudTh>
                        <MudTh>Telefonas</MudTh>
                        <MudTh>El. paštas</MudTh>
                        <MudTh>PVM</MudTh>
                        <MudTh>Mokėjimo terminas</MudTh>
                        <MudTh Style="width: 150px;">Veiksmai</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="customer">
                        <MudTd>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary"><strong>@(customer!.Name)</strong></MudText>
                        </MudTd>
                        <MudTd>
                            @if (!string.IsNullOrEmpty(customer!.CompanyCode))
                            {
                                <MudText Typo="Typo.caption">@customer!.CompanyCode</MudText>
                            }
                        </MudTd>
                        <MudTd>@(customer!.City)</MudTd>
                        <MudTd>@(customer!.Address)</MudTd>
                        <MudTd>@(customer!.Phone)</MudTd>
                        <MudTd>@(customer!.Email)</MudTd>
                        <MudTd>@(customer!.DefaultVatRate.ToString())%</MudTd>
                        <MudTd>@(customer!.PaymentTermDays) d.</MudTd>
                        <MudTd>
                            <div @onclick:stopPropagation="true">
                                <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => OpenEditDialog(customer!))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteCustomer(customer!))" />
                                </MudButtonGroup>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{25, 50, 100}" />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText Class="text-center py-4">Klientų nėra</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    private List<Customer> _customers = new();
    private bool _isLoading = false;
    private string? _filterSearch = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _isLoading = true;
        StateHasChanged();
        _customers = await CustomerService.GetCustomersAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private List<Customer> FilteredCustomers
    {
        get
        {
            if (string.IsNullOrEmpty(_filterSearch))
                return _customers;
            var search = _filterSearch.ToLower();
            return _customers.Where(c =>
                c.Name.ToLower().Contains(search) ||
                (!string.IsNullOrEmpty(c.CompanyCode) && c.CompanyCode.ToLower().Contains(search)) ||
                (!string.IsNullOrEmpty(c.VatCode) && c.VatCode.ToLower().Contains(search)) ||
                (!string.IsNullOrEmpty(c.City) && c.City.ToLower().Contains(search))).ToList();
        }
    }

    private async Task OnRowClick(Customer customer)
    {
        if (customer != null)
        {
            await OpenEditDialog(customer);
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { "Customer", new Customer() }
        };

        var dialog = await DialogService.ShowAsync<CustomerCreateDialog>("Naujas klientas", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is not null)
        {
            var savedCustomer = (Customer)result.Data;
            Snackbar.Add("Klientas sėkmingai sukurtas!", Severity.Success);
            await LoadCustomers();
        }
    }

    private async Task OpenEditDialog(Customer customer)
    {
        var parameters = new DialogParameters
        {
            { "Customer", customer }
        };

        var dialog = await DialogService.ShowAsync<CustomerCreateDialog>("Redaguoti klientą", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is not null)
        {
            var savedCustomer = (Customer)result.Data;
            Snackbar.Add("Klientas sėkmingai atnaujintas!", Severity.Success);
            await LoadCustomers();
        }
    }

    private async Task DeleteCustomer(Customer customer)
    {
        if (customer is null)
        {
            Snackbar.Add("Klaida: klientas nerastas!", Severity.Error);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            "Patvirtinti trynimą",
            $"Ar tikrai norite ištrinti klientą '{customer.Name}'? Šio veiksmo negalima atšaukti.",
            yesText: "Trinti",
            cancelText: "Atšaukti");

        if (confirmed != true) return;

        try
        {
            var deleted = await CustomerService.DeleteBusinessPartnerAsync(customer.Id);
            if (deleted)
            {
                Snackbar.Add("Klientas sėkmingai ištrintas!", Severity.Success);
                await LoadCustomers();
            }
            else
            {
                Snackbar.Add("Nepavyko ištrinti kliento: bandykite dar kartą", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klaida trinant: " + ex.Message, Severity.Error);
        }
    }
}