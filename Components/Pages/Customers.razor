@page "/customers"
@inject ICustomerService CustomerService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NordicBeesERP.Components.Dialogs
@using NordicBeesERP.Helpers
@using Microsoft.AspNetCore.Components.Authorization
<PageTitle>Klientai</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">Klientai</MudText>
        @if (_isAdmin || _isManager)
        {
            <MudButton OnClick="OpenCreateDialog"
                        StartIcon="@Icons.Material.Filled.Add"
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        Style="text-transform:none">
                Naujas klientas
            </MudButton>
        }
    </div>

    @if (_customers == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <StandardListFilterBar>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="Paieška (pavadinimas / kodas / PVM kodas)"
                    Value="_filterSearch"
                    ValueChanged="@(async (string val) => await UpdateFilterSearchAsync(val))"
                    Immediate="true" Clearable="true" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudChipSet T="string" @bind-Values="_selectedStatuses" OnValuesChanged="_ => ApplyFilters()" Variant="Variant.Outlined">
                    <MudChip Value="@("active")">Aktyvus</MudChip>
                    <MudChip Value="@("inactive")">Neaktyvus</MudChip>
                </MudChipSet>
            </MudItem>
        </MudGrid>
    </StandardListFilterBar>

    <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
        <MudTable Items="@FilteredCustomers"
                  Dense="true"
                  Hover="true"
                  RowsPerPage="25"
                  Elevation="0"
                  Style="cursor:pointer"
                  OnRowClick="@(async (TableRowClickEventArgs<Customer> args) => await OnRowClick(args.Item))">
            <HeaderContent>
                <MudTh>Pavadinimas</MudTh>
                <MudTh>Kodas</MudTh>
                <MudTh>PVM kodas</MudTh>
                <MudTh>PVM%</MudTh>
                <MudTh>Mokėjimo terminas</MudTh>
                <MudTh>Aktyvus</MudTh>
                <MudTh Style="width:120px;">Veiksmai</MudTh>
            </HeaderContent>
            <RowTemplate Context="customer">
                <MudTd>
                    <MudText Typo="Typo.body2">@customer!.Name</MudText>
                </MudTd>
                <MudTd>
                    @if (!string.IsNullOrEmpty(customer!.CompanyCode))
                    {
                        <MudText Typo="Typo.caption">@customer!.CompanyCode</MudText>
                    }
                </MudTd>
                <MudTd>@(customer!.VatCode)</MudTd>
                <MudTd Class="lakstena-mono">@customer!.DefaultVatRate.ToString("N0")%</MudTd>
                <MudTd Class="lakstena-mono">@(customer!.PaymentTermDays) d.</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(customer!.IsActive ? Color.Success : Color.Default)"
                             Variant="Variant.Outlined">
                        @(customer!.IsActive ? "Aktyvus" : "Neaktyvus")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <div @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OpenEditDialog(customer!))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteCustomer(customer!))" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    [CascadingParameter] Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // URL query-string parameters (synchronized with filter state)
    [SupplyParameterFromQuery]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusCsv { get; set; }

    private List<Customer>? _customers;
    private string _filterSearch = string.Empty;
    private HashSet<string> _selectedStatuses = new();
    private bool _isAdmin;
    private bool _isManager;
    private DateTime _lastClickTime = DateTime.MinValue;
    private object? _lastClickItem;

    private bool IsDoubleClick(object item)
    {
        var now = DateTime.Now;
        if (_lastClickItem == item && (now - _lastClickTime).TotalMilliseconds < 400)
        {
            _lastClickItem = null;
            return true;
        }
        _lastClickItem = item;
        _lastClickTime = now;
        return false;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Sync URL query params into working-state fields before loading data
        _filterSearch = Q ?? string.Empty;
        _selectedStatuses = FilterUrlBuilder.ParseStatusCsv(StatusCsv);

        var authState = await AuthStateTask;
        _isAdmin = authState.User.IsInRole("Admin");
        _isManager = authState.User.IsInRole("Manager");
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _customers = await CustomerService.GetCustomersAsync();
    }

    private void ApplyFilters()
    {
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", string.IsNullOrWhiteSpace(_filterSearch) ? null : _filterSearch),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses))));
    }

    private Task UpdateFilterSearchAsync(string val)
    {
        _filterSearch = val ?? string.Empty;
        ApplyFilters();
        return Task.CompletedTask;
    }

    private List<Customer> FilteredCustomers
    {
        get
        {
            var list = _customers ?? new List<Customer>();

            if (_selectedStatuses.Count > 0)
                list = list.Where(c => _selectedStatuses.Contains(c.IsActive ? "active" : "inactive")).ToList();

            if (string.IsNullOrWhiteSpace(_filterSearch))
                return list;

            return list.Where(c =>
                c.Name.Contains(_filterSearch, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrEmpty(c.CompanyCode) && c.CompanyCode.Contains(_filterSearch, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(c.VatCode) && c.VatCode.Contains(_filterSearch, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(c.City) && c.City.Contains(_filterSearch, StringComparison.OrdinalIgnoreCase))).ToList();
        }
    }

    private async Task OnRowClick(Customer customer)
    {
        if (customer != null && IsDoubleClick(customer))
        {
            await OpenEditDialog(customer);
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { "Customer", new Customer() }
        };

        var dialog = await DialogService.ShowAsync<CustomerCreateDialog>("Naujas klientas", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var savedCustomer = (Customer)result.Data;
            Snackbar.Add("Klientas sėkmingai sukurtas!", Severity.Success);
            await LoadCustomers();
        }
    }

    private async Task OpenEditDialog(Customer customer)
    {
        var fullPartner = await CustomerService.GetBusinessPartnerByIdAsync(customer.Id);
        if (fullPartner == null) { Snackbar.Add("Klaida: klientas nerastas!", Severity.Error); return; }

        var fullCustomer = new Customer
        {
            Id = fullPartner.Id,
            PartnerType = fullPartner.PartnerType.ToString(),
            Name = fullPartner.Name,
            CompanyCode = fullPartner.CompanyCode,
            VatCode = fullPartner.VatCode,
            Address = fullPartner.Address,
            City = fullPartner.City,
            PostalCode = fullPartner.PostalCode,
            Country = fullPartner.Country,
            CountryCode = fullPartner.CountryCode,
            Phone = fullPartner.Phone,
            Email = fullPartner.Email,
            BankAccount = fullPartner.BankAccount,
            PaymentTermDays = fullPartner.PaymentTermDays,
            DefaultLanguage = fullPartner.DefaultLanguage,
            DefaultVatRate = fullPartner.DefaultVatRate,
            Notes = fullPartner.Notes,
            IsActive = fullPartner.IsActive
        };

        var parameters = new DialogParameters
        {
            { "Customer", fullCustomer }
        };

        var dialog = await DialogService.ShowAsync<CustomerCreateDialog>("Redaguoti klientą", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var savedCustomer = (Customer)result.Data;
            Snackbar.Add("Klientas sėkmingai atnaujintas!", Severity.Success);
            await LoadCustomers();
        }
    }

    private async Task DeleteCustomer(Customer customer)
    {
        if (customer is null)
        {
            Snackbar.Add("Klaida: klientas nerastas!", Severity.Error);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            "Patvirtinti trynimą",
            $"Ar tikrai norite ištrinti klientą '{customer.Name}'? Šio veiksmo negalima atšaukti.",
            yesText: "Trinti",
            cancelText: "Atšaukti");

        if (confirmed != true) return;

        try
        {
            var deleted = await CustomerService.DeleteBusinessPartnerAsync(customer.Id);
            if (deleted)
            {
                Snackbar.Add("Klientas sėkmingai ištrintas!", Severity.Success);
                await LoadCustomers();
            }
        }
        catch (Exception ex) when (ex.InnerException?.Message.Contains("foreign key constraint") == true ||
                                    ex.Message.Contains("foreign key constraint") == true)
        {
            Snackbar.Add("Negalima ištrinti kliento — yra susijusių sąskaitų ar kitų įrašų. Pirmiau ištrinkite susijusius įrašus.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida trinant: {ex.Message}", Severity.Error);
        }
    }
}
