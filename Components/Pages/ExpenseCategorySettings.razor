@page "/settings/expense-categories"
@using NordicBeesERP.Components.Dialogs
@using NBEN = NordicBeesERP.Models.Expenses
@inject IDbContextFactory<NordicBeesERP.Data.NordicBeesERPContext> ContextFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Išlaidų kategorijos</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">Išlaidų kategorijos</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.Add" OnClick="AddNew">
            Pridėti naują
        </MudButton>
    </div>

    <!-- Save indicator -->
    @if (_saveIndicatorVisible)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check"
            Style="position:fixed; top:16px; right:16px; z-index:9999">
            Išsaugota
        </MudChip>
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }
    else
    {
        <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
            <MudTable T="NBEN.ExpenseCategory" Items="_items" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh>Pavadinimas</MudTh>
                    <MudTh>Kodas</MudTh>
                    <MudTh>Aktyvus</MudTh>
                    <MudTh Style="text-align:right">Rikiavimas</MudTh>
                    <MudTh Style="width:50px"></MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd>
                        <MudTextField T="string" Value="item.Name"
                            ValueChanged="@((string val) => { item.Name = val; OnChanged(item); })"
                            Variant="Variant.Text" Style="min-width:200px" />
                    </MudTd>
                    <MudTd>
                        <MudTextField T="string" Value="item.Code"
                            ValueChanged="@((string val) => { item.Code = val; OnChanged(item); })"
                            Variant="Variant.Text" Style="min-width:100px" />
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                            Color="@(item.IsActive ? Color.Success : Color.Default)"
                            Variant="Variant.Outlined"
                            Text="@(item.IsActive ? "Aktyvus" : "Neaktyvus")" />
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudNumericField T="int" Value="item.SortOrder"
                            ValueChanged="@((int val) => { item.SortOrder = val; OnChanged(item); })"
                            Variant="Variant.Text" Style="max-width:80px" />
                    </MudTd>
                    <MudTd>
                        <div @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                Color="Color.Error" OnClick="@(async () => await DeleteItem(item))" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</MudContainer>

@code {
    private List<NBEN.ExpenseCategory> _items = new();
    private bool _loading = true;
    private System.Threading.Timer? _autoSaveTimer;
    private bool _saveIndicatorVisible = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        _items = await context.ExpenseCategories.OrderBy(r => r.SortOrder).ToListAsync();
        _loading = false;
    }

    private async Task AddNew()
    {
        try
        {
            var maxSort = _items.Any() ? _items.Max(i => i.SortOrder) + 1 : 1;
            var newItem = new NBEN.ExpenseCategory
            {
                Name = "Nauja kategorija",
                Code = "NAUJA",
                IsActive = true,
                SortOrder = maxSort
            };
            using var ctx = await ContextFactory.CreateDbContextAsync();
            ctx.ExpenseCategories.Add(newItem);
            await ctx.SaveChangesAsync();
            _items.Add(newItem);
            Snackbar.Add("Pridėta nauja kategorija", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nepavyko sukurti: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnChanged(NBEN.ExpenseCategory item)
    {
        _autoSaveTimer?.Dispose();
        _autoSaveTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    using var ctx = await ContextFactory.CreateDbContextAsync();
                    ctx.ExpenseCategories.Update(item);
                    await ctx.SaveChangesAsync();
                    _saveIndicatorVisible = true;
                    StateHasChanged();
                    _ = Task.Delay(1500).ContinueWith(_ => InvokeAsync(() => { _saveIndicatorVisible = false; StateHasChanged(); }));
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Nepavyko išsaugoti: {ex.Message}", Severity.Error);
                    StateHasChanged();
                }
            });
        }, null, 500, Timeout.Infinite);
    }

    private async Task DeleteItem(NBEN.ExpenseCategory item)
    {
        // Check if category has invoices
        using var ctx = await ContextFactory.CreateDbContextAsync();
        var hasInvoices = await ctx.ExpenseInvoices.AnyAsync(i => i.CategoryId == item.Id);

        if (hasInvoices)
        {
            Snackbar.Add("Negalima ištrinti kategorijos, kuri priklauso sąskaitos faktūros", Severity.Warning);
            return;
        }

        var result = await ConfirmDialog.ShowAsync(DialogService, $"Ar tikrai norite ištrinti \"{item.Name}\"?", "Ištrinti", "Taip", Color.Error);
        if (!result) return;

        try
        {
            using var ctx2 = await ContextFactory.CreateDbContextAsync();
            ctx2.ExpenseCategories.Remove(item);
            await ctx2.SaveChangesAsync();
            _items.Remove(item);
            Snackbar.Add($"\"{item.Name}\" ištrinta", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nepavyko ištrinti: {ex.Message}", Severity.Error);
        }
    }

    public void Dispose()
    {
        _autoSaveTimer?.Dispose();
    }
}