@page "/expense-invoices"
@rendermode InteractiveServer
@using NordicBeesERP.Models.Expenses
@using NordicBeesERP.Services
@using NordicBeesERP.Components.Dialogs
@using NordicBeesERP.Helpers
@using MudBlazor
@using System.Globalization
@inject NavigationManager Navigation
@inject IExpenseService ExpenseService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IDbContextFactory<NordicBeesERPContext> DbFactory
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@using System.IO.Compression

<PageTitle>Išlaidų sąskaitos</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <!-- Header row -->
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">Išlaidų sąskaitos</MudText>
        <div class="d-flex align-center gap-2">
            <MudButton OnClick="OpenUploadDialog" StartIcon="@Icons.Material.Filled.CloudUpload" Variant="Variant.Filled" Color="Color.Primary">Įkelti</MudButton>
            <!-- Export button temporarily disabled - TODO: Re-enable -->
            @* <MudButton OnClick="ExportCsv" StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Filled" Color="Color.Primary">Eksportuoti</MudButton> *@
        </div>
    </div>

    <!-- Loading Overlay -->
    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <!-- Attention alert -->
    @if (_attentionInvoices.Any())
    {
        <MudAlert Severity="Severity.Warning" Class="mt-3 mb-3">
            <MudText Typo="Typo.body1">@_attentionInvoices.Count sąskaita(-os) reikalauja dėmesio</MudText>
        </MudAlert>
    }

    <!-- Filters -->
    <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField Value="@_filterSearch"
                              ValueChanged="@(async (string val) => await UpdateFilterSearchAsync(val))"
                              Label="Paieška pagal Nr. arba tiekėją"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              FullWidth="@true"
                              Clearable="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Adornment="Adornment.Start" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudDateRangePicker DateRange="@_dateRange"
                                    DateRangeChanged="@(async (DateRange dr) => await UpdateDateRangeAsync(dr))"
                                    Label="Data (nuo / iki)"
                                    Variant="Variant.Outlined"
                                    FullWidth="@true"
                                    Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
                @if (!string.IsNullOrEmpty(_filterSearch) || _dateRange?.Start != null || _selectedStatuses.Any() || _showCurrentYear)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                               OnClick="@(async () => await ClearFiltersAsync())">
                        Išvalyti filtrus
                    </MudButton>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Year toggle -->
    <div class="d-flex align-center mb-3">
        <MudSwitch Label="Rodyti tik dabartinį metą" Checked="@_showCurrentYear" CheckedChanged="@(async (bool v) => await OnYearToggleChangedAsync(v))" Color="Color.Primary" T="bool" />
    </div>

    <!-- Status filter chips -->
    <div class="d-flex flex-wrap gap-2 mb-3 align-center">
        <MudText Typo="Typo.body2" Style="color:#6b7280;margin-right:4px;">Statusas:</MudText>
        @if (_selectedStatuses.Any())
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.FilterAltOff"
                       OnClick="@(async () => await ClearStatusesAsync())">
                Rodyti visas
            </MudButton>
        }
        @foreach (var status in new[]{ "PENDING", "PARTIAL", "OVERDUE", "PAID", "NEEDS_REVIEW", "PENDING_SUPPLIER", "REJECTED" })
        {
            var isSelected = _selectedStatuses.Contains(status);
            <MudChip T="string"
                     Color="@(isSelected ? ExpenseStatusHelper.GetColor(status) : Color.Default)"
                     Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                      OnClick="@(async () => await ToggleStatusAsync(status))"
                     Size="Size.Small"
                     Style="@(isSelected ? "" : "opacity:0.7")">
                @ExpenseStatusHelper.GetLabel(status)
            </MudChip>
        }
    </div>

    <!-- MudTabs with 6 tabs -->
    <MudTabs ActivePanelIndex="_selectedTab" ActivePanelIndexChanged="@(async (int index) => await OnTabChangedAsync(index))" Elevation="0" Rounded="true" Square="false" Class="mt-2">
        <MudTabPanel Text="Visos" />
        <MudTabPanel Text="Nesumokėtos" />
        <MudTabPanel Text="Pradelsta" />
        <MudTabPanel Text="Šis mėnuo" />
        <MudTabPanel Text="ULAK" />
        <MudTabPanel Text="Reikia dėmesio" />
    </MudTabs>

    <!-- Bulk action bar -->
    @if (_selectedInvoices.Count > 0)
    {
        <MudPaper Elevation="0" Rounded="true" Square="false" Class="mb-2 pa-3 d-flex align-center justify-space-between"
                  Style="background:#e8f0fe; border-radius:8px;">
            <MudText Typo="Typo.body1" Style="color:#1976d2;font-weight:500;">
                Pasirinkta: @_selectedInvoices.Count
            </MudText>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                           OnClick="@(() => { _selectedInvoices.Clear(); StateHasChanged(); })">
                    Atšaukti
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="DownloadSelectedAsync"
                           Disabled="@_isExporting"
                           Style="text-transform:none">
                    @if (_isExporting)
                    {
                        <MudProgressCircular Size="Size.Small" Color="Color.Default" />
                    }
                    Atsisiųsti failus
                </MudButton>
            </div>
        </MudPaper>
    }

    <!-- MudTable -->
    <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
        <MudTable Items="@FilteredInvoices" Dense="@true" Hover="@true" Striped="@true" RowsPerPage="25" Elevation="0" RowStyleFunc="@((inv, _) => GetRowStyle(inv))" OnRowClick="@(async (TableRowClickEventArgs<ExpenseInvoice> args) => { if (IsDoubleClick(args.Item)) await OpenInvoiceDetail(args.Item); })" Style="cursor:pointer">
            <HeaderContent>
                <MudTh Style="min-width:48px;width:48px;">
                    <input type="checkbox"
                           checked="@(GetSelectAllState() == true)"
                           @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)e.Value! ? true : false))"
                           @onclick:stopPropagation="true" />
                </MudTh>
                <MudTh>Nr.</MudTh>
                <MudTh>Tiekėjas</MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Terminas</MudTh>
                <MudTh>Suma</MudTh>
                <MudTh>Liko</MudTh>
                <MudTh>Statusas</MudTh>
                <MudTh>Problemos</MudTh>
                <MudTh style="min-width:60px">Veiksmai</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="min-width:48px;width:48px;">
                    <input type="checkbox"
                           checked="@_selectedInvoices.Contains(context.Id)"
                           @onchange="@((ChangeEventArgs e) => ToggleInvoice(context.Id, (bool)e.Value!))"
                           @onclick:stopPropagation="true" />
                </MudTd>
                <MudTd>@context.InvoiceNumber</MudTd>
                <MudTd>
                    @GetSupplierName(context)
                    @{ var cat = _expenseCategories.FirstOrDefault(c => c.Id == (context as NordicBeesERP.Models.Expenses.ExpenseInvoice)?.CategoryId); }
                    @if (cat != null)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Style="height:18px;font-size:0.65rem">@cat.Name</MudChip>
                    }
                </MudTd>
                <MudTd>@context.InvoiceDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>
                    @{
                        var dueDateLabel = GetDueDateLabel(context);
                        var isOverdue = context.DueDate < DateTime.Today && context.Status != "PAID";
                    }
                    @if (isOverdue)
                    {
                        var daysOverdue = (DateTime.Today - context.DueDate.Date).Days;
                        <div>
                            <span>@context.DueDate.ToString("MM-dd")</span>
                            <div style="font-size:0.7rem;color:#dc2626;">Pradelsta @daysOverdue d.</div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(dueDateLabel) && dueDateLabel != "—")
                    {
                        @context.DueDate.ToString("MM-dd")
                    }
                    else
                    {
                        <span>—</span>
                    }
                </MudTd>
                <MudTd>@FormatAmountHelper.Trim(context.AmountInclVat, 2) €</MudTd>
                <MudTd>@GetRemainingAmount(context)</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@ExpenseStatusHelper.GetColor(context.Status)">
                        @ExpenseStatusHelper.GetLabel(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd>
                    @{
                        var flags = ExpenseStatusHelper.ParseFlags(context.OcrFlags);
                    }
                    @if (flags.Any())
                    {
                        <MudTooltip Text="@string.Join(", ", flags.Select(ExpenseStatusHelper.GetFlagLabel))">
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.Warning"
                                         Style="@(flags.Any(ExpenseStatusHelper.IsCriticalFlag) ? "color:#dc2626;font-size:18px" : "color:#f59e0b;font-size:18px")" />
                                @if (flags.Count > 1)
                                {
                                    <MudText Typo="Typo.caption" Style="color:#6b7280">@flags.Count</MudText>
                                }
                            </div>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Style="color:#d1d5db">—</MudText>
                    }
                </MudTd>
                <MudTd>
                    <div @onclick:stopPropagation="true">
                        @if (context.Status == "REJECTED")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                           Size="Size.Small" Color="Color.Warning"
                                           Title="Atstatyti"
                                           OnClick="@(() => RestoreInvoiceAsync(context))" />
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
            <NoRecordsContent>
                <MudText>Įrašų nėra</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private int _selectedTab = 0;
    private List<ExpenseInvoice> _invoices = new();
    private List<ExpenseInvoice> _pendingSupplierInvoices = new();
    private bool _isLoading = false;

    // URL query-string parameters (synchronized with filter state)
    [SupplyParameterFromQuery(Name = "q")]
    public string? FilterSearch { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? DateFrom { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? DateTo { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusCsv { get; set; }

    [SupplyParameterFromQuery(Name = "year")]
    public string? YearFilter { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabParam { get; set; }

    private Dictionary<int, string> _supplierNames = new();
    private string? _filterSearch = null;
    private DateRange? _dateRange;
    private bool _showCurrentYear = false;
    private HashSet<string> _selectedStatuses = new();
    private List<Models.Expenses.ExpenseCategory> _expenseCategories = new();
    private HashSet<int> _selectedInvoices = new();
    private bool _isExporting = false;
    private DateTime _lastClickTime = DateTime.MinValue;
    private object? _lastClickItem;

    private bool IsDoubleClick(object item)
    {
        var now = DateTime.Now;
        if (_lastClickItem == item && (now - _lastClickTime).TotalMilliseconds < 400)
        {
            _lastClickItem = null;
            return true;
        }
        _lastClickItem = item;
        _lastClickTime = now;
        return false;
    }

    private List<ExpenseInvoice> _attentionInvoices => _invoices
        .Where(i => ExpenseStatusHelper.NeedsAttention(i.Status, i.OcrFlags, i.DueDate))
        .ToList();

    private List<ExpenseInvoice> FilteredInvoices => GetFilteredInvoices();

    protected override async Task OnInitializedAsync()
    {
        _expenseCategories = await ExpenseService.GetCategoriesAsync(isActive: true);
    }

    protected override async Task OnParametersSetAsync()
    {
        _filterSearch = FilterSearch;
        _dateRange = (DateFrom.HasValue || DateTo.HasValue) ? new DateRange(DateFrom, DateTo) : null;
        _showCurrentYear = FilterUrlBuilder.ParseBool(YearFilter) ?? false;
        _selectedStatuses = !string.IsNullOrEmpty(StatusCsv) ? new HashSet<string>(StatusCsv.Split(',')) : new HashSet<string>();
        if (TabParam == "attention")
            _selectedTab = 5;
        else if (TabParam != null && int.TryParse(TabParam, out var tab))
            _selectedTab = tab;
        _selectedInvoices.Clear();
        await LoadDataAsync();
    }

    private async Task OpenUploadDialog()
    {
        var dialog = await DialogService.ShowAsync<ExpenseUploadDialog>("Įkelti sąskaitą-faktūrą", new DialogParameters(), new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is ExpenseUploadData uploadData)
        {
            _isLoading = true;
            StateHasChanged();
            await LoadDataAsync();
            _isLoading = false;
            StateHasChanged();
            Console.WriteLine($"Uploaded: {uploadData.FileName}");
        }
        else if (result.Data is InvoiceAddResult addResult && addResult.IsDuplicate)
        {
            var parameters = new DialogParameters
            {
                { "ThisInvoiceId", addResult.ThisInvoiceId },
                { "OriginalInvoiceId", addResult.OriginalInvoiceId }
            };
            var dupDialog = await DialogService.ShowAsync<DuplicateInvoiceDialog>("Sąskaita jau egzistuoja", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
            var dialogResult = await dupDialog.Result;
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _invoices = await ExpenseService.GetInvoicesAsync();

        // Load supplier names fresh from all invoices (not just filtered ones)
        var allInvoiceSupplierIds = _invoices
            .Where(i => i.SupplierId.HasValue && i.SupplierId > 0)
            .Select(i => i.SupplierId!.Value)
            .Distinct()
            .ToList();

        Console.WriteLine($"Loading supplier names for IDs: {string.Join(",", allInvoiceSupplierIds)}");

        if (allInvoiceSupplierIds.Any())
        {
            await using var ctx = DbFactory.CreateDbContext();
            _supplierNames = await ctx.BusinessPartners
                .Where(b => allInvoiceSupplierIds.Contains(b.Id))
                .ToDictionaryAsync(b => b.Id, b => b.Name);
        }

        Console.WriteLine($"Loaded {_supplierNames.Count} supplier names");

        _pendingSupplierInvoices = _invoices
            .Where(i => ExpenseStatusHelper.NeedsAttention(i.Status))
            .ToList();
    }

    // TODO: Re-enable export functionality
    // private async Task ExportInvoices(string format)
    // {
    //     try
    //     {
    //         var filteredInvoices = GetFilteredInvoices();
    //         var fileBytes = await ExportService.ExportInvoicesAsync(filteredInvoices, format);
    //         string fileName = $"islaidos_sąskaitos_{DateTime.Now:yyyyMMdd_HHmmss}.{format}";
    //         await JS.InvokeVoidAsync("downloadFile", Convert.ToBase64String(fileBytes), format == "csv" ? "text/csv" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    //     }
    //     catch (Exception ex)
    //     {
    //         Console.WriteLine($"Export error: {ex.Message}");
    //     }
    // }

    // TODO: Re-enable export functionality
    // private async Task ExportCsv()
    // {
    //     await ExportInvoices("csv");
    // }

    // private async Task ExportExcel()
    // {
    //     await ExportInvoices("xlsx");
    // }

    private List<ExpenseInvoice> GetFilteredInvoices()
    {
        List<ExpenseInvoice> result;
        switch (_selectedTab)
        {
            case 1: // Nesumokėtos
                result = _invoices.Where(i =>
                    i.Status == "PENDING" ||
                    i.Status == "PARTIAL" ||
                    i.Status == "OVERDUE"
                ).ToList();
                break;
            case 2: // Pradelsta
                result = _invoices.Where(i =>
                    i.DueDate < DateTime.Today &&
                    i.Status != "PAID" &&
                    i.Status != "PENDING_SUPPLIER"
                ).ToList();
                break;
            case 3: // Šis mėnuo
                result = _invoices.Where(i =>
                    i.InvoiceDate.Month == DateTime.Today.Month &&
                    i.InvoiceDate.Year == DateTime.Today.Year
                ).ToList();
                break;
            case 4: // ULAK
                result = _invoices.Where(i => i.InvoiceType == "ULAK").ToList();
                break;
            case 5: // Reikia dėmesio
                result = _attentionInvoices.ToList();
                break;
            default: // Visos
                result = _invoices.ToList();
                break;
        }

        // Apply status filter chips
        if (_selectedStatuses.Any())
        {
            result = result.Where(i => _selectedStatuses.Contains(i.Status)).ToList();
        }

        // Apply year filter
        if (_showCurrentYear)
        {
            result = result.Where(i => i.InvoiceDate.Year == DateTime.Today.Year).ToList();
        }

        // Apply date filter from _dateRange
        if (_dateRange?.Start != null)
            result = result.Where(i => i.InvoiceDate >= _dateRange.Start.Value.Date).ToList();
        if (_dateRange?.End != null)
            result = result.Where(i => i.InvoiceDate <= _dateRange.End.Value.Date).ToList();

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(_filterSearch))
            result = result.Where(i =>
                (i.InvoiceNumber?.Contains(_filterSearch, StringComparison.OrdinalIgnoreCase) == true) ||
                (_supplierNames.TryGetValue(i.SupplierId ?? 0, out var sn) && sn.Contains(_filterSearch, StringComparison.OrdinalIgnoreCase)) ||
                (i.PendingSupplierName?.Contains(_filterSearch, StringComparison.OrdinalIgnoreCase) == true)
            ).ToList();

        return result;
    }

    private string _basePageUrl() => Navigation.Uri.Split('?')[0];

    private string _buildUrl() => FilterUrlBuilder.Build(_basePageUrl(),
        ("q", _filterSearch),
        ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
        ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
        ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses)),
        ("year", FilterUrlBuilder.ToQueryValue(_showCurrentYear)),
        ("tab", _selectedTab != 0 ? _selectedTab.ToString() : null));

    private async Task UpdateFilterSearchAsync(string val)
    {
        _filterSearch = val;
        _selectedInvoices.Clear();
        Navigation.NavigateTo(FilterUrlBuilder.Build(_basePageUrl(),
            ("q", val),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses)),
            ("year", FilterUrlBuilder.ToQueryValue(_showCurrentYear)),
            ("tab", _selectedTab != 0 ? _selectedTab.ToString() : null)), replace: true);
    }

    private async Task UpdateDateRangeAsync(DateRange dr)
    {
        _dateRange = dr;
        _selectedInvoices.Clear();
        Navigation.NavigateTo(FilterUrlBuilder.Build(_basePageUrl(),
            ("q", _filterSearch),
            ("from", FilterUrlBuilder.ToQueryValue(dr.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(dr.End)),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses)),
            ("year", FilterUrlBuilder.ToQueryValue(_showCurrentYear)),
            ("tab", _selectedTab != 0 ? _selectedTab.ToString() : null)), replace: false);
    }

    private async Task OnYearToggleChangedAsync(bool checkedValue)
    {
        _showCurrentYear = checkedValue;
        _selectedInvoices.Clear();
        Navigation.NavigateTo(_buildUrl(), replace: false);
    }

    private async Task ToggleStatusAsync(string status)
    {
        var newStatuses = new HashSet<string>(_selectedStatuses);
        if (newStatuses.Contains(status))
            newStatuses.Remove(status);
        else
            newStatuses.Add(status);
        _selectedStatuses = newStatuses;
        _selectedInvoices.Clear();
        Navigation.NavigateTo(_buildUrl(), replace: false);
    }

    private async Task ClearStatusesAsync()
    {
        _selectedStatuses.Clear();
        _selectedInvoices.Clear();
        Navigation.NavigateTo(_buildUrl(), replace: false);
    }

    private async Task OnTabChangedAsync(int index)
    {
        _selectedTab = index;
        _selectedInvoices.Clear();
        Navigation.NavigateTo(_buildUrl(), replace: false);
    }

    private async Task ClearFiltersAsync()
    {
        Navigation.NavigateTo(_basePageUrl(), replace: false);
    }

    private string GetSupplierName(ExpenseInvoice invoice)
    {
        if (invoice.SupplierId.HasValue && invoice.SupplierId.Value > 0)
        {
            return _supplierNames.GetValueOrDefault(invoice.SupplierId.Value, "Nežinomas");
        }
        return invoice.PendingSupplierName ?? "Nežinomas";
    }

    private string GetDueDateLabel(ExpenseInvoice invoice)
    {
        if (invoice.DueDate == default) return "—";
        if (invoice.DueDate < DateTime.Today && invoice.Status != "PAID")
        {
            var daysOverdue = (DateTime.Today - invoice.DueDate.Date).Days;
            return $"Pradelsta {daysOverdue}d.";
        }
        return invoice.DueDate.ToString("MM-dd");
    }

    private string GetRowStyle(ExpenseInvoice inv)
    {
        var flags = ExpenseStatusHelper.ParseFlags(inv.OcrFlags);
        bool hasCritical = flags.Any(ExpenseStatusHelper.IsCriticalFlag)
                        || inv.Status == "PENDING_SUPPLIER"
                        || inv.Status == "DUPLICATE_PENDING";
        bool hasWarning = inv.Status == "NEEDS_REVIEW"
                       || (inv.DueDate < DateTime.Today && inv.Status != "PAID");
        if (hasCritical) return "background:#fff5f5;";
        if (hasWarning) return "background:#fffbeb;";
        return "";
    }

    private string GetRemainingAmount(ExpenseInvoice invoice)
    {
        var remaining = invoice.AmountInclVat - invoice.PaidAmount;
        if (remaining <= 0)
        {
            return "–";
        }
        return $"{FormatAmountHelper.Trim(remaining, 2)} €";
    }

    private async Task OpenAssignSupplierDialog(ExpenseInvoice invoice)
    {
        var parameters = new DialogParameters { ["InvoiceId"] = invoice.Id };
        var dialog = await DialogService.ShowAsync<AssignSupplierDialog>("Priskirti tiekėją", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;
        if (!result.Canceled)
            await LoadDataAsync();
    }

    private async Task OpenPaymentDialog(ExpenseInvoice invoice)
    {
        Console.WriteLine($"Opening payment dialog for invoice id: {invoice.Id}");
        var supplierName = invoice.SupplierId.HasValue
            ? _supplierNames.GetValueOrDefault(invoice.SupplierId.Value, invoice.PendingSupplierName ?? "Nežinomas")
            : (invoice.PendingSupplierName ?? "Nežinomas");
        var parameters = new DialogParameters
        {
            { "Invoice", invoice },
            { "SupplierName", supplierName }
        };
        var dialog = await DialogService.ShowAsync<ExpensePaymentDialog>("Registruoti mokėjimą", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;
        if (result != null)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task OpenInvoiceDetail(ExpenseInvoice invoice)
    {
        var parameters = new DialogParameters { ["InvoiceId"] = invoice.Id };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true, BackdropClick = true };
        var dialog = await DialogService.ShowAsync<InvoiceDetailDialog>($"Sąskaita {invoice.InvoiceNumber}", parameters, options);
        var result = await dialog.Result;

        await LoadDataAsync();
        StateHasChanged();
    }

    private void ToggleInvoice(int id, bool selected)
    {
        if (selected) _selectedInvoices.Add(id);
        else _selectedInvoices.Remove(id);
        StateHasChanged();
    }

    private bool? GetSelectAllState()
    {
        var visible = FilteredInvoices.Select(i => i.Id).ToList();
        if (!visible.Any()) return false;
        var selected = visible.Count(i => _selectedInvoices.Contains(i));
        if (selected == 0) return false;
        if (selected == visible.Count) return true;
        return null;
    }

    private void ToggleSelectAll(bool state)
    {
        var visible = FilteredInvoices.Select(i => i.Id).ToList();
        if (state) foreach (var id in visible) _selectedInvoices.Add(id);
        else foreach (var id in visible) _selectedInvoices.Remove(id);
        StateHasChanged();
    }

    private async Task DownloadSelectedAsync()
    {
        if (_selectedInvoices.Count == 0) return;

        _isExporting = true;
        StateHasChanged();

        try
        {
            var selected = _invoices.Where(i => _selectedInvoices.Contains(i.Id)
                && !string.IsNullOrEmpty(i.OriginalFilePath)).ToList();

            if (!selected.Any())
            {
                Snackbar.Add("Pasirinktos sąskaitos neturi failų", Severity.Warning);
                return;
            }

            if (selected.Count == 1)
            {
                var invoice = selected[0];
                var filePath = Path.Combine(WebHostEnvironment.WebRootPath, invoice.OriginalFilePath!);
                if (!File.Exists(filePath)) { Snackbar.Add("Failas nerastas serveryje", Severity.Error); return; }
                var bytes = await File.ReadAllBytesAsync(filePath);
                var base64 = Convert.ToBase64String(bytes);
                var fileName = Path.GetFileName(invoice.OriginalFilePath!);
                await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/pdf", base64);
                Snackbar.Add("Failas atsisiųstas", Severity.Success);
                return;
            }

            // Multiple files — ask what to do
            var choice = await DialogService.ShowMessageBox(
                "Kaip atsisiųsti?",
                $"Pasirinkta sąskaitų su failais: {selected.Count}. Pasirinkite formatą:",
                yesText: "Vienas PDF failas",
                noText: "Atskiri failai (ZIP)",
                cancelText: "Atšaukti");

            if (choice == null) return;

            if (choice == true)
            {
                // Merge all PDFs into one
                var mergedBytes = await MergePdfsAsync(selected.Select(i => i.OriginalFilePath!).ToList());
                if (mergedBytes == null) { Snackbar.Add("Nepavyko sujungti PDF failų", Severity.Error); return; }
                var base64 = Convert.ToBase64String(mergedBytes);
                var dateStr = DateTime.Now.ToString("yyyyMMdd");
                await JS.InvokeVoidAsync("downloadFileFromBytes", $"islaidos_{dateStr}.pdf", "application/pdf", base64);
                Snackbar.Add($"{selected.Count} sąskaitos sujungtos į vieną PDF", Severity.Success);
            }
            else
            {
                using var ms = new MemoryStream();
                using (var zip = new ZipArchive(ms, ZipArchiveMode.Create, true))
                {
                    foreach (var invoice in selected)
                    {
                        try
                        {
                            var filePath = Path.Combine(WebHostEnvironment.WebRootPath, invoice.OriginalFilePath!);
                            if (!File.Exists(filePath)) continue;
                            var bytes = await File.ReadAllBytesAsync(filePath);
                            var entryName = Path.GetFileName(invoice.OriginalFilePath!);
                            var entry = zip.CreateEntry(entryName);
                            using var entryStream = entry.Open();
                            await entryStream.WriteAsync(bytes);
                        }
                        catch { }
                    }
                }
                var zipBytes = ms.ToArray();
                var base64 = Convert.ToBase64String(zipBytes);
                var dateStr = DateTime.Now.ToString("yyyyMMdd");
                await JS.InvokeVoidAsync("downloadFileFromBytes", $"islaidos_{dateStr}.zip", "application/zip", base64);
                Snackbar.Add($"{selected.Count} failų atsisiųsta ZIP archyve", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

    private async Task RestoreInvoiceAsync(ExpenseInvoice invoice)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Atstatyti sąskaitą?",
            $"Sąskaita {invoice.InvoiceNumber} bus atstatyta į 'Reikia patikrinti' būseną.",
            yesText: "Atstatyti",
            cancelText: "Atšaukti");

        if (confirmed != true) return;

        try
        {
            await ExpenseService.RestoreInvoiceAsync(invoice.Id);
            Snackbar.Add("Sąskaita atstatyta", Severity.Success);
            await LoadDataAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida: {ex.Message}", Severity.Error);
        }
    }

    private async Task<byte[]?> MergePdfsAsync(List<string> filePaths)
    {
        try
        {
            var allPdfBytes = new List<byte[]>();

            foreach (var relativePath in filePaths)
            {
                var fullPath = Path.Combine(WebHostEnvironment.WebRootPath, relativePath);
                if (!File.Exists(fullPath)) continue;
                var pdfBytes = await File.ReadAllBytesAsync(fullPath);
                allPdfBytes.Add(pdfBytes);
            }

            if (allPdfBytes.Count == 1) return allPdfBytes[0];

            using var mergedDoc = new PdfSharpCore.Pdf.PdfDocument();

            foreach (var pdfBytes in allPdfBytes)
            {
                using var ms = new MemoryStream(pdfBytes);
                using var srcDoc = PdfSharpCore.Pdf.IO.PdfReader.Open(ms, PdfSharpCore.Pdf.IO.PdfDocumentOpenMode.Import);
                foreach (PdfSharpCore.Pdf.PdfPage page in srcDoc.Pages)
                {
                    mergedDoc.AddPage(page);
                }
            }

            using var resultMs = new MemoryStream();
            mergedDoc.Save(resultMs, false);
            return resultMs.ToArray();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF sujungimo klaida: {ex.Message}", Severity.Warning);
            return null;
        }
    }
