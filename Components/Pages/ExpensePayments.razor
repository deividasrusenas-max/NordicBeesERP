@page "/expense-payments"
@rendermode InteractiveServer
@using NordicBeesERP.Models.Expenses
@using NordicBeesERP.Models
@using NordicBeesERP.Data
@using NordicBeesERP.Helpers
@using MudBlazor
@inject IDbContextFactory<NordicBeesERPContext> DbFactory
@inject MudBlazor.ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Išlaidų mokėjimai</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Išlaidų mokėjimai</MudText>

    <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
        <MudGrid>
            <MudItem xs="12" sm="6" md="6">
                <MudTextField Value="@_filterSearch"
                              ValueChanged="@(async (string val) => await UpdateFilterSearchAsync(val))"
                              Label="Paieška pagal sąskaitą / tiekėją / referencę"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              FullWidth="@true"
                              Clearable="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Adornment="Adornment.Start" />
            </MudItem>
            <MudItem xs="12" sm="6" md="6">
                <MudDateRangePicker DateRange="@_dateRange"
                                    DateRangeChanged="@(async (DateRange dr) => await UpdateDateRangeAsync(dr))"
                                    Label="Data (nuo / iki)"
                                    Variant="Variant.Outlined"
                                    FullWidth="@true"
                                    Clearable="true" />
            </MudItem>
            @if (!string.IsNullOrEmpty(_filterSearch) || _dateRange?.Start != null)
            {
                <MudItem xs="12">
                    <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                                OnClick="@(async () => await ClearFiltersAsync())">
                        Išvalyti filtrus
                    </MudButton>
                </MudItem>
            }
            <MudItem xs="12">
                <div class="d-flex flex-wrap gap-2 align-center">
                    <MudText Typo="Typo.body2" Style="color:#6b7280;margin-right:4px;">Metodas:</MudText>
                    @foreach (var method in _paymentMethodDisplay)
                    {
                        <MudChip T="string"
                                 Color="@(_filterMethod == method.Key ? method.Value.Color : Color.Default)"
                                 Variant="@(_filterMethod == method.Key ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => ToggleMethod(method.Key))"
                                 Size="Size.Small"
                                 Style="@(_filterMethod == method.Key ? "" : "opacity:0.7")">
                           @method.Value.Label
                        </MudChip>
                    }
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable T="PaymentRow" Items="@_payments" Hover="true" Dense="true" Striped="true"
              Loading="@_loading" LoadingProgressColor="Color.Info" RowsPerPage="50">
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{25, 50, 100}" />
        </PagerContent>
        <HeaderContent>
            <MudTh>Data</MudTh>
            <MudTh>Tiekėjas</MudTh>
            <MudTh>Sąskaita Nr.</MudTh>
            <MudTh Class="text-right">Suma (€)</MudTh>
            <MudTh>Metodas</MudTh>
            <MudTh>Referencė</MudTh>
            <MudTh>Pastabos</MudTh>
        </HeaderContent>
        <RowTemplate Context="p">
            <MudTd>@p.PaymentDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>@p.SupplierName</MudTd>
            <MudTd>@p.InvoiceNumber</MudTd>
            <MudTd Class="text-right">@FormatAmountHelper.Trim(p.Amount, 2)</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Secondary">@p.PaymentMethod</MudChip></MudTd>
            <MudTd>@p.Reference</MudTd>
            <MudTd>@p.Notes</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Mokėjimų nėra</MudText>
        </NoRecordsContent>
    </MudTable>
</MudContainer>

@code {
    private record PaymentRow(
        int Id, DateTime PaymentDate, decimal Amount,
        string PaymentMethod, string? Reference, string? Notes,
        string InvoiceNumber, string SupplierName);

    private List<PaymentRow> _payments = new();
    private bool _loading = true;
    private string? _filterSearch;
    private DateRange? _dateRange;
    private string? _filterMethod;

    private readonly Dictionary<string, (string Label, Color Color)> _paymentMethodDisplay = new()
    {
        ["BANK"] = ("Banko pavedimas", Color.Primary),
        ["CASH"] = ("Grynais", Color.Success)
    };

    // URL query-string parameters (synchronized with filter state)
    [SupplyParameterFromQuery(Name = "q")]
    public string? FilterSearch { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? DateFrom { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? DateTo { get; set; }

    [SupplyParameterFromQuery(Name = "method")]
    public string? FilterMethod { get; set; }

    // Lifecycle
    protected override async Task OnParametersSetAsync()
    {
        _filterSearch = FilterSearch;
        _dateRange = (DateFrom.HasValue || DateTo.HasValue)
            ? new DateRange(DateFrom, DateTo)
            : null;
        _filterMethod = FilterMethod;
        await LoadPaymentsAsync();
    }

    private async Task LoadPaymentsAsync()
    {
        _loading = true;
        try
        {
            using var ctx = DbFactory.CreateDbContext();

            var query = from p in ctx.ExpensePayments
                        join i in ctx.ExpenseInvoices on p.InvoiceId equals i.Id into invGroup
                        from i in invGroup.DefaultIfEmpty()
                        join bp in ctx.BusinessPartners on i.SupplierId equals bp.Id into bpGroup
                        from bp in bpGroup.DefaultIfEmpty()
                        select new
                        {
                            p.Id,
                            p.PaymentDate,
                            p.Amount,
                            p.PaymentMethod,
                            p.Reference,
                            p.Notes,
                            InvoiceNumber = i != null ? i.InvoiceNumber : "-",
                            SupplierName = bp != null ? bp.Name : (i != null ? i.PendingSupplierName ?? "Nežinomas" : "Nežinomas"),
                            SupplierId = i != null ? i.SupplierId : null
                        };

            DateTime? fromDate = _dateRange?.Start?.Date;
            DateTime? toDate = _dateRange?.End?.Date;
            if (fromDate.HasValue)
                query = query.Where(p => p.PaymentDate >= fromDate.Value);
            if (toDate.HasValue)
                query = query.Where(p => p.PaymentDate <= toDate.Value);
            if (!string.IsNullOrWhiteSpace(_filterSearch))
            {
                var s = _filterSearch.ToLower();
                query = query.Where(p =>
                    p.InvoiceNumber.ToLower().Contains(s) ||
                    p.SupplierName.ToLower().Contains(s) ||
                    (p.Reference != null && p.Reference.ToLower().Contains(s)));
            }
            if (!string.IsNullOrWhiteSpace(_filterMethod))
                query = query.Where(p => p.PaymentMethod == _filterMethod);

            var rows = await query.OrderByDescending(p => p.PaymentDate).ToListAsync();
            _payments = rows.Select(p => new PaymentRow(
                p.Id, p.PaymentDate, p.Amount,
                p.PaymentMethod, p.Reference, p.Notes,
                p.InvoiceNumber, p.SupplierName)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klaida įkeliant mokėjimus: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // Filter handlers
    private async Task UpdateFilterSearchAsync(string val)
    {
        _filterSearch = val;
        var url = FilterUrlBuilder.Build("/expense-payments",
            ("q", _filterSearch),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("method", FilterUrlBuilder.ToQueryValue(_filterMethod)));
        Navigation.NavigateTo(url, replace: true);
    }

    private async Task UpdateDateRangeAsync(DateRange dr)
    {
        _dateRange = dr;
        var url = FilterUrlBuilder.Build("/expense-payments",
            ("q", _filterSearch),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("method", FilterUrlBuilder.ToQueryValue(_filterMethod)));
        Navigation.NavigateTo(url, replace: true);
    }

    private void ToggleMethod(string method)
    {
        _filterMethod = _filterMethod == method ? null : method;
        var url = FilterUrlBuilder.Build("/expense-payments",
            ("q", _filterSearch),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("method", FilterUrlBuilder.ToQueryValue(_filterMethod)));
        Navigation.NavigateTo(url, replace: true);
    }

    private async Task ClearFiltersAsync()
    {
        Navigation.NavigateTo("/expense-payments");
    }


}