@page "/expenses"
@rendermode InteractiveServer
@using NordicBeesERP.Models.Expenses
@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using NordicBeesERP.Helpers
@using MudBlazor
@using NordicBeesERP.Components.Dialogs
@inject IExpenseService ExpenseService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IDbContextFactory<NordicBeesERPContext> DbFactory

<PageTitle>Išlaidos</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Išlaidų suvestinė</MudText>

    @if (_loading) { <MudProgressCircular Indeterminate="true" /> }
    else {
        <MudGrid Class="mb-4">
            <!-- Card 1: Bendra suma -->
            <MudItem xs="6" md="3">
                <MudPaper Elevation="0" Class="pa-4" Style="background:#dbeafe; border-radius:12px">
                    <MudText Typo="Typo.caption">Bendra suma</MudText>
                    <MudText Typo="Typo.subtitle2">@_yearSubtitle</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:bold">@FormatAmountHelper.Trim(_totalExclVat, 2) €</MudText>
                    <MudText Typo="Typo.caption" Style="color:#1e40af">PVM: @FormatAmountHelper.Trim(_totalVat, 2) €</MudText>
                    <MudText Typo="Typo.caption" Style="color:#1e40af">Viso su PVM: @FormatAmountHelper.Trim(_totalInclVat, 2) €</MudText>
                    <MudText Typo="Typo.caption">@_totalCount vnt.</MudText>
                </MudPaper>
            </MudItem>
            <!-- Card 2: Nepilnai apmokėta -->
            <MudItem xs="6" md="3">
                <MudPaper Elevation="0" Class="pa-4" Style="background:#fef3c7; border-radius:12px">
                    <MudText Typo="Typo.caption">Nepilnai apmokėta</MudText>
                    <MudText Typo="Typo.subtitle2">@_yearSubtitle</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:bold">@FormatAmountHelper.Trim(_partialExclVat, 2) €</MudText>
                    <MudText Typo="Typo.caption" Style="color:#854d0e">PVM: @FormatAmountHelper.Trim(_partialVat, 2) €</MudText>
                    <MudText Typo="Typo.caption" Style="color:#854d0e">Viso su PVM: @FormatAmountHelper.Trim(_partialInclVat, 2) €</MudText>
                    <MudText Typo="Typo.caption">@_partialCount vnt.</MudText>
                </MudPaper>
            </MudItem>
            <!-- Card 3: Permokėjimai -->
            <MudItem xs="6" md="3">
                <MudPaper Elevation="0" Class="pa-4" Style="background:#f5f3ff; border-radius:12px">
                    <MudText Typo="Typo.caption">Permokėjimai</MudText>
                    <MudText Typo="Typo.subtitle2">@_yearSubtitle</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:bold">@FormatAmountHelper.Trim(_overpaidExclVat, 2) €</MudText>
                    <MudText Typo="Typo.caption" Style="color:#5b21b6">PVM: @FormatAmountHelper.Trim(_overpaidVat, 2) €</MudText>
                    <MudText Typo="Typo.caption" Style="color:#5b21b6">Viso su PVM: @FormatAmountHelper.Trim(_overpaidInclVat, 2) €</MudText>
                    <MudText Typo="Typo.caption">@_overpaidCount vnt.</MudText>
                </MudPaper>
            </MudItem>
            <!-- Card 4: Skolos tiekėjams -->
            <MudItem xs="6" md="3">
                <MudPaper Elevation="0" Class="pa-4" Style="background:#fef2f2; border-radius:12px">
                    <MudText Typo="Typo.caption">Skolos tiekėjams</MudText>
                    <MudText Typo="Typo.subtitle2">@_yearSubtitle</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:bold">@FormatAmountHelper.Trim(_debtExclVat, 2) €</MudText>
                    <MudText Typo="Typo.caption" Style="color:#991b1b">PVM: @FormatAmountHelper.Trim(_debtVat, 2) €</MudText>
                    <MudText Typo="Typo.caption" Style="color:#991b1b">Viso su PVM: @FormatAmountHelper.Trim(_debtInclVat, 2) €</MudText>
                    <MudText Typo="Typo.caption">@_debtCount vnt.</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Įsiskolinimų analizė -->
        <MudText Typo="Typo.subtitle1" Class="mb-2">Įsiskolinimų analizė</MudText>
        <MudText Typo="Typo.caption" Class="mb-2 ml-1" Style="color:#6b7280;">Pradelstų sąskaitų analizė</MudText>
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background:#f8fafc; border-radius:12px">
            <MudGrid>
                <MudItem xs="6" md="3">
                    <MudPaper Elevation="0" Class="pa-3" Style="background:#f0fdf4; border:1px solid #86efac; border-radius:8px">
                        <MudText Typo="Typo.caption" Style="color:#166534">0-30 dienų</MudText>
                        <MudText Typo="Typo.h6" Style="font-weight:700">@_expenseAgingBucket0To30.Count sąskaitos</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight:700; color:#166534">@FormatAmountHelper.Trim(_expenseAgingBucket0To30.ExclVat, 2) € (be PVM)</MudText>
                        <MudText Typo="Typo.caption">PVM: @FormatAmountHelper.Trim(_expenseAgingBucket0To30.Vat, 2) €</MudText>
                        <MudText Typo="Typo.caption">Su PVM: @FormatAmountHelper.Trim(_expenseAgingBucket0To30.InclVat, 2) €</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudPaper Elevation="0" Class="pa-3" Style="background:#fefce8; border:1px solid #fde047; border-radius:8px">
                        <MudText Typo="Typo.caption" Style="color:#854d0e">31-60 dienų</MudText>
                        <MudText Typo="Typo.h6" Style="font-weight:700">@_expenseAgingBucket31To60.Count sąskaitos</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight:700; color:#854d0e">@FormatAmountHelper.Trim(_expenseAgingBucket31To60.ExclVat, 2) € (be PVM)</MudText>
                        <MudText Typo="Typo.caption">PVM: @FormatAmountHelper.Trim(_expenseAgingBucket31To60.Vat, 2) €</MudText>
                        <MudText Typo="Typo.caption">Su PVM: @FormatAmountHelper.Trim(_expenseAgingBucket31To60.InclVat, 2) €</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudPaper Elevation="0" Class="pa-3" Style="background:#fff7ed; border:1px solid #fdba74; border-radius:8px">
                        <MudText Typo="Typo.caption" Style="color:#9a3412">61-90 dienų</MudText>
                        <MudText Typo="Typo.h6" Style="font-weight:700">@_expenseAgingBucket61To90.Count sąskaitos</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight:700; color:#9a3412">@FormatAmountHelper.Trim(_expenseAgingBucket61To90.ExclVat, 2) € (be PVM)</MudText>
                        <MudText Typo="Typo.caption">PVM: @FormatAmountHelper.Trim(_expenseAgingBucket61To90.Vat, 2) €</MudText>
                        <MudText Typo="Typo.caption">Su PVM: @FormatAmountHelper.Trim(_expenseAgingBucket61To90.InclVat, 2) €</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudPaper Elevation="0" Class="pa-3" Style="background:#fef2f2; border:1px solid #fca5a5; border-radius:8px">
                        <MudText Typo="Typo.caption" Style="color:#991b1b">90+ dienų</MudText>
                        <MudText Typo="Typo.h6" Style="font-weight:700">@_expenseAgingBucket90Plus.Count sąskaitos</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight:700; color:#991b1b">@FormatAmountHelper.Trim(_expenseAgingBucket90Plus.ExclVat, 2) € (be PVM)</MudText>
                        <MudText Typo="Typo.caption">PVM: @FormatAmountHelper.Trim(_expenseAgingBucket90Plus.Vat, 2) €</MudText>
                        <MudText Typo="Typo.caption">Su PVM: @FormatAmountHelper.Trim(_expenseAgingBucket90Plus.InclVat, 2) €</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-3" />
            <MudGrid>
                <MudItem xs="6" md="3">
                    <MudPaper Elevation="0" Class="pa-3" Style="background:#fef2f2; border:1px solid #fca5a5; border-radius:8px">
                        <MudText Typo="Typo.caption" Style="color:#991b1b">Iš viso pradelstų skolų</MudText>
                        <MudText Typo="Typo.body1" Style="font-weight:700; color:#991b1b">@FormatAmountHelper.Trim(_expenseAgingBucket0To30.ExclVat + _expenseAgingBucket31To60.ExclVat + _expenseAgingBucket61To90.ExclVat + _expenseAgingBucket90Plus.ExclVat, 2) € (be PVM)</MudText>
                        <MudText Typo="Typo.caption">PVM: @FormatAmountHelper.Trim(_expenseAgingTotalVat, 2) €</MudText>
                        <MudText Typo="Typo.caption" Style="font-weight:700; color:#991b1b">@FormatAmountHelper.Trim(_expenseAgingBucket0To30.InclVat + _expenseAgingBucket31To60.InclVat + _expenseAgingBucket61To90.InclVat + _expenseAgingBucket90Plus.InclVat, 2) €</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Year toggle -->
        <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
            <MudSwitch T="bool"
                       Value="_showAllYears"
                       ValueChanged="OnYearToggleChanged"
                       Color="Color.Primary"
                       Label="Rodyti visus metus"
                       Dense="true" />
        </MudPaper>

        var pendingSupplier = _attentionInvoices.Count(i => i.Status == "PENDING_SUPPLIER");
        var needsReview = _attentionInvoices.Count(i => i.Status == "NEEDS_REVIEW");
        var duplicate = _attentionInvoices.Count(i => i.Status == "DUPLICATE_PENDING");
        var overdue = _attentionInvoices.Count(i => i.DueDate < DateTime.Today && i.Status != "PAID" && i.Status is "PENDING" or "PARTIAL" or "OVERDUE");

        if (_attentionInvoices.Any())
        {
            <MudPaper Style="background:#fffbeb; border:1px solid #fbbf24; border-radius:12px; padding:16px; margin-bottom:16px">
                <div class="d-flex justify-space-between align-center">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Style="color:#d97706" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Style="color:#92400e; font-weight:600">@_attentionInvoices.Count sąskaita(-os) reikalauja dėmesio:</MudText>
                            <div class="d-flex flex-wrap gap-2 mt-1">
                                @if (pendingSupplier > 0)
                                {
                                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small">
                                        Nežinomas tiekėjas: @pendingSupplier
                                    </MudChip>
                                }
                                @if (needsReview > 0)
                                {
                                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small">
                                        Reikia patikrinti: @needsReview
                                    </MudChip>
                                }
                                @if (duplicate > 0)
                                {
                                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small">
                                        Dublikatai: @duplicate
                                    </MudChip>
                                }
                                @if (overdue > 0)
                                {
                                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small">
                                        Vėluoja: @overdue
                                    </MudChip>
                                }
                            </div>
                        </div>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Href="/expense-invoices?tab=attention">
                        Peržiūrėti →
                    </MudButton>
                </div>
            </MudPaper>
        }

        <!-- Recent invoices -->
        <MudPaper Elevation="0" Class="pa-4" Style="background:#f8fafc; border-radius:12px">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1">Paskutinės sąskaitos</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/expense-invoices">
                    Rodyti visas →
                </MudButton>
            </div>
            <MudTable T="ExpenseInvoice" Items="_recentInvoices" Dense="true" Hover="true" Striped="true"
                      RowsPerPage="10"
                       OnRowClick="@((TableRowClickEventArgs<ExpenseInvoice> args) => { if (IsDoubleClick(args.Item)) _ = OpenInvoiceDetailAsync(args.Item); })">
                <HeaderContent>
                    <MudTh>Nr.</MudTh>
                    <MudTh>Tiekėjas</MudTh>
                    <MudTh>Data</MudTh>
                    <MudTh>Terminas</MudTh>
                    <MudTh Class="text-right">Suma</MudTh>
                    <MudTh Class="text-center">Statusas</MudTh>
                </HeaderContent>
                <RowTemplate Context="inv">
                    <MudTd>@inv.InvoiceNumber</MudTd>
                    <MudTd>@GetSupplierDisplay(inv)</MudTd>
                    <MudTd>@inv.InvoiceDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd>
                        @{
                            var d = (inv.DueDate.Date - DateTime.Today).Days;
                            var lbl = d == 0 ? "Šiandien" : d > 0 ? $"-{d}d." : $"+{Math.Abs(d)}d.";
                            var sty = d < 0 ? "color:#ef4444;font-weight:600" : d <= 7 ? "color:#f97316;font-weight:600" : "color:#16a34a";
                        }
                        <MudText Style="@sty">@lbl</MudText>
                    </MudTd>
                    <MudTd Class="text-right">@FormatAmountHelper.Trim(inv.AmountInclVat, 2) €</MudTd>
                    <MudTd Class="text-center">
                        <MudChip T="string" Color="@ExpenseStatusHelper.GetColor(inv.Status)" Size="Size.Small">
                            @ExpenseStatusHelper.GetLabel(inv.Status)
                        </MudChip>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10, 25}" />
                </PagerContent>
                <NoRecordsContent>
                    <MudText Class="text-center py-4">Įrašų nėra</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private bool _showAllYears;
    private string _yearSubtitle = string.Empty;
    private decimal _totalExclVat;
    private decimal _totalVat;
    private decimal _totalInclVat;
    private int _totalCount;
    private decimal _partialExclVat;
    private decimal _partialVat;
    private decimal _partialInclVat;
    private int _partialCount;
    private decimal _overpaidExclVat;
    private decimal _overpaidVat;
    private decimal _overpaidInclVat;
    private int _overpaidCount;
    private decimal _debtExclVat;
    private decimal _debtVat;
    private decimal _debtInclVat;
    private int _debtCount;
    private List<ExpenseInvoice> _recentInvoices = new();
    private List<ExpenseInvoice> _attentionInvoices = new();
    private List<ExpenseInvoice> _invoices = new();
    private List<ExpenseInvoice> _pendingSupplierInvoices = new();
    private List<ExpenseInvoice> _needsReviewInvoices = new();
    private Dictionary<int, string> _supplierNames = new();
    private DateTime _lastClickTime = DateTime.MinValue;
    private object? _lastClickItem;

    private bool IsDoubleClick(object item)
    {
        var now = DateTime.Now;
        if (_lastClickItem == item && (now - _lastClickTime).TotalMilliseconds < 400)
        {
            _lastClickItem = null;
            return true;
        }
        _lastClickItem = item;
        _lastClickTime = now;
        return false;
    }

    // Aging buckets
    private (int Count, decimal ExclVat, decimal Vat, decimal InclVat) _expenseAgingBucket0To30;
    private (int Count, decimal ExclVat, decimal Vat, decimal InclVat) _expenseAgingBucket31To60;
    private (int Count, decimal ExclVat, decimal Vat, decimal InclVat) _expenseAgingBucket61To90;
    private (int Count, decimal ExclVat, decimal Vat, decimal InclVat) _expenseAgingBucket90Plus;
    private decimal _expenseAgingTotalVat;

    private async Task OnYearToggleChanged(bool value)
    {
        _showAllYears = value;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var all = await ExpenseService.GetInvoicesAsync();
            var nonUlak = all.Where(i => i.InvoiceType != "ULAK").ToList();
            var filtered = _showAllYears ? nonUlak : nonUlak.Where(i => i.InvoiceDate.Year == DateTime.Today.Year).ToList();

            // Confirmed statuses: PENDING, PARTIAL, PAID, OVERDUE
            var confirmed = new[] { "PENDING", "PARTIAL", "PAID", "OVERDUE" };
            var confirmedFiltered = filtered.Where(i => confirmed.Contains(i.Status)).ToList();

            // Šių metų išlaidos - only confirmed invoices
            _totalCount = confirmedFiltered.Count;
            _totalExclVat = confirmedFiltered.Sum(i => i.AmountExclVat);
            _totalVat = confirmedFiltered.Sum(i => i.VatAmount);
            _totalInclVat = confirmedFiltered.Sum(i => i.AmountInclVat);

            // Nepilnai apmokėta: confirmed + PaidAmount > 0 AND PaidAmount < AmountInclVat
            var partial = confirmedFiltered.Where(i => 
                i.PaidAmount > 0 && i.PaidAmount < i.AmountInclVat).ToList();
            _partialCount = partial.Count;
            _partialInclVat = partial.Sum(i => i.AmountInclVat);
            _partialExclVat = partial.Sum(i => i.AmountExclVat);
            _partialVat = partial.Sum(i => i.VatAmount);

            // Permokėjimai: confirmed + PaidAmount > AmountInclVat
            var overpaid = confirmedFiltered.Where(i => 
                i.PaidAmount > i.AmountInclVat).ToList();
            _overpaidCount = overpaid.Count;
            _overpaidInclVat = overpaid.Sum(i => i.AmountInclVat);
            _overpaidExclVat = overpaid.Sum(i => i.AmountExclVat);
            _overpaidVat = overpaid.Sum(i => i.VatAmount);

            // Skolos tiekėjams: PENDING/PARTIAL/OVERDUE + PaidAmount < AmountInclVat
            var debt = confirmedFiltered.Where(i => 
                (i.Status == "PENDING" || i.Status == "PARTIAL" || i.Status == "OVERDUE")
                && i.PaidAmount < i.AmountInclVat).ToList();
            _debtCount = debt.Count;
            _debtInclVat = debt.Sum(i => i.AmountInclVat - i.PaidAmount);
            _debtExclVat = debt.Sum(i => i.AmountExclVat);
            _debtVat = debt.Sum(i => i.VatAmount);

            _attentionInvoices = nonUlak.Where(i => ExpenseStatusHelper.NeedsAttention(i.Status, i.OcrFlags, i.DueDate)).ToList();
            _recentInvoices = filtered.OrderByDescending(i => i.InvoiceDate).Take(10).ToList();
            _invoices = filtered.OrderByDescending(i => i.InvoiceDate).ToList();
            _pendingSupplierInvoices = nonUlak.Where(i => i.Status == "PENDING_SUPPLIER").ToList();
            _needsReviewInvoices = nonUlak.Where(i => i.Status == "NEEDS_REVIEW").ToList();

            // Aging buckets: pradelstos sąskaitos (PENDING, PARTIAL, OVERDUE) where PaidAmount < AmountInclVat and DueDate < today
            var today = DateTime.Today;
            var overdueInvoices = confirmedFiltered
                .Where(i => (i.Status == "PENDING" || i.Status == "PARTIAL" || i.Status == "OVERDUE")
                            && i.PaidAmount < i.AmountInclVat
                            && i.DueDate < today)
                .ToList();

            _expenseAgingBucket0To30 = CalculateBucket(overdueInvoices, 0, 30, today);
            _expenseAgingBucket31To60 = CalculateBucket(overdueInvoices, 31, 60, today);
            _expenseAgingBucket61To90 = CalculateBucket(overdueInvoices, 61, 90, today);
            _expenseAgingBucket90Plus = CalculateBucket(overdueInvoices, 91, 9999, today);
            _expenseAgingTotalVat = _expenseAgingBucket0To30.Vat + _expenseAgingBucket31To60.Vat + _expenseAgingBucket61To90.Vat + _expenseAgingBucket90Plus.Vat;

            var sids = _recentInvoices.Where(i => i.SupplierId.HasValue).Select(i => i.SupplierId!.Value).Distinct().ToList();
            if (sids.Any())
            {
                await using var ctx = DbFactory.CreateDbContext();
                _supplierNames = await ctx.BusinessPartners.Where(b => sids.Contains(b.Id)).ToDictionaryAsync(b => b.Id, b => b.Name);
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string GetSupplierDisplay(ExpenseInvoice inv)
    {
        if (inv.SupplierId.HasValue)
            return _supplierNames.GetValueOrDefault(inv.SupplierId.Value, "?");
        return inv.PendingSupplierName ?? "Nežinomas";
    }

    private (int Count, decimal ExclVat, decimal Vat, decimal InclVat) CalculateBucket(List<ExpenseInvoice> invoices, int minDays, int maxDays, DateTime today)
    {
        var bucket = invoices.Where(i =>
        {
            var daysOverdue = (today - i.DueDate.Date).Days;
            return daysOverdue >= minDays && daysOverdue <= maxDays;
        }).ToList();

        return (bucket.Count, bucket.Sum(i => i.AmountExclVat), bucket.Sum(i => i.VatAmount), bucket.Sum(i => i.AmountInclVat));
    }

    private async Task OpenInvoiceDetailAsync(ExpenseInvoice invoice)
    {
        var p = new DialogParameters { ["InvoiceId"] = invoice.Id };
        await DialogService.ShowAsync<InvoiceDetailDialog>("Sąskaita", p, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = true });
        await LoadDataAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _yearSubtitle = $"({DateTime.Today.Year} m.)";
        await LoadDataAsync();
    }
}