@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Helpers
@using NordicBeesERP.Services.Dtos
@inject IDeliveryService DeliveryService
@inject IContainerService ContainerService
@inject IHoneyTypeService HoneyTypeService
@inject ICustomerService CustomerService
@inject IWarehouseService WarehouseService
@inject IPaymentService PaymentService
@inject IInvoiceService InvoiceService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Lakštena ERP</PageTitle>

@if (_dbError)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        ⚠️ Nepavyko prisijungti prie duomenų bazės. Patikrinkite ryšį.
    </MudAlert>
}

<div style="padding:26px 32px 44px;display:flex;flex-direction:column;gap:20px">

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <!-- Admin / Manager: full dashboard -->
        <AuthorizeView Roles="Admin,Manager">
            <section style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px">
                <div class="lb-kpi-card">
                    <div class="lb-kpi-head">
                        <div class="lb-kpi-labelvalue">
                            <span class="lb-kpi-label">Statinės sandėlyje</span>
                            <div class="lb-kpi-valuerow">
                                <span class="lb-kpi-value">@FormatAmountHelper.Trim(_trendResult.BarrelsKg.CurrentValue, 0)</span>
                                <span class="lb-kpi-unit">kg</span>
                            </div>
                        </div>
                        <div style="@GetDeltaPillStyle(_trendResult.BarrelsKg.DeltaAbsolute)">@FormatDeltaPill(_trendResult.BarrelsKg.DeltaPercent)</div>
                    </div>
                    @if (BuildKpiPaths(_trendResult.BarrelsKg, out var barrelsLine, out var barrelsArea))
                    {
                        <div class="lb-kpi-spark">
                            <svg viewBox="0 0 240 46" preserveAspectRatio="none" style="width:100%;height:100%;display:block">
                                <path d="@barrelsArea" fill="#c47a10" opacity="0.09"></path>
                                <path d="@barrelsLine" fill="none" stroke="#c47a10" stroke-width="1.8" stroke-linecap="round"></path>
                            </svg>
                        </div>
                    }
                </div>
                <div class="lb-kpi-card">
                    <div class="lb-kpi-head">
                        <div class="lb-kpi-labelvalue">
                            <span class="lb-kpi-label">Kibirai sandėlyje</span>
                            <div class="lb-kpi-valuerow">
                                <span class="lb-kpi-value">@FormatAmountHelper.Trim(_trendResult.BucketsKg.CurrentValue, 0)</span>
                                <span class="lb-kpi-unit">kg</span>
                            </div>
                        </div>
                        <div style="@GetDeltaPillStyle(_trendResult.BucketsKg.DeltaAbsolute)">@FormatDeltaPill(_trendResult.BucketsKg.DeltaPercent)</div>
                    </div>
                    @if (BuildKpiPaths(_trendResult.BucketsKg, out var bucketsLine, out var bucketsArea))
                    {
                        <div class="lb-kpi-spark">
                            <svg viewBox="0 0 240 46" preserveAspectRatio="none" style="width:100%;height:100%;display:block">
                                <path d="@bucketsArea" fill="#2f7d6b" opacity="0.09"></path>
                                <path d="@bucketsLine" fill="none" stroke="#2f7d6b" stroke-width="1.8" stroke-linecap="round"></path>
                            </svg>
                        </div>
                    }
                </div>
                <div class="lb-kpi-card">
                    <div class="lb-kpi-head">
                        <div class="lb-kpi-labelvalue">
                            <span class="lb-kpi-label">Neįkainotos</span>
                            <div class="lb-kpi-valuerow">
                                <span class="lb-kpi-value">@_trendResult.UnpricedDeliveries.CurrentValue.ToString("N0")</span>
                                <span class="lb-kpi-unit">vnt.</span>
                            </div>
                        </div>
                        <div style="@GetDeltaPillStyle(_trendResult.UnpricedDeliveries.DeltaAbsolute)">@FormatDeltaPill(_trendResult.UnpricedDeliveries.DeltaPercent)</div>
                    </div>
                    @if (BuildKpiPaths(_trendResult.UnpricedDeliveries, out var unpricedLine, out var unpricedArea))
                    {
                        <div class="lb-kpi-spark">
                            <svg viewBox="0 0 240 46" preserveAspectRatio="none" style="width:100%;height:100%;display:block">
                                <path d="@unpricedArea" fill="#d9a13f" opacity="0.09"></path>
                                <path d="@unpricedLine" fill="none" stroke="#d9a13f" stroke-width="1.8" stroke-linecap="round"></path>
                            </svg>
                        </div>
                    }
                </div>
                <div class="lb-kpi-card">
                    <div class="lb-kpi-head">
                        <div class="lb-kpi-labelvalue">
                            <span class="lb-kpi-label">Skolos tiekėjams</span>
                            <div class="lb-kpi-valuerow">
                                <span class="lb-kpi-value">@FormatAmountHelper.Trim(_trendResult.SupplierDebtTotal.CurrentValue, 2)</span>
                                <span class="lb-kpi-unit">€</span>
                            </div>
                        </div>
                        <div style="@GetDeltaPillStyle(_trendResult.SupplierDebtTotal.DeltaAbsolute, invert: true)">@FormatDeltaPill(_trendResult.SupplierDebtTotal.DeltaPercent)</div>
                    </div>
                    @if (BuildKpiPaths(_trendResult.SupplierDebtTotal, out var debtLine, out var debtArea))
                    {
                        <div class="lb-kpi-spark">
                            <svg viewBox="0 0 240 46" preserveAspectRatio="none" style="width:100%;height:100%;display:block">
                                <path d="@debtArea" fill="#b3402f" opacity="0.09"></path>
                                <path d="@debtLine" fill="none" stroke="#b3402f" stroke-width="1.8" stroke-linecap="round"></path>
                            </svg>
                        </div>
                    }
                </div>
            </section>

            @if (_agingReport.Bucket90Plus.InvoiceCount > 0)
            {
                <MudAlert Severity="Severity.Warning" Style="background:var(--lakstena-accent-light);border-radius:16px">
                    <b>Dėmesio!</b> @_agingReport.Bucket90Plus.InvoiceCount sąskaita(-os) pradelsta daugiau nei 90 dienų (@FormatAmountHelper.Trim(_agingReport.Bucket90Plus.TotalAmount, 2) €).
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/invoices/sales?status=overdue" Class="ml-2">PERŽIŪRĖTI</MudButton>
                </MudAlert>
            }

            <section style="display:grid;grid-template-columns:minmax(0,1.62fr) minmax(0,1fr);gap:16px">
                <div style="background:#fff;border:1px solid rgba(27,25,23,.08);border-radius:18px;padding:22px 24px 18px;display:flex;flex-direction:column;gap:20px">
                    <h2 style="margin:0;font-size:15.5px;font-weight:600;letter-spacing:-.01em;color:var(--lakstena-text)">Laukiamos įplaukos</h2>
                    @if (_weeklyBars.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--lakstena-text-secondary)">Nėra duomenų</MudText>
                    }
                    else
                    {
                        <div style="display:flex;align-items:flex-end;gap:8px;height:232px">
                            @foreach (var week in _weeklyBars)
                            {
                                <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%">
                                    <span class="lakstena-mono" style="font-size:11px;color:rgba(27,25,23,.5);margin-bottom:6px">@week.FormattedAmount</span>
                                    <div style="width:100%;max-width:32px;height:@week.BarHeightPx.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)px;background:@week.Color;border-radius:4px 4px 0 0"></div>
                                    <span style="font-size:10px;color:rgba(27,25,23,.5);white-space:nowrap;margin-top:6px">@week.Label</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div style="background:#fff;border:1px solid rgba(27,25,23,.08);border-radius:18px;padding:22px 24px;display:flex;flex-direction:column;gap:18px">
                    <h2 style="margin:0;font-size:15.5px;font-weight:600;letter-spacing:-.01em;color:var(--lakstena-text)">Įsiskolinimų senėjimas</h2>
                    <div style="position:relative;width:132px;height:132px;margin:4px auto">
                        <div style="width:100%;height:100%;border-radius:50%;background:@AgingRingCss"></div>
                        <div style="position:absolute;inset:17px;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px">
                            <span class="lakstena-mono" style="font-weight:700;font-size:17px;color:var(--lakstena-text)">@FormatAmountHelper.Trim(_agingReport.TotalOverdue, 0)</span>
                            <span class="lakstena-mono" style="font-size:8.5px;letter-spacing:.06em;text-transform:uppercase;color:rgba(27,25,23,.4)">EUR be PVM</span>
                        </div>
                    </div>
                    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:10px 14px">
                        @foreach (var bucket in _agingLegend)
                        {
                            <div style="display:flex;align-items:center;gap:5px">
                                <span style="width:7px;height:7px;border-radius:50%;background:@bucket.Color;flex:none"></span>
                                <span style="font-size:11px;color:rgba(27,25,23,.55)">@bucket.Label</span>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <!-- Row 1: Sandėlio sudėtis | Paskutiniai pristatymai (two columns, side by side) -->
            <section style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:16px">
                <div class="lb-trend-card">
                    <h2 class="lb-trend-title">Sandėlio sudėtis</h2>
                    @if (WarehouseCompositionTotalKg > 0)
                    {
                        <div class="lb-stackbar">
                            @foreach (var ht in _honeyTypeStock.Where(x => x.BarrelKg + x.BucketKg > 0))
                            {
                                var totalKg = ht.BarrelKg + ht.BucketKg;
                                <div class="lb-stackbar-seg" style="flex:0 0 @(WarehouseCompositionPercent(totalKg).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))%;background:@ht.Color" title="@($"{ht.Name}: {totalKg:N1} kg")"></div>
                            }
                        </div>
                        <MudDivider Class="my-3" />
                        @foreach (var ht in _honeyTypeStock.Where(x => x.BarrelKg + x.BucketKg > 0))
                        {
                            var totalKg = ht.BarrelKg + ht.BucketKg;
                            <div class="d-flex align-center justify-space-between pa-1">
                                <div class="d-flex align-center">
                                    <div style="width:12px;height:12px;border-radius:3px;margin-right:8px;background:@ht.Color"></div>
                                    <MudText Typo="Typo.body2">@ht.Name</MudText>
                                </div>
                                <MudText Typo="Typo.body2" Style="font-family:'Geist Mono',monospace; font-variant-numeric:tabular-nums">
                                    @totalKg.ToString("N1") kg ·
                                    @WarehouseCompositionPercent(totalKg).ToString("0.0") %
                                </MudText>
                            </div>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--lakstena-text-secondary)">Sandėlyje kol kas nėra supakuotų medaus kiekių.</MudText>
                    }
                </div>

                <div class="lb-trend-card">
                    <h2 class="lb-trend-title">Paskutiniai pristatymai</h2>
                    <MudTable T="Delivery" Items="_recentDeliveries" Dense="true" Hover="true" Striped="true"
                        OnRowClick="@((TableRowClickEventArgs<Delivery> args) => { if (IsDoubleClick(args.Item)) Navigation.NavigateTo($"/warehouse/deliveries/{args.Item.Id}"); })"
                        Style="cursor:pointer">
                        <HeaderContent>
                            <MudTh>Nr.</MudTh>
                            <MudTh>Data</MudTh>
                            <MudTh>Tiekėjas</MudTh>
                            <MudTh Style="text-align:right">Netto (kg)</MudTh>
                            <MudTh Style="text-align:right">Suma (€)</MudTh>
                            <MudTh>Statusas</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="d">
                            <MudTd>@d.DeliveryNumber</MudTd>
                            <MudTd>@d.DeliveryDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd>@GetSupplierName(d.SupplierId)</MudTd>
                            <MudTd Style="text-align:right">@d.TotalNetWeight.ToString("N1")</MudTd>
                            <MudTd Style="text-align:right">@FormatAmountHelper.Trim(d.TotalAmount, 2)</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@StatusDisplayHelper.GetColor(d.Status, _statusDisplay)" Style="font-size:0.75rem">
                                    @StatusDisplayHelper.GetLabel(d.Status, _statusDisplay)
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            </section>

            <!-- Row 2: LEFT = trend charts stacked; RIGHT = Greiti veiksmai + Reikalauja dėmesio stacked -->
            <section style="display:grid;grid-template-columns:minmax(0,1.62fr) minmax(0,1fr);gap:16px">
                <div style="display:flex;flex-direction:column;gap:16px">
                    <div class="lb-trend-card">
                        <div class="lb-trend-head">
                            <h2 class="lb-trend-title">Pirkimų apimtis</h2>
                            <div class="lb-trend-legend">
                                <span class="lb-trend-legend-item"><span class="lb-trend-swatch lb-trend-swatch-solid" style="background:#c47a10"></span>@_curYear</span>
                                <span class="lb-trend-legend-item"><span class="lb-trend-swatch lb-trend-swatch-dashed"></span>@_prevYear</span>
                            </div>
                        </div>
                        @{ var purchase = BuildTrendChart(_purchaseCurrentYear, _purchasePreviousYear); }
                        @if (!purchase.hasPeak)
                        {
                            <MudText Typo="Typo.body2" Style="color:var(--lakstena-text-secondary)">Nėra duomenų</MudText>
                        }
                        else
                        {
                            <div class="lb-trend-chart">
                                <svg viewBox="0 0 720 172" preserveAspectRatio="none" style="width:100%;height:100%;display:block">
                                    <defs>
                                        <linearGradient id="lbPurchaseAreaGrad" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-color="#c47a10" stop-opacity="0.22" />
                                            <stop offset="100%" stop-color="#c47a10" stop-opacity="0" />
                                        </linearGradient>
                                    </defs>
                                    <path d="@purchase.areaPath" fill="url(#lbPurchaseAreaGrad)"></path>
                                    <path d="@purchase.prevLinePath" fill="none" stroke="rgba(27,25,23,.22)" stroke-width="1.6" stroke-dasharray="4 4" stroke-linecap="round"></path>
                                    <path d="@purchase.curLinePath" fill="none" stroke="#c47a10" stroke-width="2.6" stroke-linecap="round"></path>
                                    <circle cx="@purchase.peakX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" cy="@purchase.peakY.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" r="3.5" fill="#fff" stroke="#c47a10" stroke-width="2"></circle>
                                </svg>
                            </div>
                        }
                        <div class="lb-trend-months">
                            @foreach (var m in _monthLabels)
                            {
                                <span>@m</span>
                            }
                        </div>
                    </div>

                    <div class="lb-trend-card">
                        <div class="lb-trend-head">
                            <h2 class="lb-trend-title">Pardavimų apimtis</h2>
                            <div class="lb-trend-legend">
                                <span class="lb-trend-legend-item"><span class="lb-trend-swatch lb-trend-swatch-solid" style="background:#2f7d6b"></span>@_curYear</span>
                                <span class="lb-trend-legend-item"><span class="lb-trend-swatch lb-trend-swatch-dashed"></span>@_prevYear</span>
                            </div>
                        </div>
                        @{ var sales = BuildTrendChart(_salesCurrentYear, _salesPreviousYear); }
                        @if (!sales.hasPeak)
                        {
                            <MudText Typo="Typo.body2" Style="color:var(--lakstena-text-secondary)">Nėra duomenų</MudText>
                        }
                        else
                        {
                            <div class="lb-trend-chart">
                                <svg viewBox="0 0 720 172" preserveAspectRatio="none" style="width:100%;height:100%;display:block">
                                    <defs>
                                        <linearGradient id="lbSalesAreaGrad" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-color="#2f7d6b" stop-opacity="0.22" />
                                            <stop offset="100%" stop-color="#2f7d6b" stop-opacity="0" />
                                        </linearGradient>
                                    </defs>
                                    <path d="@sales.areaPath" fill="url(#lbSalesAreaGrad)"></path>
                                    <path d="@sales.prevLinePath" fill="none" stroke="rgba(27,25,23,.22)" stroke-width="1.6" stroke-dasharray="4 4" stroke-linecap="round"></path>
                                    <path d="@sales.curLinePath" fill="none" stroke="#2f7d6b" stroke-width="2.6" stroke-linecap="round"></path>
                                    <circle cx="@sales.peakX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" cy="@sales.peakY.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" r="3.5" fill="#fff" stroke="#2f7d6b" stroke-width="2"></circle>
                                </svg>
                            </div>
                        }
                        <div class="lb-trend-months">
                            @foreach (var m in _monthLabels)
                            {
                                <span>@m</span>
                            }
                        </div>
                    </div>
                </div>

                <div style="display:flex;flex-direction:column;gap:16px">
                    <div class="lb-trend-card">
                        <h2 class="lb-trend-title">Greiti veiksmai</h2>
                        <div class="lb-quick-actions">
                            <button class="lb-quick-action" @onclick="GoDeliveriesNew">
                                <span class="lb-quick-action-icon" style="background:rgba(196,122,16,.12);color:#c47a10"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /></span>
                                <span class="lb-quick-action-label">Naujas pristatymas</span>
                            </button>
                            <button class="lb-quick-action" @onclick="GoStock">
                                <span class="lb-quick-action-icon" style="background:rgba(196,122,16,.12);color:#c47a10"><MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" /></span>
                                <span class="lb-quick-action-label">Sandėlio likučiai</span>
                            </button>
                            <button class="lb-quick-action" @onclick="GoPricing">
                                <span class="lb-quick-action-icon" style="background:rgba(196,122,16,.12);color:#c47a10"><MudIcon Icon="@Icons.Material.Filled.PriceCheck" Size="Size.Small" /></span>
                                <span class="lb-quick-action-label">Kainos</span>
                            </button>
                            <button class="lb-quick-action" @onclick="GoDebts">
                                <span class="lb-quick-action-icon" style="background:rgba(196,122,16,.12);color:#c47a10"><MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" /></span>
                                <span class="lb-quick-action-label">Skolos</span>
                            </button>
                        </div>
                    </div>

                    <div class="lb-trend-card">
                        <h2 class="lb-trend-title">Reikalauja dėmesio</h2>
                        <div class="lb-attention-list">
                            @if (_agingReport.Bucket90Plus.InvoiceCount > 0)
                            {
                                <div class="lb-attention-item">
                                    <span class="lb-attention-bar" style="background:#b3402f"></span>
                                    <span class="lb-attention-num">@FormatAmountHelper.Trim(_agingReport.Bucket90Plus.TotalAmount, 0)</span>
                                    <span class="lb-attention-label">Pradelstos sąskaitos virš 90 d.<br>@_agingReport.Bucket90Plus.InvoiceCount sąsk.</span>
                                </div>
                            }
                            @if (_unpricedDeliveries > 0)
                            {
                                <div class="lb-attention-item">
                                    <span class="lb-attention-bar" style="background:#c47a10"></span>
                                    <span class="lb-attention-num">@_unpricedDeliveries</span>
                                    <span class="lb-attention-label">Neįkainoti pristatymai</span>
                                </div>
                            }
                            @if (_totalDebt > 0)
                            {
                                <div class="lb-attention-item">
                                    <span class="lb-attention-bar" style="background:#d9a13f"></span>
                                    <span class="lb-attention-num">@FormatAmountHelper.Trim(_totalDebt, 0)</span>
                                    <span class="lb-attention-label">Skolos tiekėjams<br>@_suppliersWithDebt tiekėjai(-ų)</span>
                                </div>
                            }
                            @if (_agingReport.Bucket61To90.InvoiceCount > 0)
                            {
                                <div class="lb-attention-item">
                                    <span class="lb-attention-bar" style="background:#c9761f"></span>
                                    <span class="lb-attention-num">@FormatAmountHelper.Trim(_agingReport.Bucket61To90.TotalAmount, 0)</span>
                                    <span class="lb-attention-label">Pradelstos sąskaitos 61–90 d.<br>@_agingReport.Bucket61To90.InvoiceCount sąsk.</span>
                                </div>
                            }
                            @if (_navBadgeCounts.UnmatchedBankImports > 0)
                            {
                                <div class="lb-attention-item">
                                    <span class="lb-attention-bar" style="background:#2f7d6b"></span>
                                    <span class="lb-attention-num">@_navBadgeCounts.UnmatchedBankImports</span>
                                    <span class="lb-attention-label">Nesudengtos banko importo eilutės</span>
                                </div>
                            }
                            @if (_agingReport.Bucket90Plus.InvoiceCount == 0 && _unpricedDeliveries == 0 && _totalDebt <= 0 && _agingReport.Bucket61To90.InvoiceCount == 0 && _navBadgeCounts.UnmatchedBankImports == 0)
                            {
                                <MudText Typo="Typo.body2" Style="color:var(--lakstena-text-secondary)">Šiuo metu dėmesio nereikalaujančių įrašų nėra.</MudText>
                            }
                        </div>
                    </div>
                </div>
            </section>
        </AuthorizeView>

        <!-- Warehouse: simplified dashboard -->
        <AuthorizeView Roles="Warehouse">
            <MudGrid Class="mb-6">
                <MudItem xs="6" md="6">
                    <MudPaper Class="pa-4" Elevation="0" Style="background:var(--lakstena-accent-light); border-radius:16px; cursor:pointer"
                        @onclick="@(() => Navigation.NavigateTo("/warehouse/stock"))">
                        <MudText Typo="Typo.caption" Style="color:var(--lakstena-text-secondary)">Statinės sandėlyje</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight:700">@_barrelCount vnt.</MudText>
                        <MudText Typo="Typo.body2" Style="color:var(--lakstena-text-secondary)">@_barrelNetWeight.ToString("N0") kg netto</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="6">
                    <MudPaper Class="pa-4" Elevation="0" Style="background:#eef3ee; border-radius:16px; cursor:pointer"
                        @onclick="@(() => Navigation.NavigateTo("/warehouse/stock"))">
                        <MudText Typo="Typo.caption" Style="color:var(--lakstena-text-secondary)">Kibirai sandėlyje</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight:700">@_bucketCount vnt.</MudText>
                        <MudText Typo="Typo.body2" Style="color:var(--lakstena-text-secondary)">@_bucketNetWeight.ToString("N0") kg netto</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <h2 class="lb-trend-title" Style="margin-top:24px">Sandėlio sudėtis</h2>
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:16px">
                @if (WarehouseCompositionTotalKg > 0)
                {
                    <div class="lb-stackbar">
                        @foreach (var ht in _honeyTypeStock.Where(x => x.BarrelKg + x.BucketKg > 0))
                        {
                            var totalKg = ht.BarrelKg + ht.BucketKg;
                            <div class="lb-stackbar-seg" style="flex:0 0 @(WarehouseCompositionPercent(totalKg).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))%;background:@ht.Color" title="@($"{ht.Name}: {totalKg:N1} kg")"></div>
                        }
                    </div>
                    <MudDivider Class="my-3" />
                    @foreach (var ht in _honeyTypeStock.Where(x => x.BarrelKg + x.BucketKg > 0))
                    {
                        var totalKg = ht.BarrelKg + ht.BucketKg;
                        <div class="d-flex align-center justify-space-between pa-1">
                            <div class="d-flex align-center">
                                <div style="width:12px;height:12px;border-radius:3px;margin-right:8px;background:@ht.Color"></div>
                                <MudText Typo="Typo.body2">@ht.Name</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="font-family:'Geist Mono',monospace; font-variant-numeric:tabular-nums">
                                @totalKg.ToString("N1") kg ·
                                @WarehouseCompositionPercent(totalKg).ToString("0.0") %
                            </MudText>
                        </div>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="color:var(--lakstena-text-secondary)">Sandėlyje kol kas nėra supakuotų medaus kiekių.</MudText>
                }
            </MudPaper>

            <h2 class="lb-trend-title" Style="margin-top:24px">Greiti veiksmai</h2>
            <div class="lb-quick-actions">
                <button class="lb-quick-action" @onclick="GoDeliveriesNew">
                    <span class="lb-quick-action-icon" style="background:rgba(196,122,16,.12);color:#c47a10"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /></span>
                    <span class="lb-quick-action-label">Naujas pristatymas</span>
                </button>
                <button class="lb-quick-action" @onclick="GoStock">
                    <span class="lb-quick-action-icon" style="background:rgba(196,122,16,.12);color:#c47a10"><MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" /></span>
                    <span class="lb-quick-action-label">Sandėlio likučiai</span>
                </button>
                <button class="lb-quick-action" @onclick="GoDeliveriesList">
                    <span class="lb-quick-action-icon" style="background:rgba(196,122,16,.12);color:#c47a10"><MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" /></span>
                    <span class="lb-quick-action-label">Pristatymai</span>
                </button>
                <button class="lb-quick-action" @onclick="GoTransfers">
                    <span class="lb-quick-action-icon" style="background:rgba(196,122,16,.12);color:#c47a10"><MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" /></span>
                    <span class="lb-quick-action-label">Perkėlimai</span>
                </button>
            </div>
        </AuthorizeView>
    }
</div>

@code {
    private bool _dbError = false;
    private bool _loading = true;
    private int _barrelCount;
    private decimal _barrelNetWeight;
    private int _bucketCount;
    private decimal _bucketNetWeight;
    private int _unpricedDeliveries;
    private decimal _totalDebt;
    private int _suppliersWithDebt;
    private List<Delivery> _recentDeliveries = new();
    private List<NordicBeesERP.Models.BusinessPartner> _suppliers = new();
    private List<(string Name, string Color, decimal BarrelKg, decimal BucketKg)> _honeyTypeStock = new();
    private DateTime _lastClickTime = DateTime.MinValue;
    private object? _lastClickItem;

    private DashboardTrendResult _trendResult = new();
    private NavBadgeCounts _navBadgeCounts = new();
    private List<CashFlowWeek> _cashFlowForecast = new();
    private AgingReport _agingReport = new();

    // ----- KPI sparkline SVG path builder (shared by the 4 KPI cards) -----
    private static bool BuildKpiPaths(DashboardKpiTrend trend, out string linePath, out string areaPath)
    {
        var values = trend.Series.Select(p => p.Value).ToArray();
        if (values.Length < 2)
        {
            // Single point: flat horizontal line at vertical midpoint
            linePath = "M0 23 L240 23";
            areaPath = "";
            return true;
        }
        var (line, area) = ChartMathHelper.BuildSparkPath(values, 240, 46);
        linePath = line;
        areaPath = area;
        return true;
    }

    // ----- Weekly revenue bars (overdue + cash-flow weeks) -----
    private List<(string Label, decimal Amount, string Color, double BarHeightPx, string FormattedAmount)> _weeklyBars = new();

    private void BuildWeeklyBars()
    {
        var bars = new List<(string Label, decimal Amount, string Color)>();
        if (_agingReport.TotalOverdue > 0)
            bars.Add(("Pradelsta", _agingReport.TotalOverdue, "#b3402f"));
        for (var i = 0; i < _cashFlowForecast.Count; i++)
        {
            var w = _cashFlowForecast[i];
            bars.Add((w.WeekStart.ToString("MM/dd"), w.ExpectedIncome, i == 0 ? "#c47a10" : "rgba(217,161,63,.42)"));
        }
        var maxAmount = bars.Count > 0 ? bars.Max(b => b.Amount) : 0m;
        _weeklyBars = bars.Select(b => (b.Label, b.Amount, b.Color,
            maxAmount > 0 ? (double)(b.Amount / maxAmount * 192m) : 0.0,
            FormatAmountHelper.Trim(b.Amount, 0) + " €")).ToList();
    }

    // ----- Aging donut legend (color dot + bucket label) -----
    private IEnumerable<(string Color, string Label)> _agingLegend => new[]
    {
        ("#2f7d6b", "0-30"),
        ("#d9a13f", "31-60"),
        ("#c9761f", "61-90"),
        ("#b3402f", "90+")
    };

    // ----- Debt-aging donut ring (conic-gradient) -----
    private string AgingRingCss
    {
        get
        {
            var buckets = new (string Color, decimal Value)[]
            {
                ("#2f7d6b", _agingReport.Bucket0To30.TotalAmount),
                ("#d9a13f", _agingReport.Bucket31To60.TotalAmount),
                ("#c9761f", _agingReport.Bucket61To90.TotalAmount),
                ("#b3402f", _agingReport.Bucket90Plus.TotalAmount)
            };
            var total = buckets.Sum(b => b.Value);
            if (total <= 0) return "rgba(27,25,23,.08)";
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            var acc = 0m;
            var stops = new List<string>();
            foreach (var (color, value) in buckets)
            {
                if (value <= 0) continue;
                var from = (acc / total) * 100m;
                var to = ((acc + value) / total) * 100m;
                stops.Add($"{color} {from.ToString("0.##", inv)}% {to.ToString("0.##", inv)}%");
                acc += value;
            }
            return "conic-gradient(from -90deg, " + string.Join(", ", stops) + ")";
        }
    }

    private bool IsDoubleClick(object item)
    {
        var now = DateTime.Now;
        if (_lastClickItem == item && (now - _lastClickTime).TotalMilliseconds < 400)
        {
            _lastClickItem = null;
            return true;
        }
        _lastClickItem = item;
        _lastClickTime = now;
        return false;
    }

    private static readonly string[] _cardColors = {
        "#dbeafe", "#f0fdf4", "#fef3c7", "#fce7f3", "#ede9fe", "#ffedd5", "#cffafe", "#dcfce7"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.IsInRole("Designer"))
        {
            Navigation.NavigateTo("/artwork/gallery");
            return;
        }

        try
        {
            var deliveries = await DeliveryService.GetAllAsync();
            _suppliers = await CustomerService.GetSuppliersAsync();

            var allContainers = await ContainerService.GetFilteredAsync(null, null, null, "IN_STOCK", null);
            _barrelCount = allContainers.Count(c => c.ContainerType == "BARREL");
            _barrelNetWeight = allContainers.Where(c => c.ContainerType == "BARREL").Sum(c => c.NetWeight);
            _bucketCount = allContainers.Count(c => c.ContainerType == "BUCKET_GROUP");
            _bucketNetWeight = allContainers.Where(c => c.ContainerType == "BUCKET_GROUP").Sum(c => c.NetWeight);
            _unpricedDeliveries = deliveries.Count(d => d.Status == "RECEIVED");
            _totalDebt = deliveries.Sum(d => Math.Max(0, d.TotalAmount - d.PaidAmount));
            _suppliersWithDebt = deliveries.Where(d => d.TotalAmount - d.PaidAmount > 0).Select(d => d.SupplierId).Distinct().Count();
            _recentDeliveries = deliveries.Take(10).ToList();

            var honeyTypes = await HoneyTypeService.GetAllAsync();
            _honeyTypeStock = honeyTypes.Select(ht => (
                Name: ht.Name,
                Color: ht.Color ?? "#f8fafc",
                BarrelKg: allContainers.Where(c => c.HoneyTypeId == ht.Id && c.ContainerType == "BARREL").Sum(c => c.NetWeight),
                BucketKg: allContainers.Where(c => c.HoneyTypeId == ht.Id && c.ContainerType == "BUCKET_GROUP").Sum(c => c.NetWeight)
            )).ToList();

            // "Laukiamos įplaukos" is always exactly 7 bars (overdue + next 6 weeks),
            // independent of the header's 30d/90d/12mėn period selector.
            var trendTask = PaymentService.GetDashboardTrendAsync(_barrelNetWeight, _bucketNetWeight, _unpricedDeliveries, _totalDebt);
            var cashFlowTask = PaymentService.GetCashFlowForecastAsync(weeks: 6);
            var agingTask = PaymentService.GetAgingReportAsync();
            var badgeTask = PaymentService.GetNavBadgeCountsAsync();
            var salesVolumeTask = InvoiceService.GetMonthlySalesVolumeAsync(_prevYear, _curYear);
            await Task.WhenAll(trendTask, cashFlowTask, agingTask, badgeTask, salesVolumeTask);
            _trendResult = await trendTask;
            _cashFlowForecast = await cashFlowTask;
            _agingReport = await agingTask;
            _navBadgeCounts = await badgeTask;

            BuildWeeklyBars();
            BuildPurchaseVolume(deliveries);
            BuildSalesVolume(await salesVolumeTask);
            _loading = false;
        }
        catch (Exception ex)
        {
            _dbError = true;
            _ = ex;
        }
    }

    private string GetSupplierName(int id) => _suppliers.FirstOrDefault(s => s.Id == id)?.Name ?? $"#{id}";

    private static readonly Dictionary<string, (string Label, Color Color)> _statusDisplay = new()
    {
        { "RECEIVED", ("Priimtas", Color.Default) },
        { "PRICED", ("Įkainotas", Color.Info) },
        { "PARTIAL_PAID", ("Dalinai", Color.Warning) },
        { "PAID", ("Apmokėtas", Color.Success) }
    };

    private string GetUnpricedStyle() => _unpricedDeliveries > 0 ? "font-weight:700; color:#d97706" : "font-weight:700";

    private string GetDebtBackgroundStyle() => _totalDebt > 0
        ? "background:#fee2e2; border-radius:12px; cursor:pointer"
        : "background:#f0fdf4; border-radius:12px; cursor:pointer";

    private string GetDebtStyle() => _totalDebt > 0
        ? "font-weight:700; color:#dc2626"
        : "font-weight:700; color:#16a34a";

    // ----- KPI delta pill (top-right of each KPI card) -----
    private const string PillBaseStyle = "display:flex;align-items:center;gap:4px;padding:4px 8px;border-radius:99px;font-family:'Geist Mono',monospace;font-size:11px;font-weight:600;";

    private string FormatDeltaPill(decimal? deltaPercent)
    {
        if (!deltaPercent.HasValue) return "—";
        var sign = deltaPercent.Value >= 0 ? "+" : "";
        return $"{sign}{deltaPercent.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%";
    }

    // `invert` flips the good/bad color mapping for KPIs where a rising value is undesirable (e.g. debt).
    private string GetDeltaPillStyle(decimal? deltaAbs, bool invert = false)
    {
        if (!deltaAbs.HasValue) return PillBaseStyle + "background:rgba(27,25,23,.06);color:rgba(27,25,23,.45)";
        var isGood = invert ? deltaAbs.Value <= 0 : deltaAbs.Value >= 0;
        return isGood
            ? PillBaseStyle + "background:rgba(95,143,127,.14);color:#3f6c5d"
            : PillBaseStyle + "background:rgba(179,64,47,.12);color:#b3402f";
    }

    private decimal WarehouseCompositionTotalKg => _honeyTypeStock.Sum(ht => ht.BarrelKg + ht.BucketKg);

    private double WarehouseCompositionPercent(decimal kg)
        => WarehouseCompositionTotalKg > 0 ? (double)Math.Round(kg / WarehouseCompositionTotalKg * 100m, 1) : 0;

    // ===== "Pirkimų apimtis" / "Pardavimų apimtis" trend charts (12-month curve(), current vs previous year) =====

    private readonly int _curYear = DateTime.Today.Year;
    private readonly int _prevYear = DateTime.Today.Year - 1;

    private static readonly string[] _monthLabels = Enumerable.Range(1, 12)
        .Select(m => new DateTime(2001, m, 1).ToString("MMM", System.Globalization.CultureInfo.GetCultureInfo("lt-LT")))
        .ToArray();

    private decimal[] _purchaseCurrentYear = new decimal[12];
    private decimal[] _purchasePreviousYear = new decimal[12];
    private decimal[] _salesCurrentYear = new decimal[12];
    private decimal[] _salesPreviousYear = new decimal[12];

    private void BuildPurchaseVolume(List<Delivery> deliveries)
    {
        var current = new decimal[12];
        var previous = new decimal[12];
        foreach (var d in deliveries)
        {
            if (d.DeliveryDate.Year == _curYear)
                current[d.DeliveryDate.Month - 1] += d.TotalNetWeight;
            else if (d.DeliveryDate.Year == _prevYear)
                previous[d.DeliveryDate.Month - 1] += d.TotalNetWeight;
        }
        _purchaseCurrentYear = current;
        _purchasePreviousYear = previous;
    }

    private void BuildSalesVolume(List<MonthlyVolumePoint> points)
    {
        var current = new decimal[12];
        var previous = new decimal[12];
        foreach (var p in points)
        {
            if (p.Year == _curYear)
                current[p.Month - 1] += p.NetKg;
            else if (p.Year == _prevYear)
                previous[p.Month - 1] += p.NetKg;
        }
        _salesCurrentYear = current;
        _salesPreviousYear = previous;
    }

    // Ported from the mockup's curve(): smooth bezier line + gradient area for the current
    // year, dashed line for the previous year, and a peak marker on the current-year max.
    private static (string areaPath, string curLinePath, string prevLinePath, double peakX, double peakY, bool hasPeak) BuildTrendChart(
        decimal[] current, decimal[] previous, double w = 720, double h = 172)
    {
        var max = Math.Max(current.Max(), previous.Max());
        if (max <= 0m)
            return ("", "", "", 0, 0, false);

        var curLine = ChartMathHelper.BuildSmoothPath(current, w, h, max);
        var areaPath = ChartMathHelper.BuildSmoothAreaPath(curLine, w, h);
        var prevLine = ChartMathHelper.BuildSmoothPath(previous, w, h, max);

        var peakIndex = Array.IndexOf(current, current.Max());
        var (peakX, peakY) = ChartMathHelper.CurvePoint(current, peakIndex, w, h, max);

        return (areaPath, curLine, prevLine, peakX, peakY, true);
    }

    // ===== Admin "Greiti veiksmai" quick-action navigation =====

    private void GoDeliveriesNew() => Navigation.NavigateTo("/warehouse/deliveries/new");
    private void GoStock() => Navigation.NavigateTo("/warehouse/stock");
    private void GoDeliveriesList() => Navigation.NavigateTo("/warehouse/deliveries");
    private void GoTransfers() => Navigation.NavigateTo("/warehouse/stock?view=TRANSFERS");
    private void GoPricing() => Navigation.NavigateTo("/warehouse/delivery-pricing");
    private void GoDebts() => Navigation.NavigateTo("/warehouse/supplier-debts");
}
