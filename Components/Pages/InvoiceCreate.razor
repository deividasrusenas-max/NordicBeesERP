@page "/invoices/create"
@page "/invoices/create-purchase"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using NordicBeesERP.Components.Dialogs
@using MudBlazor
@using NordicBeesERP.Models.WarehouseModule
@inject IDeliveryService DeliveryService
@inject IInvoiceService _invoiceService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISupplierService SupplierService
@inject IRawMaterialTypeService RawMaterialTypeService

<PageTitle>@(_isPurchase ? "Nauja pirkimo sąskaita (ULAK)" : "Naujas pardavimas (LAK)")</PageTitle>

<!-- HEADER (sticky, outside MudContainer) -->
<div style="position:sticky; top:64px; z-index:100; background:#ffffff; padding:12px 24px; border-bottom:1px solid #e2e8f0;">
    <div class="d-flex justify-space-between align-center" style="max-width:1600px; margin:0 auto;">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight:600">@_nextInvoiceNumber</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">@(_isPurchase ? "Nauja pirkimo sąskaita (ULAK)" : "Nauja pardavimo sąskaita (LAK)")</MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none" StartIcon="@Icons.Material.Filled.Save" OnClick="@SaveInvoice">Išsaugoti</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Style="text-transform:none" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="@SaveAndGeneratePdf">Išsaugoti + PDF</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="@Cancel">Atšaukti</MudButton>
        </div>
    </div>
</div>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@(_errorMessage ?? "")</MudAlert>
    }

    <!-- PAGRINDINĖ INFORMACIJA section -->
    <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px" Class="mb-4">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Pagrindinė informacija</MudText>
        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudTextField T="string" Label="Sąskaitos numeris *" Value="@_nextInvoiceNumber" 
                              ReadOnly="@_invoiceNumberLocked" Variant="Variant.Outlined" Margin="Margin.Dense"
                              ValueChanged="@OnInvoiceNumberManuallyChanged"
                              @ondblclick="@OnInvoiceNumberDoubleClick" />
                @if (!_invoiceNumberLocked)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">Rankinis numeris — bus patikrintas unikalumas išsaugant.</MudText>
                }
            </MudItem>
            <MudItem xs="12" sm="3">
<MudDatePicker Label="Išrašymo data *" Date="@_invoiceDate" Editable="true" DateFormat="yyyy-MM-dd"
                                Variant="Variant.Outlined" Required="true" 
                                DateChanged="@(date => UpdateDueDate(date))" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
<MudNumericField T="int" Label="Apmokėjimo terminas (dienų) *" Value="@_paymentTermDays" 
                                  Variant="Variant.Outlined" Min="0" @key="_selectedCustomerId"
                                  ValueChanged="@(days => UpdateDueDate(days))" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
            <MudText Typo="Typo.body1" Color="Color.Secondary">Apmokėti iki</MudText>
            <MudText Typo="Typo.body1">@(_paymentDueDate?.ToString("yyyy-MM-dd") ?? "—")</MudText>
            </MudItem>
              @if (!_isPurchase)
              {
                  <MudItem xs="12" sm="6">
                     <MudAutocomplete T="Customer" Label="Klientas *" Value="_selectedCustomer"
                                     SearchFunc="@SearchCustomers"
                                      ToStringFunc="@FormatCustomerDisplay"
                                     ValueChanged="OnClientSelected"
                                     @bind-Text="_clientSearchText"
                                      SelectValueOnTab="true"
                                       OnBlur="@(() => TryResolveSelectedCustomerFromText())"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.Search"
                                       OnAdornmentClick="@OpenClientDialog"
                                       @ref="_clientAutocomplete"
                                     Variant="Variant.Outlined" Required="true" Clearable="true"
                                     Placeholder="Pasirinkite klientą..." Margin="Margin.Dense" />
                  </MudItem>
              }
            else
            {
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Label="Tiekėjas *" Value="_selectedSupplierId"
                               Variant="Variant.Outlined" Required="true" Placeholder="Pasirinkite tiekėją"
                               ValueChanged="OnSupplierSelected" Margin="Margin.Dense">
                        @foreach (var s in _suppliers)
                        {
                            <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Label="Pristatymas" 
                               Value="_selectedDeliveryId"
                               ValueChanged="OnDeliverySelected"
                               Variant="Variant.Outlined"
                               Placeholder="Pasirinkite pristatymą"
                               Disabled="@(_selectedSupplierId == null)" Margin="Margin.Dense">
                        @foreach (var d in _supplierDeliveries)
                        {
                            <MudSelectItem T="int?" Value="@((int?)d.Id)">
                                @d.DeliveryNumber — @d.DeliveryDate.ToString("yyyy-MM-dd") — @d.TotalNetWeight kg
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" sm="2">
                <MudSelect T="string" Label="Kalba" @bind-Value="_language" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("LT")">LT</MudSelectItem>
                    <MudSelectItem T="string" Value="@("EN")">EN</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="Sąskaitos tipas" Value="@_invoiceType" 
                           Variant="Variant.Outlined" ValueChanged="@OnInvoiceTypeChanged"
                           Disabled="@_isPurchase" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("PVM SĄSKAITA FAKTŪRA")">PVM sąskaita faktūra</MudSelectItem>
                    <MudSelectItem T="string" Value="@("6% PVM SĄSKAITA FAKTŪRA")">ULAK 6% PVM</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- PREKIŲ LENTELĖ section -->
    <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px" Class="mb-4">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">@(_isPurchase ? "Žaliavos" : "Prekės")</MudText>
        <MudTable T="InvoiceLineInput" Items="@_lines" Hover="true" Dense="true" Bordered="true">
            <HeaderContent>
                <MudTh Style="width: 5%;">Nr.</MudTh>
                <MudTh Style="width: 35%;">Prekė *</MudTh>
                <MudTh Style="width: 10%;">Kiekis *</MudTh>
                <MudTh Style="width: 8%;">Vnt.</MudTh>
                <MudTh Style="width: 12%;">Kaina (be PVM) *</MudTh>
                <MudTh Style="width: 8%;">PVM %</MudTh>
                <MudTh Style="width: 12%;">Suma (su PVM)</MudTh>
                <MudTh Style="width: 8%;"></MudTh>
            </HeaderContent>
            <RowTemplate Context="line">
                <MudTd DataLabel="Nr.">@(_lines.IndexOf(line) + 1)</MudTd>
                <MudTd DataLabel="Prekė">
                    <MudAutocomplete T="Product"
                                     Value="@line.SelectedProduct"
                                     SearchFunc="SearchProducts"
                                     ToStringFunc="@(p => p?.Name)"
                                      @bind-Text="line.Description"
                                      CoerceText="false"
                                      ValueChanged="@(product => OnProductSelected(product, line))"
                                     Variant="Variant.Text"
                                     Margin="Margin.Dense"
                                     Dense="true"
                                     Clearable="true"
                                     Placeholder="Ieškoti produkto..."
                                     Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                     OnAdornmentClick="@(async () => { if (_isPurchase) await OpenRawMaterialDialog(line); else await OpenProductDialog(line); })"
                                     @ondblclick="@((MouseEventArgs args) => HandleProductDoubleClick(args, line))">
                        <ItemTemplate>
                           <MudText Typo="Typo.body2">@context.Name (@context.Code)</MudText>
                       </ItemTemplate>
                   </MudAutocomplete>
                </MudTd>
                <MudTd DataLabel="Kiekis">
                    <MudNumericField T="decimal" Value="@line.Quantity" Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" onfocus="this.select()" Min="0" Step="1M"
                                     ValueChanged="@((decimal val) => { line.Quantity = val; CalculateLine(line); })" />
                </MudTd>
                <MudTd DataLabel="Vnt.">
                    <MudTextField T="string" @bind-Value="line.Unit" Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" ReadOnly="true" />
                </MudTd>
                <MudTd DataLabel="Kaina">
                    <MudNumericField T="decimal" Value="@line.PriceExclVat" Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" onfocus="this.select()" Min="0" Step="0.01M"
                                     ValueChanged="@((decimal val) => { line.PriceExclVat = val; CalculateLine(line); })" />
                </MudTd>
                <MudTd DataLabel="PVM %">
                    <MudNumericField T="decimal" Value="@line.VatRate" Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" onfocus="this.select()" Min="0" Step="1M" Format="G29"
                                     @key="(line, _selectedCustomerId)"
                                     ValueChanged="@((decimal val) => { line.VatRate = val; CalculateLine(line); })" />
                </MudTd>
                <MudTd DataLabel="Suma">
                    <MudTextField T="string" Value="@(line.LineTotal % 1 == 0 ? line.LineTotal.ToString("N0") : line.LineTotal.ToString("N2"))" Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" ReadOnly="true" />
                </MudTd>
                <MudTd DataLabel="">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => RemoveLine(line))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Style="text-transform:none" 
                   Class="mt-3" StartIcon="@Icons.Material.Filled.Add" 
                   OnClick="@(() => { if (_isPurchase) AddLineForPurchase(); else AddLine(); })">
            Pridėti eilutę
        </MudButton>
    </MudPaper>

    <!-- TOTALS section -->
    <div style="display:flex; justify-content:flex-end; margin-top:8px;">
        <div style="background:#eff6ff; border-radius:8px; padding:16px; min-width:280px;">
            <div class="d-flex justify-space-between gap-4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Suma be PVM:</MudText>
                <MudText Typo="Typo.body2">@_totalExclVat.ToString("N2") €</MudText>
            </div>
            <div class="d-flex justify-space-between gap-4 mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">PVM:</MudText>
                <MudText Typo="Typo.body2">@_totalVat.ToString("N2") €</MudText>
            </div>
            <MudDivider Class="my-2" />
            <div class="d-flex justify-space-between gap-4">
                <MudText Typo="Typo.body1" Style="font-weight:600">Iš viso:</MudText>
                <MudText Typo="Typo.body1" Style="font-weight:600">@_totalInclVat.ToString("N2") €</MudText>
            </div>
        </div>
    </div>

    <!-- KOMENTARAS section -->
    <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px" Class="mb-4">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Komentaras</MudText>
        <MudTextField T="string" @bind-Value="_notes" 
                      Label="Komentaras (rodomas spausdinant)" 
                      Variant="Variant.Outlined" 
                      Lines="3" Margin="Margin.Dense" />
    </MudPaper>

</MudContainer>

@code {
    private DialogOptions _stdOpt = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true };
    private List<Customer> _customers = new();
    private List<Product> _products = new();
    private List<RawMaterialType> _rawMaterials = new();
    private List<InvoiceLineInput> _lines = new();
    private List<Supplier> _suppliers = new();
    private int? _selectedSupplierId = null;
    private List<Delivery> _supplierDeliveries = new();
    private int? _selectedDeliveryId = null;
    private string _selectedDeliveryNumber = "";
    
    private string _nextInvoiceNumber = "";
    private bool _invoiceNumberLocked = true;
    private DateTime? _invoiceDate = DateTime.Today;
    private int _paymentTermDays = 7;
    private DateTime? _paymentDueDate;
    private bool _dueDateManuallyEdited = false;
    private int? _selectedCustomerId;
    private Customer? _selectedCustomer;
    private string _clientSearchText = "";
    private string _language = "LT";
    private string _invoiceType = "PVM SĄSKAITA FAKTŪRA";
    private decimal _defaultVatRate = 21m;
    
    // Invoice type options for UI display
    private readonly string _invoiceTypePurchase = "6% PVM SĄSKAITA FAKTŪRA";
    private readonly string _invoiceTypeSales = "PVM SĄSKAITA FAKTŪRA";
    
    private decimal _totalExclVat = 0;
    private decimal _totalVat = 0;
    private decimal _totalInclVat = 0;
    
    private string? _errorMessage;
    private string _notes = "";

    private bool _isPurchase = false;

    private MudAutocomplete<Customer>? _clientAutocomplete;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isPurchase && _clientAutocomplete is not null)
        {
            await _clientAutocomplete.FocusAsync();
            await _clientAutocomplete.OpenMenuAsync();
        }
    }

    private async Task OnSupplierSelected(int? supplierId)
    {
        _selectedSupplierId = supplierId;
        _supplierDeliveries = (await DeliveryService.GetAllAsync())
            .Where(d => d.SupplierId == supplierId && d.InvoiceId == null)
            .ToList();
        _selectedDeliveryId = null;
        _selectedDeliveryNumber = "";
        StateHasChanged();
    }

    private void OnDeliverySelected(int? deliveryId)
    {
        _selectedDeliveryId = deliveryId;
        var delivery = _supplierDeliveries.FirstOrDefault(d => d.Id == deliveryId);
        _selectedDeliveryNumber = delivery?.DeliveryNumber ?? "";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isPurchase = Navigation.Uri.Contains("create-purchase");
            
            // Set invoice type based on purchase/sales route
            if (_isPurchase)
            {
                _invoiceType = "6% PVM SĄSKAITA FAKTŪRA";
            }
            
            if (_isPurchase)
            {
                _suppliers = await SupplierService.GetSuppliersAsync();
                _rawMaterials = await RawMaterialTypeService.GetActiveAsync();
            }
            
            _customers = await _invoiceService.GetCustomersAsync();
            _products = await _invoiceService.GetProductsAsync();
            _nextInvoiceNumber = await _invoiceService.GenerateNextInvoiceNumberAsync(
                _invoiceDate ?? DateTime.Today, 
                _invoiceType
            );
            
            if (_isPurchase)
                AddLineForPurchase();
            else
                AddLine();
            UpdateDueDate();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Klaida kraunant duomenis: {ex.Message}";
        }
    }

    private void AddLine()
    {
        _lines.Add(new InvoiceLineInput
        {
            Quantity = 1,
            Unit = "vnt",
            VatRate = _defaultVatRate,
            PriceExclVat = 0,
            Description = ""
        });
    }

    private void AddLineForPurchase()
    {
        _lines.Add(new InvoiceLineInput
        {
            Description = "Medus",
            Unit = "kg",
            Quantity = 0,
            PriceExclVat = 0,
            VatRate = 6,
            LineTotal = 0
        });
    }

    private async Task RemoveLine(InvoiceLineInput line)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Ar tikrai norite ištrinti šią eilutę?" },
            { x => x.ButtonText, "Ištrinti" },
            { x => x.Color, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Patvirtinimas", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;

        _lines.Remove(line);
        CalculateTotals();
    }

    private void CalculateLine(InvoiceLineInput line)
    {
        var subtotal = line.Quantity * line.PriceExclVat;
        var vatAmount = subtotal * (line.VatRate / 100m);
        line.LineTotal = subtotal + vatAmount;
        
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        _totalExclVat = 0;
        _totalVat = 0;
        
        foreach (var line in _lines)
        {
            var subtotal = line.Quantity * line.PriceExclVat;
            var vat = subtotal * (line.VatRate / 100m);
            
            _totalExclVat += subtotal;
            _totalVat += vat;
        }
        
        _totalInclVat = _totalExclVat + _totalVat;
        
        // Force UI refresh for real-time totals update
        InvokeAsync(StateHasChanged);
    }

    private void UpdateDueDate(DateTime? newDate)
    {
        _invoiceDate = newDate;
        if (_invoiceDate.HasValue)
            _paymentDueDate = _invoiceDate.Value.AddDays(_paymentTermDays);
        StateHasChanged();
    }

    private void UpdateDueDate(int newDays)
    {
        _paymentTermDays = newDays;
        _dueDateManuallyEdited = true;
        if (_invoiceDate.HasValue)
            _paymentDueDate = _invoiceDate.Value.AddDays(_paymentTermDays);
        StateHasChanged();
    }

    private void UpdateDueDate()
    {
        if (_invoiceDate.HasValue)
            _paymentDueDate = _invoiceDate.Value.AddDays(_paymentTermDays);
    }

    private async Task OnInvoiceTypeChanged(string newType)
    {
        _invoiceType = newType;
        _nextInvoiceNumber = await _invoiceService.GenerateNextInvoiceNumberAsync(_invoiceDate ?? DateTime.Today, _invoiceType);
        
        if (_invoiceType == "6% PVM SĄSKAITA FAKTŪRA")
        {
            _defaultVatRate = 6m;
            _language = "LT";
            
            // Update all lines to 6%
            foreach (var line in _lines)
            {
                line.VatRate = 6m;
                CalculateLine(line);
            }
        }
        else
        {
            _defaultVatRate = 21m;
        }
    }

    private void OnInvoiceNumberManuallyChanged(string newValue)
    {
        _nextInvoiceNumber = newValue;
        
        // Only apply best-effort date guess in manual mode
        if (_invoiceNumberLocked)
        {
            return;
        }
        
        // Determine expected prefix based on invoice type
        var expectedPrefix = _isPurchase ? "ULAK" : "LAK";
        
        // Check if the new value starts with the expected prefix and has at least prefix.Length + 2 characters
        if (newValue.StartsWith(expectedPrefix) && newValue.Length >= expectedPrefix.Length + 2)
        {
            // Extract the next 2 characters after the prefix
            var numberPart = newValue.Substring(expectedPrefix.Length, 2);
            
            // Try to parse as integer
            if (int.TryParse(numberPart, out var parsedNum) && parsedNum >= 0 && parsedNum <= 99)
            {
                var parsedYear = 2000 + parsedNum;
                
                // Update invoice date if year changed
                if (_invoiceDate == null || _invoiceDate.Value.Year != parsedYear)
                {
                    _invoiceDate = new DateTime(parsedYear, _invoiceDate?.Month ?? 1, 1);
                    UpdateDueDate();
                }
            }
        }
        
        StateHasChanged();
    }

    private Task<IEnumerable<Customer>> SearchCustomers(string? value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value)) return Task.FromResult<IEnumerable<Customer>>(_customers);
        var s = value.ToLower();
        var results = _customers.Where(c => c.Name?.ToLower().Contains(s) == true || c.VatCode?.ToLower().Contains(s) == true).ToList();
        return Task.FromResult<IEnumerable<Customer>>(results);
    }

    private Task<IEnumerable<Product>> SearchProducts(string? value, CancellationToken token = default)
    {
        if (string.IsNullOrWhiteSpace(value)) return Task.FromResult<IEnumerable<Product>>(_products);
        var s = value.ToLower();
        var results = _products.Where(p => p.Name?.ToLower().Contains(s) == true || p.Code?.ToLower().Contains(s) == true).ToList();
        return Task.FromResult<IEnumerable<Product>>(results);
    }

    private string FormatCustomerDisplay(Customer? c)
    {
        if (c is null)
            return "";
        if (!string.IsNullOrWhiteSpace(c.Name))
            return c.Name;
        if (!string.IsNullOrEmpty(c.VatCode))
            return c.VatCode;
        if (!string.IsNullOrEmpty(c.CompanyCode))
            return c.CompanyCode;
        return $"Klientas #{c.Id}";
    }

    private void OnClientSelected(Customer? customer)
    {
        if (customer is null)
        {
            _selectedCustomerId = null;
            _clientSearchText = "";
            _paymentTermDays = 7;
            _dueDateManuallyEdited = false;
            _language = "LT";
            _defaultVatRate = 21m;
            UpdateDueDate();
            StateHasChanged();
            return;
        }

        _selectedCustomer = customer;
        _selectedCustomerId = customer.Id;

        if (!_dueDateManuallyEdited)
        {
            _paymentTermDays = customer.PaymentTermDays > 0 ? customer.PaymentTermDays : 7;
        }

        var lang = customer.DefaultLanguage?.Trim().ToUpperInvariant();
        if (lang is "LT" or "EN")
        {
            _language = lang;
        }

        _defaultVatRate = customer.DefaultVatRate;

        // Retroactively apply the new default VAT rate to lines already on the invoice —
        // previously only affected lines added AFTER selection, since AddLine() runs at
        // page load (before any client is chosen) and this field is never re-read afterward.
        foreach (var line in _lines)
        {
            line.VatRate = _defaultVatRate;
            CalculateLine(line);
        }

        UpdateDueDate();
        StateHasChanged();
    }

    private void OnProductSelected(Product? product, InvoiceLineInput line)
    {
        line.SelectedProduct = product;
        if (product is null)
        {
            line.ProductId = null;
            line.ProductCode = null;
            return;
        }

        line.ProductId = product.Id;
        line.ProductCode = product.Code;
        line.Description = product.Name;
        line.Unit = product.Unit;
        line.PriceExclVat = _isPurchase ? product.PurchasePrice : product.SalePrice;
        CalculateLine(line);
    }

    private async Task OpenClientDialog()
    {
        var parameters = new DialogParameters<ClientSelectDialog>();
        parameters.Add(x => x.Customers, _customers);

        var dialog = await DialogService.ShowAsync<ClientSelectDialog>("Pasirinkite klientą", parameters, _stdOpt);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Customer selectedCustomer)
        {
            OnClientSelected(selectedCustomer);
        }
    }

    private async Task OpenProductDialog(InvoiceLineInput line)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true };
        var parameters = new DialogParameters<ProductSelectDialog>();
        parameters.Add("Products", _products);
        
        var dialog = await DialogService.ShowAsync<ProductSelectDialog>("Pasirinkite prekę", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is Product selectedProduct)
        {
            line.SelectedProduct = selectedProduct;
            line.ProductId = selectedProduct.Id;
            line.ProductCode = selectedProduct.Code;
            line.Description = selectedProduct.Name;
            line.Unit = selectedProduct.Unit;
            line.PriceExclVat = _isPurchase ? selectedProduct.PurchasePrice : selectedProduct.SalePrice;
            
            CalculateLine(line);
            
            // Force UI refresh after dialog returns
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenRawMaterialDialog(InvoiceLineInput line)
    {
        var parameters = new DialogParameters
        {
            ["RawMaterials"] = _rawMaterials
        };
        var dialog = await DialogService.ShowAsync<RawMaterialSelectDialog>("Pasirinkite žaliavą", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is RawMaterialType material)
        {
            line.SelectedProduct = null;
            line.Description = material.Name;
            line.Unit = "kg";
            line.VatRate = 6;
            CalculateLine(line);
            StateHasChanged();
        }
    }

    private async Task SaveInvoice()
    {
        if (!await ValidateInvoice()) return;
        
        var invoice = BuildInvoice();
        await _invoiceService.CreateInvoiceAsync(invoice);
        Navigation.NavigateTo("/invoices");
    }

    private async Task SaveAndGeneratePdf()
    {
        if (!await ValidateInvoice()) return;
        
        var invoice = BuildInvoice();
        var invoiceId = await _invoiceService.CreateInvoiceAsync(invoice);
        Navigation.NavigateTo($"/invoices/pdf/{invoiceId}");
    }

    private async Task<bool> ValidateInvoice()
    {
        // Check invoice number uniqueness first (if not locked)
        if (!_invoiceNumberLocked)
        {
            var taken = await _invoiceService.IsInvoiceNumberTakenAsync(_nextInvoiceNumber, null);
            if (taken)
            {
                _errorMessage = $"Sąskaita su numeriu '{_nextInvoiceNumber}' jau egzistuoja. Pakeiskite numerį prieš tęsdami.";
                return false;
            }
        }

        if (_isPurchase)
        {
            if (_selectedSupplierId == null || _selectedSupplierId == 0)
            {
                _errorMessage = "Prašome pasirinkti tiekėją!";
                return false;
            }
            if (!_lines.Any(l => !string.IsNullOrEmpty(l.Description)))
            {
                _errorMessage = "Prašome pridėti bent vieną žaliavą!";
                return false;
            }
            return true;
        }
        
        TryResolveSelectedCustomerFromText();

        if (!_selectedCustomerId.HasValue)
        {
            _errorMessage = "Prašome pasirinkti klientą!";
            return false;
        }
        
        if (!_lines.Any(l => !string.IsNullOrEmpty(l.Description)))
        {
            _errorMessage = "Prašome pridėti bent vieną prekę!";
            return false;
        }
        
        // 6% PVM sąskaitų faktūrų patikrinimas (reverse charge)
        if (_invoiceType.Contains("6%"))
        {
            var customer = _customers.FirstOrDefault(c => c.Id == _selectedCustomerId);
            if (customer is not null)
            {
                if (string.IsNullOrEmpty(customer.BankAccount))
                {
                    _errorMessage = "6% PVM sąskaitai klientas turi turėti nurodytą banko sąskaitą!";
                    return false;
                }
                if (string.IsNullOrEmpty(customer.CompanyCode))
                {
                    _errorMessage = "6% PVM sąskaitai klientas turi turėti nurodytą įmonės kodą!";
                    return false;
                }
                if (string.IsNullOrEmpty(customer.VatCode))
                {
                    _errorMessage = "6% PVM sąskaitai klientas turi turėti nurodytą PVM mokėtojo kodą!";
                    return false;
                }
            }
        }
        
        _errorMessage = null;
        return true;
    }

    private void TryResolveSelectedCustomerFromText()
    {
        var text = _clientSearchText?.Trim();
        if (string.IsNullOrEmpty(text))
            return;

        var match = _customers.FirstOrDefault(c =>
            string.Equals(c.Name?.Trim(), text, StringComparison.OrdinalIgnoreCase));

        if (match is not null)
        {
            OnClientSelected(match);
        }
    }

    private Invoice BuildInvoice()
    {
        var invoice = new Invoice
        {
            InvoiceNumber = _nextInvoiceNumber,
            InvoiceDate = _invoiceDate ?? DateTime.Today,
            CustomerId = _isPurchase 
                ? (_selectedSupplierId ?? 0) 
                : (_selectedCustomerId ?? 0),
            DeliveryId = _selectedDeliveryId,
            PaymentTermDays = _paymentTermDays,
            PaymentDueDate = _paymentDueDate,
            Language = _language,
            InvoiceType = _invoiceType,
            Notes = _notes,
            Status = InvoiceStatus.Draft,
            Lines = new List<InvoiceLine>()
        };
        
        int lineNumber = 1;
        foreach (var lineInput in _lines.Where(l => !string.IsNullOrEmpty(l.Description)))
        {
            invoice.Lines.Add(new InvoiceLine
            {
                LineNumber = lineNumber++,
                ProductId = (lineInput.ProductId.HasValue && lineInput.ProductId > 0) 
                    ? lineInput.ProductId 
                    : null,
                ProductCode = lineInput.ProductCode ?? "",
                Description = lineInput.Description,
                Quantity = lineInput.Quantity,
                Unit = lineInput.Unit,
                PriceExclVat = lineInput.PriceExclVat,
                VatRate = lineInput.VatRate
            });
        }
        
        return invoice;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/invoices");
    }

    private DateTime? _lastClickTime = null;
    private InvoiceLineInput? _lastClickedLine = null;
    
    private async Task HandleProductDoubleClick(MouseEventArgs args, InvoiceLineInput line)
    {
        if (!_isPurchase)
        {
            await OpenProductDialog(line);
        }
    }

    private async Task OnInvoiceNumberDoubleClick()
    {
        if (_invoiceNumberLocked)
        {
            var parameters = new DialogParameters<ConfirmDialog>
            {
                { x => x.ContentText, "Ar tikrai norite pakeisti automatiškai sugeneruotą sąskaitos numerį? Tai skirta tik retroaktyviam sąskaitų įvedimui." },
                { x => x.ButtonText, "Keisti numerį" },
                { x => x.Color, Color.Warning }
            };
            var dialog = await DialogService.ShowAsync<ConfirmDialog>("Patvirtinimas", parameters, _stdOpt);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                _invoiceNumberLocked = false;
                StateHasChanged();
            }
        }
    }

    public class InvoiceLineInput
    {
        public int? ProductId { get; set; }
        public string? ProductCode { get; set; }
        public string Description { get; set; } = "";
        public decimal Quantity { get; set; } = 1;
        public string Unit { get; set; } = "vnt";
        public decimal PriceExclVat { get; set; } = 0;
        public decimal VatRate { get; set; } = 21;
        public decimal LineTotal { get; set; } = 0;
        public Product? SelectedProduct { get; set; }
    }
}