@page "/invoices/edit/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using NordicBeesERP.Components.Dialogs
@using MudBlazor
@using NordicBeesERP.Helpers
@inject IInvoiceService _invoiceService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IRawMaterialTypeService RawMaterialTypeService
@inject ISnackbar Snackbar

<PageTitle>Redaguoti sąskaitą</PageTitle>

<!-- HEADER (sticky, outside MudContainer) -->
<div style="position:sticky; top:64px; z-index:100; background:#ffffff; padding:12px 0; border-bottom:1px solid #e2e8f0;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="d-flex justify-space-between align-center">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight:600">@_invoiceNumber</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">@(_isPurchase ? "Redaguoti pirkimo sąskaitą (ULAK)" : "Redaguoti pardavimo sąskaitą (LAK)")</MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none" StartIcon="@Icons.Material.Filled.Save" OnClick="@SaveInvoice">Išsaugoti</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Style="text-transform:none" OnClick="@Cancel">Atšaukti</MudButton>
        </div>
    </MudContainer>
</div>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <!-- WARNING BANNER FOR CONFIRMED/PAID INVOICES -->
    @if (_status == InvoiceStatus.Confirmed || _status == InvoiceStatus.Paid)
    {
        var statusLabel = _status switch
        {
            InvoiceStatus.Confirmed => "Patvirtinta",
            InvoiceStatus.Paid => "Apmokėta",
            _ => _status.ToString()
        };
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Šios sąskaitos statusas yra '@statusLabel'. Redaguodami galite sukurti nesutapimus su jau išsiųstu PDF arba registruotais mokėjimais.
        </MudAlert>
    }

    <!-- PAGRINDINĖ INFORMACIJA -->
    <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px" Class="mb-4">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Pagrindinė informacija</MudText>
        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudTextField T="string" Label="Sąskaitos numeris *" @bind-Value="_invoiceNumber" 
                              ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Išrašymo data *" Date="@_invoiceDate"
                               Variant="Variant.Outlined" Required="true" 
                               DateChanged="@((DateTime? d) => { _invoiceDate = d; UpdateDueDate(_paymentTermDays); })"
                               Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="int" Label="Apmokėjimo terminas (dienų) *" Value="@_paymentTermDays" 
                                 Variant="Variant.Outlined" Min="0" 
                                 ValueChanged="@((int v) => UpdateDueDate(v))" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Apmokėti iki</MudText>
                <MudText Typo="Typo.body2">@(_paymentDueDate?.ToString("yyyy-MM-dd") ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="@(_isPurchase ? "Tiekėjas *" : "Klientas *")" @bind-Value="_selectedClientDisplay" 
                              Variant="Variant.Outlined" ReadOnly="true" 
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                              OnAdornmentClick="@OpenClientDialog" @ondblclick="@OpenClientDialog" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudSelect T="string" Label="Kalba" @bind-Value="_language" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("LT")">LT</MudSelectItem>
                    <MudSelectItem T="string" Value="@("EN")">EN</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="Sąskaitos tipas" Value="@_invoiceType" 
                           Variant="Variant.Outlined" ValueChanged="@OnInvoiceTypeChanged" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("PVM SĄSKAITA FAKTŪRA")">PVM sąskaita faktūra</MudSelectItem>
                    <MudSelectItem T="string" Value="@("6% PVM SĄSKAITA FAKTŪRA")">ULAK 6% PVM sąskaita faktūra</MudSelectItem>
                </MudSelect>
            </MudItem>
             <MudItem xs="12" sm="4">
                 <MudText Typo="Typo.caption" Color="Color.Secondary">Būsena</MudText>
                 <MudChip T="string" Color="StatusDisplayHelper.GetColor(_status.ToString(), _statusDisplay)" Variant="Variant.Outlined">@StatusDisplayHelper.GetLabel(_status.ToString(), _statusDisplay)</MudChip>
             </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- PREKĖS -->
    <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px" Class="mb-4">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">@(_isPurchase ? "Žaliavos" : "Prekės")</MudText>
        <MudTable T="InvoiceLineInput" Items="@_lines" Hover="true" Dense="true" Bordered="true">
                <HeaderContent>
                    <MudTh Style="width: 5%;">Nr.</MudTh>
                    <MudTh Style="width: 35%;">@(_isPurchase ? "Žaliava *" : "Prekė *")</MudTh>
                    <MudTh Style="width: 10%;">Kiekis *</MudTh>
                    <MudTh Style="width: 8%;">Vnt.</MudTh>
                    <MudTh Style="width: 12%;">Kaina (be PVM) *</MudTh>
                    <MudTh Style="width: 8%;">PVM %</MudTh>
                    <MudTh Style="width: 12%;">Suma (su PVM)</MudTh>
                    <MudTh Style="width: 8%;"></MudTh>
                </HeaderContent>
                <RowTemplate Context="line">
                    <MudTd DataLabel="Nr.">@(_lines.IndexOf(line) + 1)</MudTd>
                    <MudTd DataLabel="Prekė">
                        <MudTextField T="string" @bind-Value="line.Description" Variant="Variant.Text" 
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick="@(async () => { if (_isPurchase) await OpenRawMaterialDialog(line); else await OpenProductDialog(line); })" />
                    </MudTd>
                      <MudTd DataLabel="Kiekis">
                          <MudNumericField T="decimal" Value="@line.Quantity" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Min="0" Step="0.001M"
                              ValueChanged="@((decimal val) => { line.Quantity = val; CalculateLine(line); })" />
                      </MudTd>
                    <MudTd DataLabel="Vnt.">
                        <MudTextField T="string" @bind-Value="line.Unit" Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" ReadOnly="true" />
                    </MudTd>
                <MudTd DataLabel="Kaina">
                    <MudNumericField T="decimal" Value="@line.PriceExclVat" Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" Min="0" Step="0.01M"
                                     ValueChanged="@((decimal val) => { line.PriceExclVat = val; CalculateLine(line); })" />
                </MudTd>
                    <MudTd DataLabel="PVM %">
                        <MudNumericField T="decimal" Value="@line.VatRate" Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" Min="0" Step="1M" Format="F0"
                                         ValueChanged="@((decimal val) => { line.VatRate = val; CalculateLine(line); })" />
                    </MudTd>
                <MudTd DataLabel="Suma">
                    <MudTextField T="string" Value="@(line.LineTotal % 1 == 0 ? line.LineTotal.ToString("N0") : line.LineTotal.ToString("N2"))" Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" ReadOnly="true" />
                </MudTd>
                    <MudTd DataLabel="">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => RemoveLine(line))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Style="text-transform:none" 
                       StartIcon="@Icons.Material.Filled.Add" OnClick="@AddLine" Class="mt-2">
                Pridėti eilutę
            </MudButton>
    </MudPaper>

    <!-- TOTALS -->
    <div style="display:flex; justify-content:flex-end; margin-top:8px;">
        <div style="background:#eff6ff; border-radius:8px; padding:16px; min-width:280px;">
            <div class="d-flex justify-space-between gap-4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Suma be PVM:</MudText>
                <MudText Typo="Typo.body2">@_totalExclVat.ToString("N2") €</MudText>
            </div>
            <div class="d-flex justify-space-between gap-4 mt-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">PVM:</MudText>
                <MudText Typo="Typo.body2">@_totalVat.ToString("N2") €</MudText>
            </div>
            <MudDivider Class="my-2" />
            <div class="d-flex justify-space-between gap-4">
                <MudText Typo="Typo.body1" Style="font-weight:600">Iš viso:</MudText>
                <MudText Typo="Typo.body1" Style="font-weight:600">@_totalInclVat.ToString("N2") €</MudText>
            </div>
        </div>
    </div>

    <!-- KOMENTARAS section -->
    <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px" Class="mb-4">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Komentaras</MudText>
        <MudTextField T="string" @bind-Value="_notes"
                      Label="Komentaras (rodomas spausdinant)"
                      Variant="Variant.Outlined"
                      Lines="3" Margin="Margin.Dense" />
    </MudPaper>

</MudContainer>

@code {
    private DialogOptions _stdOpt = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true };
    private List<Customer> _customers = new();
    private List<Product> _products = new();
    private List<RawMaterialType> _rawMaterials = new();
    private List<InvoiceLineInput> _lines = new();
    
    private int _invoiceId;
    [Parameter]
    public int Id { get; set; }
    private string _invoiceNumber = "";
    private DateTime? _invoiceDate = DateTime.Today;
    private int _paymentTermDays = 7;
    private DateTime? _paymentDueDate;
    private int _selectedCustomerId;
    private string _selectedClientDisplay = "";
    private string _language = "LT";
    private string _invoiceType = "PVM SĄSKAITA FAKTŪRA";
    private InvoiceStatus _status = InvoiceStatus.Draft;
    private decimal _defaultVatRate = 21m;
    
    private decimal _totalExclVat = 0;
    private decimal _totalVat = 0;
    private decimal _totalInclVat = 0;
    
    private bool _isPurchase = false;
    private string _notes = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _customers = await _invoiceService.GetCustomersAsync();
            _products = await _invoiceService.GetProductsAsync();
            
            _invoiceId = Id;  // Get the route parameter
            await LoadInvoice();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida kraunant duomenis: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadInvoice()
    {
        var invoice = await _invoiceService.GetInvoiceWithDetailsAsync(_invoiceId);
        if (invoice is not null)
        {
            _isPurchase = invoice.InvoiceType?.Contains("6%") == true;
            if (_isPurchase)
                _rawMaterials = await RawMaterialTypeService.GetActiveAsync();
            _invoiceNumber = invoice.InvoiceNumber;
            _invoiceDate = invoice.InvoiceDate;
            _paymentTermDays = invoice.PaymentTermDays;
            _selectedCustomerId = invoice.CustomerId;
            _selectedClientDisplay = invoice.Customer?.Name ?? "";
            _language = invoice.Language ?? "LT";
            _invoiceType = invoice.InvoiceType ?? "PVM SĄSKAITA FAKTŪRA";
            
            // Map legacy "sales"/"purchase" values to new format
            if (_invoiceType == "sales") _invoiceType = "PVM SĄSKAITA FAKTŪRA";
            if (_invoiceType == "purchase") _invoiceType = "6% PVM SĄSKAITA FAKTŪRA";
            
            _status = invoice.Status;
            _notes = invoice.Notes ?? string.Empty;

            // Populate lines
            _lines.Clear();
            foreach (var line in invoice.Lines)
            {
                _lines.Add(new InvoiceLineInput
                {
                    Id = line.Id,
                    ProductId = line.ProductId,
                    ProductCode = line.ProductCode,
                    Description = line.Description,
                    Quantity = line.Quantity,
                    Unit = line.Unit,
                    PriceExclVat = line.PriceExclVat,
                    VatRate = line.VatRate
                });
            }
            
            // Calculate line totals after loading
            foreach (var line in _lines)
            {
                CalculateLine(line);
            }
            
            UpdateDueDate(_paymentTermDays);
            CalculateTotals();
        }
    }

    private void AddLine()
    {
        _lines.Add(new InvoiceLineInput
        {
            Quantity = 1,
            Unit = "vnt",
            VatRate = _defaultVatRate,
            PriceExclVat = 0,
            Description = ""
        });
    }

    private async Task RemoveLine(InvoiceLineInput line)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Ar tikrai norite ištrinti šią eilutę?" },
            { x => x.ButtonText, "Ištrinti" },
            { x => x.Color, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Patvirtinimas", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;
        
        _lines.Remove(line);
        CalculateTotals();
    }

    private void CalculateLine(InvoiceLineInput line)
    {
        var subtotal = line.Quantity * line.PriceExclVat;
        var vatAmount = subtotal * (line.VatRate / 100m);
        line.LineTotal = subtotal + vatAmount;
        
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        _totalExclVat = 0;
        _totalVat = 0;
        
        foreach (var line in _lines)
        {
            var subtotal = line.Quantity * line.PriceExclVat;
            var vat = subtotal * (line.VatRate / 100m);
            
            _totalExclVat += subtotal;
            _totalVat += vat;
        }
        
        _totalInclVat = _totalExclVat + _totalVat;
        
        // Force UI refresh for real-time totals update
        InvokeAsync(StateHasChanged);
    }

    private void UpdateDueDate(DateTime? newDate)
    {
        _invoiceDate = newDate;
        if (_invoiceDate.HasValue)
            _paymentDueDate = _invoiceDate.Value.AddDays(_paymentTermDays);
        StateHasChanged();
    }

    private void UpdateDueDate(int newDays)
    {
        _paymentTermDays = newDays;
        if (_invoiceDate.HasValue)
            _paymentDueDate = _invoiceDate.Value.AddDays(_paymentTermDays);
        StateHasChanged();
    }

    private void UpdateDueDate()
    {
        if (_invoiceDate.HasValue)
            _paymentDueDate = _invoiceDate.Value.AddDays(_paymentTermDays);
    }

    private async Task OnInvoiceTypeChanged(string newType)
    {
        _invoiceType = newType;
        
        if (_invoiceType == "6% PVM SĄSKAITA FAKTŪRA")
        {
            _defaultVatRate = 6m;
            _language = "LT";
            
            // Update all lines to 6%
            foreach (var line in _lines)
            {
                line.VatRate = 6m;
                CalculateLine(line);
            }
        }
        else
        {
            _defaultVatRate = 21m;
        }
        
        InvokeAsync(StateHasChanged);
    }

    private async Task OpenClientDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true };
        var parameters = new DialogParameters<ClientSelectDialog>();
        parameters.Add("Customers", _customers);
        
        var dialog = await DialogService.ShowAsync<ClientSelectDialog>("Pasirinkite klientą", parameters, _stdOpt);
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is Customer selectedCustomer)
        {
            _selectedCustomerId = selectedCustomer.Id;
            _selectedClientDisplay = $"{selectedCustomer.Name} ({selectedCustomer.City})";
            _paymentTermDays = selectedCustomer.PaymentTermDays;
            _language = selectedCustomer.DefaultLanguage;
            _defaultVatRate = selectedCustomer.DefaultVatRate;
            
            UpdateDueDate(_paymentTermDays);
            
            // Force UI refresh after dialog returns
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenProductDialog(InvoiceLineInput line)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true };
        var parameters = new DialogParameters<ProductSelectDialog>();
        parameters.Add("Products", _products);
        
        var dialog = await DialogService.ShowAsync<ProductSelectDialog>("Pasirinkite prekę", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is Product selectedProduct)
        {
            line.ProductId = selectedProduct.Id;
            line.ProductCode = selectedProduct.Code;
            line.Description = selectedProduct.Name;
            line.Unit = selectedProduct.Unit;
            line.PriceExclVat = selectedProduct.SalePrice;
            
            CalculateLine(line);
            
            // Force UI refresh after dialog returns
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenRawMaterialDialog(InvoiceLineInput line)
    {
        var parameters = new DialogParameters
        {
            ["RawMaterials"] = _rawMaterials
        };
        var dialog = await DialogService.ShowAsync<RawMaterialSelectDialog>("Pasirinkite žaliavą", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is RawMaterialType material)
        {
            line.Description = material.Name;
            line.Unit = "kg";
            line.VatRate = 6;
            StateHasChanged();
        }
    }

    private async Task SaveInvoice()
    {
        if (!ValidateInvoice()) return;
        
        var invoice = BuildInvoice();
        await _invoiceService.UpdateInvoiceAsync(invoice);
        await InvokeAsync(() => Navigation.NavigateTo($"/invoices/{_invoiceId}"));
    }

    private bool ValidateInvoice()
    {
        if (_selectedCustomerId == 0)
        {
            Snackbar.Add("Prašome pasirinkti klientą!", Severity.Error);
            return false;
        }
        
        if (!_lines.Any(l => !string.IsNullOrEmpty(l.Description)))
        {
            Snackbar.Add(_isPurchase ? "Prašome pridėti bent vieną žaliavą!" : "Prašome pridėti bent vieną prekę!", Severity.Error);
            return false;
        }
        
        return true;
    }

    private Invoice BuildInvoice()
    {
        var invoice = new Invoice
        {
            Id = _invoiceId,
            InvoiceNumber = _invoiceNumber,
            InvoiceDate = _invoiceDate ?? DateTime.Today,
            CustomerId = _selectedCustomerId,
            PaymentTermDays = _paymentTermDays,
            PaymentDueDate = _paymentDueDate,
            Language = _language,
            InvoiceType = _invoiceType,
            Status = _status,
            Notes = _notes
        };
        
        invoice.Lines = new List<InvoiceLine>();
        
        int lineNumber = 1;
        foreach (var lineInput in _lines.Where(l => !string.IsNullOrEmpty(l.Description)))
        {
            invoice.Lines.Add(new InvoiceLine
            {
                Id = lineInput.Id ?? 0,
                LineNumber = lineNumber++,
                ProductId = (lineInput.ProductId.HasValue && lineInput.ProductId > 0) ? lineInput.ProductId : null,
                ProductCode = lineInput.ProductCode ?? "",
                Description = lineInput.Description,
                Quantity = lineInput.Quantity,
                Unit = lineInput.Unit,
                PriceExclVat = lineInput.PriceExclVat,
                VatRate = lineInput.VatRate
            });
        }
        
        return invoice;
    }

    private async Task Cancel()
    {
        await InvokeAsync(() => Navigation.NavigateTo($"/invoices/{Id}"));
    }

    private static readonly Dictionary<string, (string Label, Color Color)> _statusDisplay = new()
    {
        { "Draft", ("Juodraštas", Color.Warning) },
        { "Confirmed", ("Patvirtinta", Color.Primary) },
        { "Paid", ("Apmokėta", Color.Success) }
    };

    public class InvoiceLineInput
    {
        public int? Id { get; set; }
        public int? ProductId { get; set; }
        public string? ProductCode { get; set; }
        public string Description { get; set; } = "";
        public decimal Quantity { get; set; } = 1;
        public string Unit { get; set; } = "vnt";
        public decimal PriceExclVat { get; set; } = 0;
        public decimal VatRate { get; set; } = 21;
        public decimal LineTotal { get; set; } = 0;
    }
}
