@page "/invoices/{Id:int}"
@rendermode InteractiveServer

@* =====================================================
   NORDIC BEES ERP - VIEW INVOICE PAGE
   Framework: .NET 10
   NordicBeesERP UI Style
   ===================================================== *@
@inject IInvoiceService InvoiceService
@inject IPaymentService PaymentService
@inject ICreditNoteService CreditNoteService
@inject IDialogService DialogService
@inject IAuthService AuthService
@using NordicBeesERP.Services.Dtos
@using NordicBeesERP.Components.Dialogs
@using NordicBeesERP.Helpers
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Sąskaitos peržiūra</PageTitle>

<!-- HEADER (sticky, full-bleed background bar; only its CONTENT is width-constrained) -->
<div style="position:sticky; top:0; z-index:100; background:#ffffff; padding:16px 0 12px 0; border-bottom:1px solid #e2e8f0; margin-bottom:16px;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <div class="d-flex flex-column gap-3">
        <!-- One line: invoice number (Typo.h5, Color.Primary, font-weight:600) + status chip inline -->
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudText Typo="Typo.h5" Style="font-weight:600" Color="Color.Primary">@(_invoice?.InvoiceNumber ?? "...")</MudText>
            @if (_invoice is not null)
            {
                <MudChip T="string" Color="StatusDisplayHelper.GetColor(_invoice.Status.ToString(), _statusDisplay)" Variant="Variant.Outlined">@StatusDisplayHelper.GetLabel(_invoice.Status.ToString(), _statusDisplay)</MudChip>
            }
            @if (GetCreditBadge().Show)
            {
                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">@GetCreditBadge().Label</MudChip>
            }
        </div>
        
        <!-- Second line: customer name (Typo.body1, Color.Secondary) -->
        @if (_invoice is not null)
        {
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                @(_invoice.InvoiceType?.Contains("6%") == true ? "Tiekėjas:" : "Klientas:") @_invoice.Customer?.Name
            </MudText>
        }
        
        <!-- Action buttons row -->
        <div class="d-flex flex-wrap gap-2 align-center">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@HandleBack" Style="text-transform:none">
                Atgal
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@HandleEdit" Style="text-transform:none">
                Redaguoti
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@HandlePrint" Style="text-transform:none">
                Spausdinti
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@HandleCopy" Style="text-transform:none">
                Kopijuoti
            </MudButton>

            @if (_invoice?.Status != InvoiceStatus.Draft)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@HandleCreditNote" StartIcon="@Icons.Material.Filled.Receipt" Style="text-transform:none">
                    Credit Note
                </MudButton>
            }

            @if (_invoice?.Status == InvoiceStatus.Draft)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@HandleConfirm" StartIcon="@Icons.Material.Filled.CheckCircle" Style="text-transform:none">
                    Patvirtinti
                </MudButton>
            }
            
            @if (_invoice?.PaymentStatus != "paid")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@RegisterPayment" Style="text-transform:none">
                    Registruoti mokėjimą
                </MudButton>
            }
        </div>
        </div>
    </MudContainer>
</div>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @if (_invoice is not null)
    {
        <!-- INFO CARDS -->
        <MudGrid Class="mt-4" Spacing="3" Style="align-items:stretch;">
            <!-- Left card: Customer Information -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-4" 
                          Style="background:#eff6ff; border-radius:8px; border-left:4px solid #2563eb; padding:16px; height:100%;">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3" Style="font-weight:600">Kliento informacija</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Vardas</MudText>
                        </MudItem>
                        <MudItem xs="7">
                            <MudText Typo="Typo.body1">@_invoice.Customer?.Name</MudText>
                        </MudItem>
                        @if (!string.IsNullOrEmpty(_invoice.CustomerVatCode) || !string.IsNullOrEmpty(_invoice.Customer?.VatCode))
                        {
                            <MudItem xs="5">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">PVM kodas</MudText>
                            </MudItem>
                            <MudItem xs="7">
                                <MudText Typo="Typo.body1">@(_invoice.CustomerVatCode ?? _invoice.Customer?.VatCode)</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_invoice.Customer?.CompanyCode))
                        {
                            <MudItem xs="5">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Įmonės kodas</MudText>
                            </MudItem>
                            <MudItem xs="7">
                                <MudText Typo="Typo.body1">@_invoice.Customer.CompanyCode</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_invoice.Customer?.Address))
                        {
                            <MudItem xs="5">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Adresas</MudText>
                            </MudItem>
                            <MudItem xs="7">
                                <MudText Typo="Typo.body1">@_invoice.Customer.Address</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_invoice.Customer?.Email))
                        {
                            <MudItem xs="5">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">El. paštas</MudText>
                            </MudItem>
                            <MudItem xs="7">
                                <MudText Typo="Typo.body1">@_invoice.Customer?.Email</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>

             <!-- Right card: Invoice Information -->
             <MudItem xs="12" md="6">
                 <MudPaper Elevation="0" Class="pa-4" 
                           Style="background:#f5f3ff; border-radius:8px; border-left:4px solid #7c3aed; padding:16px; height:100%;">
                      <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3" Style="font-weight:600">Sąskaitos duomenys</MudText>
                     <MudGrid Spacing="2">
                         <MudItem xs="5">
                             <MudText Typo="Typo.caption" Color="Color.Secondary">Tipas</MudText>
                         </MudItem>
                         <MudItem xs="7">
                              <MudText Typo="Typo.body1">@GetInvoiceTypeLabel(_invoice.InvoiceType)</MudText>
                         </MudItem>
                         <MudItem xs="5">
                             <MudText Typo="Typo.caption" Color="Color.Secondary">Data</MudText>
                         </MudItem>
                         <MudItem xs="7">
                              <MudText Typo="Typo.body1">@_invoice.InvoiceDate.ToString("yyyy-MM-dd")</MudText>
                         </MudItem>
                         <MudItem xs="5">
                             <MudText Typo="Typo.caption" Color="Color.Secondary">Terminas</MudText>
                         </MudItem>
                         <MudItem xs="7">
                              <MudText Typo="Typo.body1">@(_invoice.PaymentTermDays > 0 ? $"{_invoice.PaymentTermDays} d." : "-")</MudText>
                         </MudItem>
                         <MudItem xs="5">
                             <MudText Typo="Typo.caption" Color="Color.Secondary">Valiuta</MudText>
                         </MudItem>
                         <MudItem xs="7">
                              <MudText Typo="Typo.body1">EUR</MudText>
                         </MudItem>
                         <MudItem xs="5">
                             <MudText Typo="Typo.caption" Color="Color.Secondary">Kalba</MudText>
                         </MudItem>
                         <MudItem xs="7">
                              <MudText Typo="Typo.body1">@(_invoice.Language == "lt" || _invoice.Language == "LT" ? "Lietuvių" : _invoice.Language)</MudText>
                         </MudItem>
                     </MudGrid>
                 </MudPaper>
             </MudItem>
        </MudGrid>

        <!-- INVOICE LINES TABLE -->
        <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-3 pa-3" 
                  Style="background:#f8fafc; border-radius:8px;">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1" Style="font-weight:600">Prekių sąrašas</MudText>
            
            @if (_invoiceLines is not null && _invoiceLines.Any())
            {
                
                <MudTable T="InvoiceLine" Items="@_invoiceLines" Dense="true" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Nr</MudTh>
                        <MudTh>Aprašymas</MudTh>
                        <MudTh Class="text-center">Kiekis</MudTh>
                        <MudTh Class="text-center">Vnt</MudTh>
                        <MudTh Class="text-right">Kaina</MudTh>
                        <MudTh Class="text-center">PVM%</MudTh>
                        <MudTh Class="text-right">Suma</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="line">
                        <MudTd>@line.LineNumber</MudTd>
                        <MudTd>
                            @if (_invoice?.InvoiceType?.Contains("6%") == true && _invoice?.Delivery != null)
                            {
                                <div>
                                    @($"{line.Description}. Pristatymo nr.: @_invoice.Delivery.DeliveryNumber")
                                </div>
                                @if (FormatDeductions(_invoice.Delivery) is { } deductionsText)
                                {
                                    <div Class="mt-1" Style="font-size:0.85rem; color:#777;">@deductionsText</div>
                                }
                            }
                            else
                            {
                                @(line.Description ?? line.ProductCode)
                            }
                        </MudTd>
                        <MudTd Class="text-center">@FormatQuantity(line.Quantity)</MudTd>
                        <MudTd Class="text-center">@line.Unit</MudTd>
                        <MudTd Class="text-right">@FormatAmountHelper.FormatAmount(line.PriceExclVat)</MudTd>
                        <MudTd Class="text-center">@FormatVatRate(line.VatRate)</MudTd>
                        <MudTd Class="text-right">@FormatAmountHelper.FormatAmount(line.LineTotal)</MudTd>
                    </RowTemplate>
                </MudTable>
                
                        <!-- Totals block - right-aligned -->
                        <div style="display:flex; justify-content:flex-end; margin-top:16px;">
                            <div style="background:#eff6ff; border-radius:8px; padding:16px; min-width:280px;">
                                <div class="d-flex justify-space-between gap-4">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Suma be PVM:</MudText>
                                    <MudText Typo="Typo.body2">@FormatAmountHelper.FormatAmount(_invoice.SubtotalExclVat) €</MudText>
                                </div>
                                <div class="d-flex justify-space-between gap-4 mt-1">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">PVM:</MudText>
                                    <MudText Typo="Typo.body2">@FormatAmountHelper.FormatAmount(_invoice.TotalVat) €</MudText>
                                </div>
                                <MudDivider Class="my-2" />
                                <div class="d-flex justify-space-between gap-4">
                                    <MudText Typo="Typo.body1" Style="font-weight:600">Iš viso:</MudText>
                                    <MudText Typo="Typo.body1" Style="font-weight:600">@FormatAmountHelper.FormatAmount(_invoice.TotalInclVat) €</MudText>
                                </div>
                            </div>
                        </div>
            }
            else
            {
                <div class="pa-4 text-center">
                    <MudText Color="Color.Secondary">Prekių sąrašas yra tuščias</MudText>
                </div>
            }
        </MudPaper>

        <!-- Comment Section -->
        @if (!string.IsNullOrEmpty(_invoice.Notes))
        {
            <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-4 pa-3"
                      Style="background:#f8fafc; border-radius:8px;">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1" Style="font-weight:600">Komentaras</MudText>
                <MudText Typo="Typo.body1">@_invoice.Notes</MudText>
            </MudPaper>
        }

        <!-- Payment Information Section -->
        <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-4 pa-3" 
                  Style="background:#f8fafc; border-radius:8px;">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1" Style="font-weight:600">Mokėjimo informacija</MudText>
            
            <!-- Payment Status Cards -->
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Elevation="0" Class="pa-3" 
                              Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2; height:100%;">
                        <div style="display:flex; flex-direction:column; gap:8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Mokėjimo būsena</MudText>
                            <MudChip T="string" Color="GetPaymentStatusColor()" Size="Size.Small" Style="width:fit-content">
                                @GetPaymentStatusLabel()
                            </MudChip>
                            @if (_invoice.Status != InvoiceStatus.Paid && _invoice.PaymentDueDate.HasValue)
                            {
                                var daysLeft = (_invoice.PaymentDueDate.Value.Date - DateTime.Today).Days;
                                <div class="d-flex align-center gap-1">
                                    <MudIcon Icon="@(daysLeft < 0 ? Icons.Material.Filled.Warning : Icons.Material.Filled.Schedule)"
                                             Size="Size.Small"
                                             Style="@(daysLeft < 0 ? "color:#dc2626" : daysLeft <= 7 ? "color:#d97706" : "color:#16a34a")" />
                                    <MudText Typo="Typo.body2"
                                             Style="@(daysLeft < 0 ? "color:#dc2626;font-weight:600" : daysLeft <= 7 ? "color:#d97706;font-weight:600" : "color:#16a34a")">
                                        @if (daysLeft < 0)
                                        {
                                            <span>Vėluoja @Math.Abs(daysLeft) d.</span>
                                        }
                                        else if (daysLeft == 0)
                                        {
                                            <span>Mokėjimas šiandien</span>
                                        }
                                        else
                                        {
                                            <span>Liko @daysLeft d.</span>
                                        }
                                    </MudText>
                                </div>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Elevation="0" Class="pa-3" 
                              Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2; height:100%;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Mokėjimo sąlygos</MudText>
                        <MudText Typo="Typo.body1" Class="font-weight-bold mt-1">@(_invoice.PaymentTermDays > 0 ? $"{_invoice.PaymentTermDays} dienų" : "-")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Elevation="0" Class="pa-3" 
                              Style="background:#f0f4ff; border-radius:8px; border-left:4px solid #1976d2; height:100%;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Mokėti iki</MudText>
                        <MudText Typo="Typo.body1" Class="font-weight-bold mt-1">@(_invoice.PaymentDueDate?.ToString("yyyy-MM-dd") ?? "-")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
            
            <!-- Payment History Table -->
            @if (_paymentHistory is not null && _paymentHistory.Any())
            {
                <MudTable T="PaymentHistoryItem" Items="@_paymentHistory" Dense="true" Hover="true" Striped="true" Elevation="0" Class="mt-3">
                    <HeaderContent>
                        <MudTh Style="width:48px; min-width:48px;"></MudTh>
                        <MudTh>Data</MudTh>
                        <MudTh Class="text-right">Suma (€)</MudTh>
                        <MudTh>Mokėjimo būdas</MudTh>
                        <MudTh Class="text-center">Veiksmai</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="payment">
                        <MudTd Style="white-space:nowrap; width:48px;">
                            @if (!string.IsNullOrEmpty(payment.Reference) || !string.IsNullOrEmpty(payment.Notes))
                            {
                                <MudIconButton Icon="@(expandedRows.Contains(payment.PaymentId) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                    Size="Size.Small" OnClick="@(() => ToggleRow(payment.PaymentId))" />
                            }
                        </MudTd>
                        <MudTd>@payment.Date.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd Class="text-right">@FormatAmountHelper.Trim(payment.Amount, 2)</MudTd>
                        <MudTd>@GetPaymentMethodLabel(payment.Method)</MudTd>
                        <MudTd Class="text-center">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditPayment(payment)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeletePayment(payment.PaymentId)" />
                        </MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (expandedRows.Contains(context.PaymentId))
                        {
                            <MudTr>
                                <MudTd colspan="6">
                                    <div style="padding: 8px 8px 8px 56px; background:#f5f5f5; border-radius:4px; margin: 0 8px 8px 8px;">
                                        @if (!string.IsNullOrEmpty(context.Reference))
                                        {
                                            <div style="margin-bottom:4px">
                                                <span style="color:#666; font-size:0.8rem">Nuorodos nr.:</span>
                                                <span style="margin-left:8px; font-size:0.9rem">@context.Reference</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(context.Notes))
                                        {
                                            <div>
                                                <span style="color:#666; font-size:0.8rem">Pastabos:</span>
                                                <span style="margin-left:8px; font-size:0.9rem">@context.Notes</span>
                                            </div>
                                        }
                                    </div>
                                </MudTd>
                            </MudTr>
                        }
                    </ChildRowContent>
                </MudTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mt-3">
                    Mokėjimų nėra
                </MudAlert>
            }
        </MudPaper>

        @if (_creditNotes.Any())
        {
            <MudPaper Elevation="0" Rounded Square Class="mt-4 pa-3" Style="background:#f8fafc; border-radius:8px;">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1" Style="font-weight:600">Kreditinės sąskaitos</MudText>
                <MudTable T="CreditNoteListDto" Items="@_creditNotes" Dense="true" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Numeris</MudTh>
                        <MudTh>Data</MudTh>
                        <MudTh Class="text-right">Suma (€)</MudTh>
                        <MudTh>Būsena</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="cn">
                        <MudTr @onclick="@(() => NavigateToCreditNote(cn.Id))" Style="cursor:pointer;">
                            <MudTd>@cn.CreditNoteNumber</MudTd>
                            <MudTd>@cn.CreditDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd Class="text-right">-@FormatAmountHelper.Trim(cn.TotalInclVat, 2)</MudTd>
                            <MudTd>
                                <MudChip T="string" Color="@GetCreditStatusColor(cn.Status)" Variant="Variant.Outlined">@GetCreditStatusLabel(cn.Status)</MudChip>
                            </MudTd>
                        </MudTr>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    }
    else
    {
        <div class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" />
            <MudText Class="mt-2" Typo="Typo.subtitle1">Sąskaita nerasta</MudText>
            <MudText Color="Color.Secondary">Sąskaitos su ID @Id neaptikta</MudText>
            <MudButton OnClick="@HandleBack" Variant="Variant.Outlined" Color="Color.Default" Class="mt-3">
                Grįžti į sąskaitas
            </MudButton>
        </div>
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private Invoice? _invoice;
    private List<InvoiceLine> _invoiceLines = new List<InvoiceLine>();
    private List<CreditNoteListDto> _creditNotes = new();
    private Dictionary<int, decimal> _creditedQuantitiesByLine = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoiceAsync();
        await LoadPaymentHistoryAsync();
        await LoadCreditNotesAsync();
    }

    private async Task LoadInvoiceAsync()
    {
        try
        {
            _invoice = await InvoiceService.GetInvoiceWithDetailsAsync(Id);
            if (_invoice is not null)
            {
                _invoiceLines = _invoice.Lines.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LoadCreditNotesAsync()
    {
        try
        {
            _creditNotes = await CreditNoteService.GetCreditNotesForInvoiceAsync(Id);
            _creditedQuantitiesByLine = await CreditNoteService.GetCreditedQuantitiesByInvoiceLineAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static readonly Dictionary<CreditNoteStatus, (string Label, Color Color)> _creditNoteStatusDisplay = new()
    {
        { CreditNoteStatus.Draft, ("Juodraštas", Color.Warning) },
        { CreditNoteStatus.Printed, ("Atspausdinta", Color.Primary) },
        { CreditNoteStatus.Disputed, ("Kontroversija", Color.Error) }
    };

    private string GetCreditStatusLabel(CreditNoteStatus status) => _creditNoteStatusDisplay[status].Label;
    private Color GetCreditStatusColor(CreditNoteStatus status) => _creditNoteStatusDisplay[status].Color;

    private string? FormatDeductions(NordicBeesERP.Models.WarehouseModule.Delivery? delivery)
    {
        if (delivery == null) return null;
        var parts = new List<string>();
        if (delivery.TransportCostDeduction > 0) parts.Add($"Transportas: {delivery.TransportCostDeduction:0.00} €");
        if (delivery.BarrelCostDeduction > 0) parts.Add($"Tara: {delivery.BarrelCostDeduction:0.00} €");
        if (delivery.OtherCostDeduction > 0) parts.Add($"Kitos išlaidos: {delivery.OtherCostDeduction:0.00} €");
        return parts.Count > 0 ? string.Join(", ", parts) : null;
    }

    private void NavigateToCreditNote(int creditNoteId)
    {
        Navigation.NavigateTo($"/credit-notes/{creditNoteId}?returnUrl={Uri.EscapeDataString($"/invoices/{Id}")}");
    }

    private (string? Label, bool Show) GetCreditBadge()
    {
        if (_invoice is null || _invoiceLines.Count == 0 || _creditedQuantitiesByLine.Count == 0)
            return (null, false);

        var allCredited = true;
        foreach (var line in _invoiceLines)
        {
            var credited = _creditedQuantitiesByLine.GetValueOrDefault(line.Id, 0m);
            if (credited < line.Quantity - 0.0001m)
            {
                allCredited = false;
                break;
            }
        }

        return allCredited ? ("Pilnai kredituota", true) : ("Dalinai kredituota", true);
    }

    private static readonly Dictionary<string, (string Label, Color Color)> _statusDisplay = new()
    {
        { "Draft", ("Juodraštas", Color.Warning) },
        { "Confirmed", ("Patvirtinta", Color.Primary) },
        { "Paid", ("Apmokėta", Color.Success) }
    };

    private Color GetPaymentStatusColor()
    {
        if (_invoice is null) return Color.Error;
        
        // Use invoice.PaymentStatus from DB, not calculated from Payments collection
        return _invoice.PaymentStatus switch
        {
            "paid" => Color.Success,
            "partial" => Color.Warning,
            "unpaid" => Color.Error,
            _ => Color.Default
        };
    }
    
    private string GetPaymentStatusLabel()
    {
        if (_invoice is null) return "Neapmokėta";
        
        return _invoice.PaymentStatus switch
        {
            "paid" => "Apmokėta",
            "partial" => "Dalinai apmokėta",
            _ => "Neapmokėta"
        };
    }
    
    private string GetPaymentMethodLabel(string method)
    {
        return method switch {
            "BankTransfer" or "bank_transfer" => "Banko pavedimas",
            "Cash" or "cash" => "Grynais",
            "Card" or "card" => "Kortelė",
            "Other" or "other" => "Kita",
            _ => method
        };
    }
    
    private string GetInvoiceTypeLabel(string? type) => type switch
    {
        "sales" => "PVM sąskaita faktūra",
        "PVM SĄSKAITA FAKTŪRA" => "PVM sąskaita faktūra",
        "6% PVM SĄSKAITA FAKTŪRA" => "ULAK 6% PVM",
        "ULAK" => "ULAK pirkimo aktas",
        _ => type ?? "—"
    };

    private string FormatQuantity(decimal qty) => qty == Math.Floor(qty) ? qty.ToString("N0") : qty.ToString("G29");
    private string FormatVatRate(decimal rate)
    {
        var display = rate <= 1 ? rate * 100 : rate;
        return display % 1 == 0 ? ((int)display).ToString() + "%" : display.ToString("G29") + "%";
    }
    
    private List<PaymentHistoryItem> _paymentHistory = new List<PaymentHistoryItem>();
    private HashSet<int> expandedRows = new();
    private void ToggleRow(int paymentId)
    {
        if (!expandedRows.Add(paymentId)) expandedRows.Remove(paymentId);
    }

    private async Task LoadPaymentHistoryAsync()
    {
        try
        {
            if (_invoice is not null)
            {
                _paymentHistory = await PaymentService.GetPaymentsByInvoiceAsync(_invoice.Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditPayment(PaymentHistoryItem p)
    {
        try
        {
            var parameters = new DialogParameters
            {
                ["PaymentId"] = p.PaymentId,
                ["CurrentAmount"] = p.Amount,
                ["CurrentDate"] = p.Date,
                ["CurrentMethod"] = p.Method
            };
            var dialog = await DialogService.ShowAsync<EditPaymentDialog>(
                "Redaguoti mokėjimą", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            var result = await dialog.Result;
            if (result != null && !result.Canceled)
            {
                _paymentHistory = await PaymentService.GetPaymentsByInvoiceAsync(Id);
                _invoice = await InvoiceService.GetInvoiceWithDetailsAsync(Id);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeletePayment(int paymentId)
    {
        try
        {
            var payment = _paymentHistory.FirstOrDefault(p => p.PaymentId == paymentId);
            if (payment == null) return;

            var confirmed = await ConfirmDialog.ShowAsync(
                DialogService,
                "Ištrinti mokėjimą",
                $"Ar tikrai norite ištrinti mokėjimą {payment.Amount:F2} €?",
                "Ištrinti");

            if (!confirmed) return;

            var userId = await AuthService.GetUserIdAsync();
            await PaymentService.DeletePaymentAsync(paymentId, userId!.Value);
            _paymentHistory = await PaymentService.GetPaymentsByInvoiceAsync(Id);
            _invoice = await InvoiceService.GetInvoiceWithDetailsAsync(Id);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RegisterPayment()
    {
        try
        {
            if (_invoice is null) return;

            // Calculate fresh RemainingAmount from current invoice state
            var remainingAmount = _invoice.TotalInclVat - _invoice.PaidAmount;

            var parameters = new DialogParameters
            {
                ["InvoiceId"] = _invoice.Id,
                ["InvoiceNumber"] = _invoice.InvoiceNumber,
                ["RemainingAmount"] = remainingAmount,
                ["ExistingPayments"] = _paymentHistory
            };

            var dialog = await DialogService.ShowAsync<PaymentDialog>(
                  "Registruoti mokėjimą", parameters,
                  new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = true });

            var result = await dialog.Result;
            if (result != null && !result.Canceled)
            {
                // Reload invoice and payment history after successful payment registration
                _invoice = await InvoiceService.GetInvoiceWithDetailsAsync(Id);
                _paymentHistory = await PaymentService.GetPaymentsByInvoiceAsync(Id);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task HandleConfirm()
    {
        if (_invoice is null) return;
        try
        {
            await InvoiceService.UpdateInvoiceStatusAsync(_invoice.Id, InvoiceStatus.Confirmed);
            await LoadInvoiceAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void HandleBack()
    {
        var target = !string.IsNullOrEmpty(ReturnUrl) ? Uri.UnescapeDataString(ReturnUrl) : "/invoices";
        Navigation.NavigateTo(target);
    }

    private void HandleEdit()
    {
        if (_invoice is not null)
        {
            Navigation.NavigateTo($"/invoices/edit/{_invoice.Id}");
        }
    }

    private void HandlePrint()
    {
        if (_invoice is not null)
        {
            Navigation.NavigateTo($"/invoices/pdf/{_invoice.Id}");
        }
    }

    private async Task HandleCopy()
    {
        try
        {
            var source = await InvoiceService.GetInvoiceWithDetailsAsync(Id);
            if (source == null) return;
            
            var newInvoice = new Invoice
            {
                InvoiceNumber = await InvoiceService.GenerateNextInvoiceNumberAsync(DateTime.Now, source.InvoiceType),
                InvoiceDate = DateTime.Now,
                PaymentTermDays = source.PaymentTermDays,
                PaymentDueDate = DateTime.Now.AddDays(source.PaymentTermDays),
                Status = InvoiceStatus.Draft,
                CustomerId = source.CustomerId,
                InvoiceType = source.InvoiceType,
                Language = source.Language,
                ReverseCharge = source.ReverseCharge,
                Lines = source.Lines.Select(l => new InvoiceLine
                {
                    Description = l.Description,
                    ProductCode = l.ProductCode,
                    ProductId = l.ProductId,
                    Quantity = l.Quantity,
                    Unit = l.Unit,
                    PriceExclVat = l.PriceExclVat,
                    VatRate = l.VatRate,
                    LineSubtotal = l.LineSubtotal,
                    VatAmount = l.VatAmount,
                    LineTotal = l.LineTotal
                }).ToList()
            };
            
            var newId = await InvoiceService.CreateInvoiceAsync(newInvoice);
            Navigation.NavigateTo($"/invoices/edit/{newId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void HandleCreditNote()
    {
        if (_invoice == null) return;
        Navigation.NavigateTo($"/credit-notes/new?invoiceId={_invoice.Id}");
    }
