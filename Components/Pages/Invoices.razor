@page "/invoices"
@page "/invoices/sales"
@page "/invoices/purchases"
@rendermode InteractiveServer
@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using MudBlazor
@using System.IO.Compression
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IPdfGeneratorService PdfGeneratorService
@inject IJSRuntime JS
@inject IDialogService DialogService

<PageTitle>Sąskaitos</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <!-- Header row -->
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">Sąskaitos</MudText>
        <MudButton OnClick="OpenCreateDialog"
                   StartIcon="@Icons.Material.Filled.Add"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Style="text-transform:none">
            Sukurti sąskaitą
        </MudButton>
    </div>

    <!-- Two-level Tabs: Level 1 - Type tabs (top, prominent) -->
    <div class="d-flex gap-2 mb-3">
        <MudButton Variant="@(_invoiceType == "LAK" ? Variant.Filled : Variant.Outlined)"
                   Color="Color.Primary"
                   Style="@(_invoiceType == "LAK" ? "text-transform:none;min-width:180px;background:#1976d2;color:white;" : "text-transform:none;min-width:180px;background:#dbeafe;color:#1e40af;border-color:#93c5fd;")"
                   OnClick="@(async () => await SetInvoiceType("LAK"))">
            LAK — Pardavimai
        </MudButton>
        <MudButton Variant="@(_invoiceType == "ULAK" ? Variant.Filled : Variant.Outlined)"
                   Color="Color.Primary"
                   Style="@(_invoiceType == "ULAK" ? "text-transform:none;min-width:180px;background:#1976d2;color:white;" : "text-transform:none;min-width:180px;background:#dbeafe;color:#1e40af;border-color:#93c5fd;")"
                   OnClick="@(async () => await SetInvoiceType("ULAK"))">
            ULAK — Pirkimai
        </MudButton>
    </div>

    <!-- Loading indicator -->
    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <!-- Filter section -->
    <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField Value="@_filterSearch"
                              ValueChanged="@(async (string val) => { _filterSearch = val; _selectedInvoices.Clear(); await LoadDataAsync(); })"
                              Label="Paieška pagal Nr. arba klientą"
                              Variant="Variant.Outlined"
                               Immediate="true"
                               FullWidth="@true"
                               Clearable="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Adornment="Adornment.Start" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudDateRangePicker DateRange="@_dateRange"
                                     DateRangeChanged="@(async (DateRange dr) => { _dateRange = dr; _selectedInvoices.Clear(); await LoadDataAsync(); })"
                                    Label="Data (nuo / iki)"
                                     Variant="Variant.Outlined"
                                     FullWidth="@true"
                                     Clearable="true" />
            </MudItem>
            @if (!string.IsNullOrEmpty(_filterSearch) || _dateRange?.Start != null)
            {
                <MudItem xs="12">
                    <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Variant="Variant.Text"
                               Color="Color.Secondary"
                               Size="Size.Small"
                                OnClick="@(async () => { _filterSearch = null; _dateRange = null; _selectedInvoices.Clear(); await LoadDataAsync(); StateHasChanged(); })">
                        Išvalyti filtrus
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <!-- Status chip filters (Level 2 - below type tabs) -->
    <div class="d-flex flex-wrap gap-2 mb-3 align-center">
        <MudText Typo="Typo.body2" Style="color:#6b7280;margin-right:4px;">Būsena:</MudText>
        @if (_selectedStatuses.Any())
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.FilterAltOff"
                        OnClick="@(() => { _selectedStatuses.Clear(); _selectedInvoices.Clear(); StateHasChanged(); })">
                Rodyti visas
            </MudButton>
        }
        @foreach (var status in _availableStatuses)
        {
            var isSelected = _selectedStatuses.Contains(status);
            <MudChip T="string"
                     Color="@(isSelected ? GetStatusColor(status) : Color.Default)"
                     Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => ToggleStatus(status))"
                     Size="Size.Small"
                     Style="@(isSelected ? "" : "opacity:0.7")">
                @GetStatusLabel(status)
            </MudChip>
        }
    </div>

    <!-- Tabs -->
    <MudTabs ActivePanelIndex="_selectedTab"
             ActivePanelIndexChanged="OnTabChanged"
             Elevation="0" Rounded="true" Square="false" Class="mt-2">
        <MudTabPanel Text="Visos" />
        <MudTabPanel Text="Nesumokėtos" />
        <MudTabPanel Text="Vėluojančios" />
        <MudTabPanel Text="Šis mėnuo" />
    </MudTabs>

    <!-- Bulk actions bar -->
    @if (_selectedInvoices.Count > 0)
    {
        <MudPaper Elevation="0" Rounded="true" Square="false" Class="mb-2 pa-3 d-flex align-center justify-space-between"
                  Style="background:#e8f0fe; border-radius:8px;">
            <MudText Typo="Typo.body1" Style="color:#1976d2;font-weight:500;">
                Pasirinkta: @_selectedInvoices.Count
            </MudText>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                           OnClick="@(() => { _selectedInvoices.Clear(); StateHasChanged(); })">
                    Atšaukti
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="GenerateBulkPdfAsync"
                           Disabled="@_isGenerating"
                           Style="text-transform:none">
                    @if (_isGenerating)
                    {
                        <MudProgressCircular Size="Size.Small" Color="Color.Default" />
                    }
                    Generuoti PDF
                </MudButton>
            </div>
        </MudPaper>
    }

    <!-- Table -->
    <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
        <MudTable Items="@FilteredItems"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  RowsPerPage="25"
                  Elevation="0"
                  RowStyleFunc="@GetRowStyle"
                   Style="cursor:default">
            <HeaderContent>
                <MudTh Style="min-width:48px;width:48px;">
                    <input type="checkbox"
                           checked="@(GetSelectAllState() == true)"
                           @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)e.Value! ? true : false))"
                           @onclick:stopPropagation="true" />
                </MudTh>
                <MudTh>Nr.</MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Klientas</MudTh>
                <MudTh>Terminas</MudTh>
                <MudTh>Suma</MudTh>
                <MudTh>Liko</MudTh>
                <MudTh>Būsena</MudTh>
                <MudTh>Veiksmai</MudTh>
            </HeaderContent>
            <RowTemplate Context="invoice">
                <MudTd Style="min-width:48px;width:48px;">
                    <input type="checkbox"
                           checked="@_selectedInvoices.Contains(invoice.Id)"
                           @onchange="@((ChangeEventArgs e) => ToggleInvoice(invoice.Id, (bool)e.Value!))"
                           @onclick:stopPropagation="true" />
                </MudTd>
                <MudTd>@invoice.InvoiceNumber</MudTd>
                <MudTd>@invoice.InvoiceDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@GetCustomerName(invoice)</MudTd>
                <MudTd Style="@GetDueDateStyle(invoice)">
                    @(invoice.PaymentDueDate?.ToString("yyyy-MM-dd") ?? "-")
                </MudTd>
                <MudTd>@invoice.TotalInclVat.ToString("N2") €</MudTd>
                <MudTd Style="font-weight:bold;color:#1976d2">
                    @((invoice.TotalInclVat - invoice.PaidAmount).ToString("N2")) €
                </MudTd>
                <MudTd>
                    @{
                        var payStatus = invoice.PaymentStatus ?? "unpaid";
                        var statusString = invoice.Status.ToString();
                        var payLabel = payStatus switch {
                            "paid" => "Apmokėta",
                            "partial" => "Dalinai",
                            "unpaid" => statusString == "Draft" ? "Juodraštas" : "Neapmokėta",
                            _ => GetStatusLabel(statusString)
                        };
                        var payColor = payStatus switch {
                            "paid" => Color.Success,
                            "partial" => Color.Warning,
                            "unpaid" => statusString == "Draft" ? Color.Default : Color.Error,
                            _ => GetStatusColor(statusString)
                        };
                    }
                    <MudChip T="string" Color="@payColor" Size="Size.Small" Style="text-transform:none">@payLabel</MudChip>
                </MudTd>
                <MudTd>
                    <div @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       OnClick="@(async () => { ViewInvoice(invoice.Id); })"
                                       Color="Color.Primary"
                                       Size="Size.Small" />
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{25, 50, 100}" />
            </PagerContent>
            <NoRecordsContent>
                <MudText Class="text-center py-4">Įrašų nėra</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

<style>
    input[type=checkbox] {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #594ae2;
    }
</style>

@code {
    private List<Invoice> _items = new();
    private bool _isLoading = false;
    private int _selectedTab = 0;
    private string _invoiceType = "LAK";
    private HashSet<int> _selectedInvoices = new();
    private bool _isGenerating = false;

    // Filter state
    private string? _filterSearch = null;
    private DateRange? _dateRange = null;
    private HashSet<string> _selectedStatuses = new();

    // Available statuses for filtering
    private readonly List<string> _availableStatuses = new()
    {
        "Draft", "Confirmed", "Paid", "Disputed", "Cancelled"
    };

    // Computed
    private List<Invoice> FilteredItems => GetFilteredItems();

    // Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    // Data loading
    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            
            var invoices = await InvoiceService.GetInvoicesAsync(
                fromDate: _dateRange?.Start,
                toDate: _dateRange?.End,
                searchTerm: _filterSearch,
                type: _invoiceType == "LAK" ? "sales" : "purchase");

            _items = invoices;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida įkraunant sąskaitas: {ex.Message}", Severity.Error);
        }

        _isLoading = false;
        StateHasChanged();
    }

    // Type switcher
    private async Task SetInvoiceType(string type)
    {
        _invoiceType = type;
        _selectedInvoices.Clear();
        await LoadDataAsync();
    }

    // Filter logic
    private List<Invoice> GetFilteredItems()
    {
        var result = _items.AsQueryable();

        // Status filter
        if (_selectedStatuses.Any())
        {
            result = result.Where(i => _selectedStatuses.Contains(i.Status.ToString()));
        }

        // Tab filters (applied after status filter)
        switch (_selectedTab)
        {
            case 1: // Nesumokėtos
                result = result.Where(i => i.Status == InvoiceStatus.Confirmed);
                break;
            case 2: // Vėluojančios
                result = result.Where(i => 
                    i.Status == InvoiceStatus.Confirmed && 
                    i.PaymentDueDate.HasValue && 
                    i.PaymentDueDate.Value < DateTime.Today &&
                    i.PaidAmount < i.TotalInclVat);
                break;
            case 3: // Šis mėnuo
                var startOfMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
                result = result.Where(i => i.InvoiceDate >= startOfMonth);
                break;
        }

        return result.ToList();
    }

    private void ToggleStatus(string status)
    {
        if (_selectedStatuses.Contains(status))
        {
            _selectedStatuses.Remove(status);
        }
        else
        {
            _selectedStatuses.Add(status);
        }
        _selectedInvoices.Clear();
        StateHasChanged();
    }

    private void OnTabChanged(int index)
    {
        _selectedTab = index;
        _selectedInvoices.Clear();
        StateHasChanged();
    }

    private void ViewInvoice(int invoiceId)
    {
        Navigation.NavigateTo($"/invoices/{invoiceId}");
    }

    private void OpenCreateDialog()
    {
        Navigation.NavigateTo("/invoices/create");
    }

    private void OnCreateClick()
    {
        Navigation.NavigateTo("/invoices/create");
    }

    // Display helpers
    private string GetCustomerName(Invoice invoice)
    {
        return invoice.Customer?.Name ?? "Nežinomas";
    }

    private string GetStatusLabel(string status) => status switch
    {
        "Draft" => "Juodraštis",
        "Confirmed" => "Patvirtinta",
        "Paid" => "Apmokėta",
        "Disputed" => "Ginčijama",
        "Cancelled" => "Atšaukta",
        _ => status
    };

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Confirmed" => Color.Warning,
        "Paid" => Color.Success,
        "Disputed" => Color.Error,
        "Cancelled" => Color.Dark,
        _ => Color.Default
    };

    private string GetDueDateStyle(Invoice invoice)
    {
        if (!invoice.PaymentDueDate.HasValue) return "";
        
        var dueDate = invoice.PaymentDueDate.Value;
        var today = DateTime.Today;
        
        if (dueDate < today)
        {
            return "color:#dc2626;font-weight:bold"; // Red - overdue
        }
        else if (dueDate <= today.AddDays(7))
        {
            return "color:#f97316;font-weight:bold"; // Orange - due soon
        }
        
        return "color:#16a34a"; // Green - OK
    }

    private string GetRowStyle(Invoice item, int index)
    {
        if (item.Status == InvoiceStatus.Paid)
        {
            return ""; // Normal for paid invoices
        }
        
        if (item.PaymentDueDate.HasValue && item.PaymentDueDate.Value < DateTime.Today && item.PaidAmount < item.TotalInclVat)
        {
            return "background:#fef2f2"; // Red background for overdue
        }
        
        if (item.PaymentDueDate.HasValue && item.PaymentDueDate.Value <= DateTime.Today.AddDays(7))
        {
            return "background:#fffbeb"; // Yellow background for due soon
        }
        
        return "";
    }

    // Selection helpers
    private void ToggleInvoice(int id, bool selected)
    {
        Console.WriteLine($"ToggleInvoice called: id={id}, selected={selected}, count before={_selectedInvoices.Count}");
        if (selected)
            _selectedInvoices.Add(id);
        else
            _selectedInvoices.Remove(id);
        Console.WriteLine($"ToggleInvoice after: count={_selectedInvoices.Count}");
        StateHasChanged();
    }

    private bool? GetSelectAllState()
    {
        var visible = FilteredItems.Select(i => i.Id).ToList();
        if (!visible.Any()) return false;
        var selected = visible.Count(i => _selectedInvoices.Contains(i));
        if (selected == 0) return false;
        if (selected == visible.Count) return true;
        return null; // partial
    }

    private void ToggleSelectAll(bool state)
    {
        var visible = FilteredItems.Select(i => i.Id).ToList();
        if (state)
        {
            foreach (var id in visible)
                _selectedInvoices.Add(id);
        }
        else
        {
            foreach (var id in visible)
                _selectedInvoices.Remove(id);
        }
        StateHasChanged();
    }

    // Bulk PDF generation
    private async Task GenerateBulkPdfAsync()
    {
        if (_selectedInvoices.Count == 0) return;

        var selectedIds = _selectedInvoices.ToList();

        if (selectedIds.Count == 1)
        {
            await GenerateSinglePdfAsync(selectedIds[0]);
            return;
        }

        var choice = await DialogService.ShowMessageBox(
            "Kaip generuoti PDF?",
            $"Pasirinkta sąskaitų: {selectedIds.Count}. Norite sugeneruoti vieną sujungtą PDF failą ar atskirus failus ZIP archyve?",
            yesText: "Vienas failas",
            noText: "Atskiri failai (ZIP)");

        if (choice == null) return;

        _isGenerating = true;
        StateHasChanged();

        try
        {
            if (choice == true)
            {
                var pdfBytes = await PdfGeneratorService.GenerateMultipleInvoicesPdfAsync(selectedIds);
                var dateStr = DateTime.Now.ToString("yyyyMMdd");
                var fileName = $"invoices_{dateStr}.pdf";
                var base64 = Convert.ToBase64String(pdfBytes);
                var dataUrl = $"data:application/pdf;base64,{base64}";
                await JS.InvokeVoidAsync("downloadPdf", dataUrl, fileName);
                Snackbar.Add($"PDF su {selectedIds.Count} sąskaitomis sugeneruotas", Severity.Success);
            }
            else
            {
                await GenerateZipAsync(selectedIds);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida generuojant PDF: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task GenerateSinglePdfAsync(int invoiceId)
    {
        _isGenerating = true;
        StateHasChanged();

        try
        {
            var pdfBytes = await PdfGeneratorService.GenerateInvoicePdfAsync(invoiceId);
            var invoice = _items.FirstOrDefault(i => i.Id == invoiceId);
            var fileName = $"{invoice?.InvoiceNumber ?? "invoice"}.pdf";
            var base64 = Convert.ToBase64String(pdfBytes);
            var dataUrl = $"data:application/pdf;base64,{base64}";
            await JS.InvokeVoidAsync("downloadPdf", dataUrl, fileName);
            Snackbar.Add("PDF sėkmingai sugeneruotas", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida generuojant PDF: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task GenerateZipAsync(List<int> selectedIds)
    {
        try
        {
            using var ms = new MemoryStream();
            using (var zip = new ZipArchive(ms, ZipArchiveMode.Create, true))
            {
                foreach (var id in selectedIds)
                {
                    try
                    {
                        var pdfBytes = await PdfGeneratorService.GenerateInvoicePdfAsync(id);
                        var invoice = _items.FirstOrDefault(i => i.Id == id);
                        var entryName = $"{invoice?.InvoiceNumber ?? $"invoice-{id}"}.pdf";
                        var entry = zip.CreateEntry(entryName);
                        using var entryStream = entry.Open();
                        await entryStream.WriteAsync(pdfBytes);
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add($"Klaida generuojant sąskaitą (ID {id}): {ex.Message}", Severity.Warning);
                    }
                }
            }

            var zipBytes = ms.ToArray();
            var base64 = Convert.ToBase64String(zipBytes);
            var dateStr = DateTime.Now.ToString("yyyyMMdd");
            var fileName = $"invoices_{dateStr}.zip";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/zip", base64);
            Snackbar.Add($"PDF archyvas su {selectedIds.Count} sąskaitomis sugeneruotas", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida generuojant PDF: {ex.Message}", Severity.Error);
        }
    }
}