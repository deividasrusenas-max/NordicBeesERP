@page "/invoices"
@page "/invoices/sales"
@page "/invoices/purchases"
@rendermode InteractiveServer
@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using NordicBeesERP.Services.Dtos
@using NordicBeesERP.Helpers
@using MudBlazor
@using System.IO.Compression
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IPdfGeneratorService PdfGeneratorService
@inject ICreditNoteService CreditNoteService
@inject IJSRuntime JS
@inject IDialogService DialogService

<PageTitle>Sąskaitos</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <!-- Title row -->
    <MudText Typo="Typo.h5" Class="mb-3">Sąskaitos</MudText>

    <!-- Primary action row -->
    <MudButton OnClick="OpenCreateDialog"
               StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
                Color="Color.Primary"
                Class="mb-4"
                Style="text-transform:none">
         Sukurti sąskaitą
    </MudButton>

    <!-- Two-level Tabs: Level 1 - Type tabs (top, prominent) -->
    <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
        <MudChipSet T="string"
                    SelectedValue="_invoiceType"
                    SelectedValueChanged="@(async (val) => { if (val != null && val != _invoiceType) await SetInvoiceType(val); })"
                    SelectionMode="SelectionMode.SingleSelection">
            <MudChip T="string" Value="@("LAK")"
                     Color="@(_invoiceType == "LAK" ? Color.Primary : Color.Default)"
                     Variant="@(_invoiceType == "LAK" ? Variant.Filled : Variant.Outlined)"
                     Style="text-transform:none;min-width:180px;">
                LAK — Pardavimai
            </MudChip>
        <MudChip T="string" Value="@("ULAK")"
                 Color="@(_invoiceType == "ULAK" ? Color.Primary : Color.Default)"
                 Variant="@(_invoiceType == "ULAK" ? Variant.Filled : Variant.Outlined)"
                 Style="text-transform:none;min-width:180px;">
            ULAK — Atsakomosios sąskaitos
        </MudChip>
        <MudChip T="string" Value="@("KLAK")"
                 Color="@(_invoiceType == "KLAK" ? Color.Primary : Color.Default)"
                 Variant="@(_invoiceType == "KLAK" ? Variant.Filled : Variant.Outlined)"
                 Style="text-transform:none;min-width:180px;">
            KLAK — Kreditinės sąskaitos
        </MudChip>
    </MudChipSet>
    </MudStack>

    <!-- Loading indicator -->
    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <!-- Filter section -->
    <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField Value="@_filterSearch"
                                ValueChanged="@(async (string val) => await UpdateFilterSearchAsync(val))"
                                Label="Paieška pagal Nr. arba klientą"
                               Variant="Variant.Text"
                               Immediate="true"
                               FullWidth="@true"
                               Clearable="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Adornment="Adornment.Start" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                 <MudDateRangePicker DateRange="@_dateRange"
                                        DateRangeChanged="@(async (DateRange dr) => await UpdateDateRangeAsync(dr))"
                                    Label="Data (nuo / iki)"
                                     Variant="Variant.Text"
                                     FullWidth="@true"
                                     Clearable="true" Editable="true" DateFormat="yyyy-MM-dd" />
            </MudItem>
            @if (!string.IsNullOrEmpty(_filterSearch) || _dateRange?.Start != null || _selectedStatuses.Any())
            {
                <MudItem xs="12">
                    <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Variant="Variant.Text"
                               Color="Color.Secondary"
                               Size="Size.Small"
                                 OnClick="@(async () => await ClearFiltersAsync())">
                        Išvalyti filtrus
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <!-- Unified quick-filter + status chip row -->
    @if (_invoiceType != "KLAK")
    {
    <div class="d-flex flex-wrap gap-2 mb-3 align-center">
        <MudChip T="string"
                 Color="@(_selectedTab == 0 ? Color.Primary : Color.Default)"
                 Variant="@(_selectedTab == 0 ? Variant.Filled : Variant.Outlined)"
                 Style="text-transform:none;"
                 Size="Size.Small"
                 OnClick="@(async () => { if (_selectedTab != 0) await OnTabChangedAsync(0); })">
            Visos
        </MudChip>
        <MudChip T="string"
                  Color="@(_selectedTab == 1 ? Color.Error : Color.Default)"
                  Variant="@(_selectedTab == 1 ? Variant.Filled : Variant.Outlined)"
                  Style="text-transform:none;"
                  Size="Size.Small"
                  OnClick="@(async () => { if (_selectedTab != 1) await OnTabChangedAsync(1); })">
             Neapmokėtos
         </MudChip>
          <MudChip T="string"
                   Color="@(_selectedTab == 2 ? Color.Warning : Color.Default)"
                   Variant="@(_selectedTab == 2 ? Variant.Filled : Variant.Outlined)"
                   Style="text-transform:none;"
                   Size="Size.Small"
                   OnClick="@(async () => { if (_selectedTab != 2) await OnTabChangedAsync(2); })">
             Vėluojančios
         </MudChip>
          <MudChip T="string"
                   Color="@(_selectedTab == 3 ? Color.Primary : Color.Default)"
                   Variant="@(_selectedTab == 3 ? Variant.Filled : Variant.Outlined)"
                   Style="text-transform:none;"
                   Size="Size.Small"
                   OnClick="@(async () => { if (_selectedTab != 3) await OnTabChangedAsync(3); })">
             Šis mėnuo
         </MudChip>

        @* Status chips (multi-select) — NO "Būsena:" label, "Paid/Apmokėta" excluded per v2 *@
        @foreach (var status in _availableStatuses)
        {
            @if (status != "Paid")
            {
                var isSelected = _selectedStatuses.Contains(status);
                var chipColor = status == "Confirmed" ? Color.Info : Color.Default;
                <MudChip T="string"
                          Color="@chipColor"
                          Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                          OnClick="@(async () => await ToggleStatusAsync(status))"
                          Size="Size.Small"
                          Style="@(isSelected ? "" : "opacity:0.7")">
                    @StatusDisplayHelper.GetLabel(status, _statusDisplay)
                </MudChip>
            }
        }
    </div>
    }

    <!-- Bulk actions bar -->
    @if (_selectedInvoices.Count > 0 && _invoiceType != "KLAK")
    {
        <MudPaper Elevation="0" Rounded="true" Square="false" Class="mb-2 pa-3 d-flex align-center justify-space-between"
                  Style="background:#e8f0fe; border-radius:8px;">
            <MudText Typo="Typo.body1" Style="color:#1976d2;font-weight:500;">
                Pasirinkta: @_selectedInvoices.Count
            </MudText>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                           OnClick="@(() => { _selectedInvoices.Clear(); StateHasChanged(); })">
                    Atšaukti
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                            OnClick="@(async () => await GenerateBulkPdfAsync())"
                           Disabled="@_isGenerating"
                           Style="text-transform:none">
                    @if (_isGenerating)
                    {
                        <MudProgressCircular Size="Size.Small" Color="Color.Default" />
                    }
                    Generuoti PDF
                </MudButton>
            </div>
        </MudPaper>
    }

    <!-- Table -->
    <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
        @if (_invoiceType != "KLAK")
        {
        <MudTable Items="@PagedItems"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Elevation="0"
                  RowStyleFunc="@GetRowStyle"
                   Style="cursor:default">
            <HeaderContent>
                <MudTh Style="min-width:48px;width:48px;">
                    <input type="checkbox"
                           checked="@(GetSelectAllState() == true)"
                           @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)e.Value! ? true : false))"
                           @onclick:stopPropagation="true" />
                </MudTh>
                <MudTh>Nr.</MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Klientas</MudTh>
                <MudTh>Terminas</MudTh>
                <MudTh>Suma</MudTh>
                <MudTh>Liko</MudTh>
                <MudTh>Būsena</MudTh>
            </HeaderContent>
            <RowTemplate Context="invoice">
                <MudTd Style="min-width:48px;width:48px;">
                    <input type="checkbox"
                           checked="@_selectedInvoices.Contains(invoice.Id)"
                           @onchange="@((ChangeEventArgs e) => ToggleInvoice(invoice.Id, (bool)e.Value!))"
                           @onclick:stopPropagation="true" />
                </MudTd>
                <MudTd @ondblclick="@(() => ViewInvoice(invoice.Id))" Style="cursor:pointer">@invoice.InvoiceNumber</MudTd>
                <MudTd @ondblclick="@(() => ViewInvoice(invoice.Id))" Style="cursor:pointer">@invoice.InvoiceDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd @ondblclick="@(() => ViewInvoice(invoice.Id))" Style="cursor:pointer">@GetCustomerName(invoice)</MudTd>
                <MudTd @ondblclick="@(() => ViewInvoice(invoice.Id))" Style="cursor:pointer">
                    @{
                        var remaining = invoice.TotalInclVat - invoice.PaidAmount;
                        var isPaid = remaining <= 0;
                    }
                    @if (invoice.PaymentDueDate.HasValue)
                    {
                        var days = (invoice.PaymentDueDate.Value.Date - DateTime.Today).Days;
                        <span>@invoice.PaymentDueDate.Value.ToString("yyyy-MM-dd")</span>
                        @if (!isPaid)
                        {
                            @if (days == 0)
                            {
                                <span Style="color:orange;font-size:11px;margin-left:4px;">(šiandien)</span>
                            }
                            else if (days > 0)
                            {
                                <span Style="color:green;font-size:11px;margin-left:4px;">(@days d.)</span>
                            }
                            else
                            {
                                <span Style="color:red;font-size:11px;margin-left:4px;">(@days d.)</span>
                            }
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </MudTd>
                <MudTd @ondblclick="@(() => ViewInvoice(invoice.Id))" Style="cursor:pointer">@invoice.TotalInclVat.ToString("N2") €</MudTd>
                <MudTd @ondblclick="@(() => ViewInvoice(invoice.Id))" Style="cursor:pointer;font-weight:bold;color:#1976d2">
                    @((invoice.TotalInclVat - invoice.PaidAmount).ToString("N2")) €
                </MudTd>
                <MudTd @ondblclick="@(() => ViewInvoice(invoice.Id))" Style="cursor:pointer">
                    @{
                        var payStatus = invoice.PaymentStatus ?? "unpaid";
                        var statusString = invoice.Status.ToString();
                        var payLabel = payStatus switch {
                            "paid" => "Apmokėta",
                            "partial" => "Dalinai",
                            "unpaid" => statusString == "Draft" ? "Juodraštas" : "Neapmokėta",
                            _ => StatusDisplayHelper.GetLabel(statusString, _statusDisplay)
                        };
                        var payColor = payStatus switch {
                            "paid" => Color.Success,
                            "partial" => Color.Warning,
                            "unpaid" => statusString == "Draft" ? Color.Default : Color.Error,
                            _ => StatusDisplayHelper.GetColor(statusString, _statusDisplay)
                        };
                    }
                    <MudChip T="string" Color="@payColor" Size="Size.Small" Style="text-transform:none">@payLabel</MudChip>
                    @if (_invoiceIdsWithCreditNote.Contains(invoice.Id))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Color="Color.Error" Style="margin-left:8px;vertical-align:middle;" Title="Yra kreditinė sąskaita" />
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                @if (FilteredItems.Count > PageSize)
                {
                    var totalPages = (int)Math.Ceiling((double)FilteredItems.Count / PageSize);
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="pa-2">
                        <MudButton Variant="Variant.Outlined" 
                                   Size="Size.Small"
                                   Disabled="@(_currentPage <= 1)"
                                   OnClick="@(() => NavigateToPage(_currentPage - 1))"
                                   StartIcon="@Icons.Material.Filled.ChevronLeft">
                            Ankstesnė
                        </MudButton>
                        
                        @for (int i = 0; i < totalPages; i++)
                        {
                            var pageNum = i + 1;
                            if (ShouldShowPage(pageNum, _currentPage, totalPages))
                            {
                                if (i > 0 && !ShouldShowPage(pageNum - 1, _currentPage, totalPages))
                                {
                                    <MudText Class="mx-1">...</MudText>
                                }
                                <MudButton Variant="@(pageNum == _currentPage ? Variant.Filled : Variant.Outlined)"
                                           Color="@(pageNum == _currentPage ? Color.Primary : Color.Default)"
                                           Size="Size.Small"
                                           OnClick="@(() => NavigateToPage(pageNum))">
                                    @pageNum
                                </MudButton>
                            }
                        }
                        
                        <MudButton Variant="Variant.Outlined" 
                                   Size="Size.Small"
                                   Disabled="@(_currentPage >= totalPages)"
                                   OnClick="@(() => NavigateToPage(_currentPage + 1))"
                                   EndIcon="@Icons.Material.Filled.ChevronRight">
                            Kitas
                        </MudButton>
                    </MudStack>
                }
            </PagerContent>
            <NoRecordsContent>
                <MudText Class="text-center py-4">Įrašų nėra</MudText>
            </NoRecordsContent>
        </MudTable>
        }
        else
        {
        <MudTable Items="@PagedCreditNoteItems"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Elevation="0"
                  Style="cursor:pointer">
            <HeaderContent>
                <MudTh>Nr.</MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Klientas</MudTh>
                <MudTh>Kredituojama sąskaita</MudTh>
                <MudTh>Suma</MudTh>
                <MudTh>Būsena</MudTh>
            </HeaderContent>
            <RowTemplate Context="creditNote">
                <MudTd @onclick="@(() => ViewCreditNote(creditNote))" Style="cursor:pointer">@creditNote.CreditNoteNumber</MudTd>
                <MudTd @onclick="@(() => ViewCreditNote(creditNote))" Style="cursor:pointer">@creditNote.CreditDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd @onclick="@(() => ViewCreditNote(creditNote))" Style="cursor:pointer">@creditNote.CustomerName</MudTd>
                <MudTd @onclick="@(() => ViewCreditNote(creditNote))" Style="cursor:pointer">@creditNote.OriginalInvoiceNumber</MudTd>
                <MudTd @onclick="@(() => ViewCreditNote(creditNote))" Style="cursor:pointer;text-align:right">@creditNote.TotalInclVat.ToString("N2") €</MudTd>
                <MudTd @onclick="@(() => ViewCreditNote(creditNote))" Style="cursor:pointer">
                    @{
                        var statusString = creditNote.Status.ToString();
                        var cnLabel = statusString switch {
                            "Draft" => "Juodraštis",
                            "Printed" => "Atspausdinta",
                            "Disputed" => "Ginčijama",
                            _ => statusString
                        };
                        var cnColor = statusString switch {
                            "Draft" => Color.Default,
                            "Printed" => Color.Primary,
                            "Disputed" => Color.Error,
                            _ => Color.Default
                        };
                    }
                    <MudChip T="string" Color="@cnColor" Size="Size.Small" Style="text-transform:none">@cnLabel</MudChip>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                @if (_creditNoteItems.Count > PageSize)
                {
                    var totalPages = (int)Math.Ceiling((double)_creditNoteItems.Count / PageSize);
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="pa-2">
                        <MudButton Variant="Variant.Outlined" 
                                   Size="Size.Small"
                                   Disabled="@(_currentPage <= 1)"
                                   OnClick="@(() => NavigateToPage(_currentPage - 1))"
                                   StartIcon="@Icons.Material.Filled.ChevronLeft">
                            Ankstesnė
                        </MudButton>
                        
                        @for (int i = 0; i < totalPages; i++)
                        {
                            var pageNum = i + 1;
                            if (ShouldShowPage(pageNum, _currentPage, totalPages))
                            {
                                if (i > 0 && !ShouldShowPage(pageNum - 1, _currentPage, totalPages))
                                {
                                    <MudText Class="mx-1">...</MudText>
                                }
                                <MudButton Variant="@(pageNum == _currentPage ? Variant.Filled : Variant.Outlined)"
                                           Color="@(pageNum == _currentPage ? Color.Primary : Color.Default)"
                                           Size="Size.Small"
                                           OnClick="@(() => NavigateToPage(pageNum))">
                                    @pageNum
                                </MudButton>
                            }
                        }
                        
                        <MudButton Variant="Variant.Outlined" 
                                   Size="Size.Small"
                                   Disabled="@(_currentPage >= totalPages)"
                                   OnClick="@(() => NavigateToPage(_currentPage + 1))"
                                   EndIcon="@Icons.Material.Filled.ChevronRight">
                            Kitas
                        </MudButton>
                    </MudStack>
                }
            </PagerContent>
            <NoRecordsContent>
                <MudText Class="text-center py-4">Įrašų nėra</MudText>
            </NoRecordsContent>
        </MudTable>
        }
    </MudPaper>
</MudContainer>

<style>
    input[type=checkbox] {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #594ae2;
    }
</style>

@code {
    private List<Invoice> _items = new();
    private HashSet<int> _invoiceIdsWithCreditNote = new();
    private List<CreditNoteListDto> _creditNoteItems = new();
    private bool _isLoading = false;
    private int _selectedTab = 0;
    private string _invoiceType = "LAK";
    private HashSet<int> _selectedInvoices = new();
    private bool _isGenerating = false;

    // Filter state
    private string? _filterSearch = null;
    private DateRange? _dateRange = null;
    private HashSet<string> _selectedStatuses = new();

    // URL query-string parameters (synchronized with filter state)
    [SupplyParameterFromQuery(Name = "q")]
    public string? FilterSearch { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? DateFrom { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? DateTo { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusCsv { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public int? Tab { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? InvoiceTypeParam { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public string? PageParam { get; set; }

    // Pagination state
    private int _currentPage = 1;
    private const int PageSize = 25;

    // Available statuses for filtering
    private readonly List<string> _availableStatuses = new()
    {
        "Draft", "Confirmed", "Paid"
    };

    // Computed
    private List<Invoice> FilteredItems => GetFilteredItems();
    private List<Invoice> PagedItems
    {
        get
        {
            var filtered = FilteredItems;
            int start = (_currentPage - 1) * PageSize;
            return filtered.Skip(start).Take(PageSize).ToList();
        }
    }

    private List<CreditNoteListDto> PagedCreditNoteItems
    {
        get
        {
            int start = (_currentPage - 1) * PageSize;
            return _creditNoteItems.Skip(start).Take(PageSize).ToList();
        }
    }

    // Lifecycle
    protected override async Task OnParametersSetAsync()
    {
        _filterSearch = FilterSearch;
        _dateRange = (DateFrom.HasValue || DateTo.HasValue)
            ? new DateRange(DateFrom, DateTo)
            : null;
        _selectedStatuses = !string.IsNullOrEmpty(StatusCsv)
            ? new HashSet<string>(StatusCsv.Split(','))
            : new HashSet<string>();
        _selectedTab = Tab ?? 0;
        if (!string.IsNullOrEmpty(InvoiceTypeParam))
            _invoiceType = InvoiceTypeParam;
        _currentPage = int.TryParse(PageParam, out var p) && p > 0 ? p : 1;

        _selectedInvoices.Clear();
        await LoadDataAsync();
    }

    // Data loading
    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            if (_invoiceType == "KLAK")
            {
                var notes = await CreditNoteService.GetCreditNotesAsync(
                    currentPage: 1,
                    itemsPerPage: int.MaxValue,
                    filterSearch: _filterSearch,
                    filterStatus: null,
                    filterFromDate: _dateRange?.Start,
                    filterToDate: _dateRange?.End);

                _creditNoteItems = notes.Items;
                _items = new List<Invoice>();
                _invoiceIdsWithCreditNote = new HashSet<int>();
            }
            else
            {
                var invoices = await InvoiceService.GetInvoicesAsync(
                    fromDate: _dateRange?.Start,
                    toDate: _dateRange?.End,
                    searchTerm: _filterSearch,
                    type: _invoiceType == "LAK" ? "sales" : "purchase");

                _items = invoices;
                _creditNoteItems = new List<CreditNoteListDto>();

                var invoiceIds = _items.Select(i => i.Id).ToList();
                _invoiceIdsWithCreditNote = invoiceIds.Count > 0
                    ? await CreditNoteService.GetInvoiceIdsWithCreditNotesAsync(invoiceIds)
                    : new HashSet<int>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida įkraunant sąskaitas: {ex.Message}", Severity.Error);
        }

        _isLoading = false;
        StateHasChanged();
    }

    // Type switcher
    private async Task SetInvoiceType(string type)
    {
        _invoiceType = type;
        _selectedInvoices.Clear();
        _currentPage = 1;

        var newUrl = FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _filterSearch),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses)),
            ("tab", _selectedTab != 0 ? _selectedTab.ToString() : null),
            ("type", !string.IsNullOrEmpty(type) && type != "LAK" ? type : null),
            ("page", null));
        Navigation.NavigateTo(newUrl, replace: false);
        await LoadDataAsync();
    }

    // Filter logic
    private List<Invoice> GetFilteredItems()
    {
        var result = _items.AsQueryable();

        // Status filter
        if (_selectedStatuses.Any())
        {
            result = result.Where(i => _selectedStatuses.Contains(i.Status.ToString()));
        }

        // Tab filters (applied after status filter)
        switch (_selectedTab)
        {
            case 1: // Nesumokėtos
                result = result.Where(i => i.Status == InvoiceStatus.Confirmed);
                break;
            case 2: // Vėluojančios
                result = result.Where(i => 
                    i.Status == InvoiceStatus.Confirmed && 
                    i.PaymentDueDate.HasValue && 
                    i.PaymentDueDate.Value < DateTime.Today &&
                    i.PaidAmount < i.TotalInclVat);
                break;
            case 3: // Šis mėnuo
                var startOfMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
                result = result.Where(i => i.InvoiceDate >= startOfMonth);
                break;
        }

        return result.ToList();
    }

    private async Task ToggleStatusAsync(string status)
    {
        var newStatuses = new HashSet<string>(_selectedStatuses);
        if (newStatuses.Contains(status))
            newStatuses.Remove(status);
        else
            newStatuses.Add(status);

        _selectedStatuses = newStatuses;
        _selectedInvoices.Clear();
        _currentPage = 1;

        var newUrl = FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _filterSearch),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses)),
            ("tab", _selectedTab != 0 ? _selectedTab.ToString() : null),
            ("page", null));
        Navigation.NavigateTo(newUrl, replace: false);
    }

    private async Task OnTabChangedAsync(int index)
    {
        _selectedTab = index;
        _selectedInvoices.Clear();
        _currentPage = 1;

        var newUrl = FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _filterSearch),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses)),
            ("tab", index != 0 ? index.ToString() : null),
            ("page", null));
        Navigation.NavigateTo(newUrl, replace: false);
    }

    private async Task ClearFiltersAsync()
    {
