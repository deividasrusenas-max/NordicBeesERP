@page "/login"
@layout EmptyLayout
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http

<PageTitle>Prisijungimas</PageTitle>

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background:#f8fafc">
    <MudPaper Elevation="2" Class="pa-8" Style="width:400px; border-radius:16px">
        <div style="text-align:center; margin-bottom:24px">
            <img src="/logo.png" style="height:60px; margin-bottom:16px;" alt="Lakštena" />
            <MudText Typo="Typo.h5" Style="font-weight:700; color:#1e293b">Lakštena ERP</MudText>
            <MudText Typo="Typo.body2" Style="color:#64748b">Prisijunkite prie sistemos</MudText>
        </div>
        <form method="post" action="/auth/login">
            <AntiforgeryToken />
            @if (!string.IsNullOrEmpty(ReturnUrl))
            {
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            }
            <MudStack Spacing="3">
                <input name="email" type="email" required placeholder="El. paštas"
                    style="width:100%; box-sizing:border-box; padding:14px; border:1px solid #e2e8f0; border-radius:8px; font-size:16px; color:#1e293b; outline:none" />
                <input name="password" type="password" required placeholder="Slaptažodis"
                    style="width:100%; box-sizing:border-box; padding:14px; border:1px solid #e2e8f0; border-radius:8px; font-size:16px; color:#1e293b; outline:none" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="@true"
                    Size="Size.Large" ButtonType="ButtonType.Submit" Style="height:48px">
                    <span>Prisijungti</span>
                </MudButton>
            </MudStack>
        </form>
        @if (Error == "Invalid")
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">Neteisingas el. paštas arba slaptažodis</MudAlert>
        }
    </MudPaper>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx?.User.Identity?.IsAuthenticated == true && !ctx.Response.HasStarted)
            ctx.Response.Redirect("/");
    }
}
