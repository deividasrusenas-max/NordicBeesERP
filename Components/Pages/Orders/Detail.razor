@page "/orders/{OrderId:int}"
@rendermode InteractiveServer
@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using MudBlazor
@using NordicBeesERP.Components.Dialogs
@using NordicBeesERP.Helpers
@inject IOrderService OrderService
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject IAuthService AuthService
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Užsakymas @_order?.OrderNumber</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <!-- Loading -->
    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    @if (_order == null && !_isLoading)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            Užsakymas nerastas.
        </MudAlert>
        <MudButton OnClick="@(() => HandleBack())" Variant="Variant.Text" Color="Color.Primary">
            ← Atgal į užsakymus
        </MudButton>
    }

    @if (_order != null)
    {
        <!-- Header row -->
        <div class="d-flex justify-space-between align-center mb-3">
            <div>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.h5" Style="font-weight:600">
                        @_order.OrderNumber
                    </MudText>
                    <MudChip T="string" Color="@StatusDisplayHelper.GetColor(_order.Status, _statusDisplay)" Size="Size.Small" Style="text-transform:none">
                        @StatusDisplayHelper.GetLabel(_order.Status, _statusDisplay)
                    </MudChip>
                    @if (_order.IsUninvoiced)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Style="text-transform:none">Neišrašyta</MudChip>
                    }
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_customerName &nbsp;|&nbsp; @_order.OrderDate.ToString("yyyy-MM-dd")
                    @if (_order.DeliveryDate.HasValue)
                    {
                        <text>&nbsp;|&nbsp; Pristatymas: @_order.DeliveryDate.Value.ToString("yyyy-MM-dd")</text>
                    }
                </MudText>
            </div>
            <div class="d-flex gap-2">
                <MudButton OnClick="@(() => HandleBack())"
                           Variant="Variant.Outlined"
                           Color="Color.Default"
                           Style="text-transform:none">
                    ← Atgal į užsakymus
                </MudButton>
            </div>
        </div>

        <!-- Notes -->
        @if (!string.IsNullOrEmpty(_order.Notes))
        {
            <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px" Class="mb-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-1">Pastabos</MudText>
                <MudText Typo="Typo.body1">@_order.Notes</MudText>
            </MudPaper>
        }

        <!-- Line Items -->
        <MudPaper Elevation="0" Rounded="true" Square="false" Class="pa-3 mb-4">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.h6">Produktai</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_order.Lines.Count eilutė
                </MudText>
            </div>

            <MudTable Items="@_order.Lines" Dense="true" Hover="true" Striped="true" Elevation="0">
                <HeaderContent>
                    <MudTh Style="width:40px">#</MudTh>
                    <MudTh>Produkto pavadinimas</MudTh>
                    <MudTh Style="width:120px">Kiekis paletėmis</MudTh>
                    <MudTh Style="width:280px">Partijos (kiekis)</MudTh>
                    <MudTh Style="width:100px">Būsena</MudTh>
                    <MudTh Style="width:160px"></MudTh>
                </HeaderContent>
                <RowTemplate Context="line">
                    @{
                        var lineBatches = _pallets.Where(p => p.OrderLineId == line.Id).ToList();
                    }
                    <MudTd>@line.LineNumber</MudTd>
                    <MudTd>@GetProductName(line.ProductId)</MudTd>
                    <MudTd>@line.Quantity.ToString("N0")</MudTd>
                    <MudTd>
                        @if (lineBatches.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">–</MudText>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-1">
                                @foreach (var b in lineBatches)
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(b.IsShipped ? Color.Success : Color.Default)"
                                             Style="text-transform:none">
                                        @b.LotNumber · @b.Quantity.ToString("N0")@(b.IsShipped ? " ✓" : "")
                                    </MudChip>
                                }
                            </div>
                        }
                    </MudTd>
                    <MudTd>
                        @if (lineBatches.Count > 0)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Style="text-transform:none">
                                ✓ Pakuota
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Style="text-transform:none">
                                ● Nepakuota
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        @if (lineBatches.Count == 0)
                        {
                            <MudButton Size="Size.Small"
                                        Variant="Variant.Outlined"
                                        Color="Color.Primary"
                                        StartIcon="@Icons.Material.Filled.Inventory2"
                                        OnClick="@(() => OpenPackDialog(line))"
                                        Style="text-transform:none">
                                Paruošti siuntimui
                            </MudButton>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="text-center py-4">Eilučių nėra</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        <!-- Kurjeris paėmė button (only when ready_for_pickup) -->
        @if (_order.Status == "ready_for_pickup")
        {
            <MudPaper Elevation="0" Rounded="true" Square="false" Class="pa-3 mb-4">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.body1">
                        Visos eilutės pakuotos – užsakymas pasiruošęs kurjeriui paėmti.
                    </MudText>
                    <MudButton Size="Size.Large"
                               Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.LocalShipping"
                               OnClick="@MarkShippedAsync"
                               Disabled="@_isActioning"
                               Style="text-transform:none">
                        Kurjeris paėmė
                    </MudButton>
                </div>
            </MudPaper>
        }

        <!-- Shipped info -->
        @if (_order.Status == "shipped" && _order.ShippedAt.HasValue)
        {
            <MudPaper Elevation="0" Style="background:#f0fdf4; border-radius:8px; padding:16px" Class="mb-4">
                <MudText Typo="Typo.overline" Color="Color.Success">Išsiųsta</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_order.ShippedAt.Value.ToString("yyyy-MM-dd HH:mm")
                </MudText>
            </MudPaper>
        }

        <!-- Invoice section (visible ONLY when shipped AND Admin) -->
        @if (_order.Status == "shipped" && _isAdmin)
        {
            <MudPaper Elevation="0" Rounded="true" Square="false" Class="pa-3 mb-4">
                <MudText Typo="Typo.h6" Class="mb-3">Sąskaitos susiejimas</MudText>

                @if (_order.InvoiceId.HasValue && _linkedInvoice != null)
                {
                    <!-- Already linked - show read-only info -->
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">Sąskaitos Nr.</MudText>
                            <MudText Typo="Typo.body1" Style="font-weight:600">
                                @_linkedInvoice.InvoiceNumber
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">Sąskaitos data</MudText>
                            <MudText Typo="Typo.body1">
                                @_linkedInvoice.InvoiceDate.ToString("yyyy-MM-dd")
                            </MudText>
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <!-- Not linked yet - show autocomplete -->
                    <MudGrid>
                        <MudItem xs="12" sm="8">
                            <MudAutocomplete T="Invoice"
                                             @bind-Value="_selectedInvoiceOption"
                                             Label="Sąskaitos Nr."
                                             Placeholder="Pradėkite rašyti sąskaitos numerį..."
                                             SearchFunc="SearchInvoices"
                                             ToStringFunc="@(i => i != null ? $"{i.InvoiceNumber} ({i.InvoiceDate:yyyy-MM-dd})" : "")"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             FullWidth="@true" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudButton Variant="Variant.Filled"
                                        Color="Color.Primary"
                                        StartIcon="@Icons.Material.Filled.Link"
                                        OnClick="@LinkInvoiceAsync"
                                        Disabled="@( _isActioning || _selectedInvoiceOption == null)"
                                        Style="text-transform:none; margin-top:16px;">
                                Susieti
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                }
            </MudPaper>
        }
    }
</MudContainer>

@code {
    [Parameter]
    public int OrderId { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private Order? _order;
    private List<OrderPalletInfo> _pallets = new();

    // Shipment creation state
    private HashSet<int> _selectedBatchIds = new();
    private DateTime? _shipmentDate = DateTime.Today;
    private string? _courierName;
    private string? _shipmentNotes;
    private bool _pendingShipmentsDirty;
    private Invoice? _linkedInvoice;
    private bool _isLoading = true;
    private bool _isActioning = false;
    private bool _isAdmin;

    private Dictionary<int, string> _customerNames = new();
    private Dictionary<int, string> _productNames = new();
    private string _customerName = "Nežinomas";

    // Invoice linking state
    private Invoice? _selectedInvoiceOption;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _isAdmin = authState.User.IsInRole("Admin");

        await LoadLookupsAsync();
        await LoadOrderAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var customers = await CustomerService.GetCustomersAsync();
            _customerNames = customers.ToDictionary(c => c.Id, c => c.Name);

            var products = await ProductService.GetAllProductsAsync();
            _productNames = products.ToDictionary(p => p.Id, p => p.Name);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida įkraunant duomenis: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadOrderAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _order = await OrderService.GetOrderByIdAsync(OrderId);

            try { _pallets = await OrderService.GetOrderPalletsAsync(OrderId); }
            catch { _pallets = new List<OrderPalletInfo>(); }

            if (_order != null)
            {
                _customerName = GetCustomerName(_order.CustomerId);

                // If order has a linked invoice, fetch it for display
                if (_order.InvoiceId.HasValue)
                {
                    try
                    {
                        _linkedInvoice = await InvoiceService.GetInvoiceAsync(_order.InvoiceId.Value);
                    }
                    catch
                    {
                        // Invoice might have been deleted; ignore
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida įkraunant užsakymą: {ex.Message}", Severity.Error);
        }

        _isLoading = false;
        StateHasChanged();
    }

    // --- Pack Dialog ---
    private async Task OpenPackDialog(OrderLine line)
    {
        var productName = GetProductName(line.ProductId);
        List<PackLineDialog.BatchEntry>? result = await PackLineDialog.PackBatchesResult.ShowBatchesAsync(DialogService, line, productName);

        if (result != null)
        {
            _isActioning = true;
            StateHasChanged();

            try
            {
                var userId = await AuthService.GetUserIdAsync();
                if (userId == null)
                {
                    Snackbar.Add("Nėra prisijungusio naudotojo.", Severity.Error);
                    return;
                }

                var batches = result.Select(b => new OrderLineBatch
                {
                    OrderLineId = line.Id,
                    LotNumber = b.LotNumber,
                    ExpiryDate = b.ExpiryDate!.Value,
                    Quantity = b.Quantity!.Value
                }).ToList();

                await OrderService.SaveLineBatchesAsync(line.Id, batches, userId.Value);
                Snackbar.Add("Eilutė sėkmingai pakuota.", Severity.Success);
                await LoadOrderAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Klaida pakuojant: {ex.Message}", Severity.Error);
            }
            finally
            {
                _isActioning = false;
                StateHasChanged();
            }
        }
    }

    // --- Mark Shipped ---
    private async Task MarkShippedAsync()
    {
        if (_order == null) return;

        _isActioning = true;
        StateHasChanged();

        try
        {
            var userId = await AuthService.GetUserIdAsync();
            if (userId == null)
            {
                Snackbar.Add("Nėra prisijungusio naudotojo.", Severity.Error);
                return;
            }

            await OrderService.MarkShippedAsync(_order.Id, userId.Value);
            Snackbar.Add("Užsakymas pažymėtas kaip išsiųstas.", Severity.Success);
            await LoadOrderAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida žymint išsiųstą: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isActioning = false;
            StateHasChanged();
        }
    }

    // --- Create Shipment ---
    private void ToggleBatchSelection(int batchId)
    {
        if (!_selectedBatchIds.Remove(batchId))
            _selectedBatchIds.Add(batchId);
    }

    private bool CanConfirmShipment => _selectedBatchIds.Count > 0 && _shipmentDate.HasValue && !_isActioning;

    private async Task ConfirmShipmentAsync()
    {
        if (_order == null) return;

        if (_selectedBatchIds.Count == 0)
        {
            Snackbar.Add("Pasirinkite bent vieną padėklą.", Severity.Warning);
            return;
        }

        _isActioning = true;
        StateHasChanged();

        try
        {
            var userId = await AuthService.GetUserIdAsync();
            if (userId == null)
            {
                Snackbar.Add("Nėra prisijungusio naudotojo.", Severity.Error);
                return;
            }

            await OrderService.CreateShipmentAsync(_order.Id, _shipmentDate!.Value, _courierName, _shipmentNotes, userId.Value, _selectedBatchIds.ToList());
            Snackbar.Add("Siunta įrašyta.", Severity.Success);

            _selectedBatchIds.Clear();
            _courierName = null;
            _shipmentNotes = null;
            _shipmentDate = DateTime.Today;

            await LoadOrderAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida kuriant siuntą: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isActioning = false;
            StateHasChanged();
        }
    }

    // --- Invoice Autocomplete Search ---
    private async Task<IEnumerable<Invoice>> SearchInvoices(string term, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(term) || term.Length < 2)
            return Array.Empty<Invoice>();
        if (_order == null)
            return Array.Empty<Invoice>();
        try
        {
            return await InvoiceService.SearchInvoicesAsync(term, _order.CustomerId);
        }
        catch (OperationCanceledException) { return Array.Empty<Invoice>(); }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching invoices: {ex.Message}");
            return Array.Empty<Invoice>();
        }
    }

    // --- Link Invoice ---
    private async Task LinkInvoiceAsync()
    {
        if (_order == null) return;
        if (_selectedInvoiceOption == null)
        {
            Snackbar.Add("Pasirinkite sąskaitą iš sąrašo.", Severity.Warning);
            return;
        }

        _isActioning = true;
        StateHasChanged();

        try
        {
            var userId = await AuthService.GetUserIdAsync();
            if (userId == null)
            {
                Snackbar.Add("Nėra prisijungusio naudotojo.", Severity.Error);
                return;
            }

            await OrderService.LinkInvoiceAsync(_order.Id, _selectedInvoiceOption.Id, userId.Value);
            Snackbar.Add($"Sąskaita {_selectedInvoiceOption.InvoiceNumber} sėkmingai susieta.", Severity.Success);

            // Reload order to reflect changes
            await LoadOrderAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida susiejant sąskaitą: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isActioning = false;
            StateHasChanged();
        }
    }

    // --- Navigation ---
    private void HandleBack()
    {
        Navigation.NavigateTo(FilterUrlBuilder.ResolveReturnUrl(ReturnUrl, "/orders"));
    }

    // --- Display Helpers ---
    private string GetCustomerName(int customerId)
    {
        return _customerNames.TryGetValue(customerId, out var name) ? name : "Nežinomas";
    }

    private string GetProductName(int productId)
    {
        return _productNames.TryGetValue(productId, out var name) ? name : "Nežinomas";
    }

    private static readonly IReadOnlyDictionary<string, (string Label, Color Color)> _statusDisplay = StatusDisplayHelper.OrderStatusMap;
}
