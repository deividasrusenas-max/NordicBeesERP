@page "/orders"
@rendermode InteractiveServer
@using NordicBeesERP.Models
@using NordicBeesERP.Services
@using MudBlazor
@using NordicBeesERP.Helpers
@inject IOrderService OrderService
@inject ICustomerService CustomerService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Užsakymai</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <!-- Title row -->
    <MudText Typo="Typo.h5" Class="mb-3">Užsakymai</MudText>

    <!-- Primary action row -->
    <MudButton OnClick="OpenCreatePage"
               StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mb-3"
               Style="text-transform:none">
        Naujas užsakymas
    </MudButton>

    <!-- Filter section -->
    <StandardListFilterBar>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField Value="@_filterSearch"
                               ValueChanged="@(async (string val) => await UpdateFilterSearchAsync(val))"
                               Label="Paieška pagal Nr. arba klientą"
                               Variant="Variant.Text"
                               Immediate="true"
                              FullWidth="@true"
                              Clearable="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Adornment="Adornment.Start" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudDateRangePicker DateRange="@_dateRange"
                                     DateRangeChanged="@(async (DateRange dr) => await UpdateDateRangeAsync(dr))"
                                     Label="Data (nuo / iki)"
                                     Variant="Variant.Text"
                                     FullWidth="@true"
                                     Clearable="true"
                                     Editable="true"
                                     DateFormat="yyyy-MM-dd" />
            </MudItem>
            @if (!string.IsNullOrEmpty(_filterSearch) || _dateRange?.Start != null || _selectedStatuses.Any())
            {
                <MudItem xs="12">
                    <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Variant="Variant.Text"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               OnClick="@(async () => await ClearFiltersAsync())">
                        Išvalyti filtrus
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </StandardListFilterBar>

    <!-- Loading indicator -->
    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <!-- Unified quick-filter + status chip row -->
    <div class="d-flex flex-wrap gap-2 mb-3 align-center">
        @* Quick-filter chips (single-select, driven by _selectedTab) — valid MudBlazor 8.15 API: Selected + OnClick *@
        <MudChip T="string"
                 Selected="@(_selectedTab == 0)"
                 Color="@(_selectedTab == 0 ? Color.Primary : Color.Default)"
                 Variant="@(_selectedTab == 0 ? Variant.Filled : Variant.Outlined)"
                 Style="text-transform:none;"
                 OnClick="@(async () => await OnTabChangedAsync(0))">
            Visos
        </MudChip>
        <MudChip T="string"
                 Selected="@(_selectedTab == 1)"
                 Color="@(_selectedTab == 1 ? StatusDisplayHelper.GetColor("confirmed", _statusDisplay) : Color.Default)"
                 Variant="@(_selectedTab == 1 ? Variant.Filled : Variant.Outlined)"
                 Style="text-transform:none;"
                 OnClick="@(async () => await OnTabChangedAsync(1))">
            Patvirtinti
        </MudChip>
        <MudChip T="string"
                 Selected="@(_selectedTab == 2)"
                 Color="@(_selectedTab == 2 ? StatusDisplayHelper.GetColor("packing", _statusDisplay) : Color.Default)"
                 Variant="@(_selectedTab == 2 ? Variant.Filled : Variant.Outlined)"
                 Style="text-transform:none;"
                 OnClick="@(async () => await OnTabChangedAsync(2))">
            Pakuojami
        </MudChip>
        <MudChip T="string"
                 Selected="@(_selectedTab == 3)"
                 Color="@(_selectedTab == 3 ? StatusDisplayHelper.GetColor("ready_for_pickup", _statusDisplay) : Color.Default)"
                 Variant="@(_selectedTab == 3 ? Variant.Filled : Variant.Outlined)"
                 Style="text-transform:none;"
                 OnClick="@(async () => await OnTabChangedAsync(3))">
            Paruošti atsiėmimui
        </MudChip>
        <MudChip T="string"
                 Selected="@(_selectedTab == 4)"
                 Color="@(_selectedTab == 4 ? StatusDisplayHelper.GetColor("shipped", _statusDisplay) : Color.Default)"
                 Variant="@(_selectedTab == 4 ? Variant.Filled : Variant.Outlined)"
                 Style="text-transform:none;"
                 OnClick="@(async () => await OnTabChangedAsync(4))">
            Išsiųsti
        </MudChip>
        <MudChip T="string"
                 Selected="@(_selectedTab == 5)"
                 Color="@(_selectedTab == 5 ? Color.Error : Color.Default)"
                 Variant="@(_selectedTab == 5 ? Variant.Filled : Variant.Outlined)"
                 Style="text-transform:none;"
                 OnClick="@(async () => await OnTabChangedAsync(5))">
            Neišrašyta
        </MudChip>
        <MudChip T="string"
                 Selected="@(_selectedTab == 6)"
                 Color="@(_selectedTab == 6 ? Color.Info : Color.Default)"
                 Variant="@(_selectedTab == 6 ? Variant.Filled : Variant.Outlined)"
                 Style="text-transform:none;"
                 OnClick="@(async () => await OnTabChangedAsync(6))">
            Šis mėnuo
        </MudChip>

        @* Status chips (multi-select) *@
        @foreach (var status in _availableStatuses)
        {
            var isSelected = _selectedStatuses.Contains(status);
            <MudChip T="string"
                     Color="@(isSelected ? StatusDisplayHelper.GetColor(status, _statusDisplay) : Color.Default)"
                     Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(async () => await ToggleStatusAsync(status))"
                     Size="Size.Small"
                     Style="@(isSelected ? "" : "opacity:0.7")">
                @StatusDisplayHelper.GetLabel(status, _statusDisplay)
            </MudChip>
        }
    </div>

    <!-- Table -->
    <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
        <MudTable Items="@FilteredItems"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  RowsPerPage="25"
                  Elevation="0"
                  Style="cursor:pointer"
                  OnRowClick="@( (TableRowClickEventArgs<Order> args) => ViewOrder(args.Item.Id) )">
            <HeaderContent>
                <MudTh>Nr.</MudTh>
                <MudTh>Klientas</MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Paletai</MudTh>
                <MudTh>Būsena</MudTh>
            </HeaderContent>
            <RowTemplate Context="order">
                <MudTd>@order.OrderNumber</MudTd>
                <MudTd>@GetCustomerName(order.CustomerId)</MudTd>
                <MudTd>@order.OrderDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd Class="lakstena-mono">@order.TotalQuantity.ToString("N0")</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@StatusDisplayHelper.GetColor(order.Status, _statusDisplay)" Size="Size.Small" Style="text-transform:none">
                        @StatusDisplayHelper.GetLabel(order.Status, _statusDisplay)@(order.Status == "partially_shipped" ? $" {order.ShippedQuantity.ToString("N0")}/{order.TotalQuantity.ToString("N0")}" : "")
                    </MudChip>
                    @if (order.IsUninvoiced)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ml-1" Style="text-transform:none">Neišrašyta</MudChip>
                    }
                    @if (order.Status == "partially_shipped" && order.TotalQuantity > 0)
                    {
                        <MudProgressLinear Value="@GetShipmentProgress(order)"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           Class="mt-1"
                                           Style="height:4px; border-radius:2px; width:120px" />
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{25, 50, 100}" />
            </PagerContent>
            <NoRecordsContent>
                <MudText Class="text-center py-4">Įrašų nėra</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<Order> _items = new();
    private bool _isLoading = false;
    private int _selectedTab = 0;
    private Dictionary<int, string> _customerNames = new();

    // Filter state
    private string? _filterSearch = null;
    private DateRange? _dateRange = null;
    private HashSet<string> _selectedStatuses = new();

    // URL query-string parameters (synchronized with filter state)
    [SupplyParameterFromQuery(Name = "q")]
    public string? FilterSearch { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? DateFrom { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? DateTo { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusCsv { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public int? Tab { get; set; }

    // Available statuses for filtering
    private readonly List<string> _availableStatuses = new()
    {
        "draft", "confirmed", "packing", "ready_for_pickup", "shipped"
    };

    // Computed
    private List<Order> FilteredItems => GetFilteredItems();

    // Lifecycle
    protected override async Task OnParametersSetAsync()
    {
        _filterSearch = FilterSearch;
        _dateRange = (DateFrom.HasValue || DateTo.HasValue)
            ? new DateRange(DateFrom, DateTo)
            : null;
        _selectedStatuses = !string.IsNullOrEmpty(StatusCsv)
            ? new HashSet<string>(StatusCsv.Split(','))
            : new HashSet<string>();
        _selectedTab = Tab ?? 0;

        await LoadCustomersAsync();
        await LoadDataAsync();
    }

    private async Task LoadCustomersAsync()
    {
        try
        {
            var customers = await CustomerService.GetCustomersAsync();
            _customerNames = customers.ToDictionary(c => c.Id, c => c.Name);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida įkraunant klientus: {ex.Message}", Severity.Error);
        }
    }

    // Data loading
    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var orders = await OrderService.GetOrdersAsync();
            _items = orders;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida įkraunant užsakymus: {ex.Message}", Severity.Error);
        }

        _isLoading = false;
        StateHasChanged();
    }

    // Filter logic
    private List<Order> GetFilteredItems()
    {
        var result = _items.AsQueryable();

        // Status filter
        if (_selectedStatuses.Any())
        {
            result = result.Where(o => _selectedStatuses.Contains(o.Status));
        }

        // Search filter
        if (!string.IsNullOrWhiteSpace(_filterSearch))
        {
            var search = _filterSearch!.ToLower();
            result = result.Where(o =>
                o.OrderNumber.ToLower().Contains(search) ||
                GetCustomerName(o.CustomerId).ToLower().Contains(search));
        }

        // Date range filter
        if (_dateRange?.Start != null)
        {
            result = result.Where(o => o.OrderDate >= _dateRange.Start.Value);
        }
        if (_dateRange?.End != null)
        {
            var end = _dateRange.End.Value.Date.AddDays(1);
            result = result.Where(o => o.OrderDate < end);
        }

        // Tab filters (applied after search/date filters)
        switch (_selectedTab)
        {
            case 1: // Patvirtinti
                result = result.Where(o => o.Status == "confirmed");
                break;
            case 2: // Pakuojami
                result = result.Where(o => o.Status == "packing");
                break;
            case 3: // Paruošti atsiėmimui
                result = result.Where(o => o.Status == "ready_for_pickup");
                break;
            case 4: // Išsiųsti
                result = result.Where(o => o.Status == "shipped");
                break;
            case 5: // Neišrašyta
                result = result.Where(o => o.IsUninvoiced);
                break;
            case 6: // Šis mėnuo
                var startOfMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
                result = result.Where(o => o.OrderDate >= startOfMonth);
                break;
        }

        return result.ToList();
    }

    private async Task OnTabChangedAsync(int index)
    {
        _selectedTab = index;

        var newUrl = FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _filterSearch),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses)),
            ("tab", index != 0 ? index.ToString() : null));
        Navigation.NavigateTo(newUrl, replace: false);
    }

    private async Task ToggleStatusAsync(string status)
    {
        var newStatuses = new HashSet<string>(_selectedStatuses);
        if (newStatuses.Contains(status))
            newStatuses.Remove(status);
        else
            newStatuses.Add(status);

        _selectedStatuses = newStatuses;

        var newUrl = FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _filterSearch),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses)));
        Navigation.NavigateTo(newUrl, replace: false);
    }

    private async Task ClearFiltersAsync()
    {
        Navigation.NavigateTo(Navigation.Uri.Split('?')[0], replace: false);
    }

    private async Task UpdateFilterSearchAsync(string val)
    {
        _filterSearch = val;

        var newUrl = FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", val),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses)));
        Navigation.NavigateTo(newUrl, replace: true);
    }

    private async Task UpdateDateRangeAsync(DateRange dr)
    {
        _dateRange = dr;

        var newUrl = FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _filterSearch),
            ("from", FilterUrlBuilder.ToQueryValue(dr.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(dr.End)),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses)));
        Navigation.NavigateTo(newUrl, replace: false);
    }

    private void ViewOrder(int orderId)
    {
        var detailUrl = FilterUrlBuilder.BuildDetailUrl($"/orders/{orderId}", Navigation.Uri, Navigation.BaseUri);
        Navigation.NavigateTo(detailUrl);
    }

    private void OpenCreatePage()
    {
        Navigation.NavigateTo("/orders/create");
    }

    // Display helpers
    private string GetCustomerName(int customerId)
    {
        return _customerNames.TryGetValue(customerId, out var name) ? name : "Nežinomas";
    }

    private double GetShipmentProgress(Order order)
        => order.TotalQuantity > 0 ? Math.Min(100, (double)order.ShippedQuantity / (double)order.TotalQuantity * 100) : 0;

    private static readonly IReadOnlyDictionary<string, (string Label, Color Color)> _statusDisplay = StatusDisplayHelper.OrderStatusMap;
}
