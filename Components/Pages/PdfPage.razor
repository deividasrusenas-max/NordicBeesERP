@page "/invoices/pdf/{Id:int}"

@* =====================================================
   NORDIC BEES ERP - PDF GENERATOR PAGE
   Framework: .NET 10
   Generates and downloads invoice PDF using QuestPDF
   ===================================================== *@
@inject IPdfGeneratorService PdfService
@inject NavigationManager Navigation
@inject IDbContextFactory<NordicBeesERPContext> DbContextFactory
@inject NordicBeesERP.Services.IInvoiceService InvoiceService

<PageTitle>Sąskaitos spausdinimas</PageTitle>

<MudPaper Elevation="2" Class="pa-8 text-center">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    <MudText Typo="Typo.subtitle1" Class="mb-2">Kuriamas PDF...</MudText>
    <MudText Color="Color.Secondary">Prašome palaukite</MudText>
</MudPaper>

@code {
    [Parameter]
    public int Id { get; set; }

    private bool _firstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_firstRender) return;
        _firstRender = false;

        try
        {
            var pdfBytes = await PdfService.GenerateInvoicePdfAsync(Id);
            
            if (pdfBytes is not null && pdfBytes.Length > 0)
            {
                using var context = DbContextFactory.CreateDbContext();
                var invoice = await context.Invoices.FindAsync(Id);
                var fileName = $"{invoice.InvoiceNumber}.pdf";
                await DownloadPdfAsync(pdfBytes, fileName);
                
                // Update invoice status from Draft to Confirmed (PDF generation = "sending")
                if (invoice.Status == InvoiceStatus.Draft)
                {
                    try
                    {
                        await InvoiceService.UpdateInvoiceStatusAsync(Id, InvoiceStatus.Confirmed);
                    }
                    catch (Exception statusEx)
                    {
                        // Log error but don't fail PDF download - the PDF was generated successfully
                        Console.WriteLine($"PDF kūrimo puslapis: nepavyko atnaujinti būsenos iš Draft į Confirmed: {statusEx.Message}");
                    }
                }
                
                await Task.Delay(3000);
                Navigation.NavigateTo($"/invoices/{Id}");
            }
            else
            {
                ShowError("Nepavyko sukurti PDF");
            }
        }
        catch (Exception ex)
        {
            ShowError($"PDF kūrimo klaida: {ex.Message}");
        }
    }

    private async Task DownloadPdfAsync(byte[] pdfBytes, string fileName)
    {
        var base64 = Convert.ToBase64String(pdfBytes);
        var link = $"data:application/pdf;base64,{base64}";
        
        // Naudojame JavaScript interoperability PDF atsisiųimui
        await JsInteropDownload(link, fileName);
    }

    private async Task JsInteropDownload(string link, string fileName)
    {
        await JsRuntime.InvokeVoidAsync("downloadPdf", link, fileName);
    }

    private void ShowError(string message)
    {
        Navigation.NavigateTo($"/invoices?error={Uri.EscapeDataString(message)}");
    }

    [Inject]
    public IJSRuntime JsRuntime { get; set; } = default!;
}