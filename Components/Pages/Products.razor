@page "/products"
@inject IProductService ProductService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@using NordicBeesERP.Components.Dialogs
@using NordicBeesERP.Models
@using NordicBeesERP.Helpers
@using MudBlazor

<PageTitle>Prekės</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">Prekės</MudText>
        <MudButton OnClick="@OpenCreateDialog" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary">Nauja prekė</MudButton>
    </div>

    @if (products == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
        <MudTextField Value="@_searchText"
                      ValueChanged="@((string val) => UpdateSearchAsync(val))"
                      Placeholder="Ieškoti pagal kodą, pavadinimą, EAN..."
                      Variant="Variant.Outlined"
                      Immediate="true"
                      FullWidth="true"
                      Clearable="true"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Adornment="Adornment.Start" />
    </MudPaper>

    <div class="d-flex flex-wrap gap-2 mb-3 mt-2 align-center">
        <MudText Typo="Typo.body2" Style="color:#6b7280;margin-right:4px;">Tipas:</MudText>
        @foreach (var (type, label, color) in new (ProductType, string, Color)[]
        {
            (ProductType.FinishedGood, "Galutinis", Color.Success),
            (ProductType.RawMaterial, "Žaliava", Color.Warning),
            (ProductType.Packaging, "Tara", Color.Info),
            (ProductType.Service, "Paslauga", Color.Default)
        })
        {
            var isSelected = _selectedTypes.Contains(type);
            <MudChip T="string"
                     Color="@(isSelected ? color : Color.Default)"
                     Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => ToggleTypeFilter(type))"
                     Size="Size.Small"
                     Style="@(isSelected ? "" : "opacity:0.7")">
                @label
            </MudChip>
        }
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
        <MudChip T="string"
                 Color="@(_filterActive == true ? Color.Success : Color.Default)"
                 Variant="@(_filterActive == true ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => ToggleActiveFilter(true))"
                 Size="Size.Small"
                 Style="@(_filterActive == true ? "" : "opacity:0.7")">
            Aktyvus
        </MudChip>
        <MudChip T="string"
                 Color="@(_filterActive == false ? Color.Error : Color.Default)"
                 Variant="@(_filterActive == false ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => ToggleActiveFilter(false))"
                 Size="Size.Small"
                 Style="@(_filterActive == false ? "" : "opacity:0.7")">
            Neaktyvus
        </MudChip>
    </div>

    <MudPaper Elevation="0" Class="mt-2 pa-3">
        <MudTable T="Product" Items="@FilteredProducts" Hover="true" Dense="true" Elevation="0"
                  OnRowClick="@(async (TableRowClickEventArgs<Product> args) => { if (IsDoubleClick(args.Item!)) await OpenEditDialog(args.Item!); })"
                  Style="cursor:pointer" RowsPerPage="25">
            <HeaderContent>
                <MudTh>Kodas</MudTh>
                <MudTh>Tipas</MudTh>
                <MudTh>Pavadinimas</MudTh>
                <MudTh>EAN</MudTh>
                <MudTh>Vienetas</MudTh>
                <MudTh>Savikaina</MudTh>
                <MudTh>Pardavimo kaina</MudTh>
                <MudTh>Aktyvus</MudTh>
                <MudTh Style="width:100px;">Veiksmai</MudTh>
            </HeaderContent>
            <RowTemplate Context="product">
                <MudTd>
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary"><strong>@product.Code</strong></MudText>
                </MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(GetProductTypeColor(product.ProductType))">
                        @(GetProductTypeLabel(product.ProductType))
                    </MudChip>
                </MudTd>
                <MudTd>@product.Name</MudTd>
                <MudTd>
                    @if (!string.IsNullOrEmpty(product.EanCode))
                    {
                        <MudText Typo="Typo.caption">@product.EanCode</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">—</MudText>
                    }
                </MudTd>
                <MudTd>@product.Unit</MudTd>
                <MudTd>@product.CostPrice.ToString("N2") €</MudTd>
                <MudTd><strong>@product.SalePrice.ToString("N2") €</strong></MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(product.IsActive ? Color.Success : Color.Default)"
                             Variant="Variant.Outlined">
                        @(product.IsActive ? "Aktyvus" : "Neaktyvus")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <div @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OpenEditDialog(product))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteProduct(product))" />
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="text-center py-4">Prekių nėra</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{25, 50, 100}" />
            </PagerContent>
        </MudTable>
    </MudPaper>

</MudContainer>

@code {
    private List<Product>? products;
    private string? _searchText;
    private HashSet<ProductType> _selectedTypes = new();
    private bool? _filterActive;
    private DateTime _lastClickTime = DateTime.MinValue;
    private object? _lastClickItem;

    // URL query-string parameters (synchronized with filter state)
    [SupplyParameterFromQuery(Name = "q")]
    public string? FilterSearch { get; set; }

    [SupplyParameterFromQuery(Name = "active")]
    public string? ActiveFilter { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeCsv { get; set; }

    private bool IsDoubleClick(object item)
    {
        var now = DateTime.Now;
        if (_lastClickItem == item && (now - _lastClickTime).TotalMilliseconds < 400)
        {
            _lastClickItem = null;
            return true;
        }
        _lastClickItem = item;
        _lastClickTime = now;
        return false;
    }

    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            IEnumerable<Product> list = products ?? [];

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                list = list.Where(p =>
                    p.Code.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    p.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    (p.EanCode?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) == true));
            }

            if (_selectedTypes.Any())
                list = list.Where(p => _selectedTypes.Contains(p.ProductType));

            if (_filterActive.HasValue)
                list = list.Where(p => p.IsActive == _filterActive.Value);

            return list;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _searchText = FilterSearch;

        _filterActive = ActiveFilter switch
        {
            "1" => true,
            "0" => false,
            _ => null
        };

        if (!string.IsNullOrWhiteSpace(TypeCsv))
        {
            _selectedTypes = new HashSet<ProductType>();
            foreach (var part in TypeCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (Enum.TryParse<ProductType>(part, out var t))
                    _selectedTypes.Add(t);
            }
        }
        else
        {
            _selectedTypes = new HashSet<ProductType>();
        }

        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = await ProductService.GetAllProductsAsync();
    }

    private void UpdateSearchAsync(string val)
    {
        _searchText = val;
        NavigateWithFilters();
    }

    private void ToggleTypeFilter(ProductType type)
    {
        if (!_selectedTypes.Remove(type))
            _selectedTypes.Add(type);
        NavigateWithFilters();
    }

    private void ToggleActiveFilter(bool value)
    {
        _filterActive = _filterActive == value ? null : value;
        NavigateWithFilters();
    }

    // Single navigation site persisting the full filter state (q, type, active)
    private void NavigateWithFilters()
    {
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _searchText),
            ("type", FilterUrlBuilder.ToQueryValue(_selectedTypes.Select(t => t.ToString()))),
            ("active", FilterUrlBuilder.ToQueryValue(_filterActive))), replace: true);
    }

    private static string GetProductTypeLabel(ProductType type) => type switch
    {
        ProductType.RawMaterial => "Žaliava",
        ProductType.Packaging => "Pakuotė",
        ProductType.SemiFinished => "Pusgaminis",
        ProductType.FinishedGood => "Galutinis",
        ProductType.Service => "Paslauga",
        _ => type.ToString()
    };

    private static Color GetProductTypeColor(ProductType type) => type switch
    {
        ProductType.RawMaterial => Color.Warning,
        ProductType.Packaging => Color.Info,
        ProductType.SemiFinished => Color.Secondary,
        ProductType.FinishedGood => Color.Success,
        ProductType.Service => Color.Default,
        _ => Color.Default
    };

    private async Task OpenCreateDialog()
    {
        var product = new Product
        {
            IsActive = true,
            Unit = "kg",
            ProductType = ProductType.FinishedGood
        };

        var parameters = new DialogParameters
        {
            { "Product", product }
        };

        var dialog = await DialogService.ShowAsync<ProductEditDialog>("Nauja prekė", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            Snackbar.Add("Prekė sėkmingai sukurta!", Severity.Success);
            await LoadProducts();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenEditDialog(Product product)
    {
        var fullProduct = await ProductService.GetProductByIdAsync(product.Id) ?? product;

        var parameters = new DialogParameters
        {
            { "Product", fullProduct }
        };

        var dialog = await DialogService.ShowAsync<ProductEditDialog>($"Redaguoti prekę: {fullProduct.Code}", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            Snackbar.Add("Prekė sėkmingai atnaujinta!", Severity.Success);
            await LoadProducts();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeleteProduct(Product product)
    {
        if (product is null)
        {
            Snackbar.Add("Klaida: prekė nerasta!", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            { "ContentText", $"Ar tikrai norite ištrinti prekę '{product.Name}'?" },
            { "ButtonText", "Trinti" },
            { "Color", Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Patvirtinti", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            var deleted = await ProductService.DeleteProductAsync(product.Id);
            if (deleted)
            {
                Snackbar.Add("Prekė sėkmingai ištrinta!", Severity.Success);
                await LoadProducts();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                Snackbar.Add("Nepavyko ištrinti prekės: bandykite dar kartą", Severity.Error);
            }
        }
    }
}
