@page "/app-settings"
@rendermode InteractiveServer
@inject IDbContextFactory<NordicBeesERPContext> DbFactory
@inject ISnackbar Snackbar
@using NordicBeesERP.Models.Expenses

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">Nustatymai</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettings">
            Išsaugoti
        </MudButton>
    </div>

    <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background:#f8fafc; border-radius:8px">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Azure Document Intelligence</MudText>

        <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background:#f8fafc; border-radius:8px">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField @bind-Value="azureDiEndpoint" Label="Endpoint URL" Style="flex:1"
                              Placeholder="https://<resource>.cognitiveservices.azure.com/"
                              Variant="Variant.Outlined" />
                <MudIconButton Icon="@Icons.Material.Filled.NetworkCheck"
                               Color="Color.Primary"
                               OnClick="TestAzureConnection"
                               Title="Tikrinti ryšį" />
                @if (azureStatus.HasValue)
                {
                    <MudIcon Icon="@(azureStatus.Value ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                             Color="@(azureStatus.Value ? Color.Success : Color.Error)" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.HelpOutline"
                             Color="Color.Default"
                             Title="Azure nesukonfigūruotas" />
                }
            </MudStack>

            <MudTextField @bind-Value="azureDiKey" InputType="InputType.Password"
                          Label="API Key"
                          Variant="Variant.Outlined"
                          @bind-Value:after="SaveSettingsAsync" />
        </MudPaper>

        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Būsena</MudText>
        <MudPaper Elevation="0" Class="pa-3" Style="background:#f8fafc; border-radius:8px">
            @if (azureStatus == true)
            {
                <MudText Color="Color.Success">Sistema sukonfigūruota ir veikia.</MudText>
            }
            else if (azureStatus == false)
            {
                <MudText Color="Color.Error">Azure Document Intelligence nepasiekiamas - patikrinkite nustatymus.</MudText>
            }
            else
            {
                <MudText Color="Color.Default">Azure Document Intelligence nesukonfigūruotas.</MudText>
            }
        </MudPaper>
    </MudPaper>

    <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background:#f8fafc; border-radius:8px">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-3">Telegram pranešimai</MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudTextField @bind-Value="telegramBotToken" InputType="InputType.Password"
                          Label="Bot Token" Variant="Variant.Outlined" Style="flex:1" />
            <MudIconButton Icon="@Icons.Material.Filled.NetworkCheck"
                           Color="Color.Primary"
                           OnClick="TestTelegramConnection"
                           Title="Tikrinti ryšį" />
            @if (telegramStatus.HasValue)
            {
                <MudIcon Icon="@(telegramStatus.Value ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                         Color="@(telegramStatus.Value ? Color.Success : Color.Error)" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.HelpOutline"
                         Color="Color.Default"
                         Title="Telegram nesukonfigūruotas" />
            }
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudNumericField T="long" @bind-Value="telegramChatSandelis" Label="Sandėlio grupė (chat ID)" Variant="Variant.Outlined" Style="flex:1" />
            <MudNumericField T="long" @bind-Value="telegramChatUzsakymai" Label="Užsakymų grupė (chat ID)" Variant="Variant.Outlined" Style="flex:1" />
            <MudNumericField T="long" @bind-Value="telegramChatGamyba" Label="Gamybos grupė (chat ID)" Variant="Variant.Outlined" Style="flex:1" />
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string azureDiEndpoint = string.Empty;
    private string azureDiKey = string.Empty;
    private bool? azureStatus;

    [Inject] IExpenseOcrService ExpenseOcrService { get; set; } = default!;
    [Inject] TelegramNotificationService Telegram { get; set; } = default!;

    private string telegramBotToken = string.Empty;
    private long telegramChatSandelis;
    private long telegramChatUzsakymai;
    private long telegramChatGamyba;
    private bool? telegramStatus;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        await using var context = DbFactory.CreateDbContext();

        var endpointSetting = await context.AppSettings
            .FirstOrDefaultAsync(s => s.SettingKey == "azure_di_endpoint");
        azureDiEndpoint = endpointSetting?.SettingValue ?? string.Empty;

        var keySetting = await context.AppSettings
            .FirstOrDefaultAsync(s => s.SettingKey == "azure_di_key");
        azureDiKey = keySetting?.SettingValue ?? string.Empty;

        telegramBotToken = (await context.AppSettings.FirstOrDefaultAsync(s => s.SettingKey == "telegram_bot_token"))?.SettingValue ?? string.Empty;
        telegramChatSandelis = long.TryParse((await context.AppSettings.FirstOrDefaultAsync(s => s.SettingKey == "telegram_chat_sandelis"))?.SettingValue, out var ts) ? ts : 0;
        telegramChatUzsakymai = long.TryParse((await context.AppSettings.FirstOrDefaultAsync(s => s.SettingKey == "telegram_chat_uzsakymai"))?.SettingValue, out var tu) ? tu : 0;
        telegramChatGamyba = long.TryParse((await context.AppSettings.FirstOrDefaultAsync(s => s.SettingKey == "telegram_chat_gamyba"))?.SettingValue, out var tg) ? tg : 0;
        telegramStatus = string.IsNullOrEmpty(telegramBotToken) ? null : true;

        // Automatically test connection if both values are configured
        if (!string.IsNullOrEmpty(azureDiEndpoint) && !string.IsNullOrEmpty(azureDiKey))
        {
            azureStatus = await ExpenseOcrService.IsAzureHealthyAsync();
        }
        else
        {
            azureStatus = null; // Not configured - show neutral state
        }
    }

    private async Task SaveSettings()
    {
        await SaveSettingsAsync();
    }

    private async Task SaveSettingsAsync()
    {
        await using var context = DbFactory.CreateDbContext();

        await UpsertSettingAsync(context, "azure_di_endpoint", azureDiEndpoint);
        await UpsertSettingAsync(context, "azure_di_key", azureDiKey);
        await UpsertSettingAsync(context, "telegram_bot_token", telegramBotToken);
        await UpsertSettingAsync(context, "telegram_chat_sandelis", telegramChatSandelis.ToString());
        await UpsertSettingAsync(context, "telegram_chat_uzsakymai", telegramChatUzsakymai.ToString());
        await UpsertSettingAsync(context, "telegram_chat_gamyba", telegramChatGamyba.ToString());

        Snackbar.Add("Nustatymai išsaugoti", Severity.Success);
    }

    private static async Task UpsertSettingAsync(NordicBeesERPContext context, string key, string value)
    {
        await context.Database.ExecuteSqlRawAsync(
            "INSERT INTO app_settings (setting_key, setting_value) VALUES ({0}, {1}) " +
            "ON DUPLICATE KEY UPDATE setting_value = {1}",
            key, value);
    }

    private async Task TestAzureConnection()
    {
        await SaveSettingsAsync();

        azureStatus = await ExpenseOcrService.IsAzureHealthyAsync();

        Snackbar.Add(azureStatus.Value
            ? "Azure Document Intelligence aktyvus"
            : "Azure Document Intelligence nepasiekiamas",
            azureStatus.Value ? Severity.Success : Severity.Error);

        StateHasChanged();
    }

    private async Task TestTelegramConnection()
    {
        await SaveSettingsAsync();

        telegramStatus = await Telegram.TestConnectionAsync(telegramBotToken);

        Snackbar.Add(telegramStatus.Value
            ? "Telegram botas aktyvus"
            : "Telegram botas nepasiekiamas - patikrinkite tokeną",
            telegramStatus.Value ? Severity.Success : Severity.Error);

        StateHasChanged();
    }
}