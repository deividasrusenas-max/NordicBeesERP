@page "/suppliers"
@inject ISupplierService SupplierService
@inject IExpenseService ExpenseService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NordicBeesERP.Components.Dialogs
@using NordicBeesERP.Helpers
@using NordicBeesERP.Models.Expenses
@using MudBlazor

<PageTitle>Tiekėjai</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <MudText Typo="Typo.h5" Class="mb-3">Tiekėjai</MudText>
    <div class="d-flex justify-space-between align-center mb-4">
        @if (_isAdmin || _isManager)
        {
            <MudButton OnClick="@(() => OpenCreateDialog(PartnerType.Both))" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none">Naujas tiekėjas</MudButton>
        }
        else if (_isWarehouse)
        {
            <MudButton OnClick="@(() => OpenCreateDialog(PartnerType.Supplier))" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Style="text-transform:none">Naujas ūkininkas</MudButton>
        }
    </div>

    @if (suppliers == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <StandardListFilterBar>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField Value="@_searchText"
                              ValueChanged="@((string val) => OnSearchChanged(val))"
                              Label="Paieška pagal pavadinimą, kodą arba PVM kodą"
                              Variant="Variant.Text"
                              Immediate="true"
                              FullWidth="true"
                              Clearable="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Adornment="Adornment.Start" />
            </MudItem>
            @if (!string.IsNullOrEmpty(_searchText) || _selectedVatRates.Any() || _filterActive.HasValue || _tabIndex != 0)
            {
                <MudItem xs="12">
                    <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Variant="Variant.Text"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               OnClick="@ClearFiltersAsync">
                        Išvalyti filtrus
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </StandardListFilterBar>

    <MudStack Row="true" Class="mt-2 mb-0">
        @if (!_isWarehouse)
        {
            <MudChip T="string"
                     Checked="@(_tabIndex == 0)"
                     OnCheckedChange="@(async (bool v) => { if (v) OnTabChanged(0); })"
                     Color="@(_tabIndex == 0 ? Color.Primary : Color.Default)"
                     Variant="@(_tabIndex == 0 ? Variant.Filled : Variant.Outlined)"
                     Size="Size.Small"
                     SelectionGroup="true"
                     Style="@(_tabIndex == 0 ? "" : "opacity:0.7")">
                VISI
            </MudChip>
        }
        <MudChip T="string"
                 Checked="@(_tabIndex == 1)"
                 OnCheckedChange="@(async (bool v) => { if (v) OnTabChanged(1); })"
                 Color="@(_tabIndex == 1 ? Color.Primary : Color.Default)"
                 Variant="@(_tabIndex == 1 ? Variant.Filled : Variant.Outlined)"
                 Size="Size.Small"
                 SelectionGroup="true"
                 Style="@(_tabIndex == 1 ? "" : "opacity:0.7")">
            ŪKININKAI
        </MudChip>
        @if (!_isWarehouse)
        {
            <MudChip T="string"
                     Checked="@(_tabIndex == 2)"
                     OnCheckedChange="@(async (bool v) => { if (v) OnTabChanged(2); })"
                     Color="@(_tabIndex == 2 ? Color.Primary : Color.Default)"
                     Variant="@(_tabIndex == 2 ? Variant.Filled : Variant.Outlined)"
                     Size="Size.Small"
                     SelectionGroup="true"
                     Style="@(_tabIndex == 2 ? "" : "opacity:0.7")">
                ĮMONĖS
            </MudChip>
        }
    </MudStack>

    <div class="d-flex flex-wrap gap-2 mb-3 mt-2 align-center">
        <MudText Typo="Typo.body2" Class="mr-1">PVM:</MudText>
        @foreach (var rate in new decimal[] { 0, 6, 21 })
        {
            var isVatSelected = _selectedVatRates.Contains(rate);
            <MudChip T="string"
                     Color="@(isVatSelected ? Color.Primary : Color.Default)"
                     Variant="@(isVatSelected ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => ToggleVatRate(rate))"
                     Size="Size.Small"
                     Style="@(isVatSelected ? "" : "opacity:0.7")">
                @rate%
            </MudChip>
        }
        @if (_tabIndex == 2 && !_isWarehouse)
        {
            <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
            var isActiveSelected = _filterActive == true;
            var isInactiveSelected = _filterActive == false;
            <MudChip T="string"
                     Color="@(isActiveSelected ? Color.Success : Color.Default)"
                     Variant="@(isActiveSelected ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => ToggleActiveFilter(true))"
                     Size="Size.Small"
                     Style="@(isActiveSelected ? "" : "opacity:0.7")">
                Aktyvus
            </MudChip>
            <MudChip T="string"
                     Color="@(isInactiveSelected ? Color.Error : Color.Default)"
                     Variant="@(isInactiveSelected ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => ToggleActiveFilter(false))"
                     Size="Size.Small"
                     Style="@(isInactiveSelected ? "" : "opacity:0.7")">
                Neaktyvus
            </MudChip>
        }
    </div>

    <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
        @if (_tabIndex == 1 || _isWarehouse)
        {
            <MudTable T="Supplier" Items="@FilteredSuppliers" Hover="true" Dense="true" Elevation="0"
                      OnRowClick="@(async (TableRowClickEventArgs<Supplier> args) => { if (IsDoubleClick(args.Item)) await OpenEditDialog(args.Item); })"
                      Style="cursor:pointer" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>Vardas</MudTh>
                    <MudTh>Asmens kodas</MudTh>
                    <MudTh>PVM%</MudTh>
                    <MudTh>Mokėjimo term.</MudTh>
                    <MudTh>Aktyvus</MudTh>
                    <MudTh Style="width:120px;">Veiksmai</MudTh>
                </HeaderContent>
                <RowTemplate Context="supplier">
                    <MudTd>@supplier.Name</MudTd>
                    <MudTd>@(supplier.NationalIdNumber ?? "—")</MudTd>
                    <MudTd Class="lakstena-mono">@supplier.DefaultVatRate.ToString("N0")%</MudTd>
                    <MudTd Class="lakstena-mono">@supplier.PaymentTermDays d.</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(supplier.IsActive ? Color.Success : Color.Default)"
                                 Variant="Variant.Outlined">
                            @(supplier.IsActive ? "Aktyvus" : "Neaktyvus")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <div @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => OpenEditDialog(supplier))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteSupplier(supplier))" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else if (_tabIndex == 2)
        {
            <MudTable T="Supplier" Items="@FilteredSuppliers" Hover="true" Dense="true" Elevation="0"
                      OnRowClick="@(async (TableRowClickEventArgs<Supplier> args) => { if (IsDoubleClick(args.Item)) await OpenEditDialog(args.Item); })"
                      Style="cursor:pointer" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>Pavadinimas</MudTh>
                    <MudTh>Įm. kodas</MudTh>
                    <MudTh>PVM kodas</MudTh>
                    <MudTh>Numatyta kategorija</MudTh>
                    <MudTh>Mokėjimo term.</MudTh>
                    <MudTh>Aktyvus</MudTh>
                    <MudTh Style="width:120px;">Veiksmai</MudTh>
                </HeaderContent>
                <RowTemplate Context="supplier">
                    <MudTd>@supplier.Name</MudTd>
                    <MudTd>@(supplier.CompanyCode ?? "—")</MudTd>
                    <MudTd>@(supplier.VatCode ?? "—")</MudTd>
                    <MudTd>@(_categories.FirstOrDefault(c => c.Id == supplier.DefaultExpenseCategoryId)?.Name ?? "—")</MudTd>
                    <MudTd Class="lakstena-mono">@supplier.PaymentTermDays d.</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(supplier.IsActive ? Color.Success : Color.Default)"
                                 Variant="Variant.Outlined">
                            @(supplier.IsActive ? "Aktyvus" : "Neaktyvus")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <div @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => OpenEditDialog(supplier))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteSupplier(supplier))" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudTable T="Supplier" Items="@FilteredSuppliers" Hover="true" Dense="true" Elevation="0"
                      OnRowClick="@(async (TableRowClickEventArgs<Supplier> args) => { if (IsDoubleClick(args.Item)) await OpenEditDialog(args.Item); })"
                      Style="cursor:pointer" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>Pavadinimas</MudTh>
                    <MudTh>Kodas</MudTh>
                    <MudTh>PVM%</MudTh>
                    <MudTh>Mokėjimo term.</MudTh>
                    <MudTh>Aktyvus</MudTh>
                    <MudTh Style="width:120px;">Veiksmai</MudTh>
                </HeaderContent>
                <RowTemplate Context="supplier">
                    <MudTd>@supplier.Name</MudTd>
                    <MudTd>@(supplier.CompanyCode ?? supplier.NationalIdNumber ?? "—")</MudTd>
                    <MudTd Class="lakstena-mono">@supplier.DefaultVatRate.ToString("N0")%</MudTd>
                    <MudTd Class="lakstena-mono">@supplier.PaymentTermDays d.</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(supplier.IsActive ? Color.Success : Color.Default)"
                                 Variant="Variant.Outlined">
                            @(supplier.IsActive ? "Aktyvus" : "Neaktyvus")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <div @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => OpenEditDialog(supplier))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteSupplier(supplier))" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

</MudContainer>

@code {
    [CascadingParameter] Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private List<Supplier>? suppliers;
    private int _tabIndex = 0;
    private string? _searchText;
    private List<NordicBeesERP.Models.Expenses.ExpenseCategory> _categories = new();
    private HashSet<decimal> _selectedVatRates = new();
    private bool? _filterActive;
    private bool _isWarehouse;
    private bool _isAdmin;
    private bool _isManager;
    private DateTime _lastClickTime = DateTime.MinValue;
    private object? _lastClickItem;

    // URL query-string parameters (synchronized with filter state)
    [SupplyParameterFromQuery(Name = "q")]
    public string? FilterSearch { get; set; }

    [SupplyParameterFromQuery(Name = "vat")]
    public string? VatRates { get; set; }

    [SupplyParameterFromQuery(Name = "active")]
    public string? ActiveFilter { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public int? TabIndex { get; set; }

    // Lifecycle: restore filter state from URL on every navigation
    protected override void OnParametersSet()
    {
        _searchText = FilterSearch;

        if (!string.IsNullOrEmpty(VatRates))
        {
            try
            {
                _selectedVatRates = new HashSet<decimal>(
                    VatRates.Split(',', StringSplitOptions.RemoveEmptyEntries)
                        .Select(x => decimal.Parse(x.Trim(), System.Globalization.CultureInfo.InvariantCulture)));
            }
            catch
            {
                _selectedVatRates = new HashSet<decimal>();
            }
        }
        else
        {
            _selectedVatRates = new HashSet<decimal>();
        }

        _filterActive = ActiveFilter switch
        {
            "1" => true,
            "0" => false,
            _ => null
        };

        if (TabIndex.HasValue)
            _tabIndex = TabIndex.Value;

        StateHasChanged();
    }

    // Filter change handlers
    private void OnSearchChanged(string val)
    {
        _searchText = val;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _searchText),
            ("vat", FilterUrlBuilder.ToQueryValue(_selectedVatRates.Select(r => r.ToString(System.Globalization.CultureInfo.InvariantCulture)))),
            ("active", FilterUrlBuilder.ToQueryValue(_filterActive)),
            ("tab", _tabIndex != 0 ? _tabIndex.ToString() : null)), replace: true);
    }

    private void OnTabChanged(int i)
    {
        _tabIndex = i;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _searchText),
            ("vat", FilterUrlBuilder.ToQueryValue(_selectedVatRates.Select(r => r.ToString(System.Globalization.CultureInfo.InvariantCulture)))),
            ("active", FilterUrlBuilder.ToQueryValue(_filterActive)),
            ("tab", _tabIndex != 0 ? _tabIndex.ToString() : null)), replace: false);
    }

    private async Task ClearFiltersAsync()
    {
        _searchText = null;
        _selectedVatRates = new HashSet<decimal>();
        _filterActive = null;
        _tabIndex = 0;
        Navigation.NavigateTo(Navigation.Uri.Split('?')[0], replace: false);
        await LoadSuppliers();
    }

    private bool IsDoubleClick(object item)
    {
        var now = DateTime.Now;
        if (_lastClickItem == item && (now - _lastClickTime).TotalMilliseconds < 400)
        {
            _lastClickItem = null;
            return true;
        }
        _lastClickItem = item;
        _lastClickTime = now;
        return false;
    }

    private IEnumerable<Supplier> FilteredSuppliers
    {
        get
        {
            IEnumerable<Supplier> list;
            if (_isWarehouse)
            {
                list = suppliers?.Where(s => !string.IsNullOrEmpty(s.NationalIdNumber)) ?? [];
            }
            else
            {
                list = _tabIndex switch
                {
                    1 => suppliers?.Where(s => !string.IsNullOrEmpty(s.NationalIdNumber)) ?? [],
                    2 => suppliers?.Where(s => !string.IsNullOrEmpty(s.CompanyCode) || (string.IsNullOrEmpty(s.NationalIdNumber) && string.IsNullOrEmpty(s.CompanyCode))) ?? [],
                    _ => suppliers ?? []
                };
            }

            if (!string.IsNullOrWhiteSpace(_searchText))
                list = list.Where(s =>
                    (s.Name?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) == true) ||
                    (s.CompanyCode?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) == true) ||
                    (s.NationalIdNumber?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) == true));

            if (_selectedVatRates.Any())
                list = list.Where(s => _selectedVatRates.Contains(s.DefaultVatRate));

            if (_tabIndex == 2 && !_isWarehouse && _filterActive.HasValue)
                list = list.Where(s => s.IsActive == _filterActive.Value);

            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _isWarehouse = authState.User.IsInRole("Warehouse");
        _isAdmin = authState.User.IsInRole("Admin");
        _isManager = authState.User.IsInRole("Manager");
        if (_isWarehouse) _tabIndex = 1;
        _categories = await ExpenseService.GetCategoriesAsync(isActive: true);
        await LoadSuppliers();
        StateHasChanged();
    }

    private async Task LoadSuppliers()
    {
        suppliers = await SupplierService.GetSuppliersAsync();
    }

    private void ToggleVatRate(decimal rate)
    {
        if (!_selectedVatRates.Remove(rate))
            _selectedVatRates.Add(rate);
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _searchText),
            ("vat", FilterUrlBuilder.ToQueryValue(_selectedVatRates.Select(r => r.ToString(System.Globalization.CultureInfo.InvariantCulture)))),
            ("active", FilterUrlBuilder.ToQueryValue(_filterActive)),
            ("tab", _tabIndex != 0 ? _tabIndex.ToString() : null)), replace: false);
    }

    private void ToggleActiveFilter(bool value)
    {
        _filterActive = _filterActive == value ? null : value;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", _searchText),
            ("vat", FilterUrlBuilder.ToQueryValue(_selectedVatRates.Select(r => r.ToString(System.Globalization.CultureInfo.InvariantCulture)))),
            ("active", FilterUrlBuilder.ToQueryValue(_filterActive)),
            ("tab", _tabIndex != 0 ? _tabIndex.ToString() : null)), replace: false);
    }

    private async Task OpenCreateDialog(PartnerType partnerType)
    {
        var supplier = new Supplier { PartnerType = PartnerType.Supplier };
        var parameters = new DialogParameters
        {
            { "Supplier", supplier }
        };

        var dialog = await DialogService.ShowAsync<SupplierEditDialog>("Naujas tiekėjas", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is not null)
        {
            var savedSupplier = (Supplier)result.Data;
            Snackbar.Add("Tiekėjas sėkmingai sukurtas!", Severity.Success);
            await LoadSuppliers();
        }
    }

    private async Task OpenEditDialog(Supplier supplier)
    {
        var fullSupplier = await SupplierService.GetSupplierByIdAsync(supplier.Id) ?? supplier;
        
        var parameters = new DialogParameters
        {
            { "Supplier", fullSupplier }
        };

        var dialog = await DialogService.ShowAsync<SupplierEditDialog>("Redaguoti tiekėją", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is not null)
        {
            var savedSupplier = (Supplier)result.Data;
            Snackbar.Add("Tiekėjas sėkmingai atnaujintas!", Severity.Success);
            await LoadSuppliers();
        }
    }

    private async Task DeleteSupplier(Supplier supplier)
    {
        if (supplier is null)
        {
            Snackbar.Add("Klaida: tiekėjas nerastas!", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            { "ContentText", $"Ar tikrai norite ištrinti tiekėją '{supplier.Name}'?" },
            { "ButtonText", "Trinti" },
            { "Color", Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Patvirtinti", parameters, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true });
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                var deleted = await SupplierService.DeleteBusinessPartnerAsync(supplier.Id);
                if (deleted)
                {
                    Snackbar.Add("Tiekėjas sėkmingai ištrintas!", Severity.Success);
                    await LoadSuppliers();
                }
            }
            catch (Exception ex) when (ex.InnerException?.Message.Contains("foreign key constraint") == true ||
                                        ex.Message.Contains("foreign key constraint") == true)
            {
                Snackbar.Add("Negalima ištrinti tiekėjo — yra susijusių sąskaitų ar kitų įrašų. Pirmiau ištrinkite susijusius įrašus.", Severity.Warning);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Klaida trinant: {ex.Message}", Severity.Error);
            }
        }
    }
}
