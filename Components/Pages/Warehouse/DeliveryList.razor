@page "/warehouse/deliveries"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Warehouse")]
@rendermode InteractiveServer
@using NordicBeesERP.Models
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Helpers
@using NordicBeesERP.Components.Dialogs
@inject IDeliveryService DeliveryService
@inject ICustomerService CustomerService
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Pristatymai</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-3">Pristatymai</MudText>

    <MudButton OnClick="@(() => Navigation.NavigateTo("/warehouse/deliveries/new"))"
               StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mb-4"
               Style="text-transform:none">
        Naujas pristatymas
    </MudButton>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <ListFilterCard Search="@_search"
                    SearchChanged="UpdateSearchAsync"
                    SearchLabel="Paieška (numeris, tiekėjas, sąskaita)"
                    DateRange="@_dateRange"
                    DateRangeChanged="UpdateDateRangeAsync"
                    ShowClear="@(!string.IsNullOrWhiteSpace(_search) || _dateRange?.Start != null || _dateRange?.End != null || _tab != 0)"
                    OnClear="ClearFilters" />

    <div class="d-flex flex-wrap gap-2 mb-3 align-center">
        @foreach (var chip in _quickChips)
        {
            <FilterChip Selected="@(_tab == chip.Tab)" ActiveColor="@chip.Color" OnClick="@(() => SetTabAsync(chip.Tab))">@chip.Label</FilterChip>
        }
    </div>

    <SelectionBar Count="_selectedIds.Count" OnCancel="@(() => _selectedIds.Clear())">
        @if (EligibleSelected.Any())
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Receipt"
                       OnClick="CreateInvoicesForSelected"
                       Style="text-transform:none">
                Išrašyti sąskaitas (@EligibleSelected.Count)
            </MudButton>
        }
    </SelectionBar>

    <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
        <MudTable T="Delivery" Items="PagedItems" Dense="true" Hover="true" Striped="true" Elevation="0"
                  RowsPerPage="@PageSize" Style="cursor:default">
            <HeaderContent>
                <MudTh Style="min-width:48px;width:48px;">
                    <input type="checkbox" class="nb-check"
                           checked="@(AllPageSelected)"
                           @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)e.Value!))"
                           @onclick:stopPropagation="true" />
                </MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Numeris</MudTh>
                <MudTh>Tiekėjas</MudTh>
                <MudTh Style="text-align:right">Netto (kg)</MudTh>
                <MudTh Style="text-align:center">Tara</MudTh>
                <MudTh>Būsena</MudTh>
            </HeaderContent>
            <RowTemplate Context="delivery">
                <MudTd Style="min-width:48px;width:48px;">
                    <input type="checkbox" class="nb-check"
                           checked="@_selectedIds.Contains(delivery.Id)"
                           @onchange="@((ChangeEventArgs e) => ToggleSelection(delivery.Id, (bool)e.Value!))"
                           @onclick:stopPropagation="true" />
                </MudTd>
                <MudTd @ondblclick="@(() => GoToDelivery(delivery.Id))" Style="cursor:pointer">@delivery.DeliveryDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd @ondblclick="@(() => GoToDelivery(delivery.Id))" Style="cursor:pointer">@delivery.DeliveryNumber</MudTd>
                <MudTd @ondblclick="@(() => GoToDelivery(delivery.Id))" Style="cursor:pointer">@GetSupplierName(delivery.SupplierId)</MudTd>
                <MudTd @ondblclick="@(() => GoToDelivery(delivery.Id))" Class="lakstena-mono" Style="cursor:pointer;text-align:right">@delivery.TotalNetWeight.ToString("N1")</MudTd>
                <MudTd @ondblclick="@(() => GoToDelivery(delivery.Id))" Style="cursor:pointer;text-align:center">
                    @if (delivery.BarrelsOwed == 0)
                    {
                        <MudText Typo="Typo.caption" Style="color:#aaa">-</MudText>
                    }
                    else
                    {
                        var taraFull = delivery.BarrelsReturned >= delivery.BarrelsOwed;
                        <MudChip T="string" Size="Size.Small" Color="@(taraFull ? Color.Success : Color.Warning)">@delivery.BarrelsReturned/@delivery.BarrelsOwed</MudChip>
                    }
                </MudTd>
                <MudTd @ondblclick="@(() => GoToDelivery(delivery.Id))" Style="cursor:pointer">
                    <MudChip T="string" Size="Size.Small" Style="text-transform:none"
                             Color="@StatusDisplayHelper.GetColor(delivery.Status, _statusDisplay)"
                             Icon="@(!string.IsNullOrEmpty(delivery.InvoiceNumber) ? Icons.Material.Filled.Receipt : null)">
                        @StatusDisplayHelper.GetLabel(delivery.Status, _statusDisplay)
                    </MudChip>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <ListPager Page="EffectivePage" PageSize="PageSize" TotalCount="FilteredDeliveries.Count" PageChanged="NavigateToPage" />
            </PagerContent>
            <NoRecordsContent>
                <MudText Class="text-center py-4">Pristatymų nerasta</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

<style>
    input[type=checkbox].nb-check {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #594ae2;
    }
</style>

@code {
    private const int PageSize = 50;

    private List<Delivery> _deliveries = new();
    private List<NordicBeesERP.Models.BusinessPartner> _suppliers = new();
    private HashSet<int> _selectedIds = new();
    private bool _loading = true;

    // Filter state (mirrors the URL; filtering runs over the already loaded list, no reload)
    private string? _search;
    private DateRange? _dateRange;
    private int _tab;
    private int _page = 1;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? QFrom { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? QTo { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public int? QTab { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? QPage { get; set; }

    // Tab 0 = all
    private static readonly (int Tab, string Label, Color Color)[] _quickChips =
    {
        (0, "Visos", Color.Primary),
        (1, "Neįkainoti", Color.Warning),
        (2, "Be sąskaitos", Color.Warning),
        (3, "Negrąžintos statinės", Color.Warning),
        (4, "Šis mėnuo", Color.Primary),
    };

    private List<Delivery> _filtered = new();
    private List<Delivery> FilteredDeliveries => _filtered;
    private Dictionary<int, string> _supplierNames = new();
    private int EffectivePage => Math.Clamp(_page, 1, Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize)));
    private List<Delivery> PagedItems => _filtered.Skip((EffectivePage - 1) * PageSize).Take(PageSize).ToList();

    private List<Delivery> GetFiltered()
    {
        IEnumerable<Delivery> result = _deliveries;

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            result = result.Where(d =>
                (d.DeliveryNumber != null && d.DeliveryNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                GetSupplierName(d.SupplierId).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrEmpty(d.InvoiceNumber) && d.InvoiceNumber.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }
        if (_dateRange?.Start != null)
            result = result.Where(d => d.DeliveryDate.Date >= _dateRange.Start.Value.Date);
        if (_dateRange?.End != null)
            result = result.Where(d => d.DeliveryDate.Date <= _dateRange.End.Value.Date);

        switch (_tab)
        {
            case 1: // Neįkainoti
                result = result.Where(d => d.Status == "RECEIVED");
                break;
            case 2: // Be sąskaitos
                result = result.Where(d => string.IsNullOrEmpty(d.InvoiceNumber));
                break;
            case 3: // Negrąžintos statinės
                result = result.Where(d => d.BarrelsOwed > d.BarrelsReturned);
                break;
            case 4: // Šis mėnuo
                var startOfMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                result = result.Where(d => d.DeliveryDate >= startOfMonth);
                break;
        }
        return result.ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        _suppliers = await CustomerService.GetSuppliersAsync();
        await LoadData();
    }

    // Only URL query parameters change on filtering/paging: sync state, never reload from the DB.
    protected override void OnParametersSet()
    {
        _search = Q;
        _dateRange = (QFrom.HasValue || QTo.HasValue) ? new DateRange(QFrom, QTo) : null;
        _tab = QTab is >= 0 and <= 4 ? QTab.Value : 0;
        _page = QPage is > 0 ? QPage.Value : 1;
        _selectedIds.Clear();
        _filtered = GetFiltered();
    }

    private async Task LoadData()
    {
        _loading = true;
        _deliveries = await DeliveryService.GetFilteredAsync(null, null, null, null);
        _supplierNames = _suppliers.ToDictionary(x => x.Id, x => x.Name ?? "");
        _filtered = GetFiltered();
        _loading = false;
    }

    private string BuildListUrl(int page) => FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
        ("q", FilterUrlBuilder.ToQueryValue(_search)),
        ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
        ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
        ("tab", _tab != 0 ? _tab.ToString() : null),
        ("page", page > 1 ? page.ToString() : null));

    private Task UpdateSearchAsync(string? value)
    {
        _search = value;
        _page = 1;
        Navigation.NavigateTo(BuildListUrl(1), replace: true);
        return Task.CompletedTask;
    }

    private Task UpdateDateRangeAsync(DateRange? range)
    {
        _dateRange = range;
        _page = 1;
        Navigation.NavigateTo(BuildListUrl(1));
        return Task.CompletedTask;
    }

    private Task SetTabAsync(int tab)
    {
        if (_tab == tab) return Task.CompletedTask;
        _tab = tab;
        _page = 1;
        Navigation.NavigateTo(BuildListUrl(1));
        return Task.CompletedTask;
    }

    private Task NavigateToPage(int page)
    {
        _page = page;
        Navigation.NavigateTo(BuildListUrl(page), replace: true);
        return Task.CompletedTask;
    }

    private void ClearFilters()
    {
        Navigation.NavigateTo(Navigation.Uri.Split('?')[0]);
    }

    private void GoToDelivery(int id)
    {
        var detailUrl = FilterUrlBuilder.BuildDetailUrl($"/warehouse/deliveries/{id}", BuildListUrl(EffectivePage), Navigation.BaseUri);
        Navigation.NavigateTo(detailUrl);
    }

    private void ToggleSelection(int id, bool selected)
    {
        if (selected) _selectedIds.Add(id);
        else _selectedIds.Remove(id);
    }

    private bool AllPageSelected
    {
        get
        {
            var ids = PagedItems.Select(d => d.Id).ToList();
            return ids.Count > 0 && ids.All(_selectedIds.Contains);
        }
    }

    private void ToggleSelectAll(bool state)
    {
        foreach (var d in PagedItems)
        {
            if (state) _selectedIds.Add(d.Id);
            else _selectedIds.Remove(d.Id);
        }
    }

    private string GetSupplierName(int id)
    {
        return _supplierNames.TryGetValue(id, out var name) ? name : $"#{id}";
    }

    // Bulk invoicing is the 6% (ULAK) flow: only farmers (individuals) with a compensation VAT code.
    // The VAT code is NOT the criterion - UABs have one and must not get a ULAK, farmers don't have one.
    private bool IsFarmerSupplier(int supplierId)
    {
        var supplier = _suppliers.FirstOrDefault(s => s.Id == supplierId);
        return supplier != null && supplier.IsIndividual && !string.IsNullOrWhiteSpace(supplier.CompensationVatCode);
    }

    private List<Delivery> EligibleSelected => _filtered
        .Where(d => _selectedIds.Contains(d.Id)
                 && string.IsNullOrEmpty(d.InvoiceNumber)
                 && IsFarmerSupplier(d.SupplierId)
                 && d.TotalAmount > 0)
        .ToList();

    private static readonly Dictionary<string, (string Label, Color Color)> _statusDisplay = new()
    {
        { "RECEIVED", ("Priimtas", Color.Info) },
        { "PRICED", ("Įkainotas", Color.Error) },
        { "PARTIAL_PAID", ("Dalinai", Color.Warning) },
        { "PAID", ("Apmokėtas", Color.Success) }
    };

    private async Task CreateInvoicesForSelected()
    {
        var eligible = EligibleSelected;

        if (!eligible.Any())
        {
            Snackbar.Add("Nėra tinkamų pristatymų sąskaitoms išrašyti", Severity.Warning);
            return;
        }

        // Issue day (default today): drives the invoice number year and the due date; delivery date stays the supply date
        var dialog = await DialogService.ShowAsync<InvoiceDateDialog>("Sąskaitų išrašymas",
            new DialogParameters<InvoiceDateDialog> { { x => x.ContentText, $"Išrašoma sąskaitų: {eligible.Count}. Pasirinkite išrašymo datą." } },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var dialogResult = await dialog.Result;
        if (dialogResult == null || dialogResult.Canceled || dialogResult.Data is not DateTime issueDate)
            return;

        // One shared path per delivery (draft invoice, delivery date, supplier payment term, farmer validation).
        // A failure on one delivery must not abort or hide the rest of the batch.
        var created = 0;
        var failures = new List<string>();
        foreach (var delivery in eligible)
        {
            try
            {
                await InvoiceService.CreateInvoiceFromDeliveryAsync(delivery.Id, 0m, 0m, 0m, null, issueDate);
                created++;
            }
            catch (Exception ex)
            {
                failures.Add($"{delivery.DeliveryNumber}: {ex.Message}");
            }
        }

        if (created > 0)
            Snackbar.Add($"{created} sąskaita(-os) išrašyta(-os) (juodraščiai)", Severity.Success);
        foreach (var failure in failures)
            Snackbar.Add($"Nepavyko išrašyti – {failure}", Severity.Error);
        _selectedIds.Clear();
        await LoadData();
    }
}
