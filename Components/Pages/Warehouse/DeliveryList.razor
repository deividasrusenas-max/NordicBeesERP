@page "/warehouse/deliveries"
@rendermode InteractiveServer
@using NordicBeesERP.Models
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Helpers
@inject IDeliveryService DeliveryService
@inject ICustomerService CustomerService
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Pristatymai</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Style="font-weight:600" Class="mb-4">Pristatymai</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
        Href="/warehouse/deliveries/new" Class="mb-2">Naujas pristatymas</MudButton>

    @if (_selectedDeliveries.Any(d => string.IsNullOrEmpty(d.InvoiceNumber) && !string.IsNullOrEmpty(GetSupplierVatCode(d.SupplierId)) && d.TotalAmount > 0))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.Receipt"
                   OnClick="CreateInvoicesForSelected">
            Išrašyti sąskaitas (@_selectedDeliveries.Count(d => string.IsNullOrEmpty(d.InvoiceNumber)))
        </MudButton>
    }

    <!-- Filters -->
    <StandardListFilterBar>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField T="string" Value="@_search" ValueChanged="UpdateSearchAsync"
                    Label="Paieška (numeris, tiekėjas, sąskaita)"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    Clearable="true" Immediate="true" FullWidth="@true" Variant="Variant.Text" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudDateRangePicker DateRange="@_dateRange" DateRangeChanged="UpdateDateRangeAsync"
                    Label="Laikotarpis" Variant="Variant.Text" FullWidth="@true" Clearable="true" />
            </MudItem>
            @if (!string.IsNullOrWhiteSpace(_search) || _dateRange?.Start != null || _dateRange?.End != null || _filterStatus != null)
            {
                <MudItem xs="12">
                    <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                               OnClick="ClearFilters">
                        Išvalyti filtrus
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </StandardListFilterBar>

    <div class="d-flex flex-wrap gap-2 mb-3 align-center">
        @foreach (var status in _statusDisplay)
        {
            var isStatusSelected = _filterStatus == status.Key;
            <MudChip T="string"
                     Color="@status.Value.Color"
                     Variant="@(isStatusSelected ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => ToggleStatusFilter(status.Key))"
                     Size="Size.Small"
                     Style="@(isStatusSelected ? "" : "opacity:0.7")">
               @status.Value.Label
             </MudChip>
        }
    </div>

    <MudTable T="Delivery" Items="FilteredDeliveries" Hover="true" Dense="true" Loading="_loading"
        RowClassFunc="@((delivery, i) => _selectedDeliveries.Contains(delivery) ? "selected-row" : "")"
        OnRowClick="@((TableRowClickEventArgs<Delivery> args) => { if (IsDoubleClick(args.Item)) GoToDelivery(args.Item.Id); })">
        <HeaderContent>
            <MudTh Style="width:40px"></MudTh>
            <MudTh>Data</MudTh>
            <MudTh>Numeris</MudTh>
            <MudTh>Tiekėjas</MudTh>
            <MudTh Style="text-align:right">Netto (kg)</MudTh>
            <MudTh Style="text-align:right">Suma (€)</MudTh>
            <MudTh Style="text-align:right">Sumokėta (€)</MudTh>
            <MudTh Style="text-align:right">Skola (€)</MudTh>
            <MudTh>Būsena</MudTh>
            <MudTh>Sąskaita</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd @onclick:stopPropagation="true" Style="width:40px">
                <input type="checkbox"
                    checked="@_selectedDeliveries.Contains(context)"
                    @onchange="@(_ => ToggleSelection(context))" />
            </MudTd>
            <MudTd>@context.DeliveryDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>@context.DeliveryNumber</MudTd>
            <MudTd>@GetSupplierName(context.SupplierId)</MudTd>
            <MudTd Class="lakstena-mono" Style="text-align:right">@context.TotalNetWeight.ToString("N1")</MudTd>
            <MudTd Class="lakstena-mono" Style="text-align:right">@FormatAmountHelper.Trim(context.TotalAmount, 2)</MudTd>
            <MudTd Class="lakstena-mono" Style="text-align:right">@FormatAmountHelper.Trim(context.PaidAmount, 2)</MudTd>
            <MudTd Class="lakstena-mono" Style="text-align:right">@FormatAmountHelper.Trim(context.TotalAmount - context.PaidAmount, 2)</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@StatusDisplayHelper.GetColor(context.Status, _statusDisplay)">@StatusDisplayHelper.GetLabel(context.Status, _statusDisplay)</MudChip>
            </MudTd>
            <MudTd>
                @if (!string.IsNullOrEmpty(context.InvoiceNumber))
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@context.InvoiceNumber</MudChip>
                }
                else if (!string.IsNullOrEmpty(GetSupplierVatCode(context.SupplierId)) && context.TotalAmount > 0)
                {
                    <MudText Typo="Typo.caption" Style="color:#aaa">galima išrašyti</MudText>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Pristatymų nerasta</MudText>
        </NoRecordsContent>
    </MudTable>
</MudContainer>

@code {
    private List<Delivery> _selectedDeliveries = new();
    private List<Delivery> _deliveries = new();
    private List<NordicBeesERP.Models.BusinessPartner> _suppliers = new();
    private bool _loading = true;

    private string? _filterStatus;
    private string? _search;
    private DateRange? _dateRange;
    private DateTime? _filterFrom;
    private DateTime? _filterTo;

    // URL query-string parameters (synchronized with filter state)
    [SupplyParameterFromQuery(Name = "status")]
    public string? QStatus { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? QFrom { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? QTo { get; set; }

    // Client-side free-text filter over the loaded deliveries (number, supplier name, invoice number)
    private List<Delivery> FilteredDeliveries => string.IsNullOrWhiteSpace(_search)
        ? _deliveries
        : _deliveries.Where(d =>
            (d.DeliveryNumber != null && d.DeliveryNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)) ||
            (GetSupplierName(d.SupplierId) != null && GetSupplierName(d.SupplierId).Contains(_search, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(d.InvoiceNumber) && d.InvoiceNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)))
          .ToList();

    private DateTime _lastClickTime = DateTime.MinValue;
    private object? _lastClickItem;

    private bool IsDoubleClick(object item)
    {
        var now = DateTime.Now;
        if (_lastClickItem == item && (now - _lastClickTime).TotalMilliseconds < 400)
        {
            _lastClickItem = null;
            return true;
        }
        _lastClickItem = item;
        _lastClickTime = now;
        return false;
    }

    protected override async Task OnParametersSetAsync()
    {
        _filterStatus = QStatus;
        _search = Q;
        _dateRange = (QFrom.HasValue || QTo.HasValue) ? new DateRange(QFrom, QTo) : null;
        _filterFrom = QFrom;
        _filterTo = QTo;

        _suppliers = await CustomerService.GetSuppliersAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _deliveries = await DeliveryService.GetFilteredAsync(_filterStatus, null, _filterFrom, _filterTo);
        _loading = false;
    }

    private async Task UpdateSearchAsync(string? value)
    {
        _search = value;
        StateHasChanged();
        PersistUrl();
    }

    private async Task UpdateDateRangeAsync(DateRange? range)
    {
        _dateRange = range;
        _filterFrom = range?.Start;
        _filterTo = range?.End;
        await LoadData();
        PersistUrl();
    }

    private void PersistUrl()
    {
        var newUrl = FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("status", FilterUrlBuilder.ToQueryValue(_filterStatus)),
            ("q", FilterUrlBuilder.ToQueryValue(_search)),
            ("from", FilterUrlBuilder.ToQueryValue(_filterFrom)),
            ("to", FilterUrlBuilder.ToQueryValue(_filterTo)));
        Navigation.NavigateTo(newUrl, replace: true);
    }

    private void ClearFilters()
    {
        _search = null;
        _dateRange = null;
        _filterStatus = null;
        _filterFrom = null;
        _filterTo = null;
        Navigation.NavigateTo(Navigation.Uri.Split('?')[0]);
    }

    private async Task ToggleStatusFilter(string status)
    {
        _filterStatus = _filterStatus == status ? null : status;
        await LoadData();
        PersistUrl();
    }

    private void ToggleSelection(Delivery delivery)
    {
        if (_selectedDeliveries.Contains(delivery))
            _selectedDeliveries.Remove(delivery);
        else
            _selectedDeliveries.Add(delivery);
    }

    private void GoToDelivery(int id)
    {
        var detailUrl = FilterUrlBuilder.BuildDetailUrl($"/warehouse/deliveries/{id}", Navigation.Uri, Navigation.BaseUri);
        Navigation.NavigateTo(detailUrl);
    }

    private string GetSupplierName(int id)
    {
        return _suppliers.FirstOrDefault(s => s.Id == id)?.Name ?? $"#{id}";
    }

    private string? GetSupplierVatCode(int supplierId)
    {
        return _suppliers.FirstOrDefault(s => s.Id == supplierId)?.VatCode;
    }

    private static readonly Dictionary<string, (string Label, Color Color)> _statusDisplay = new()
    {
        { "RECEIVED", ("Priimtas", Color.Default) },
        { "PRICED", ("Įkainotas", Color.Info) },
        { "PARTIAL_PAID", ("Dalinai", Color.Warning) },
        { "PAID", ("Apmokėtas", Color.Success) }
    };

    private async Task CreateInvoicesForSelected()
    {
        var eligible = _selectedDeliveries
            .Where(d => string.IsNullOrEmpty(d.InvoiceNumber)
                     && !string.IsNullOrEmpty(GetSupplierVatCode(d.SupplierId))
                     && d.TotalAmount > 0)
            .ToList();

        if (!eligible.Any())
        {
            Snackbar.Add("Nėra tinkamų pristatymų sąskaitoms išrašyti", Severity.Warning);
            return;
        }

        foreach (var delivery in eligible)
        {
            var vatAmount = Math.Round(delivery.TotalAmount * 0.06m, 2);
            var total = Math.Round(delivery.TotalAmount * 1.06m, 2);
            var pricePerKg = delivery.TotalNetWeight > 0
                ? delivery.TotalAmount / delivery.TotalNetWeight
                : 0;

            var invoice = new Invoice
            {
                InvoiceNumber = await InvoiceService.GenerateNextInvoiceNumberAsync(DateTime.Today, "6% PVM SĄSKAITA FAKTŪRA"),
                InvoiceDate = DateTime.Today,
                CustomerId = delivery.SupplierId,
                PaymentDueDate = DateTime.Today.AddDays(10),
                PaymentTermDays = 10,
                Language = "LT",
                InvoiceType = "6% PVM SĄSKAITA FAKTŪRA",
                Status = InvoiceStatus.Confirmed,
                SubtotalExclVat = delivery.TotalAmount,
                TotalVat = vatAmount,
                TotalInclVat = total,
                DeliveryId = delivery.Id,
                Lines = new List<InvoiceLine>
                {
                    new InvoiceLine
                    {
                        LineNumber = 1,
                        Description = "Medus",
                        Unit = "kg",
                        Quantity = delivery.TotalNetWeight,
                        PriceExclVat = pricePerKg,
                        VatRate = 6,
                        LineSubtotal = delivery.TotalAmount,
                        VatAmount = vatAmount,
                        LineTotal = total
                    }
                }
            };

            await InvoiceService.CreateInvoiceAsync(invoice);
        }

        Snackbar.Add($"{eligible.Count} sąskaita(-os) išrašyta(-os)!", Severity.Success);
        _selectedDeliveries.Clear();
        await LoadData();
    }
}

<style>
    .selected-row { background-color: #e3f2fd !important; }
</style>
