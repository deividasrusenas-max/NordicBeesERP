@page "/warehouse/delivery-pricing"
@rendermode InteractiveServer
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Components.Dialogs
@using NordicBeesERP.Helpers
@inject IDeliveryService DeliveryService
@inject ISupplierPaymentService PaymentService
@inject ICustomerService CustomerService
@inject IHoneyTypeService HoneyTypeService
@inject IProductService ProductService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IDbContextFactory<NordicBeesERP.Data.NordicBeesERPContext> ContextFactory
@inject NavigationManager Navigation

<PageTitle>Pristatymų kainos ir mokėjimai</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Pristatymų kainos ir mokėjimai</MudText>

    <MudPaper Class="pa-3 mb-4" Elevation="2">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudTextField T="string" Label="Paieška (nr. / tiekėjas)" @bind-Value="_searchText"
                    Immediate="true" OnValueChange="UpdateFilterSearchAsync" Clearable="true" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDateRangePicker T="DateTime?" Label="Pristatymo data" @bind-DateRange="_dateRange"
                    OnRangeSelected="UpdateDateRangeAsync" />
            </MudItem>
            @if (!string.IsNullOrWhiteSpace(_searchText) || _dateRange?.Start != null || _selectedStatuses.Any())
            {
                <MudItem xs="12" Class="d-flex align-center">
                    <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                        Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                        OnClick="ClearFiltersAsync">
                        Išvalyti filtrus
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <div class="d-flex flex-wrap gap-2 mb-3 align-center">
        <MudText Typo="Typo.body2" Style="color:#6b7280;margin-right:4px;">Statusas:</MudText>
        @if (_selectedStatuses.Any())
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                StartIcon="@Icons.Material.Filled.FilterAltOff"
                OnClick="ClearFiltersAsync">
                Rodyti visas
            </MudButton>
        }
        @foreach (var status in _availableStatuses)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                Color="@(_statusChipColor[status])"
                OnClick="@(() => ToggleStatusAsync(status))"
                Checked="@_selectedStatuses.Contains(status)">@status</MudChip>
        }
    </div>

    <MudTabs ActivePanelIndex="_selectedTab"
             ActivePanelIndexChanged="@(async (int index) => await OnTabChangedAsync(index))"
             Elevation="0" Rounded="true" Square="false" Class="mt-2">
        <MudTabPanel Text="Visos" />
        <MudTabPanel Text="Neapmokėtos" />
        <MudTabPanel Text="Dalinai apmokėtos" />
        <MudTabPanel Text="Apmokėtos" />
        <MudTabPanel Text="Šis mėnuo" />
    </MudTabs>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudTable T="Delivery" Items="FilteredDeliveries" Dense="true" Hover="true" Striped="true"
            OnRowClick="@((TableRowClickEventArgs<Delivery> args) => { if (IsDoubleClick(args.Item)) OpenPricingDetail(args.Item.Id); })"
            Style="cursor:pointer">
            <HeaderContent>
                <MudTh>Nr.</MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Tiekėjas</MudTh>
                <MudTh Style="text-align:right">Netto (kg)</MudTh>
                <MudTh>Statusas</MudTh>
                <MudTh Style="text-align:right">Suma €</MudTh>
                <MudTh Style="text-align:right">Sumokėta €</MudTh>
                <MudTh Style="text-align:right">Skola €</MudTh>
            </HeaderContent>
            <RowTemplate Context="d">
                <MudTd>@d.DeliveryNumber</MudTd>
                <MudTd>@d.DeliveryDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@GetSupplierName(d.SupplierId)</MudTd>
                <MudTd Style="text-align:right">@d.TotalNetWeight.ToString("N1")</MudTd>
                <MudTd>
                    @{
                        var badge = GetStatusBadge(d);
                    }
                    <MudChip T="string" Size="Size.Small" Color="@badge.Color">@badge.Label</MudChip>
                </MudTd>
                <MudTd Style="text-align:right">@d.TotalAmount.ToString("N2")</MudTd>
                <MudTd Style="text-align:right">@d.PaidAmount.ToString("N2")</MudTd>
                <MudTd @attributes='new Dictionary<string, object> { 
                    { "style", $"text-align:right; {GetDebtStyle(d.TotalAmount - d.PaidAmount)}" } 
                }'>
                    @((d.TotalAmount - d.PaidAmount).ToString("N2"))
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private List<Delivery> _deliveries = new();
    private List<BusinessPartner> _suppliers = new();
    private bool _loading = true;
    private DateTime _lastClickTime = DateTime.MinValue;
    private object? _lastClickItem;

    [SupplyParameterFromQuery]
    private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "from")]
    private string? DateFrom { get; set; }
    [SupplyParameterFromQuery(Name = "to")]
    private string? DateTo { get; set; }
    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusCsv { get; set; }
    [SupplyParameterFromQuery(Name = "tab")]
    private int? Tab { get; set; }

    private int _selectedTab = 0;
    private string _searchText = string.Empty;
    private DateRange? _dateRange;
    private HashSet<string> _selectedStatuses = new();
    private readonly List<string> _availableStatuses = new() { "Priimtas", "Neapmokėtas", "Apmokėtas", "Dalinai" };
    private readonly Dictionary<string, Color> _statusChipColor = new()
    {
        { "Priimtas", Color.Default },
        { "Neapmokėtas", Color.Error },
        { "Apmokėtas", Color.Success },
        { "Dalinai", Color.Warning }
    };

    private bool IsDoubleClick(object item)
    {
        var now = DateTime.Now;
        if (_lastClickItem == item && (now - _lastClickTime).TotalMilliseconds < 400)
        {
            _lastClickItem = null;
            return true;
        }
        _lastClickItem = item;
        _lastClickTime = now;
        return false;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
        _searchText = Q ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(DateFrom) && DateTime.TryParse(DateFrom, out var from))
            _dateRange = new DateRange(from, _dateRange?.End);
        if (!string.IsNullOrWhiteSpace(DateTo) && DateTime.TryParse(DateTo, out var to))
            _dateRange = new DateRange(_dateRange?.Start, to);
        _selectedStatuses = FilterUrlBuilder.ParseStatusCsv(StatusCsv);
        _selectedTab = Tab ?? 0;
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _suppliers = await CustomerService.GetSuppliersAsync();
            _deliveries = await DeliveryService.GetAllAsync();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OpenPricingDetail(int deliveryId)
    {
        // Kol kas navigacija į esamą delivery view — vėliau bus atskiras pricing dialog
        Navigation.NavigateTo($"/warehouse/deliveries/{deliveryId}/pricing");
    }

    private string GetSupplierName(int id) => _suppliers.FirstOrDefault(s => s.Id == id)?.Name ?? $"#{id}";

    private (string Label, Color Color) GetStatusBadge(Delivery d) => (d.TotalAmount, d.PaidAmount) switch {
        _ when d.TotalAmount <= 0 => ("Priimtas", Color.Default),
        _ when d.PaidAmount <= 0 => ("Neapmokėtas", Color.Error),
        _ when d.PaidAmount >= d.TotalAmount => ("Apmokėtas", Color.Success),
        _ => ("Dalinai", Color.Warning)
    };

    private string GetDebtStyle(decimal debt) => debt > 0 ? "color:red;font-weight:bold" : "";

    private IEnumerable<Delivery> GetFilteredDeliveries()
    {
        if (_deliveries == null) return Enumerable.Empty<Delivery>();
        var q = _searchText?.Trim().ToLowerInvariant() ?? string.Empty;
        return _deliveries.Where(d =>
        {
            if (!string.IsNullOrWhiteSpace(q) &&
                !d.DeliveryNumber.ToLowerInvariant().Contains(q) &&
                !GetSupplierName(d.SupplierId).ToLowerInvariant().Contains(q))
                return false;
            if (_dateRange?.Start != null && d.DeliveryDate.Date < _dateRange.Start.Value.Date) return false;
            if (_dateRange?.End != null && d.DeliveryDate.Date > _dateRange.End.Value.Date) return false;
            if (_selectedStatuses.Count > 0 && !_selectedStatuses.Contains(GetStatusBadge(d).Label)) return false;
            switch (_selectedTab)
            {
                case 1: // Neapmokėtos
                    if (!(d.TotalAmount > 0 && d.PaidAmount <= 0)) return false;
                    break;
                case 2: // Dalinai apmokėtos
                    if (!(d.PaidAmount > 0 && d.PaidAmount < d.TotalAmount)) return false;
                    break;
                case 3: // Apmokėtos
                    if (d.PaidAmount <= 0 || d.PaidAmount < d.TotalAmount) return false;
                    break;
                case 4: // Šis mėnuo
                    if (d.DeliveryDate.Date < new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)) return false;
                    break;
            }
            return true;
        });
    }

    private IEnumerable<Delivery> FilteredDeliveries => GetFilteredDeliveries();

    private Task UpdateFilterSearchAsync(string value)
    {
        _searchText = value ?? string.Empty;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", string.IsNullOrWhiteSpace(_searchText) ? null : _searchText),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("status", _selectedStatuses.Count == 0 ? null : string.Join(",", _selectedStatuses)),
            ("tab", _selectedTab != 0 ? _selectedTab.ToString() : null)));
        return Task.CompletedTask;
    }

    private Task UpdateDateRangeAsync(DateRange? range)
    {
        _dateRange = range;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", string.IsNullOrWhiteSpace(_searchText) ? null : _searchText),
            ("from", FilterUrlBuilder.ToQueryValue(range?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(range?.End)),
            ("status", _selectedStatuses.Count == 0 ? null : string.Join(",", _selectedStatuses)),
            ("tab", _selectedTab != 0 ? _selectedTab.ToString() : null)));
        return Task.CompletedTask;
    }

    private Task ToggleStatusAsync(string status)
    {
        if (_selectedStatuses.Contains(status)) _selectedStatuses.Remove(status);
        else _selectedStatuses.Add(status);
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", string.IsNullOrWhiteSpace(_searchText) ? null : _searchText),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("status", _selectedStatuses.Count == 0 ? null : string.Join(",", _selectedStatuses)),
            ("tab", _selectedTab != 0 ? _selectedTab.ToString() : null)));
        return Task.CompletedTask;
    }

    private Task OnTabChangedAsync(int index)
    {
        _selectedTab = index;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", string.IsNullOrWhiteSpace(_searchText) ? null : _searchText),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
            ("status", _selectedStatuses.Count == 0 ? null : string.Join(",", _selectedStatuses)),
            ("tab", index != 0 ? index.ToString() : null)));
        return Task.CompletedTask;
    }

    private Task ClearFiltersAsync()
    {
        _selectedTab = 0;
        _searchText = string.Empty;
        _dateRange = null;
        _selectedStatuses.Clear();
        Navigation.NavigateTo(Navigation.Uri.Split('?')[0]);
        return Task.CompletedTask;
    }
}
