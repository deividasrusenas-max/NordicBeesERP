@page "/warehouse/delivery-pricing"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer
@using NordicBeesERP.Models
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Components.Dialogs
@using NordicBeesERP.Helpers
@inject IDeliveryService DeliveryService
@inject ISupplierPaymentService PaymentService
@inject ICustomerService CustomerService
@inject IHoneyTypeService HoneyTypeService
@inject IProductService ProductService
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IDbContextFactory<NordicBeesERP.Data.NordicBeesERPContext> ContextFactory
@inject NavigationManager Navigation

<PageTitle>Pristatymų kainos ir mokėjimai</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-3">Pristatymų kainos ir mokėjimai</MudText>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <ListFilterCard Search="@_searchText"
                    SearchChanged="UpdateFilterSearchAsync"
                    SearchLabel="Paieška (nr., tiekėjas, sąskaita)"
                    DateRange="@_dateRange"
                    DateRangeChanged="UpdateDateRangeAsync"
                    ShowClear="@(!string.IsNullOrWhiteSpace(_searchText) || _dateRange?.Start != null || _dateRange?.End != null || _selectedTab != 0)"
                    OnClear="ClearFiltersAsync" />

    <div class="d-flex flex-wrap gap-2 mb-3 align-center">
        @foreach (var chip in _quickChips)
        {
            <FilterChip Selected="@(_selectedTab == chip.Tab)" ActiveColor="@chip.Color" OnClick="@(() => OnTabChangedAsync(chip.Tab))">@chip.Label</FilterChip>
        }
    </div>

    @if (!_loading)
    {
    <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
        <MudTable T="Delivery" Items="PagedItems" Dense="true" Hover="true" Striped="true" Elevation="0"
                  RowsPerPage="@PageSize" RowStyleFunc="@GetRowStyle" Style="cursor:default">
            <HeaderContent>
                <MudTh>Nr.</MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Tiekėjas</MudTh>
                <MudTh Style="text-align:right">Netto (kg)</MudTh>
                <MudTh>Statusas</MudTh>
                <MudTh>Sąskaita</MudTh>
                <MudTh Style="text-align:right">Suma €</MudTh>
                <MudTh Style="text-align:right">Sumokėta €</MudTh>
                <MudTh Style="text-align:right">Skola €</MudTh>
            </HeaderContent>
            <RowTemplate Context="d">
                <MudTd @ondblclick="@(() => OpenPricingDetail(d.Id))" Style="cursor:pointer">@d.DeliveryNumber</MudTd>
                <MudTd @ondblclick="@(() => OpenPricingDetail(d.Id))" Style="cursor:pointer">@d.DeliveryDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd @ondblclick="@(() => OpenPricingDetail(d.Id))" Style="cursor:pointer">@GetSupplierName(d.SupplierId)</MudTd>
                <MudTd @ondblclick="@(() => OpenPricingDetail(d.Id))" Class="lakstena-mono" Style="cursor:pointer;text-align:right">@d.TotalNetWeight.ToString("N1")</MudTd>
                <MudTd @ondblclick="@(() => OpenPricingDetail(d.Id))" Style="cursor:pointer">
                    @{
                        var statusKey = DeliveryStatusHelper.KeyFor(d);
                    }
                    <MudChip T="string" Size="Size.Small" Style="text-transform:none" Color="@DeliveryStatusHelper.ColorForKey(statusKey)">@DeliveryStatusHelper.LabelForKey(statusKey)</MudChip>
                </MudTd>
                <MudTd>
                    @if (d.InvoiceId != null)
                    {
                        var invStatus = GetInvoiceStatus(d.InvoiceId.Value);
                        <div class="d-flex align-center gap-1">
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Receipt" Style="text-transform:none"
                                Href="@($"/invoices/{d.InvoiceId}")">@d.InvoiceNumber</MudButton>
                            @if (invStatus == InvoiceStatus.Draft)
                            {
                                <MudChip T="string" Size="Size.Small" Style="text-transform:none" Color="Color.Warning">Neatspausdinta</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Style="text-transform:none" Color="Color.Success">Atspausdinta</MudChip>
                            }
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Style="color:#aaa">—</MudText>
                    }
                </MudTd>
                <MudTd @ondblclick="@(() => OpenPricingDetail(d.Id))" Class="lakstena-mono" Style="cursor:pointer;text-align:right">
                    @FormatAmountHelper.Money(d.DebtBase)
                    @if (d.DebtInvoiceTotal.HasValue)
                    {
                        <MudText Typo="Typo.caption" Style="color:#6b7280;display:block" title="Suma su 6 % PVM">su 6 % PVM</MudText>
                    }
                </MudTd>
                <MudTd @ondblclick="@(() => OpenPricingDetail(d.Id))" Class="lakstena-mono" Style="cursor:pointer;text-align:right">@FormatAmountHelper.Money(d.PaidAmount)</MudTd>
                <MudTd @ondblclick="@(() => OpenPricingDetail(d.Id))" Class="lakstena-mono" Style="@($"cursor:pointer;text-align:right;{GetDebtStyle(d.DebtBase - d.PaidAmount)}")">
                    @FormatAmountHelper.Money(d.DebtBase - d.PaidAmount)
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <ListPager Page="EffectivePage" PageSize="PageSize" TotalCount="_filtered.Count" PageChanged="NavigateToPage" />
            </PagerContent>
            <NoRecordsContent>
                <MudText Class="text-center py-4">Pristatymų nerasta</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
    }
</MudContainer>

@code {
    private const int PageSize = 50;

    private List<Delivery> _deliveries = new();
    private List<Delivery> _filtered = new();
    private List<BusinessPartner> _suppliers = new();
    private Dictionary<int, string> _supplierNames = new();
    private bool _loading = true;

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "from")]
    private DateTime? DateFrom { get; set; }
    [SupplyParameterFromQuery(Name = "to")]
    private DateTime? DateTo { get; set; }
    [SupplyParameterFromQuery(Name = "tab")]
    private int? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "page")]
    private int? QPage { get; set; }

    private int _selectedTab = 0;
    private int _page = 1;
    private string _searchText = string.Empty;
    private DateRange? _dateRange;

    // Tab 0 = all. One chip row only (the status chips and the tabs used to filter together).
    private static readonly (int Tab, string Label, Color Color)[] _quickChips =
    {
        (0, "Visos", Color.Primary),
        (1, "Neįkainoti", Color.Warning),
        (2, "Neapmokėti", Color.Error),
        (3, "Dalinai", Color.Warning),
        (4, "Vėluojantys", Color.Error),
        (5, "Šis mėnuo", Color.Primary),
    };

    private int EffectivePage => Math.Clamp(_page, 1, Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize)));
    private List<Delivery> PagedItems => _filtered.Skip((EffectivePage - 1) * PageSize).Take(PageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    // Only query parameters change on filtering/paging: sync state and re-filter the loaded list, no DB reload.
    protected override void OnParametersSet()
    {
        _searchText = Q ?? string.Empty;
        _dateRange = (DateFrom.HasValue || DateTo.HasValue) ? new DateRange(DateFrom, DateTo) : null;
        _selectedTab = Tab is >= 0 and <= 5 ? Tab.Value : 0;
        _page = QPage is > 0 ? QPage.Value : 1;
        _filtered = GetFilteredDeliveries();
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _suppliers = await CustomerService.GetSuppliersAsync();
            _supplierNames = _suppliers.ToDictionary(x => x.Id, x => x.Name ?? "");
            _deliveries = await DeliveryService.GetAllAsync();

            var invoiceIds = _deliveries.Where(d => d.InvoiceId != null).Select(d => d.InvoiceId!.Value).Distinct().ToList();
            _invoiceStatusById.Clear();
            _invoiceDueById.Clear();
            if (invoiceIds.Any())
            {
                var allInvoices = await InvoiceService.GetInvoicesAsync(take: 5000);
                foreach (var inv in allInvoices.Where(i => invoiceIds.Contains(i.Id)))
                {
                    _invoiceStatusById[inv.Id] = inv.Status;
                    _invoiceDueById[inv.Id] = inv.PaymentDueDate;
                }
            }
            _filtered = GetFilteredDeliveries();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Dictionary<int, InvoiceStatus> _invoiceStatusById = new();
    private Dictionary<int, DateTime?> _invoiceDueById = new();
    private InvoiceStatus GetInvoiceStatus(int invoiceId) => _invoiceStatusById.TryGetValue(invoiceId, out var s) ? s : InvoiceStatus.Draft;

    // Payment due date of the linked purchase invoice; deliveries without an invoice have none.
    private DateTime? GetDueDate(Delivery d) =>
        d.InvoiceId.HasValue && _invoiceDueById.TryGetValue(d.InvoiceId.Value, out var due) ? due : null;

    private string BuildListUrl(int page) => FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
        ("q", string.IsNullOrWhiteSpace(_searchText) ? null : _searchText),
        ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
        ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End)),
        ("tab", _selectedTab != 0 ? _selectedTab.ToString() : null),
        ("page", page > 1 ? page.ToString() : null));

    private void OpenPricingDetail(int deliveryId)
    {
        Navigation.NavigateTo(FilterUrlBuilder.BuildDetailUrl(
            $"/warehouse/deliveries/{deliveryId}/pricing", BuildListUrl(EffectivePage), Navigation.BaseUri));
    }

    private string GetSupplierName(int id) => _supplierNames.TryGetValue(id, out var name) ? name : $"#{id}";

    private string GetDebtStyle(decimal debt) => debt > 0 ? "color:red;font-weight:bold" : "";

    private string GetRowStyle(Delivery d, int index)
    {
        var debt = d.DebtBase - d.PaidAmount;
        return ListRowStyle.ForDue(debt <= 0, GetDueDate(d)?.Date, debt > 0, AppClock.TodayLt);
    }

    private List<Delivery> GetFilteredDeliveries()
    {
        var q = _searchText?.Trim() ?? string.Empty;
        var today = AppClock.TodayLt;
        IEnumerable<Delivery> result = _deliveries;

        if (q.Length > 0)
        {
            result = result.Where(d =>
                (d.DeliveryNumber != null && d.DeliveryNumber.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                GetSupplierName(d.SupplierId).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrEmpty(d.InvoiceNumber) && d.InvoiceNumber.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
        if (_dateRange?.Start != null)
            result = result.Where(d => d.DeliveryDate.Date >= _dateRange.Start.Value.Date);
        if (_dateRange?.End != null)
            result = result.Where(d => d.DeliveryDate.Date <= _dateRange.End.Value.Date);

        switch (_selectedTab)
        {
            case 1: // Neįkainoti
                result = result.Where(d => d.DebtBase <= 0);
                break;
            case 2: // Neapmokėti
                result = result.Where(d => d.DebtBase > 0 && d.PaidAmount <= 0);
                break;
            case 3: // Dalinai
                result = result.Where(d => d.PaidAmount > 0 && d.PaidAmount < d.DebtBase);
                break;
            case 4: // Vėluojantys: open debt past the linked invoice's payment due date
                result = result.Where(d => d.DebtBase - d.PaidAmount > 0 && GetDueDate(d) is DateTime due && due.Date < today);
                break;
            case 5: // Šis mėnuo
                var startOfMonth = new DateTime(today.Year, today.Month, 1);
                result = result.Where(d => d.DeliveryDate.Date >= startOfMonth);
                break;
        }
        return result.ToList();
    }

    private Task UpdateFilterSearchAsync(string? value)
    {
        _searchText = value ?? string.Empty;
        _page = 1;
        Navigation.NavigateTo(BuildListUrl(1), replace: true);
        return Task.CompletedTask;
    }

    private Task UpdateDateRangeAsync(DateRange? range)
    {
        _dateRange = range;
        _page = 1;
        Navigation.NavigateTo(BuildListUrl(1));
        return Task.CompletedTask;
    }

    private Task OnTabChangedAsync(int index)
    {
        if (_selectedTab == index) return Task.CompletedTask;
        _selectedTab = index;
        _page = 1;
        Navigation.NavigateTo(BuildListUrl(1));
        return Task.CompletedTask;
    }

    private Task NavigateToPage(int page)
    {
        _page = page;
        Navigation.NavigateTo(BuildListUrl(page), replace: true);
        return Task.CompletedTask;
    }

    private Task ClearFiltersAsync()
    {
        Navigation.NavigateTo(Navigation.Uri.Split('?')[0]);
        return Task.CompletedTask;
    }
}
