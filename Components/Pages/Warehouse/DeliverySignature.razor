@page "/warehouse/deliveries/{Id:int}/sign"
@rendermode InteractiveServer
@using NordicBeesERP.Models.WarehouseModule
@inject IDeliveryService DeliveryService
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IDbContextFactory<NordicBeesERP.Data.NordicBeesERPContext> ContextFactory
@inject IHoneyTypeService HoneyTypeService

<PageTitle>Pasirašyti pristatymą</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-2">
    @if (_delivery == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_delivery.SupplierSignedAt.HasValue)
    {
        <MudText Typo="Typo.h5" Class="mb-4">Pasirašyti pristatymą</MudText>
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-4">
            Jau pasirašyta @_delivery.SupplierSignedAt.Value.ToString("yyyy-MM-dd HH:mm")
        </MudAlert>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/warehouse/deliveries">Atgal</MudButton>
    }
    else
    {
        <MudText Typo="Typo.h5" Class="mb-4">Pasirašyti pristatymą</MudText>

        @if (_missingFields.Any())
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Filled.Warning">
                <MudText Typo="Typo.body1"><b>Tiekėjo kortelėje trūksta duomenų:</b></MudText>
                @foreach (var field in _missingFields)
                {
                    <MudText Typo="Typo.body2">• @field</MudText>
                }
                <MudText Typo="Typo.body2" Class="mt-2">
                    <MudLink Href="@($"/suppliers/{_delivery?.SupplierId}/edit")" Target="_blank">Atidaryti tiekėjo kortelę →</MudLink>
                </MudText>
            </MudAlert>
        }

        <!-- Delivery info -->
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Pristatymo informacija</MudText>
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption">Numeris</MudText>
                    <MudText Typo="Typo.body1">@_delivery.DeliveryNumber</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption">Data</MudText>
                    <MudText Typo="Typo.body1">@_delivery.DeliveryDate.ToString("yyyy-MM-dd")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption">Tiekėjas</MudText>
                    <MudText Typo="Typo.body1">@_supplierName</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption">Bendras netto</MudText>
                    <MudText Typo="Typo.body1">@_delivery.TotalNetWeight.ToString("N1") kg</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Containers -->
        @if (_containers.Any())
        {
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Pakuotės</MudText>
                <MudTable T="NordicBeesERP.Models.WarehouseModule.Container" Items="_containers" Dense="true" Hover="false" Elevation="0">
                    <HeaderContent>
                        <MudTh>Tipas</MudTh>
                        <MudTh Style="text-align:right">Brutto (kg)</MudTh>
                        <MudTh Style="text-align:right">Tara (kg)</MudTh>
                        <MudTh Style="text-align:right">Netto (kg)</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="container">
                        <MudTd>
                            @{
                                var line = _lines.FirstOrDefault(l => l.Id == container.DeliveryLineId);
                                var honeyTypeName = line?.HoneyTypeId != null
                                    ? (_honeyTypes.FirstOrDefault(h => h.Id == line.HoneyTypeId)?.Name ?? $"#{line.HoneyTypeId}")
                                    : "-";
                                var typeName = container.ContainerType switch { "BARREL" => "Statinė", "BUCKET" => "Kibiras", _ => container.ContainerType ?? "-" };
                            }
                            @(honeyTypeName != "-" ? $"{honeyTypeName} ({typeName})" : typeName)
                        </MudTd>
                        <MudTd Style="text-align:right">@container.GrossWeight.ToString("N1")</MudTd>
                        <MudTd Style="text-align:right">@container.TareWeight.ToString("N1")</MudTd>
                        <MudTd Style="text-align:right"><b>@container.NetWeight.ToString("N1")</b></MudTd>
                    </RowTemplate>
                    <FooterContent>
                    </FooterContent>
                </MudTable>
                <div style="border-top:2px solid #e0e0e0; margin-top:4px; padding:8px 4px; display:flex; justify-content:flex-end; gap:32px">
                    <span style="flex:1"><b>Iš viso (@_containers.Count vnt.)</b></span>
                    <span style="min-width:80px; text-align:right"><b>@_containers.Sum(c => c.GrossWeight).ToString("N1")</b></span>
                    <span style="min-width:80px; text-align:right"><b>@_containers.Sum(c => c.TareWeight).ToString("N1")</b></span>
                    <span style="min-width:80px; text-align:right"><b>@_containers.Sum(c => c.NetWeight).ToString("N1")</b></span>
                </div>
            </MudPaper>
        }

        <!-- Terms -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="background:#f0f4ff; border-left:4px solid #1976d2">
            <MudText Typo="Typo.body1">Patvirtinu, kad pristačiau aukščiau nurodytus produktus pagal sutartas sąlygas. Duomenys teisingi.</MudText>
        </MudPaper>

        <!-- Signer name -->
        @if (!_isCompany)
        {
            <MudTextField @bind-Value="_signerName" Label="Pristatė (vardas, pavardė)" Variant="Variant.Outlined"
                FullWidth="true" Class="mb-4" Required="true" Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Person" Style="font-size:18px" />
        }
        else
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Pristatė: <b>@_supplierName</b>
            </MudAlert>
        }

        <!-- Signature canvas -->
        <MudPaper Class="pa-4 mb-4" Elevation="1" Style="background:white; border-radius:8px">
            <MudText Typo="Typo.subtitle2" Class="mb-3">Parašas (pieškite pirštu)</MudText>
            <canvas id="signatureCanvas" width="800" height="300"
                style="border:2px solid #1976d2; border-radius:8px; touch-action:none; cursor:crosshair; background:white; display:block; width:100%; height:300px"></canvas>
        </MudPaper>

        <!-- Buttons -->
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mb-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large"
                StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearCanvasAsync"
                Style="min-width:140px; height:56px; font-size:16px">
                Išvalyti
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                StartIcon="@Icons.Material.Filled.Draw" OnClick="SaveSignatureAsync" Disabled="@_saving"
                Style="min-width:240px; height:56px; font-size:16px">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Color="Color.Inherit" />
                }
                Patvirtinti ir pasirašyti
            </MudButton>
        </MudStack>
    }
</MudContainer>

<script>
window.initSignatureCanvas = function(canvasId) {
        setTimeout(function() {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;

            const rect = canvas.getBoundingClientRect();
            if (rect.width > 0) {
                canvas.width = Math.round(rect.width);
                canvas.height = Math.round(rect.height);
            }

            const ctx = canvas.getContext('2d');
            ctx.strokeStyle = '#000';
            ctx.lineWidth = 2;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';

            let isDrawing = false;
            let lastX = 0;
            let lastY = 0;

            const getPos = (e) => {
                const rect = canvas.getBoundingClientRect();
                if (e.touches && e.touches.length > 0) {
                    return {
                        x: e.touches[0].clientX - rect.left,
                        y: e.touches[0].clientY - rect.top
                    };
                }
                return {
                    x: e.clientX - rect.left,
                    y: e.clientY - rect.top
                };
            };

            canvas.addEventListener('mousedown', (e) => { e.preventDefault(); isDrawing = true; const p = getPos(e); lastX = p.x; lastY = p.y; });
            canvas.addEventListener('mousemove', (e) => { if (!isDrawing) return; e.preventDefault(); const p = getPos(e); ctx.beginPath(); ctx.moveTo(lastX, lastY); ctx.lineTo(p.x, p.y); ctx.stroke(); lastX = p.x; lastY = p.y; });
            canvas.addEventListener('mouseup', () => { isDrawing = false; });
            canvas.addEventListener('mouseleave', () => { isDrawing = false; });
            canvas.addEventListener('touchstart', (e) => { e.preventDefault(); isDrawing = true; const p = getPos(e); lastX = p.x; lastY = p.y; }, { passive: false });
            canvas.addEventListener('touchmove', (e) => { if (!isDrawing) return; e.preventDefault(); const p = getPos(e); ctx.beginPath(); ctx.moveTo(lastX, lastY); ctx.lineTo(p.x, p.y); ctx.stroke(); lastX = p.x; lastY = p.y; }, { passive: false });
            canvas.addEventListener('touchend', () => { isDrawing = false; }, { passive: false });

            window._signatureCanvases = window._signatureCanvases || {};
            window._signatureCanvases[canvasId] = { canvas, ctx };
        }, 300);
    };

    window.clearSignatureCanvas = function(canvasId) {
        const entry = (window._signatureCanvases || {})[canvasId];
        if (!entry) return;
        entry.ctx.clearRect(0, 0, entry.canvas.width, entry.canvas.height);
    };

    window.getCanvasSvg = function(canvasId) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return '';
        const dataUrl = canvas.toDataURL('image/png');
        return `<svg xmlns="http://www.w3.org/2000/svg" width="500" height="200"><image width="500" height="200" href="${dataUrl}"/></svg>`;
    };
</script>

@code {
    [Parameter] public int Id { get; set; }

    private Delivery? _delivery;
    private BusinessPartner? _supplier;
    private bool _isCompany => !string.IsNullOrWhiteSpace(_supplier?.CompanyCode);
    private string _supplierName = "";
    private string _signerName = "";
    private bool _saving = false;
    private List<NordicBeesERP.Models.WarehouseModule.Container> _containers = new();
    private List<NordicBeesERP.Models.WarehouseModule.DeliveryLine> _lines = new();
    private List<NordicBeesERP.Models.Product> _products = new();
    private List<NordicBeesERP.Models.HoneyType> _honeyTypes = new();
    private List<string> _missingFields = new();

    protected override async Task OnInitializedAsync()
    {
        _delivery = await DeliveryService.GetByIdAsync(Id);
        if (_delivery != null)
        {
            var suppliers = await CustomerService.GetSuppliersAsync();
            _supplier = suppliers.FirstOrDefault(s => s.Id == _delivery.SupplierId);
            _supplierName = _supplier?.Name ?? "";

            // Pre-fill signer name for individuals
            if (_supplier != null && string.IsNullOrWhiteSpace(_supplier.CompanyCode))
            {
                var firstName = _supplier.SupplierFirstName ?? "";
                var lastName = _supplier.SupplierLastName ?? "";
                var fullName = $"{firstName} {lastName}".Trim();
                // Fallback to partner Name if first/last not set
                _signerName = !string.IsNullOrWhiteSpace(fullName) ? fullName : (_supplier.Name ?? "");
            }

            _missingFields = new List<string>();
            if (_supplier != null)
            {
                if (string.IsNullOrWhiteSpace(_supplier.Address))
                    _missingFields.Add("Adresas");
                if (string.IsNullOrWhiteSpace(_supplier.CompanyCode) && string.IsNullOrWhiteSpace(_supplier.NationalIdNumber))
                    _missingFields.Add("Asmens kodas arba įmonės kodas");
                if (string.IsNullOrWhiteSpace(_supplier.BankAccount))
                    _missingFields.Add("Banko sąskaita (IBAN)");
            }

            _products = await ProductService.GetAllProductsAsync();
            _honeyTypes = await HoneyTypeService.GetActiveAsync();
            _lines = await DeliveryService.GetLinesByDeliveryIdAsync(_delivery.Id);

            using var ctx = await ContextFactory.CreateDbContextAsync();
            var lineIds = await ctx.DeliveryLines
                .Where(l => l.DeliveryId == _delivery.Id)
                .Select(l => (int?)l.Id)
                .ToListAsync();
            _containers = await ctx.Containers
                .Where(c => lineIds.Contains(c.DeliveryLineId))
                .OrderBy(c => c.Id)
                .ToListAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initSignatureCanvas", "signatureCanvas");
        }
    }

    private async Task ClearCanvasAsync()
    {
        await JS.InvokeVoidAsync("clearSignatureCanvas", "signatureCanvas");
    }

    private async Task SaveSignatureAsync()
    {
        if (string.IsNullOrWhiteSpace(_signerName))
        {
            Snackbar.Add("Įveskite savo vardą ir pavardę", Severity.Warning);
            return;
        }

        if (_missingFields.Any())
        {
            Snackbar.Add("Pirmiausia užpildykite trūkstamus tiekėjo duomenis", Severity.Error);
            return;
        }

        if (_delivery == null) return;

        _saving = true;
        StateHasChanged();

        try
        {
            if (_isCompany && string.IsNullOrWhiteSpace(_signerName))
                _signerName = _supplierName;

            var svg = await JS.InvokeAsync<string>("getCanvasSvg", "signatureCanvas");

            if (string.IsNullOrWhiteSpace(svg))
            {
                Snackbar.Add("Nupieškite parašą prieš patvirtinant", Severity.Warning);
                _saving = false;
                StateHasChanged();
                return;
            }

            await DeliveryService.SaveSignatureAsync(Id, _signerName, svg);
            Snackbar.Add("Parašas išsaugotas sėkmingai", Severity.Success);
            Navigation.NavigateTo($"/warehouse/deliveries/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida išsaugant parašą: {ex.Message}", Severity.Error);
            _saving = false;
            StateHasChanged();
        }
    }
}
