@page "/warehouse/deliveries/{Id:int}"
@rendermode InteractiveServer
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Models.Printing
@using NordicBeesERP.Components.Dialogs
@inject IDeliveryService DeliveryService
@inject ICustomerService CustomerService
@inject IHoneyTypeService HoneyTypeService
@inject IProductService ProductService
@inject IWarehouseService WarehouseService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IDbContextFactory<NordicBeesERP.Data.NordicBeesERPContext> ContextFactory
@inject IDeliveryReceiptPdfService DeliveryReceiptPdfService
@inject IJSRuntime JS
@inject IRawMaterialTypeService RawMaterialTypeService
@inject IAuthService AuthService
@inject ILabelPrintService LabelPrintService
@inject IContainerService ContainerService

@implements IDisposable

<PageTitle>Pristatymas</PageTitle>

    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
        }
        else if (_delivery == null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">Pristatymas nerastas.</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                Href="/warehouse/deliveries"
                StartIcon="@Icons.Material.Filled.ArrowBack"
                Style="text-transform:none">
                Atgal
            </MudButton>
        }
        else
        {
            <div class="d-flex justify-space-between align-center mb-2">
                <div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.h5">@_delivery.DeliveryNumber</MudText>
                        <MudChip T="string" Color="@GetStatusColor(_delivery.Status)" Size="Size.Small">@GetStatusText(_delivery.Status)</MudChip>
                        @if (_delivery.SupplierSignedAt.HasValue)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.VerifiedUser">
                                Pasirašyta @_delivery.SupplierSignedAt.Value.ToString("yyyy-MM-dd HH:mm")
                            </MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">@_supplierName</MudText>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                        StartIcon="@Icons.Material.Filled.ArrowBack"
                        Href="/warehouse/deliveries"
                        Style="text-transform:none">
                        Atgal
                    </MudButton>
                    @if (!_delivery.SupplierSignedAt.HasValue)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Draw"
                            Href="@($"/warehouse/deliveries/{Id}/sign")"
                            Style="text-transform:none">
                            Gauti parašą
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.PictureAsPdf"
                            OnClick="@DownloadReceiptAsync"
                            Style="text-transform:none">
                            Atsisiųsti aktą
                        </MudButton>
                    }
                </div>
            </div>
            @if (!_delivery.SupplierSignedAt.HasValue)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.Draw"
                    Href="@($"/warehouse/deliveries/{Id}/sign")">
                    Gauti parašą
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Success"
                    StartIcon="@Icons.Material.Filled.PictureAsPdf"
                    OnClick="@DownloadReceiptAsync">
                    Atsisiųsti aktą
                </MudButton>
            }
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/warehouse/deliveries">Atgal</MudButton>

        <!-- Save indicator -->
        @if (_saveIndicatorVisible)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check"
                Style="position:fixed; top:16px; right:16px; z-index:9999">
                Išsaugota
            </MudChip>
        }

        <!-- Info cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="3">
                <MudPaper Elevation="0" Style="background:#eff6ff; border-radius:8px; border-left:4px solid #2563eb; padding:16px">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Data</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600">@_delivery.DeliveryDate.ToString("yyyy-MM-dd")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Elevation="0" Style="background:#f5f3ff; border-radius:8px; border-left:4px solid #7c3aed; padding:16px">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Tiekėjas</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600">@_supplierName</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Elevation="0" Style="background:#f0fdf4; border-radius:8px; border-left:4px solid #16a34a; padding:16px">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Sandėlis</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600">@_warehouseName</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Elevation="0" Style="background:#eff6ff; border-radius:8px; border-left:4px solid #2563eb; padding:16px">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Bendras netto</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600">@_delivery.TotalNetWeight.ToString("N1") kg</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Elevation="0" Style="background:#fef3c7; border-radius:8px; border-left:4px solid #f59e0b; padding:16px">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Priėmė (BRC8 3.9)</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600">@_receivedByUser</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Delivery Lines -->
        <MudText Typo="Typo.h6" Class="mb-2">Pristatymo eilutės</MudText>
        <MudTable T="DeliveryLine" Items="_lines" Dense="true" Hover="true" Class="mb-4">
            <HeaderContent>
                <MudTh colspan="2">Prekė</MudTh>
                <MudTh>Tipas</MudTh>
                <MudTh Style="text-align:right">Kiekis</MudTh>
                <MudTh Style="text-align:right">Netto (kg)</MudTh>
            </HeaderContent>
            <RowTemplate Context="context">
                <MudTd colspan="2">@GetLineName(context)</MudTd>
                <MudTd>@GetContainerTypeName(context.ContainerType)</MudTd>
                <MudTd Style="text-align:right">@context.ContainerCount</MudTd>
                <MudTd Style="text-align:right">@((context.TotalNetWeight ?? 0m).ToString("N1"))</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTFootRow>
                    <MudTd colspan="3" Style="text-align:right"><strong>Iš viso netto:</strong></MudTd>
                    <MudTd Style="text-align:right"><strong>@GetFooterNetWeight() kg</strong></MudTd>
                </MudTFootRow>
            </FooterContent>
        </MudTable>

        <!-- Statics (barrels) section -->
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-1">STATINIŲ APSKAITA</MudText>
        <MudPaper Elevation="0" Style="background:#f8fafc; border-radius:8px; padding:16px">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSwitch T="bool" Value="_delivery.NeedReturnBarrels"
                        ValueChanged="@((bool val) => { _delivery.NeedReturnBarrels = val; OnFieldChanged(); })"
                        Color="Color.Primary" Label="Ar reikės grąžinti statines?" />
                </MudItem>
                @if (_delivery.NeedReturnBarrels)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudNumericField T="int" Value="_delivery.BarrelsOwed"
                            ValueChanged="@((int val) => { _delivery.BarrelsOwed = val; OnFieldChanged(); })"
                            Label="Skolingos statinės (vnt)" Variant="Variant.Outlined" Min="0" FullWidth="@true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudNumericField T="int" Value="_delivery.BarrelsReturned"
                            ValueChanged="@((int val) => { _delivery.BarrelsReturned = val; OnFieldChanged(); })"
                            Label="Grąžintos (vnt)" Variant="Variant.Outlined" Min="0" FullWidth="@true" />
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <!-- Containers table -->
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-1">PRISTATYMO DETALIZACIJA</MudText>

        <!-- Print status summary (BRC8 3.19) -->
        @if (_containers.Count > 0)
        {
            var printedCount = _containers.Count(c => c.LabelPrintCount > 0);
            var unprintedCount = _containers.Count - printedCount;

            @if (unprintedCount > 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-3" Icon="@Icons.Material.Filled.Warning">
                    <MudText Typo="Typo.body2">
                        <strong>@unprintedCount</strong> iš <strong>@_containers.Count</strong> konteinerių neturi išspausdintos etiketės.
                        @if (printedCount > 0 && unprintedCount < _containers.Count)
                        {
                            <span> (<strong>@printedCount</strong> išspausdinta)</span>
                        }
                    </MudText>
                </MudAlert>
            }
            else if (printedCount == _containers.Count)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-3" Icon="@Icons.Material.Filled.CheckCircle">
                    <MudText Typo="Typo.body2">
                        Visi <strong>@printedCount</strong> konteineriai turi išspausdintą etiketę.
                    </MudText>
                </MudAlert>
            }
        }

        <MudPaper Elevation="0" Rounded="true" Square="false" Class="pa-3">
            <MudTable T="Container" Items="_containers" Dense="true" Hover="true" Striped="true" Elevation="0">
                <HeaderContent>
                    <MudTh Style="width:140px">Kodas</MudTh>
                    <MudTh Style="width:140px">Tipas</MudTh>
                    <MudTh Style="width:120px; text-align:right">Brutto (kg)</MudTh>
                    <MudTh Style="width:120px; text-align:right">Tara (kg)</MudTh>
                    <MudTh Style="width:90px; text-align:right">Netto (kg)</MudTh>
                    <MudTh Style="width:100px">Etiketė</MudTh>
                    <MudTh Style="width:110px">Statusas</MudTh>
                    <MudTh Style="width:120px">Veiksmai</MudTh>
                </HeaderContent>
        <RowTemplate Context="item">
                    <MudTd Style="width:140px">
                        <MudText Typo="Typo.body2" Style="font-family:monospace; font-weight:600">
                            @(!string.IsNullOrEmpty(item.ContainerCode) ? item.ContainerCode : $"#{item.Id}")
                        </MudText>
                    </MudTd>
                    <MudTd Style="width:140px">@GetContainerTypeName(item.ContainerType)</MudTd>
                    <MudTd Style="text-align:right">
                        <input type="number"
                            value="@item.GrossWeight.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                            step="0.1"
                            style="width:70px; text-align:right; border:none; border-bottom:1px solid #ccc; background:transparent; font-size:14px; outline:none"
                            inputmode="decimal"
                            @onchange="@(async (ChangeEventArgs e) => {
                                if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
                                { item.GrossWeight = val; item.NetWeight = val - item.TareWeight; await OnContainerWeightChanged(item); }
                            })" />
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <input type="number"
                            value="@item.TareWeight.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                            step="0.1"
                            style="width:70px; text-align:right; border:none; border-bottom:1px solid #ccc; background:transparent; font-size:14px; outline:none"
                            inputmode="decimal"
                            @onchange="@(async (ChangeEventArgs e) => {
                                if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
                                { item.TareWeight = val; item.NetWeight = item.GrossWeight - val; await OnContainerWeightChanged(item); }
                            })" />
                    </MudTd>
                    <MudTd Style="width:90px; text-align:right"><b>@item.NetWeight.ToString("F1")</b></MudTd>
                    <MudTd Style="width:100px">
                        @if (item.LabelPrintCount > 0)
                        {
                            <MudChip T="int" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Print">
                                @item.LabelPrintCount x
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.PrintDisabled">
                                Nėra
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd Style="width:110px">
                        <MudChip T="string" Size="Size.Small" Color="@GetContainerStatusColor(item.Status)">@GetContainerStatusName(item.Status)</MudChip>
                    </MudTd>
                    <MudTd Style="width:120px">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Print"
                            Class="tablet-action-btn"
                            OnClick="@(() => ReprintContainerLabelAsync(item.Id))"
                            Title="Perspausdinti etiketę">
                            Perspausdinti
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="text-center py-4">Konteinerių nėra</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
        }
    </MudContainer>

@code {
    [Parameter] public int Id { get; set; }
    private bool _isLoading = true;

    private Delivery? _delivery;
    private List<DeliveryLine> _lines = new();
    private List<Container> _containers = new();
    private string _supplierName = "";
    private string _warehouseName = "";
    private string _receivedByUser = "-";

    // Lookups
    private List<Product> _products = new();
    private List<HoneyType> _honeyTypes = new();
    private List<RawMaterialType> _rawMaterialTypes = new();

    private System.Threading.Timer? _autoSaveTimer;
    private bool _saveIndicatorVisible = false;

    private void OnFieldChanged()
    {
        _autoSaveTimer?.Dispose();
        _autoSaveTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    if (_delivery == null) return;
                    _delivery.UpdatedAt = DateTime.Now;
                    using var context = await ContextFactory.CreateDbContextAsync();
                    context.Deliveries.Update(_delivery);
                    await context.SaveChangesAsync();
                    _saveIndicatorVisible = true;
                    StateHasChanged();
                    _ = Task.Delay(1500).ContinueWith(_ => InvokeAsync(() => { _saveIndicatorVisible = false; StateHasChanged(); }));
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Nepavyko išsaugoti: {ex.Message}", Severity.Error);
                    StateHasChanged();
                }
            });
        }, null, 500, Timeout.Infinite);
    }

    private async Task OnContainerWeightChanged(Container container)
    {
        // BRC8 3.21 — if label already printed, require weight correction dialog
        if (container.LabelPrintCount > 0)
        {
            var correctionResult = await WeightCorrectionDialogAsync(container);
            if (!correctionResult)
                return; // cancelled — revert UI values by reloading
            await PersistContainerWeight(container);
            return;
        }

        // Normal path — auto-save with debounce
        _autoSaveTimer?.Dispose();
        _autoSaveTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    await PersistContainerWeight(container);
                    _saveIndicatorVisible = true;
                    StateHasChanged();
                    _ = Task.Delay(1500).ContinueWith(_ => InvokeAsync(() => { _saveIndicatorVisible = false; StateHasChanged(); }));
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Nepavyko išsaugoti: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
                    StateHasChanged();
                }
            });
        }, null, 500, Timeout.Infinite);
    }

    private async Task<bool> WeightCorrectionDialogAsync(Container container)
    {
        var oldGross = container.GrossWeight;
        var oldTare = container.TareWeight;
        var oldNet = container.NetWeight;

        var dialog = await DialogService.ShowAsync<WeightCorrectionDialog>("Svorio korekcija", new DialogParameters
        {
            [nameof(WeightCorrectionDialog.OldGrossWeight)] = oldGross,
            [nameof(WeightCorrectionDialog.OldTareWeight)] = oldTare,
            [nameof(WeightCorrectionDialog.OldNetWeight)] = oldNet,
        }, new DialogOptions { MaxWidth = MaxWidth.Medium, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result == null || result.Canceled)
            return false;

        var correction = result.Data as WeightCorrectionDialog.WeightCorrectionResult;
        if (correction == null)
            return false;

        try
        {
            var operatorId = await AuthService.GetUserIdAsync();
            if (!operatorId.HasValue)
            {
                Snackbar.Add("Nėra prisijungusio vartotojo", Severity.Error);
                return false;
            }

            await ContainerService.SaveWeightCorrectionAsync(
                container.Id,
                oldGross, correction.NewGrossWeight,
                oldTare, correction.NewTareWeight,
                oldNet, correction.NewNetWeight,
                correction.Reason,
                operatorId.Value
            );

            // Update local container
            container.GrossWeight = correction.NewGrossWeight;
            container.TareWeight = correction.NewTareWeight;
            container.NetWeight = correction.NewNetWeight;

            // If user requested reprint, trigger it
            if (correction.ReprintLabel)
            {
                // Auto-reprint with "Misprint" reason (weight changed)
                await LabelPrintService.ReprintLabelAsync(container.Id, ReprintReasonCode.MISPRINT, correction.Reason, operatorId.Value);
            }

            Snackbar.Add("Svorio korekcija įrašyta", Severity.Info);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nepavyko įrašyti korekcijos: {ex.Message}", Severity.Error);
            return false;
        }
    }

    private async Task PersistContainerWeight(Container container)
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        var existing = await context.Containers.FindAsync(container.Id);
        if (existing != null)
        {
            existing.GrossWeight = container.GrossWeight;
            existing.TareWeight = container.TareWeight;
            existing.NetWeight = container.GrossWeight - container.TareWeight;
            existing.UpdatedAt = DateTime.Now;
            context.Entry(existing).Property(x => x.GrossWeight).IsModified = true;
            context.Entry(existing).Property(x => x.TareWeight).IsModified = true;
            context.Entry(existing).Property(x => x.NetWeight).IsModified = true;
            context.Entry(existing).Property(x => x.UpdatedAt).IsModified = true;
            await context.SaveChangesAsync();
        }
    }

    private async Task ReprintContainerLabelAsync(int containerId)
    {
        var result = await ReprintReasonDialog.ShowAsync(DialogService);
        if (result == null)
            return;

        var (reasonCode, reasonText) = result.Value;

        try
        {
            var operatorId = await AuthService.GetUserIdAsync();
            if (!operatorId.HasValue)
            {
                Snackbar.Add("Nėra prisijungusio vartotojo", Severity.Error);
                return;
            }

            await LabelPrintService.ReprintLabelAsync(containerId, reasonCode, reasonText, operatorId.Value);

            // Refresh containers to get updated LabelPrintCount
            _containers = await DeliveryService.GetContainersByDeliveryAsync(Id);
            StateHasChanged();

            Snackbar.Add($"Etiketė perspausdinta: {GetReprintReasonName(reasonCode)}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nepavyko perspausdinti: {ex.Message}", Severity.Error);
        }
    }

    private void OnContainerChanged(Container container)
    {
        _autoSaveTimer?.Dispose();
        _autoSaveTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    using var context = await ContextFactory.CreateDbContextAsync();
                    var existing = await context.Containers.FindAsync(container.Id);
                    if (existing != null)
                    {
                        existing.GrossWeight = container.GrossWeight;
                        existing.TareWeight = container.TareWeight;
                        existing.NetWeight = container.GrossWeight - container.TareWeight;
                        existing.UpdatedAt = DateTime.Now;
                        context.Entry(existing).Property(x => x.GrossWeight).IsModified = true;
                        context.Entry(existing).Property(x => x.TareWeight).IsModified = true;
                        context.Entry(existing).Property(x => x.NetWeight).IsModified = true;
                        context.Entry(existing).Property(x => x.UpdatedAt).IsModified = true;
                        await context.SaveChangesAsync();
                    }
                    _saveIndicatorVisible = true;
                    StateHasChanged();
                    _ = Task.Delay(1500).ContinueWith(_ => InvokeAsync(() => { _saveIndicatorVisible = false; StateHasChanged(); }));
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Nepavyko išsaugoti: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
                    StateHasChanged();
                }
            });
        }, null, 500, Timeout.Infinite);
    }

    protected override async Task OnInitializedAsync()
    {
        _products = await ProductService.GetAllProductsAsync();
        _honeyTypes = await HoneyTypeService.GetAllAsync();
        _rawMaterialTypes = await RawMaterialTypeService.GetActiveAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        _delivery = await DeliveryService.GetByIdAsync(Id);
        if (_delivery == null) return;

        _lines = await DeliveryService.GetLinesByDeliveryIdAsync(Id);
        _containers = await DeliveryService.GetContainersByDeliveryAsync(Id);

        var suppliers = await CustomerService.GetSuppliersAsync();
        _supplierName = suppliers.FirstOrDefault(s => s.Id == _delivery.SupplierId)?.Name ?? "";

        var warehouses = await WarehouseService.GetAllAsync();
        _warehouseName = warehouses.FirstOrDefault(w => w.Id == _delivery.WarehouseId)?.Name ?? "";

        // BRC8 3.9 — resolve received_by_user_id to user name
        if (_delivery.ReceivedByUserId.HasValue)
        {
            var user = await AuthService.GetUserByIdAsync(_delivery.ReceivedByUserId.Value);
            _receivedByUser = user?.FullName ?? user?.Email ?? $"#{_delivery.ReceivedByUserId}";
        }
    }

    private string GetLineName(DeliveryLine line)
    {
        var rawMat = _delivery?.RawMaterialTypeId.HasValue == true
            ? _rawMaterialTypes.FirstOrDefault(r => r.Id == _delivery.RawMaterialTypeId)?.Name
            : null;
        var honeyType = line.HoneyTypeId.HasValue
            ? _honeyTypes.FirstOrDefault(h => h.Id == line.HoneyTypeId)?.Name
            : null;
        if (!string.IsNullOrEmpty(rawMat) && !string.IsNullOrEmpty(honeyType))
            return $"{rawMat} — {honeyType}";
        if (!string.IsNullOrEmpty(rawMat))
            return rawMat;
        if (!string.IsNullOrEmpty(honeyType))
            return honeyType;
        return "-";
    }
    private string GetHoneyTypeName(int? id) => id.HasValue ? _honeyTypes.FirstOrDefault(h => h.Id == id.Value)?.Name ?? "-" : "-";

    private string GetContainerTypeName(string containerType) => containerType switch
    {
        "BARREL" => "Statinės",
        "BUCKET" => "Kibiras",
        _ => containerType
    };

    private Color GetStatusColor(string status) => status switch
    {
        "RECEIVED" => Color.Default, "PRICED" => Color.Info,
        "PARTIAL_PAID" => Color.Warning, "PAID" => Color.Success, _ => Color.Default
    };

    private string GetStatusText(string status) => status switch
    {
        "RECEIVED" => "Priimtas", "PRICED" => "Įkainotas",
        "PARTIAL_PAID" => "Dalinai", "PAID" => "Apmokėtas", _ => status
    };

    private string GetContainerStatusName(string? status) => status switch
    {
        "IN_STOCK" => "Sandėlyje",
        "QUARANTINE" => "Karetinyje",
        "TRANSFERRED" => "Perkeltas",
        "WRITTEN_OFF" => "Nurašytas",
        "PACKAGED" => "Supakuotas",
        "SHIPPED" => "Išsiųstas",
        _ => status ?? "-"
    };

    private Color GetContainerStatusColor(string? status) => status switch
    {
        "IN_STOCK" => Color.Default,
        "QUARANTINE" => Color.Warning,
        "TRANSFERRED" => Color.Info,
        "WRITTEN_OFF" => Color.Error,
        "PACKAGED" => Color.Success,
        "SHIPPED" => Color.Primary,
        _ => Color.Default
    };

    private string GetReprintReasonName(ReprintReasonCode reason) => reason switch
    {
        ReprintReasonCode.DAMAGED => "Pažeista",
        ReprintReasonCode.LOST => "Pameista",
        ReprintReasonCode.MISPRINT => "Neteisingai išspausdinta",
        ReprintReasonCode.OTHER => "Kita",
        _ => reason.ToString()
    };

    private string GetFooterNetWeight()
    {
        var total = _lines != null ? _lines.Sum(l => l.TotalNetWeight ?? 0m) : 0m;
        return total.ToString("N1");
    }

    private async Task DownloadReceiptAsync()
    {
        try
        {
            byte[] pdfBytes;

            if (!string.IsNullOrWhiteSpace(_delivery?.ReceiptPdfPath))
            {
                var baseDir = "/var/lib/nordicbees/delivery-receipts";
                var fullPath = Path.Combine(baseDir, _delivery.ReceiptPdfPath);
                if (File.Exists(fullPath))
                {
                    pdfBytes = await File.ReadAllBytesAsync(fullPath);
                }
                else
                {
                    pdfBytes = await DeliveryReceiptPdfService.GenerateReceiptAsync(Id);
                }
            }
            else
            {
                pdfBytes = await DeliveryReceiptPdfService.GenerateReceiptAsync(Id);
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"pristatymo-aktas-{_delivery?.DeliveryNumber ?? Id.ToString()}.pdf";
            await JS.InvokeVoidAsync("downloadFileFromBase64", base64, fileName, "application/pdf");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF klaida: {ex.Message}", Severity.Error);
        }
    }

    public void Dispose()
    {
        _autoSaveTimer?.Dispose();
    }
}
