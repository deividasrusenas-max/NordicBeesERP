    private class TransferGroup
    {
        public string TransferNumber { get; set; } = "";
        public DateTime Date { get; set; }
        public int? FromWarehouseId { get; set; }
        public int? ToWarehouseId { get; set; }
        public int ContainerCount { get; set; }
        public decimal TotalQuantity { get; set; }
        public bool ShowDetail { get; set; }
        public List<TransferContainerInfo> Containers { get; set; } = new();
    }

    private class TransferContainerInfo
    {
        public string Code { get; set; } = "";
        public decimal Quantity { get; set; }
    }

    private async Task LoadData()
    {
        _loading = true;
        _selectedContainers.Clear();
        _containers = await ContainerService.GetFilteredAsync(_filterWarehouseId, _filterHoneyTypeId, _filterSupplierId, _filterStatus, null);

        // Build the delivery-line → raw material type mapping once per load (before any FilteredContainers-dependent work)
        await LoadDeliveryLineToRawTypeMappingAsync();

        // Calculate bičių duona stats
        CalculateBiciuDuonaStats();

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task LoadDeliveryLineToRawTypeMappingAsync()
    {
        var allDeliveries = await DeliveryService.GetAllAsync();
        var deliveryById = allDeliveries.ToDictionary(d => d.Id);

        using var context = DbContextFactory.CreateDbContext();
        var lines = await context.DeliveryLines
            .Select(l => new { l.Id, l.DeliveryId })
            .ToListAsync();

        _deliveryLineToRawTypeId.Clear();
        foreach (var line in lines)
        {
            if (!deliveryById.TryGetValue(line.DeliveryId, out var delivery)) continue;
            if (!delivery.RawMaterialTypeId.HasValue) continue;
            _deliveryLineToRawTypeId[line.Id] = delivery.RawMaterialTypeId.Value;
        }
    }

    private void CalculateBiciuDuonaStats()
    {
        // A container belongs to bičių duona when its DeliveryLineId maps (via the shared mapping)
        // to a raw material type whose name contains "BIČIŲ DUONA".
        var biciuTypeIds = _rawMaterialTypes
            .Where(r => r.Name.Contains("BIČIŲ DUONA", StringComparison.OrdinalIgnoreCase))
            .Select(r => r.Id)
            .ToHashSet();

        bool IsBiciuDuona(Container c) =>
            c.DeliveryLineId.HasValue
            && _deliveryLineToRawTypeId.TryGetValue(c.DeliveryLineId.Value, out var rawTypeId)
            && biciuTypeIds.Contains(rawTypeId);

        // Count and sum containers whose DeliveryLineId matches bičių duona delivery lines
        _biciuDuonaCount = _containers.Count(IsBiciuDuona);
        _biciuDuonaWeight = _containers.Where(IsBiciuDuona).Sum(c => c.NetWeight);
    }

    private void ClearFilters()
    {
        Navigation.NavigateTo(Navigation.Uri.Split('?')[0], replace: true);
    }

    private async Task ApplyFiltersFromUrl()
    {
        var newUrl = FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("warehouse", FilterUrlBuilder.ToQueryValue(_filterWarehouseId)),
            ("honeyType", FilterUrlBuilder.ToQueryValue(_filterHoneyTypeId)),
            ("supplier", FilterUrlBuilder.ToQueryValue(_filterSupplierId)),
            ("status", FilterUrlBuilder.ToQueryValue(_filterStatus)),
            ("q", FilterUrlBuilder.ToQueryValue(_search)),
            ("from", FilterUrlBuilder.ToQueryValue(_filterDateFrom)),
            ("to", FilterUrlBuilder.ToQueryValue(_filterDateTo)),
            ("view", _viewType != "STOCK" ? _viewType : null));
        Navigation.NavigateTo(newUrl, replace: true);
    }

    private async Task SetViewType(string view)
    {
        if (view == _viewType) return;
        _viewType = view;
        _selectedContainers.Clear();
        await ApplyFiltersFromUrl();
    }

    private async Task UpdateSearchAsync(string? value)
    {
        _search = value;
        await ApplyFiltersFromUrl();
    }

    private async Task UpdateDateRangeAsync(DateRange? range)
    {
        _dateRange = range;
        _filterDateFrom = range?.Start;
        _filterDateTo = range?.End;
        await ApplyFiltersFromUrl();
    }

    private string GetSupplierName(int id) => _suppliers.FirstOrDefault(s => s.Id == id)?.Name ?? $"#{id}";
    private string GetHoneyTypeName(int? id) => id.HasValue ? _honeyTypes.FirstOrDefault(h => h.Id == id.Value)?.Name ?? "-" : "-";
    private string GetWarehouseName(int id) => _warehouses.FirstOrDefault(w => w.Id == id)?.Name ?? $"#{id}";

    private static readonly Dictionary<string, (string Label, Color Color)> _containerStatusDisplay = new()
    {
        ["IN_STOCK"] = ("Sandėlyje", Color.Success),
        ["RECEIVED"] = ("Priimtas", Color.Default),
        ["RESERVED"] = ("Rezervuotas", Color.Warning),
        ["IN_PRODUCTION"] = ("Gamyboje", Color.Info),
    };

    // Transfer dialog
    private bool _transferDialogVisible;
    private int _transferTargetWarehouseId;
    private string _transferNotes = "";

    private void OpenTransferDialog()
    {
        // Patikrinti ar visos iš to paties sandėlio
        var warehouseIds = _selectedContainers.Select(c => c.WarehouseId).Distinct().ToList();
        if (warehouseIds.Count > 1)
        {
            Snackbar.Add("Pasirinkite statines tik iš vieno sandėlio", Severity.Warning);
            return;
        }
        
        _transferTargetWarehouseId = 0;
        _transferNotes = "";
        _transferDialogVisible = true;
    }

    private async Task ExecuteTransfer()
    {
        try
        {
            var ids = _selectedContainers.Select(c => c.Id).ToList();
            var fromWarehouseId = _selectedContainers.First().WarehouseId;
            var transferNumber = await TransferService.TransferContainersAsync(ids, fromWarehouseId, _transferTargetWarehouseId, _transferNotes);
            _transferDialogVisible = false;
            var targetName = _warehouses.FirstOrDefault(w => w.Id == _transferTargetWarehouseId)?.Name ?? "";
            Snackbar.Add($"Perkelta {ids.Count} vnt. į {targetName} ({transferNumber})", Severity.Success);
            await LoadData();
            _selectedContainers.Clear();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nepavyko perkelti: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    private string GetCurrentWarehouseName()
    {
        if (_selectedContainers.Any())
        {
            var warehouseId = _selectedContainers.First().WarehouseId;
            return _warehouses.FirstOrDefault(w => w.Id == warehouseId)?.Name ?? "Nežinomas";
        }
        return "-";
    }

    // Assign Honey Type dialog
    private bool _assignTypeDialogVisible;
    private int? _assignHoneyTypeId;

    private void OpenAssignHoneyTypeDialog()
    {
        _assignHoneyTypeId = null;
        _assignTypeDialogVisible = true;
    }

    private async Task ExecuteAssignHoneyType()
    {
        try
        {
            var ids = _selectedContainers.Select(c => c.Id).ToList();
            await ContainerService.UpdateHoneyTypeAsync(ids, _assignHoneyTypeId!.Value);
            _assignTypeDialogVisible = false;
            var typeName = _honeyTypes.FirstOrDefault(h => h.Id == _assignHoneyTypeId)?.Name ?? "";
            Snackbar.Add($"Priskirta rūšis \"{typeName}\" — {ids.Count} vnt.", Severity.Success);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nepavyko priskirti: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    // Write Off dialog
    private bool _writeOffDialogVisible;
    private string _writeOffReason = "";
    private string _writeOffNotes = "";
    private bool _processing;

    private void OpenWriteOffDialog()
    {
        if (!_selectedContainers.Any()) return;
        _writeOffReason = "";
        _writeOffNotes = "";
        _writeOffDialogVisible = true;
    }

    private void CloseWriteOffDialog()
    {
        _writeOffDialogVisible = false;
        _writeOffReason = "";
        _writeOffNotes = "";
    }

    private async Task ConfirmWriteOff()
    {
        var ids = _selectedContainers.Select(c => c.Id).ToList();
        var reason = _writeOffReason + (!string.IsNullOrEmpty(_writeOffNotes) ? $": {_writeOffNotes}" : "");
        _processing = true;
        try
        {
            await ContainerService.WriteOffAsync(ids, reason, null);
            _writeOffDialogVisible = false;
            _writeOffReason = "";
            _writeOffNotes = "";
            Snackbar.Add($"Nurašyta {ids.Count} vnt.", Severity.Success);
            await LoadData();
            _selectedContainers.Clear();
        }
        finally
        {
            _processing = false;
        }
    }
