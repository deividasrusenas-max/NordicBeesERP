@page "/warehouse/stock"
@rendermode InteractiveServer
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Helpers
@inject IContainerService ContainerService
@inject IWarehouseService WarehouseService
@inject ICustomerService CustomerService
@inject IHoneyTypeService HoneyTypeService
@inject ITransferService TransferService
@inject IDeliveryService DeliveryService
@inject IRawMaterialTypeService RawMaterialTypeService
@inject IDbContextFactory<NordicBeesERPContext> DbContextFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Sandėlio likučiai</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Sandėlio likučiai</MudText>

    <!-- View switcher (Likučiai / Nurašyta / Perkėlimai) -->
    <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
        <MudChipSet T="string"
                    SelectedValue="_viewType"
                    SelectedValueChanged="@(async (val) => { if (val != null && val != _viewType) await SetViewType(val); })"
                    SelectionMode="SelectionMode.SingleSelection">
            <MudChip T="string" Value="@("STOCK")"
                     Color="@(_viewType == "STOCK" ? Color.Primary : Color.Default)"
                     Variant="@(_viewType == "STOCK" ? Variant.Filled : Variant.Outlined)"
                     Style="text-transform:none;min-width:180px;">
                Likučiai
            </MudChip>
            <MudChip T="string" Value="@("WRITTEN_OFF")"
                     Color="@(_viewType == "WRITTEN_OFF" ? Color.Primary : Color.Default)"
                     Variant="@(_viewType == "WRITTEN_OFF" ? Variant.Filled : Variant.Outlined)"
                     Style="text-transform:none;min-width:180px;">
                Nurašyta
            </MudChip>
            <MudChip T="string" Value="@("TRANSFERS")"
                     Color="@(_viewType == "TRANSFERS" ? Color.Primary : Color.Default)"
                     Variant="@(_viewType == "TRANSFERS" ? Variant.Filled : Variant.Outlined)"
                     Style="text-transform:none;min-width:180px;">
                Perkėlimai
            </MudChip>
        </MudChipSet>
    </MudStack>

    <!-- Filters -->
    <StandardListFilterBar>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="int?" Value="_filterWarehouseId" ValueChanged="@(async (int? v) => { _filterWarehouseId = v; await ApplyFiltersFromUrl(); })" Label="Sandėlis" Variant="Variant.Text" Clearable="@true">
                    @foreach (var w in _warehouses)
                    {
                        <MudSelectItem T="int?" Value="w.Id">@w.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField T="string" Value="@_search" ValueChanged="UpdateSearchAsync" Label="Paieška (kodas, tiekėjas, rūšis, sandėlis)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="@true" Immediate="@true" FullWidth="@true" Variant="Variant.Text" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudDateRangePicker DateRange="@_dateRange" DateRangeChanged="UpdateDateRangeAsync" Label="Laikotarpis" Variant="Variant.Text" FullWidth="@true" Clearable="@true" />
            </MudItem>
            @if (!string.IsNullOrWhiteSpace(_search)
                || _filterStatus != null
                || _dateRange?.Start != null
                || _dateRange?.End != null
                || (_filterWarehouseId.HasValue && _warehouses.Any() && _filterWarehouseId.Value != _warehouses.First().Id))
            {
                <MudItem xs="12">
                    <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                               OnClick="ClearFilters">
                        Išvalyti filtrus
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </StandardListFilterBar>

    <!-- Status chips row (separate from filter bar, no label) -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var status in _containerStatusDisplay)
        {
            var isSelected = _filterStatus == status.Key;
            <MudChip T="string"
                     Color="@(isSelected ? status.Value.Color : Color.Default)"
                     Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => ToggleStatus(status.Key))"
                     Size="Size.Small"
                      Style="@("text-transform:none;" + (isSelected ? "" : " opacity:0.7"))">
                @status.Value.Label
            </MudChip>
        }
    </div>

    <!-- Summary cards -->
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3">
            <MudPaper Elevation="0" Class="pa-3" Style="background:#f8fafc; border-radius:12px; height:90px; display:flex; flex-direction:column; justify-content:space-between">
                <MudText Typo="Typo.caption">Statinės</MudText>
                <MudText Typo="Typo.h5">@_containers.Count(c => c.ContainerType == "BARREL") vnt.</MudText>
                <MudText Typo="Typo.body2" Style="color:#64748b">@_containers.Where(c => c.ContainerType == "BARREL").Sum(c => c.NetWeight).ToString("N1") kg</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Elevation="0" Class="pa-3" Style="background:#f8fafc; border-radius:12px; height:90px; display:flex; flex-direction:column; justify-content:space-between">
                <MudText Typo="Typo.caption">Bendras netto</MudText>
                <MudText Typo="Typo.h5">@_containers.Sum(c => c.NetWeight).ToString("N1") kg</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Elevation="0" Class="pa-3" Style="background:#f8fafc; border-radius:12px; height:90px; display:flex; flex-direction:column; justify-content:space-between">
                <MudText Typo="Typo.caption">Kibirai</MudText>
                <MudText Typo="Typo.h5">@_containers.Count(c => c.ContainerType == "BUCKET_GROUP") vnt.</MudText>
                <MudText Typo="Typo.body2" Style="color:#64748b">@_containers.Where(c => c.ContainerType == "BUCKET_GROUP").Sum(c => c.NetWeight).ToString("N1") kg</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Elevation="0" Class="pa-3" Style="background:#f8fafc; border-radius:12px; height:90px; display:flex; flex-direction:column; justify-content:space-between">
                <MudText Typo="Typo.caption">Bičių duona</MudText>
                <MudText Typo="Typo.h5">@_biciuDuonaWeight.ToString("N1") kg</MudText>
                <MudText Typo="Typo.body2" Style="color:#64748b">@_biciuDuonaCount vnt.</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Category hierarchy -->
    <MudExpansionPanels Dense="true" MultiExpansion="true" Class="mb-3">
        @foreach (var group in CategoryGroups)
        {
            @RenderGroup(group)
        }
    </MudExpansionPanels>

    @if (_selectedContainers.Any())
    {
        <MudPaper Class="pa-3 mt-3" Elevation="2" Style="border-radius:8px; position:sticky; bottom:16px; background:white">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText>Pasirinkta: <strong>@_selectedContainers.Count</strong> vnt. | @_selectedContainers.Sum(c => c.NetWeight).ToString("N1") kg</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.MoveDown"
                        OnClick="OpenTransferDialog">Perkelti</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Label"
                        OnClick="OpenAssignHoneyTypeDialog">Priskirti rūšį</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.DeleteForever"
                        OnClick="OpenWriteOffDialog">Nurašyti</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }

    <!-- WRITTEN_OFF view (ported from WriteOffHistory.razor) -->
    @if (_viewType == "WRITTEN_OFF")
    {
        <StandardListFilterBar>
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField T="string" Value="@_writeOffSearchText" ValueChanged="UpdateWriteOffSearchAsync"
                        Label="Paieška (kodas, tiekėjas, rūšis)"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                        Clearable="@true" Immediate="@true" FullWidth="@true" Variant="Variant.Text" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDateRangePicker T="DateTime?" DateRange="@_writeOffDateRange" DateRangeChanged="UpdateWriteOffDateRangeAsync"
                        Label="Nurašymo data" Variant="Variant.Text" FullWidth="@true" Clearable="@true" Editable="true" DateFormat="yyyy-MM-dd" />
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(_writeOffSearchText) || _writeOffDateRange?.Start != null || _writeOffDateRange?.End != null)
                {
                    <MudItem xs="12">
                        <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff" Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" OnClick="ClearWriteOffFilters">Išvalyti filtrus</MudButton>
                    </MudItem>
                }
            </MudGrid>
        </StandardListFilterBar>

        @if (_writeOffLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (!FilteredWriteOffContainers.Any())
        {
            <MudAlert Severity="Severity.Info">Nurašytų konteinerių nėra</MudAlert>
        }
        else
        {
            <MudGrid Class="mb-4">
                <MudItem xs="6" md="3">
                    <MudPaper Class="pa-3" Elevation="0" Style="background:#ffebee; border-radius:8px">
                        <MudText Typo="Typo.caption">Nurašyta vnt.</MudText>
                        <MudText Typo="Typo.h5">@FilteredWriteOffContainers.Count()</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudPaper Class="pa-3" Elevation="0" Style="background:#ffebee; border-radius:8px">
                        <MudText Typo="Typo.caption">Nurašyta kg</MudText>
                        <MudText Typo="Typo.h5">@FilteredWriteOffContainers.Sum(c => c.NetWeight).ToString("N1")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudTable T="Container" Items="FilteredWriteOffContainers.ToList()" Dense="true" Hover="true" Striped="true" RowsPerPage="50">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Tipas</MudTh>
                    <MudTh>Tiekėjas</MudTh>
                    <MudTh>Rūšis</MudTh>
                    <MudTh Style="text-align:right">Netto (kg)</MudTh>
                    <MudTh>Sandėlis</MudTh>
                    <MudTh>Priežastis</MudTh>
                    <MudTh>Data</MudTh>
                </HeaderContent>
                <RowTemplate Context="c">
                    <MudTd><strong>@c.ContainerCode</strong></MudTd>
                    <MudTd>@(c.ContainerType == "BARREL" ? "Statinė" : "Kibirai")</MudTd>
                    <MudTd>@GetSupplierName(c.SupplierId)</MudTd>
                    <MudTd>@GetHoneyTypeName(c.HoneyTypeId)</MudTd>
                    <MudTd Style="text-align:right">@c.NetWeight.ToString("N1")</MudTd>
                    <MudTd>@GetWarehouseName(c.WarehouseId)</MudTd>
                    <MudTd>@(string.IsNullOrWhiteSpace(c.Notes) ? "—" : c.Notes)</MudTd>
                    <MudTd>@c.UpdatedAt.ToString("yyyy-MM-dd")</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" RowsPerPageString="Eilučių puslapyje:" />
                </PagerContent>
            </MudTable>
        }
    }

    <!-- TRANSFERS view (ported from TransferHistory.razor) -->
    @if (_viewType == "TRANSFERS")
    {
        <StandardListFilterBar>
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField T="string" Value="@_transferSearchText" ValueChanged="UpdateTransferSearchAsync"
                        Label="Paieška (nr. / sandėlis)" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Search"
                        Clearable="@true" Immediate="@true" FullWidth="@true" Variant="Variant.Text" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDateRangePicker T="DateTime?" DateRange="@_transferDateRange" DateRangeChanged="UpdateTransferDateRangeAsync"
                        Label="Perkėlimo data" Variant="Variant.Text" FullWidth="@true" Clearable="@true" Editable="true" DateFormat="yyyy-MM-dd" />
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(_transferSearchText) || _transferDateRange?.Start != null || _transferDateRange?.End != null)
                {
                    <MudItem xs="12">
                        <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff" Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" OnClick="ClearTransferFilters">Išvalyti filtrus</MudButton>
                    </MudItem>
                }
            </MudGrid>
        </StandardListFilterBar>

        @if (_transferLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (!FilteredTransferGroups.Any())
        {
            <MudAlert Severity="Severity.Info">Perkėlimų dar nėra</MudAlert>
        }
        else
        {
            <MudTable T="TransferGroup" Items="FilteredTransferGroups" Dense="true" Hover="true" Striped="true"
                OnRowClick="@((TableRowClickEventArgs<TransferGroup> args) => ToggleTransferDetail(args.Item))"
                Style="cursor:pointer">
                <HeaderContent>
                    <MudTh>Nr.</MudTh>
                    <MudTh>Data</MudTh>
                    <MudTh>Iš</MudTh>
                    <MudTh>Į</MudTh>
                    <MudTh Style="text-align:right">Vnt.</MudTh>
                    <MudTh Style="text-align:right">Netto (kg)</MudTh>
                </HeaderContent>
                <RowTemplate Context="t">
                    <MudTd><strong>@t.TransferNumber</strong></MudTd>
                    <MudTd>@t.Date.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd>@GetTransferWarehouseName(t.FromWarehouseId)</MudTd>
                    <MudTd>@GetTransferWarehouseName(t.ToWarehouseId)</MudTd>
                    <MudTd Style="text-align:right">@t.ContainerCount</MudTd>
                    <MudTd Style="text-align:right">@t.TotalQuantity.ToString("N1")</MudTd>
                </RowTemplate>
                <ChildRowContent Context="t">
                    @if (t.ShowDetail)
                    {
                        <MudTr>
                            <td colspan="6" style="padding:0 16px 16px 48px; background:#f8fafc">
                                <MudSimpleTable Dense="true" Style="background:white; border-radius:8px" Elevation="0">
                                    <thead>
                                        <tr><th>Konteineris</th><th style="text-align:right">Netto (kg)</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in t.Containers)
                                        {
                                            <tr><td><strong>@c.Code</strong></td><td style="text-align:right">@c.Quantity.ToString("N1")</td></tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            </td>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        }
    }

    <!-- Transfer Dialog -->
    <MudDialog @bind-Visible="_transferDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
        <TitleContent>
            <MudText Typo="Typo.h6">Perkelti @_selectedContainers.Count vnt. (@_selectedContainers.Sum(c => c.NetWeight).ToString("N1") kg)</MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="3">
                <MudText Typo="Typo.body2">Iš: <strong>@GetCurrentWarehouseName()</strong></MudText>
                <MudSelect T="int" @bind-Value="_transferTargetWarehouseId" Label="Kur perkelti?" Variant="Variant.Outlined" Required="true">
                    @foreach (var w in _warehouses.Where(w => w.Id != (_filterWarehouseId ?? 0)))
                    {
                        <MudSelectItem Value="w.Id">@w.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_transferNotes" Label="Pastaba" Variant="Variant.Outlined" Lines="2" />
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Secondary" OnClick="@(() => _transferDialogVisible = false)">Atšaukti</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExecuteTransfer"
                Disabled="@(_transferTargetWarehouseId == 0)">
                Perkelti ✓
            </MudButton>
        </DialogActions>
    </MudDialog>

    <!-- Assign Honey Type Dialog -->
    <MudDialog @bind-Visible="_assignTypeDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
        <TitleContent>
            <MudText Typo="Typo.h6">Priskirti medaus rūšį (@_selectedContainers.Count vnt.)</MudText>
        </TitleContent>
        <DialogContent>
            <MudSelect T="int?" @bind-Value="_assignHoneyTypeId" Label="Medaus rūšis" Variant="Variant.Outlined" Required="true">
                @foreach (var h in _honeyTypes)
                {
                    <MudSelectItem T="int?" Value="h.Id">@h.Name</MudSelectItem>
                }
            </MudSelect>
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Secondary" OnClick="@(() => _assignTypeDialogVisible = false)">Atšaukti</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExecuteAssignHoneyType"
                Disabled="@(!_assignHoneyTypeId.HasValue)">
                Priskirti ✓
            </MudButton>
        </DialogActions>
    </MudDialog>

    <!-- Write Off Dialog -->
    <MudDialog @bind-Visible="_writeOffDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
        <TitleContent>
            <MudText Typo="Typo.h6">Nurašyti @_selectedContainers.Count vnt. (@_selectedContainers.Sum(c => c.NetWeight).ToString("N1") kg)</MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="3">
                <MudSelect T="string" @bind-Value="_writeOffReason" Label="Priežastis" Variant="Variant.Outlined" Required="true" FullWidth="true">
                    <MudSelectItem Value="@("Pažeista")">Pažeista</MudSelectItem>
                    <MudSelectItem Value="@("Pasenusi")">Pasenusi</MudSelectItem>
                    <MudSelectItem Value="@("Netinkama")">Netinkama</MudSelectItem>
                    <MudSelectItem Value="@("Užteršta")">Užteršta</MudSelectItem>
                    <MudSelectItem Value="@("Kita")">Kita</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="_writeOffNotes" Label="Pastaba" Variant="Variant.Outlined" FullWidth="true" />
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" OnClick="CloseWriteOffDialog">Atšaukti</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(string.IsNullOrEmpty(_writeOffReason) || _processing)" OnClick="ConfirmWriteOff">Patvirtinti nurašymą</MudButton>
        </DialogActions>
    </MudDialog>
</MudContainer>

@code {
    private List<Container> _containers = new();
    private HashSet<Container> _selectedContainers = new();
    private bool _loading = true;

    // Bičių duona stats
    private decimal _biciuDuonaWeight = 0m;
    private int _biciuDuonaCount = 0;

    // Lookups
    private List<Warehouse> _warehouses = new();
    private List<BusinessPartner> _suppliers = new();
    private List<HoneyType> _honeyTypes = new();
    private List<RawMaterialType> _rawMaterialTypes = new();
    private readonly Dictionary<int, int> _deliveryLineToRawTypeId = new();

    // Filters
    private int? _filterWarehouseId;
    private int? _filterHoneyTypeId;
    private int? _filterSupplierId;
    private string? _filterStatus;
    private string? _search;
    private DateTime? _filterDateFrom;
    private DateTime? _filterDateTo;
    private DateRange? _dateRange;

    // Top-level view switcher (Likučiai / Nurašyta / Perkėlimai) — UI + URL state only for now
    private string _viewType = "STOCK";

    // WRITTEN_OFF view (ported from WriteOffHistory.razor) — separate fields so they never collide with the STOCK-view filters above
    private List<Container> _writeOffContainers = new();
    private bool _writeOffLoading = true;
    private bool _writeOffContainersLoaded;
    private string _writeOffSearchText = string.Empty;
    private DateRange? _writeOffDateRange;

    // Client-side date-range + free-text filter applied on top of the server-fetched _containers
    private IEnumerable<Container> FilteredContainers => _containers.Where(c =>
    {
        if (_filterDateFrom.HasValue && c.CreatedAt.Date < _filterDateFrom.Value.Date) return false;
        if (_filterDateTo.HasValue && c.CreatedAt.Date > _filterDateTo.Value.Date) return false;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var match = (c.ContainerCode != null && c.ContainerCode.Contains(_search, StringComparison.OrdinalIgnoreCase))
                || (GetSupplierName(c.SupplierId)?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                || (GetHoneyTypeName(c.HoneyTypeId)?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                || (GetWarehouseName(c.WarehouseId)?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
            if (!match) return false;
        }
        return true;
    });

    private sealed class StockGroup
    {
        public required string Key { get; init; }
        public required string Label { get; init; }
        public bool IsHoneyLevel { get; init; }              // true = this group's Children are container-type groups; false = this group holds Items directly
        public List<StockGroup> Children { get; set; } = new();
        public List<Container> Items { get; set; } = new();
        public int Count => Items.Count + Children.Sum(c => c.Count);
        public decimal NetWeight => Items.Sum(i => i.NetWeight) + Children.Sum(c => c.NetWeight);
        public string SummaryText => $"{Label} — {Count} vnt., {NetWeight.ToString("N0")} kg";
    }

    private IReadOnlyList<StockGroup> CategoryGroups => BuildStockHierarchy();

    private bool HasActiveSearch => !string.IsNullOrWhiteSpace(_search);

    private RenderFragment RenderGroup(StockGroup group) => __builder =>
    {
        <MudExpansionPanel Dense="@true" Expanded="HasActiveSearch" Text="@group.SummaryText">
            @if (group.Children.Any())
            {
                <MudExpansionPanels Dense="true" MultiExpansion="true">
                    @foreach (var child in group.Children)
                    {
                        @RenderGroup(child)
                    }
                </MudExpansionPanels>
            }
            else if (group.Items.Any())
            {
                @RenderLeafTable(group.Items)
            }
        </MudExpansionPanel>
    };

    private RenderFragment RenderLeafTable(List<Container> items) => __builder =>
    {
        <MudTable T="Container" Items="@items" Dense="true" Hover="true" Striped="true"
            MultiSelection="true" @bind-SelectedItems="_selectedContainers" RowsPerPage="50">
            <HeaderContent>
                <MudTh>ID</MudTh><MudTh>Tiekėjas</MudTh><MudTh>Rūšis</MudTh><MudTh Style="text-align:right">Brutto</MudTh><MudTh Style="text-align:right">Tara</MudTh><MudTh Style="text-align:right">Netto</MudTh><MudTh>Statusas</MudTh><MudTh>Sandėlis</MudTh><MudTh>Data</MudTh>
            </HeaderContent>
            <RowTemplate Context="container">
                <MudTd><strong>@container.ContainerCode</strong></MudTd>
                <MudTd>@GetSupplierName(container.SupplierId)</MudTd>
                <MudTd>@GetHoneyTypeName(container.HoneyTypeId)</MudTd>
                <MudTd Class="lakstena-mono" Style="text-align:right">@container.GrossWeight.ToString("N1")</MudTd>
                <MudTd Class="lakstena-mono" Style="text-align:right">@container.TareWeight.ToString("N1")</MudTd>
                <MudTd Class="lakstena-mono" Style="text-align:right"><strong>@container.NetWeight.ToString("N1")</strong></MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusDisplayHelper.GetColor(container.Status, _containerStatusDisplay)">@StatusDisplayHelper.GetLabel(container.Status, _containerStatusDisplay)</MudChip></MudTd>
                <MudTd>@GetWarehouseName(container.WarehouseId)</MudTd>
                <MudTd>@container.CreatedAt.ToString("MM-dd")</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" RowsPerPageString="Eilučių puslapyje:" />
            </PagerContent>
        </MudTable>
    };

    private IReadOnlyList<StockGroup> BuildStockHierarchy()
    {
        var filtered = FilteredContainers.ToList();
        var result = new List<StockGroup>();

        // Resolve each container's raw material type (null when it cannot be resolved)
        var withCategory = filtered.Select(c =>
        {
            int? rawTypeId = c.DeliveryLineId.HasValue && _deliveryLineToRawTypeId.TryGetValue(c.DeliveryLineId.Value, out var rid) ? rid : null;
            return (Container: c, RawType: rawTypeId.HasValue ? _rawMaterialTypes.FirstOrDefault(r => r.Id == rawTypeId.Value) : null);
        }).ToList();

        // Level 1 — one group per raw material type that has containers, ordered by SortOrder
        foreach (var rawType in withCategory.Where(x => x.RawType != null).GroupBy(x => x.RawType!.Id))
        {
            var type = _rawMaterialTypes.First(r => r.Id == rawType.Key);
            var containersInCategory = rawType.Select(x => x.Container).ToList();

            var categoryGroup = new StockGroup { Key = $"raw-{type.Id}", Label = type.Name, IsHoneyLevel = false };
            categoryGroup.Children = BuildContainerTypeGroups(containersInCategory);

            // Level 2 — honey-type sub-groups for honey categories only
            if (type.IsHoney)
            {
                var honeyGroups = new List<StockGroup>();
                foreach (var honeyBucket in containersInCategory.GroupBy(c => c.HoneyTypeId))
                {
                    var honeyType = _honeyTypes.FirstOrDefault(h => h.Id == honeyBucket.Key);
                    var label = honeyType?.Name ?? "Nenurodyta";
                    var honeyGroup = new StockGroup { Key = $"raw-{type.Id}-honey-{(honeyBucket.Key.HasValue ? honeyBucket.Key.Value : "null")}", Label = label, IsHoneyLevel = true };
                    honeyGroup.Children = BuildContainerTypeGroups(honeyBucket.ToList());
                    if (honeyGroup.Count > 0) honeyGroups.Add(honeyGroup);
                }
                // Order honey groups by honey type name (unknown/null last), fall back to label for stability
                categoryGroup.Children = honeyGroups
                    .OrderBy(g => _honeyTypes.Any(h => h.Name == g.Label) ? 0 : 1)
                    .ThenBy(g => g.Label, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            if (categoryGroup.Count > 0) result.Add(categoryGroup);
        }

        // Level 1 — synthetic "Kita" group for unresolvable containers
        var otherContainers = withCategory.Where(x => x.RawType == null).Select(x => x.Container).ToList();
        if (otherContainers.Count > 0)
        {
            var otherGroup = new StockGroup { Key = "raw-other", Label = "Kita", IsHoneyLevel = false };
            otherGroup.Children = BuildContainerTypeGroups(otherContainers);
            if (otherGroup.Count > 0) result.Add(otherGroup);
        }

        return result;
    }

    private static List<StockGroup> BuildContainerTypeGroups(List<Container> containers)
    {
        var groups = new List<StockGroup>();
        foreach (var typeBucket in containers.GroupBy(c => c.ContainerType))
        {
            var label = typeBucket.Key switch
            {
                "BARREL" => "Statinės",
                "BUCKET_GROUP" or "BUCKET" => "Kibirai",
                _ => typeBucket.Key
            };
            groups.Add(new StockGroup
            {
                Key = $"type-{typeBucket.Key}",
                Label = label,
                IsHoneyLevel = false,
                Items = typeBucket.ToList()
            });
        }
        return groups;
    }

