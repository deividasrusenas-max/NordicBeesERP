    protected override async Task OnInitializedAsync()
    {
        _warehouses = (await WarehouseService.GetAllAsync()).ToList();
        _suppliers = await CustomerService.GetSuppliersAsync();
        _honeyTypes = await HoneyTypeService.GetAllAsync();
        _rawMaterialTypes = await RawMaterialTypeService.GetActiveAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _filterWarehouseId = WarehouseId;
        _filterHoneyTypeId = HoneyTypeId;
        _filterSupplierId = SupplierId;
        _filterStatus = Status;
        _search = SearchCode;

        // View switcher param — default to "STOCK" when absent/invalid
        _viewType = View switch
        {
            "WRITTEN_OFF" or "TRANSFERS" => View,
            _ => "STOCK"
        };

        // Parse date-range params (null-safe: a fresh load with no query string leaves both null)
        _filterDateFrom = DateTime.TryParse(DateFrom, out var from) ? from : null;
        _filterDateTo = DateTime.TryParse(DateTo, out var to) ? to : null;
        _dateRange = (_filterDateFrom.HasValue || _filterDateTo.HasValue) ? new DateRange(_filterDateFrom, _filterDateTo) : null;

        // Default: pirmas sandėlis (only if no URL param)
        if (!_filterWarehouseId.HasValue && _warehouses.Any())
            _filterWarehouseId = _warehouses.First().Id;

        ReadWriteOffUrlParams();
        ReadTransferUrlParams();

        await LoadData();

        // WRITTEN_OFF view — load once on first entry into this view (guarded so filter-keystroke
        // navigations don't refetch); does NOT touch the STOCK-view _containers.
        if (_viewType == "WRITTEN_OFF" && !_writeOffContainersLoaded)
            await LoadWriteOffDataAsync();

        // TRANSFERS view — load once on first entry into this view (guarded so filter-keystroke
        // navigations don't refetch); does NOT touch the STOCK-view _containers.
        if (_viewType == "TRANSFERS" && !_transferGroupsLoaded)
            await LoadTransferDataAsync();
    }

    private void ReadWriteOffUrlParams()
    {
        _writeOffSearchText = WriteOffQ ?? string.Empty;
        _writeOffDateRange = null;
        if (!string.IsNullOrWhiteSpace(WriteOffFrom) && DateTime.TryParse(WriteOffFrom, out var woFrom))
            _writeOffDateRange = new DateRange(woFrom, _writeOffDateRange?.End);
        if (!string.IsNullOrWhiteSpace(WriteOffTo) && DateTime.TryParse(WriteOffTo, out var woTo))
            _writeOffDateRange = new DateRange(_writeOffDateRange?.Start, woTo);
    }

    private async Task LoadWriteOffDataAsync()
    {
        _writeOffLoading = true;
        StateHasChanged();
        try
        {
            // _warehouses/_suppliers/_honeyTypes are already populated by OnInitializedAsync — no re-fetch here.
            _writeOffContainers = await ContainerService.GetFilteredAsync(null, null, null, "WRITTEN_OFF", null);
        }
        finally
        {
            _writeOffLoading = false;
            _writeOffContainersLoaded = true;
            StateHasChanged();
        }
    }

    // Client-side filter for the WRITTEN_OFF view (ported from WriteOffHistory.razor's GetFilteredContainers,
    // renamed to use _writeOffContainers) — never touches STOCK-view _containers/_dateRange.
    private IEnumerable<Container> FilteredWriteOffContainers => _writeOffContainers.Where(c =>
    {
        var q = _writeOffSearchText?.Trim().ToLowerInvariant() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(q) &&
            !(c.ContainerCode?.ToLowerInvariant().Contains(q) ?? false) &&
            !GetSupplierName(c.SupplierId).ToLowerInvariant().Contains(q) &&
            !GetHoneyTypeName(c.HoneyTypeId).ToLowerInvariant().Contains(q))
            return false;
        if (_writeOffDateRange?.Start != null && c.UpdatedAt.Date < _writeOffDateRange.Start.Value.Date) return false;
        if (_writeOffDateRange?.End != null && c.UpdatedAt.Date > _writeOffDateRange.End.Value.Date) return false;
        return true;
    });

    private Task UpdateWriteOffSearchAsync(string value)
    {
        _writeOffSearchText = value ?? string.Empty;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("woq", string.IsNullOrWhiteSpace(_writeOffSearchText) ? null : _writeOffSearchText),
            ("view", _viewType != "STOCK" ? _viewType : null)));
        return Task.CompletedTask;
    }

    private Task UpdateWriteOffDateRangeAsync(DateRange? range)
    {
        _writeOffDateRange = range;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("wofrom", range?.Start?.ToString("yyyy-MM-dd")),
            ("woto", range?.End?.ToString("yyyy-MM-dd")),
            ("view", _viewType != "STOCK" ? _viewType : null)));
        return Task.CompletedTask;
    }

    private Task ClearWriteOffFilters()
    {
        _writeOffSearchText = string.Empty;
        _writeOffDateRange = null;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("view", _viewType != "STOCK" ? _viewType : null)));
        return Task.CompletedTask;
    }

    // TRANSFERS view (ported from TransferHistory.razor) — separate fields so they never collide with the STOCK/WRITTEN_OFF filters above
    private List<TransferGroup> _transferGroups = new();
    private bool _transferLoading = true;
    private bool _transferGroupsLoaded;
    private string _transferSearchText = string.Empty;
    private DateRange? _transferDateRange;

    private void ReadTransferUrlParams()
    {
        _transferSearchText = TransferQ ?? string.Empty;
        _transferDateRange = null;
        if (!string.IsNullOrWhiteSpace(TransferFrom) && DateTime.TryParse(TransferFrom, out var tFrom))
            _transferDateRange = new DateRange(tFrom, _transferDateRange?.End);
        if (!string.IsNullOrWhiteSpace(TransferTo) && DateTime.TryParse(TransferTo, out var tTo))
            _transferDateRange = new DateRange(_transferDateRange?.Start, tTo);
    }

    private async Task LoadTransferDataAsync()
    {
        _transferLoading = true;
        StateHasChanged();
        try
        {
            // _warehouses is already populated by OnInitializedAsync — no re-fetch here.
            var movements = await TransferService.GetTransferHistoryAsync();

            _transferGroups = movements
                .GroupBy(m => m.Notes ?? "")
                .Where(g => !string.IsNullOrEmpty(g.Key))
                .Select(g => new TransferGroup
                {
                    TransferNumber = g.Key,
                    Date = g.Min(m => m.CreatedAt),
                    FromWarehouseId = g.First().FromWarehouseId,
                    ToWarehouseId = g.First().ToWarehouseId,
                    ContainerCount = g.Count(),
                    TotalQuantity = g.Sum(m => m.Quantity),
                    Containers = g.Select(m => new TransferContainerInfo
                    {
                        Code = m.ContainerId.ToString(),
                        Quantity = m.Quantity
                    }).ToList()
                })
                .OrderByDescending(t => t.Date)
                .ToList();

            // Pakeisti container ID į kodus
            var allContainerIds = movements.Select(m => m.ContainerId).Distinct().ToList();
            var containers = await ContainerService.GetByIdsAsync(allContainerIds);
            foreach (var transfer in _transferGroups)
            {
                foreach (var c in transfer.Containers)
                {
                    var container = containers.FirstOrDefault(x => x.Id.ToString() == c.Code);
                    if (container != null)
                        c.Code = container.ContainerCode;
                }
            }
        }
        finally
        {
            _transferLoading = false;
            _transferGroupsLoaded = true;
            StateHasChanged();
        }
    }

    private string GetTransferWarehouseName(int? id) => id.HasValue
        ? _warehouses.FirstOrDefault(w => w.Id == id.Value)?.Name ?? $"#{id}"
        : "-";

