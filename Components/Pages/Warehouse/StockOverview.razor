    // renamed to use _transferGroups/_transferSearchText/_transferDateRange) — never touches STOCK-view _containers/_dateRange.
    private IEnumerable<TransferGroup> FilteredTransferGroups => _transferGroups.Where(t =>
    {
        var q = _transferSearchText?.Trim().ToLowerInvariant() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(q) &&
            !t.TransferNumber.ToLowerInvariant().Contains(q) &&
            !GetTransferWarehouseName(t.FromWarehouseId).ToLowerInvariant().Contains(q) &&
            !GetTransferWarehouseName(t.ToWarehouseId).ToLowerInvariant().Contains(q))
            return false;
        if (_transferDateRange?.Start != null && t.Date.Date < _transferDateRange.Start.Value.Date) return false;
        if (_transferDateRange?.End != null && t.Date.Date > _transferDateRange.End.Value.Date) return false;
        return true;
    });

