@page "/warehouse/supplier-debts/{SupplierId:int}"
@rendermode InteractiveServer
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Helpers
@inject IDeliveryService DeliveryService
@inject ICustomerService CustomerService
@inject ISupplierPaymentService PaymentService
@inject NavigationManager Navigation

<PageTitle>Skolos tiekėjams</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudText Typo="Typo.h5" Style="font-weight:600">@_supplierName</MudText>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/warehouse/supplier-debts">Atgal</MudButton>
    </MudStack>

    <!-- Summary -->
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="0" Style="background:#e3f2fd; border-radius:8px">
                <MudText Typo="Typo.caption">Bendra suma</MudText>
                <MudText Typo="Typo.h6">@FormatAmountHelper.Trim(_deliveries.Sum(d => d.TotalAmount), 2) €</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="0" Style="background:#e8f5e9; border-radius:8px">
                <MudText Typo="Typo.caption">Sumokėta</MudText>
                <MudText Typo="Typo.h6">@FormatAmountHelper.Trim(_deliveries.Sum(d => d.PaidAmount), 2) €</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="0" Style="background:#ffebee; border-radius:8px">
                <MudText Typo="Typo.caption">Skola</MudText>
                <MudText Typo="Typo.h6">@FormatAmountHelper.Trim(_deliveries.Sum(d => d.TotalAmount - d.PaidAmount), 2) €</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="0" Style="background:#fff3e0; border-radius:8px">
                <MudText Typo="Typo.caption">Statinių skola</MudText>
                <MudText Typo="Typo.h6">@_deliveries.Sum(d => d.BarrelsOwed - d.BarrelsReturned) vnt.</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Filter -->
    <MudStack Row="true" Spacing="4" Class="mb-3">
        <MudButton Variant="Variant.Filled" Color="@(_filter == "all" ? Color.Primary : Color.Secondary)" 
                  OnClick="@(() => SetFilter("all"))">Visi</MudButton>
        <MudButton Variant="Variant.Filled" Color="@(_filter == "unpaid" ? Color.Primary : Color.Secondary)" 
                  OnClick="@(() => SetFilter("unpaid"))">Nesumokėti</MudButton>
    </MudStack>

        <MudTable T="Delivery" Items="@_filteredDeliveries" Dense="true" Hover="true"
        OnRowClick="@((TableRowClickEventArgs<Delivery> args) => { if (IsDoubleClick(args.Item)) Navigation.NavigateTo($"/warehouse/deliveries/{args.Item.Id}"); })">
        <HeaderContent>
            <MudTh>Data</MudTh>
            <MudTh>Numeris</MudTh>
            <MudTh Style="text-align:right">Netto (kg)</MudTh>
            <MudTh Style="text-align:right">Suma (€)</MudTh>
            <MudTh Style="text-align:right">Sumokėta (€)</MudTh>
            <MudTh Style="text-align:right">Skola (€)</MudTh>
            <MudTh>Būsena</MudTh>
        </HeaderContent>
        <RowTemplate Context="delivery">
            <MudTd DataLabel="Data">@delivery.DeliveryDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Numeris">@delivery.DeliveryNumber</MudTd>
            <MudTd DataLabel="Netto" Style="text-align:right">@delivery.TotalNetWeight.ToString("N1")</MudTd>
            <MudTd DataLabel="Suma" Style="text-align:right">@FormatAmountHelper.Trim(delivery.TotalAmount, 2)</MudTd>
            <MudTd DataLabel="Sumokėta" Style="text-align:right">@FormatAmountHelper.Trim(delivery.PaidAmount, 2)</MudTd>
            <MudTd DataLabel="Skola" Style="@GetDebtStyle(delivery.TotalAmount - delivery.PaidAmount)">
                @(FormatAmountHelper.Trim((delivery.TotalAmount - delivery.PaidAmount), 2))
            </MudTd>
            <MudTd DataLabel="Būsena">
                <MudChip T="string" Size="Size.Small" Color="@StatusDisplayHelper.GetColor(delivery.Status, _statusDisplay)"
                    Icon="@(!string.IsNullOrEmpty(delivery.InvoiceNumber) ? Icons.Material.Filled.Receipt : null)">
                    @StatusDisplayHelper.GetLabel(delivery.Status, _statusDisplay)
                </MudChip>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    [Parameter] public int SupplierId { get; set; }

    private string _supplierName = "";
    private List<Delivery> _deliveries = new();
    private List<Delivery> _filteredDeliveries = new();
    private string _filter = "all";
    private DateTime _lastClickTime = DateTime.MinValue;
    private object? _lastClickItem;

    private bool IsDoubleClick(object item)
    {
        var now = DateTime.Now;
        if (_lastClickItem == item && (now - _lastClickTime).TotalMilliseconds < 400)
        {
            _lastClickItem = null;
            return true;
        }
        _lastClickItem = item;
        _lastClickTime = now;
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        var suppliers = await CustomerService.GetSuppliersAsync();
        _supplierName = suppliers.FirstOrDefault(s => s.Id == SupplierId)?.Name ?? $"#{SupplierId}";

        _deliveries = await DeliveryService.GetFilteredAsync(null, SupplierId, null, null);
        ApplyFilter();
    }

    protected override void OnParametersSet()
    {
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _filteredDeliveries = _filter switch
        {
            "unpaid" => _deliveries.Where(d => d.TotalAmount - d.PaidAmount > 0).ToList(),
            _ => _deliveries
        };
    }

    private void SetFilter(string filter)
    {
        _filter = filter;
        ApplyFilter();
    }

    private string GetDebtStyle(decimal debt)
    {
        return debt > 0 ? "text-align:right; color:red; font-weight:bold" : "text-align:right; color:green";
    }

    private static readonly Dictionary<string, (string Label, Color Color)> _statusDisplay = new()
    {
        { "RECEIVED", ("Priimtas", Color.Default) },
        { "PRICED", ("Įkainotas", Color.Info) },
        { "PARTIAL_PAID", ("Dalinai", Color.Warning) },
        { "PAID", ("Apmokėtas", Color.Success) }
    };
}