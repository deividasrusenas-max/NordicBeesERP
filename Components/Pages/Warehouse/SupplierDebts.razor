@page "/warehouse/supplier-debts"
@rendermode InteractiveServer
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Helpers
@inject IDeliveryService DeliveryService
@inject ICustomerService CustomerService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Skolos tiekėjams</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Skolos tiekėjams</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <!-- Filter bar -->
        <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Paieška (tiekėjas)" @bind-Value="_searchText"
                        Immediate="true" OnValueChange="UpdateFilterSearchAsync" Clearable="true"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDateRangePicker T="DateTime?" Label="Laikotarpis" @bind-DateRange="_dateRange"
                        OnRangeSelected="UpdateDateRangeAsync" Clearable="true" />
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(_searchText) || _dateRange?.Start != null || _dateRange?.End != null)
                {
                    <MudItem xs="12" Class="d-flex align-center">
                        <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                            Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                            OnClick="ClearFiltersAsync">
                            Išvalyti filtrus
                        </MudButton>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <!-- Summary cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-4 summary-card" Style="background:#f0fdf4; border-radius:12px">
                    <MudText Typo="Typo.caption" Style="color:#666">Tiekėjų</MudText>
                    <MudText Typo="Typo.h4" Class="summary-value">@FilteredDebtRows.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-4 summary-card" Style="background:#fef3c7; border-radius:12px">
                    <MudText Typo="Typo.caption" Style="color:#666">Bendra suma</MudText>
                    <MudText Typo="Typo.h4" Class="summary-value">@FormatAmountHelper.Trim(FilteredDebtRows.Sum(r => r.TotalAmount), 2) €</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-4 summary-card" Style="background:#dbeafe; border-radius:12px">
                    <MudText Typo="Typo.caption" Style="color:#666">Sumokėta</MudText>
                    <MudText Typo="Typo.h4" Class="summary-value">@FormatAmountHelper.Trim(FilteredDebtRows.Sum(r => r.PaidAmount), 2) €</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-4 summary-card debt-card" Style="@_debtCardStyle">
                    <MudText Typo="Typo.caption" Style="color:#666">Skola</MudText>
                    <MudText Typo="Typo.h4" Class="summary-value debt-text">@FormatAmountHelper.Trim(_totalDebt, 2) €</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Tabs -->
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4" @bind-ActivePanelIndex="_activeTab">
            <MudTabPanel Text="@($"Visi ({_baseRows.Count})")" OnClick="ShowAll" />
            <MudTabPanel Text="@($"Skolingi ({_baseRows.Count(r => r.Debt > 0)})")" OnClick="ShowWithDebt" />
            <MudTabPanel Text="@($"Atsiskaitę ({_baseRows.Count(r => r.Debt <= 0)})")" OnClick="ShowPaid" />
        </MudTabs>

        <!-- Table -->
        <MudTable T="SupplierDebtRow" Items="FilteredDebtRows" Dense="true" Hover="true" Striped="true"
            OnRowClick="@((TableRowClickEventArgs<SupplierDebtRow> args) => { if (IsDoubleClick(args.Item)) GoToDetail(args.Item.SupplierId); })"
            Style="cursor:pointer">
            <HeaderContent>
                <MudTh>Tiekėjas</MudTh>
                <MudTh Style="text-align:right">Pristatymai</MudTh>
                <MudTh Style="text-align:right">Netto (kg)</MudTh>
                <MudTh Style="text-align:right">Suma (€)</MudTh>
                <MudTh Style="text-align:right">Sumokėta (€)</MudTh>
                <MudTh Style="text-align:right">Skola (€)</MudTh>
            </HeaderContent>
            <RowTemplate Context="row">
                <MudTd><strong>@row.SupplierName</strong></MudTd>
                <MudTd Style="text-align:right">@row.DeliveryCount</MudTd>
                <MudTd Style="text-align:right">@row.TotalNetWeight.ToString("N1")</MudTd>
                <MudTd Style="text-align:right">@FormatAmountHelper.Trim(row.TotalAmount, 2)</MudTd>
                <MudTd Style="text-align:right">@FormatAmountHelper.Trim(row.PaidAmount, 2)</MudTd>
                <MudTd @attributes='@(new Dictionary<string, object> { { "Style", $"text-align:right{GetRowDebtClass(row.Debt)}" } })'>
                    @FormatAmountHelper.Trim(row.Debt, 2)
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "from")]
    private string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")]
    private string? To { get; set; }

    private List<Delivery> _deliveries = new();
    private List<SupplierDebtRow> _baseRows = new();
    private decimal _totalDebt => FilteredDebtRows.Sum(r => r.Debt);
    private int _activeTab = 0;
    private string _debtCardStyle => _totalDebt > 0
        ? "background:#fee2e2; border-radius:12px"
        : "background:#f0fdf4; border-radius:12px";
    private bool _loading = true;
    private string _searchText = string.Empty;
    private DateRange? _dateRange;
    // Tracks the date range currently applied to _baseRows, so OnParametersSetAsync can detect
    // URL from/to changes after data is already loaded (back/forward nav, refreshed link) and re-aggregate.
    private (DateTime? From, DateTime? To) _appliedRange = (null, null);
    private DateTime _lastClickTime = DateTime.MinValue;
    private object? _lastClickItem;

    protected override async Task OnParametersSetAsync()
    {
        // Null-safe URL sync: a fresh page load with no query string must not throw.
        _searchText = Q ?? string.Empty;
        var from = ParseDate(From);
        var to = ParseDate(To);
        if (from != null || to != null)
            _dateRange = new DateRange(from, to);

        if (_deliveries.Count == 0 && !string.Equals(Navigation.Uri.Split('?')[0], _loadedUri))
        {
            _loading = true;
            try
            {
                var deliveries = await DeliveryService.GetAllAsync();
                var suppliers = await CustomerService.GetSuppliersAsync();
                _deliveries = deliveries.ToList();
                _cachedSuppliers = suppliers;
                _loadedUri = Navigation.Uri.Split('?')[0];
                // First load: apply the date range parsed from the URL so a shared link /
                // browser refresh shows the exact filtered view, not all deliveries.
                BuildBaseRows(suppliers, from, to);
                _appliedRange = (from, to);
            }
            finally
            {
                _loading = false;
            }
        }
        else if (_deliveries.Count > 0 && (from, to) != _appliedRange)
        {
            // Data already loaded but the URL's from/to changed (back/forward navigation or a
            // navigated-to link): re-run the aggregation with the freshly parsed values.
            if (_cachedSuppliers != null)
            {
                BuildBaseRows(_cachedSuppliers, from, to);
                _appliedRange = (from, to);
            }
        }

        ApplyFilters();
    }

    // Robust date parse — never throws on malformed/missing values.
    private static DateTime? ParseDate(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        if (DateTime.TryParseExact(raw, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var exact))
            return exact;
        return DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var parsed) ? parsed : null;
    }

    private string _loadedUri = "";

    // Aggregates per-supplier debt rows from the given deliveries (date range
    // already applied to deliveries before grouping). Search filter is applied
    // afterwards in ApplyFilters.
    private void BuildBaseRows(List<BusinessPartner> suppliers, DateTime? from = null, DateTime? to = null)
    {
        var filteredDeliveries = _deliveries.AsEnumerable();
        if (from != null) filteredDeliveries = filteredDeliveries.Where(d => d.DeliveryDate >= from);
        if (to != null) filteredDeliveries = filteredDeliveries.Where(d => d.DeliveryDate <= to.Value.Date.AddDays(1).AddTicks(-1));

        _baseRows = suppliers
            .Select(s =>
            {
                var supplierDeliveries = filteredDeliveries.Where(d => d.SupplierId == s.Id).ToList();
                return new SupplierDebtRow
                {
                    SupplierId = s.Id,
                    SupplierName = s.Name,
                    DeliveryCount = supplierDeliveries.Count,
                    TotalNetWeight = supplierDeliveries.Sum(d => d.TotalNetWeight),
                    TotalAmount = supplierDeliveries.Sum(d => d.TotalAmount),
                    PaidAmount = supplierDeliveries.Sum(d => d.PaidAmount),
                    Debt = supplierDeliveries.Sum(d => d.TotalAmount - d.PaidAmount)
                };
            })
            .Where(r => r.DeliveryCount > 0)
            .OrderByDescending(r => r.Debt)
            .ToList();
    }

    // Applies the search filter (in-memory) over aggregated rows, then the
    // active tab to produce the displayed list. No service re-fetch on keystroke.
    private List<SupplierDebtRow> FilteredDebtRows
    {
        get
        {
            var q = _searchText.Trim().ToLowerInvariant();
            var searched = string.IsNullOrWhiteSpace(q)
                ? _baseRows
                : _baseRows.Where(r => r.SupplierName.ToLowerInvariant().Contains(q)).ToList();

            return _activeTab switch
            {
                1 => searched.Where(r => r.Debt > 0).ToList(),
                2 => searched.Where(r => r.Debt <= 0).ToList(),
                _ => searched
            };
        }
    }

    private void ApplyFilters()
    {
        StateHasChanged();
    }

    private bool IsDoubleClick(object item)
    {
        var now = DateTime.Now;
        if (_lastClickItem == item && (now - _lastClickTime).TotalMilliseconds < 400)
        {
            _lastClickItem = null;
            return true;
        }
        _lastClickItem = item;
        _lastClickTime = now;
        return false;
    }

    private void ShowAll()
    {
        _activeTab = 0;
        ApplyFilters();
    }

    private void ShowWithDebt()
    {
        _activeTab = 1;
        ApplyFilters();
    }

    private void ShowPaid()
    {
        _activeTab = 2;
        ApplyFilters();
    }

    private Task UpdateFilterSearchAsync(string value)
    {
        _searchText = value ?? string.Empty;
        StateHasChanged();
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", string.IsNullOrWhiteSpace(_searchText) ? null : _searchText),
            ("from", FilterUrlBuilder.ToQueryValue(_dateRange?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateRange?.End))));
        return Task.CompletedTask;
    }

    private List<BusinessPartner>? _cachedSuppliers;

    // Single place that re-runs the date-range aggregation and records it as applied.
    private void ApplyDateRange(DateTime? from, DateTime? to)
    {
        if (_loadedUri.Length > 0 && _cachedSuppliers != null)
            BuildBaseRows(_cachedSuppliers, from, to);
        _appliedRange = (from, to);
    }

    private Task UpdateDateRangeAsync(DateRange? range)
    {
        _dateRange = range;
        // Date range changes the underlying aggregation (filter deliveries BEFORE grouping).
        ApplyDateRange(range?.Start, range?.End);
        StateHasChanged();
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", string.IsNullOrWhiteSpace(_searchText) ? null : _searchText),
            ("from", FilterUrlBuilder.ToQueryValue(range?.Start)),
            ("to", FilterUrlBuilder.ToQueryValue(range?.End))));
        return Task.CompletedTask;
    }

    private Task ClearFiltersAsync()
    {
        _searchText = string.Empty;
        _dateRange = null;
        ApplyDateRange(null, null);
        StateHasChanged();
        Navigation.NavigateTo(Navigation.Uri.Split('?')[0]);
        return Task.CompletedTask;
    }

    private string GetRowDebtClass(decimal debt)
    {
        return debt > 0 ? " color:#dc2626; font-weight:bold" : " color:#16a34a";
    }

    private void GoToDetail(int supplierId)
    {
        Navigation.NavigateTo($"/warehouse/supplier-debts/{supplierId}");
    }

    private class SupplierDebtRow
    {
        public int SupplierId { get; set; }
        public string SupplierName { get; set; } = "";
        public int DeliveryCount { get; set; }
        public decimal TotalNetWeight { get; set; }
        public decimal TotalAmount { get; set; }
        public decimal PaidAmount { get; set; }
        public decimal Debt { get; set; }
    }
}
