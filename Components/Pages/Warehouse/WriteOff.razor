@page "/warehouse/write-off"
@rendermode InteractiveServer
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Helpers
@inject IContainerService ContainerService
@inject IWarehouseService WarehouseService
@inject IHoneyTypeService HoneyTypeService
@inject ICustomerService CustomerService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Nurašymas</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Nurašymas iš sandėlio</MudText>

    <!-- Step 1: Select warehouse and filter -->
    <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f8fafc; border-radius:8px">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudSelect T="int?" @bind-Value="_warehouseId" Label="Sandėlis">
                    @foreach (var w in _warehouses)
                    {
                        <MudSelectItem T="int?" Value="w.Id">@w.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="int?" @bind-Value="_honeyTypeId" Label="Medaus rūšis" Clearable="true">
                    @foreach (var h in _honeyTypes)
                    {
                        <MudSelectItem T="int?" Value="h.Id">@h.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_searchCode" Label="Paieška (ID)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker @bind-Date="_dateFrom" Label="Nuo" DateFormat="yyyy-MM-dd" Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker @bind-Date="_dateTo" Label="Iki" DateFormat="yyyy-MM-dd" Clearable="true" />
            </MudItem>
            <MudItem xs="12">
                <div class="d-flex flex-wrap gap-2 align-center">
                    <MudText Typo="Typo.body2" Style="color:#6b7280;margin-right:4px;">Statusas:</MudText>
                    @foreach (var status in _containerStatusDisplay)
                    {
                        <MudChip T="string"
                                 Color="@(_status == status.Key ? status.Value.Color : Color.Default)"
                                 Variant="@(_status == status.Key ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => ToggleStatus(status.Key))"
                                 Size="Size.Small"
                                 Style="@(_status == status.Key ? "" : "opacity:0.7")">
                            @status.Value.Label
                        </MudChip>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadContainers" Size="Size.Small">Filtruoti</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_containers.Any())
    {
        <!-- Step 2: Select containers -->
        <MudTable T="Container" Items="@FilteredContainers" Hover="true" Striped="true"
            MultiSelection="true" @bind-SelectedItems="_selectedContainers" RowsPerPage="50">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Tipas</MudTh>
                <MudTh>Tiekėjas</MudTh>
                <MudTh>Rūšis</MudTh>
                <MudTh Style="text-align:right">Netto (kg)</MudTh>
                <MudTh>Statusas</MudTh>
            </HeaderContent>
            <RowTemplate Context="context">
                <MudTd><strong>@context.ContainerCode</strong></MudTd>
                <MudTd>@(context.ContainerType == "BARREL" ? "🛢️ Statinė" : "🪣 Kibirai")</MudTd>
                <MudTd>@GetSupplierName(context.SupplierId)</MudTd>
                <MudTd>@GetHoneyTypeName(context.HoneyTypeId)</MudTd>
                <MudTd Style="text-align:right">@context.NetWeight.ToString("N1")</MudTd>
                <MudTd>@context.Status</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" RowsPerPageString="Eilučių puslapyje:" />
            </PagerContent>
        </MudTable>
    }

    @if (_selectedContainers.Any())
    {
        <!-- Step 3: Reason and confirm -->
        <MudPaper Class="pa-4 mt-4" Elevation="2" Style="border: 2px solid var(--mud-palette-error); border-radius:8px">
            <MudText Typo="Typo.h6" Color="Color.Error" Class="mb-3">
                Nurašyti: @_selectedContainers.Count vnt. | @_selectedContainers.Sum(c => c.NetWeight).ToString("N1") kg
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_writeOffReason" Label="Priežastis" Variant="Variant.Outlined" Required="true">
                        <MudSelectItem Value="@("Pažeista")">Pažeista</MudSelectItem>
                        <MudSelectItem Value="@("Pasenusi")">Pasenusi</MudSelectItem>
                        <MudSelectItem Value="@("Netinkama")">Netinkama</MudSelectItem>
                        <MudSelectItem Value="@("Užteršta")">Užteršta</MudSelectItem>
                        <MudSelectItem Value="@("Kita")">Kita</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_writeOffNotes" Label="Pastaba" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Filled" Color="Color.Error" Class="mt-3"
                OnClick="ConfirmWriteOff" FullWidth="@true" Style="min-height:56px; font-size:1.1rem"
                Disabled="@(string.IsNullOrEmpty(_writeOffReason) || _processing)"
                StartIcon="@Icons.Material.Filled.DeleteForever">
                @if (_processing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Patvirtinti nurašymą
            </MudButton>
        </MudPaper>
    }
</MudContainer>

@code {
    private List<Container> _containers = new();
    private HashSet<Container> _selectedContainers = new();

    private List<NordicBeesERP.Models.Warehouse> _warehouses = new();
    private List<NordicBeesERP.Models.HoneyType> _honeyTypes = new();
    private List<NordicBeesERP.Models.BusinessPartner> _suppliers = new();

    private int? _warehouseId;
    private int? _honeyTypeId;
    private int? _supplierId;
    private string? _status;
    private string? _searchCode;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    private readonly Dictionary<string, (string Label, Color Color)> _containerStatusDisplay = new()
    {
        ["RECEIVED"] = ("Priimtas", Color.Info),
        ["IN_STOCK"] = ("Sandėlyje", Color.Success),
        ["RESERVED"] = ("Rezervuotas", Color.Warning),
        ["IN_PRODUCTION"] = ("Gamyboje", Color.Primary),
        ["SOLD"] = ("Parduotas", Color.Secondary),
        ["RETURNED"] = ("Grąžintas", Color.Default),
        ["WRITTEN_OFF"] = ("Nurašytas", Color.Error)
    };

    private IEnumerable<Container> FilteredContainers => _containers.Where(c =>
        (!_dateFrom.HasValue || c.CreatedAt.Date >= _dateFrom.Value.Date) &&
        (!_dateTo.HasValue || c.CreatedAt.Date <= _dateTo.Value.Date));

    // URL query-string parameters (synchronized with filter state)
    [SupplyParameterFromQuery(Name = "warehouse")]
    public int? FilterWarehouseId { get; set; }

    [SupplyParameterFromQuery(Name = "honeyType")]
    public int? FilterHoneyTypeId { get; set; }

    [SupplyParameterFromQuery(Name = "supplier")]
    public int? FilterSupplierId { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? FilterStatus { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? FilterSearch { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? FilterDateFrom { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? FilterDateTo { get; set; }

    private string _writeOffReason = "";
    private string _writeOffNotes = "";
    private bool _processing = false;

    protected override async Task OnParametersSetAsync()
    {
        // Sync URL query params to filter fields
        _warehouseId = FilterWarehouseId;
        _honeyTypeId = FilterHoneyTypeId;
        _supplierId = FilterSupplierId;
        _status = FilterStatus;
        _searchCode = FilterSearch;
        _dateFrom = FilterDateFrom;
        _dateTo = FilterDateTo;

        _warehouses = (await WarehouseService.GetAllAsync()).ToList();
        _honeyTypes = (await HoneyTypeService.GetActiveAsync()).ToList();
        _suppliers = (await CustomerService.GetSuppliersAsync()).ToList();
    }

    private async Task ToggleStatus(string status)
    {
        _status = _status == status ? null : status;
        await LoadContainers();
    }

    private async Task LoadContainers()
    {
        _selectedContainers.Clear();

        var newUrl = FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("warehouse", FilterUrlBuilder.ToQueryValue(_warehouseId)),
            ("honeyType", FilterUrlBuilder.ToQueryValue(_honeyTypeId)),
            ("supplier", FilterUrlBuilder.ToQueryValue(_supplierId)),
            ("status", FilterUrlBuilder.ToQueryValue(_status)),
            ("q", FilterUrlBuilder.ToQueryValue(_searchCode)),
            ("from", FilterUrlBuilder.ToQueryValue(_dateFrom)),
            ("to", FilterUrlBuilder.ToQueryValue(_dateTo)));
        Navigation.NavigateTo(newUrl, replace: false);

        _containers = await ContainerService.GetFilteredAsync(_warehouseId, _honeyTypeId, _supplierId, _status, _searchCode);
    }

    private async Task ConfirmWriteOff()
    {
        _processing = true;
        try
        {
            var ids = _selectedContainers.Select(c => c.Id).ToList();
            var reason = _writeOffReason + (!string.IsNullOrEmpty(_writeOffNotes) ? $": {_writeOffNotes}" : "");
            await ContainerService.WriteOffAsync(ids, reason, null);
            Snackbar.Add($"Nurašyta {ids.Count} vienetų", Severity.Success);
            _selectedContainers.Clear();
            await LoadContainers();
            _writeOffReason = "";
            _writeOffNotes = "";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Klaida: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private string GetSupplierName(int id) => _suppliers.FirstOrDefault(s => s.Id == id)?.Name ?? $"#{id}";
    private string GetHoneyTypeName(int? id) => id.HasValue ? _honeyTypes.FirstOrDefault(h => h.Id == id.Value)?.Name ?? "-" : "-";

    private async Task ClearFilters()
    {
        _warehouseId = null;
        _honeyTypeId = null;
        _supplierId = null;
        _status = null;
        _searchCode = null;
        Navigation.NavigateTo(Navigation.Uri.Split('?')[0], replace: false);
        _containers.Clear();
        _selectedContainers.Clear();
    }
}