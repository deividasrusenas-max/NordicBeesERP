@page "/warehouse/write-off-history"
@rendermode InteractiveServer
@using NordicBeesERP.Models.WarehouseModule
@using NordicBeesERP.Helpers
@inject IContainerService ContainerService
@inject IWarehouseService WarehouseService
@inject ICustomerService CustomerService
@inject IHoneyTypeService HoneyTypeService
@inject NavigationManager Navigation

<PageTitle>Nurašymų istorija</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Nurašymų istorija</MudText>

    <!-- Filter section — standard filter bar card (Docs/FILTER_STANDARDIZATION_PLAN.md §2) -->
    <StandardListFilterBar>
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="4">
                <MudTextField T="string" Value="@_searchText" ValueChanged="@(async (string v) => await UpdateFilterSearchAsync(v))"
                    Label="Paieška (kodas, tiekėjas, rūšis)"
                    Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                    Clearable="@true" Immediate="@true" FullWidth="@true" Variant="Variant.Text" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudDateRangePicker T="DateTime?" DateRange="@_dateRange" DateRangeChanged="@(async (DateRange dr) => await UpdateDateRangeAsync(dr))"
                    Label="Nurašymo data" Variant="Variant.Text" FullWidth="@true" Clearable="@true" Editable="true" DateFormat="yyyy-MM-dd" />
            </MudItem>
            @if (!string.IsNullOrWhiteSpace(_searchText) || _dateRange?.Start != null || _dateRange?.End != null)
            {
                <MudItem xs="12">
                    <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                               OnClick="ClearFiltersAsync">
                        Išvalyti filtrus
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </StandardListFilterBar>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!FilteredContainers.Any())
    {
        <MudAlert Severity="Severity.Info">Nurašytų konteinerių nėra</MudAlert>
    }
    else
    {
        <MudGrid Class="mb-4">
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-3" Elevation="0" Style="background:#ffebee; border-radius:8px">
                    <MudText Typo="Typo.caption">Nurašyta vnt.</MudText>
                    <MudText Typo="Typo.h5">@FilteredContainers.Count()</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-3" Elevation="0" Style="background:#ffebee; border-radius:8px">
                    <MudText Typo="Typo.caption">Nurašyta kg</MudText>
                    <MudText Typo="Typo.h5">@FilteredContainers.Sum(c => c.NetWeight).ToString("N1")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudTable T="Container" Items="FilteredContainers.ToList()" Dense="true" Hover="true" Striped="true" RowsPerPage="50">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Tipas</MudTh>
                <MudTh>Tiekėjas</MudTh>
                <MudTh>Rūšis</MudTh>
                <MudTh Style="text-align:right">Netto (kg)</MudTh>
                <MudTh>Sandėlis</MudTh>
                <MudTh>Priežastis</MudTh>
                <MudTh>Data</MudTh>
            </HeaderContent>
            <RowTemplate Context="c">
                <MudTd><strong>@c.ContainerCode</strong></MudTd>
                <MudTd>@(c.ContainerType == "BARREL" ? "Statinė" : "Kibirai")</MudTd>
                <MudTd>@GetSupplierName(c.SupplierId)</MudTd>
                <MudTd>@GetHoneyTypeName(c.HoneyTypeId)</MudTd>
                <MudTd Style="text-align:right">@c.NetWeight.ToString("N1")</MudTd>
                <MudTd>@GetWarehouseName(c.WarehouseId)</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(c.Notes) ? "—" : c.Notes)</MudTd>
                <MudTd>@c.UpdatedAt.ToString("yyyy-MM-dd")</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" RowsPerPageString="Eilučių puslapyje:" />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<Container> _containers = new();
    private List<Warehouse> _warehouses = new();
    private List<BusinessPartner> _suppliers = new();
    private List<HoneyType> _honeyTypes = new();
    private bool _loading = true;

    [SupplyParameterFromQuery]
    private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "from")]
    private string? DateFrom { get; set; }
    [SupplyParameterFromQuery(Name = "to")]
    private string? DateTo { get; set; }

    private string _searchText = string.Empty;
    private DateRange? _dateRange;

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
        _searchText = Q ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(DateFrom) && DateTime.TryParse(DateFrom, out var from))
            _dateRange = new DateRange(from, _dateRange?.End);
        if (!string.IsNullOrWhiteSpace(DateTo) && DateTime.TryParse(DateTo, out var to))
            _dateRange = new DateRange(_dateRange?.Start, to);
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _warehouses = (await WarehouseService.GetAllAsync()).ToList();
            _suppliers = await CustomerService.GetSuppliersAsync();
            _honeyTypes = await HoneyTypeService.GetAllAsync();
            _containers = await ContainerService.GetFilteredAsync(null, null, null, "WRITTEN_OFF", null);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string GetSupplierName(int id) => _suppliers.FirstOrDefault(s => s.Id == id)?.Name ?? $"#{id}";
    private string GetHoneyTypeName(int? id) => id.HasValue ? _honeyTypes.FirstOrDefault(h => h.Id == id.Value)?.Name ?? "-" : "-";
    private string GetWarehouseName(int id) => _warehouses.FirstOrDefault(w => w.Id == id)?.Name ?? $"#{id}";

    private IEnumerable<Container> GetFilteredContainers()
    {
        if (_containers == null) return Enumerable.Empty<Container>();
        var q = _searchText?.Trim().ToLowerInvariant() ?? string.Empty;
        return _containers.Where(c =>
        {
            if (!string.IsNullOrWhiteSpace(q) &&
                !(c.ContainerCode?.ToLowerInvariant().Contains(q) ?? false) &&
                !GetSupplierName(c.SupplierId).ToLowerInvariant().Contains(q) &&
                !GetHoneyTypeName(c.HoneyTypeId).ToLowerInvariant().Contains(q))
                return false;
            if (_dateRange?.Start != null && c.UpdatedAt.Date < _dateRange.Start.Value.Date) return false;
            if (_dateRange?.End != null && c.UpdatedAt.Date > _dateRange.End.Value.Date) return false;
            return true;
        });
    }

    private IEnumerable<Container> FilteredContainers => GetFilteredContainers();

    private Task UpdateFilterSearchAsync(string value)
    {
        _searchText = value ?? string.Empty;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0], ("q", string.IsNullOrWhiteSpace(_searchText) ? null : _searchText)));
        return Task.CompletedTask;
    }

    private Task UpdateDateRangeAsync(DateRange? range)
    {
        _dateRange = range;
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("from", range?.Start?.ToString("yyyy-MM-dd")),
            ("to", range?.End?.ToString("yyyy-MM-dd"))));
        return Task.CompletedTask;
    }

    private Task ClearFiltersAsync()
    {
        _searchText = string.Empty;
        _dateRange = null;
        Navigation.NavigateTo(Navigation.Uri.Split('?')[0]);
        return Task.CompletedTask;
    }
}