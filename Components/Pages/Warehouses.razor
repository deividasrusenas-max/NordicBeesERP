@page "/warehouses"
@inject IWarehouseService WarehouseService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using NordicBeesERP.Models
@using NordicBeesERP.Helpers

<PageTitle>Sandėliai</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h5">Sandėliai</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
            OnClick="CreateNewWarehouse">Naujas sandėlis</MudButton>
    </div>

    <MudPaper Class="pa-3 mb-4" Elevation="2">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="Paieška (kodas / pavadinimas)" @bind-Value="_searchText"
                    Immediate="true" OnValueChange="UpdateFilterSearchAsync" Clearable="true" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudChipSet T="string" @bind-Values="_selectedStatuses" OnValuesChanged="_ => ApplyFilters()" Variant="Variant.Outlined">
                    <MudChip Value="@("active")">Aktyvus</MudChip>
                    <MudChip Value="@("inactive")">Neaktyvus</MudChip>
                </MudChipSet>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="0" Rounded="true" Square="false" Class="mt-2 pa-3">
        <MudTable T="NordicBeesERP.Models.Warehouse" Items="@FilteredWarehouses" Dense="true" Hover="true" Striped="true" Elevation="0">
            <HeaderContent>
                <MudTh>Kodas</MudTh>
                <MudTh>Pavadinimas</MudTh>
                <MudTh>Tipas</MudTh>
                <MudTh>Adresas</MudTh>
                <MudTh>Miestas</MudTh>
                <MudTh>Šalis</MudTh>
                <MudTh>Aprašymas</MudTh>
                <MudTh>Aktyvus</MudTh>
                <MudTh>Sukurtas</MudTh>
                <MudTh>Atnaujintas</MudTh>
                <MudTh>E-paštas</MudTh>
                <MudTh Style="width:160px">Veiksmiai</MudTh>
            </HeaderContent>
            <RowTemplate Context="warehouse">
                <MudTd>@warehouse.Code</MudTd>
                <MudTd>@warehouse.Name</MudTd>
                <MudTd>@GetWarehouseType(warehouse.WarehouseTypeId ?? 0)</MudTd>
                <MudTd>@warehouse.Address</MudTd>
                <MudTd>@warehouse.City</MudTd>
                <MudTd>@warehouse.Country</MudTd>
                <MudTd>@warehouse.Description</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(warehouse.IsActive ? Color.Success : Color.Default)"
                        Variant="Variant.Outlined">
                        @(warehouse.IsActive ? "Aktyvus" : "Neaktyvus")
                    </MudChip>
                </MudTd>
                <MudTd>@warehouse.CreatedAt</MudTd>
                <MudTd>@warehouse.UpdatedAt</MudTd>
                <MudTd>@warehouse.Email</MudTd>
                <MudTd>
                    <div class="d-flex gap-1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                            OnClick="@(() => EditWarehouse(warehouse.Id))" Title="Redaguoti" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                            OnClick="@(() => DeleteWarehouseAsync(warehouse))" Title="Ištrinti" />
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{25, 50}" />
            </PagerContent>
            <NoRecordsContent>
                <MudText Class="text-center py-4">Sandėlių nėra</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<NordicBeesERP.Models.Warehouse> warehouses = new List<NordicBeesERP.Models.Warehouse>();

    [SupplyParameterFromQuery]
    private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusCsv { get; set; }

    private string _searchText = string.Empty;
    private HashSet<string> _selectedStatuses = new();

    protected override async Task OnInitializedAsync()
    {
        warehouses = (List<NordicBeesERP.Models.Warehouse>)await WarehouseService.GetAllAsync();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _searchText = Q ?? string.Empty;
        _selectedStatuses = FilterUrlBuilder.ParseStatusCsv(StatusCsv);
    }

    private IEnumerable<NordicBeesERP.Models.Warehouse> FilteredWarehouses
    {
        get
        {
            if (warehouses == null) yield break;
            var q = _searchText?.Trim().ToLowerInvariant() ?? string.Empty;
            foreach (var w in warehouses)
            {
                if (!string.IsNullOrWhiteSpace(q) &&
                    !w.Code.ToLowerInvariant().Contains(q) &&
                    !w.Name.ToLowerInvariant().Contains(q))
                    continue;

                if (_selectedStatuses.Count > 0)
                {
                    var status = w.IsActive ? "active" : "inactive";
                    if (!_selectedStatuses.Contains(status))
                        continue;
                }

                yield return w;
            }
        }
    }

    private Task UpdateFilterSearchAsync(string value)
    {
        _searchText = value ?? string.Empty;
        ApplyFilters();
        return Task.CompletedTask;
    }

    private void ApplyFilters()
    {
        Navigation.NavigateTo(FilterUrlBuilder.Build(Navigation.Uri.Split('?')[0],
            ("q", string.IsNullOrWhiteSpace(_searchText) ? null : _searchText),
            ("status", FilterUrlBuilder.ToQueryValue(_selectedStatuses))));
    }

    private void EditWarehouse(int id)
    {
        Navigation.NavigateTo($"/warehouses/edit/{id}");
    }

    private void CreateNewWarehouse()
    {
        Navigation.NavigateTo("/warehouses/create");
    }

    private async Task DeleteWarehouseAsync(NordicBeesERP.Models.Warehouse warehouse)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Patvirtinti trynimą",
            $"Ar tikrai norite ištrinti sandėlį \"{warehouse.Name}\"?",
            yesText: "Ištrinti",
            cancelText: "Atšaukti");

        if (confirmed != true) return;

        try
        {
            await WarehouseService.DeleteAsync(warehouse.Id);
            Snackbar.Add($"Sandėlis \"{warehouse.Name}\" ištrintas sėkmingai", Severity.Success);
            warehouses = (List<NordicBeesERP.Models.Warehouse>)await WarehouseService.GetAllAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Klaida trinant: " + ex.Message, Severity.Error);
        }
    }

    private string GetWarehouseType(int type) => type switch
    {
        0 => "Žaliavų",
        1 => "Gatavos produkcijos",
        2 => "Gamybos",
        3 => "Pakuotės",
        _ => $"Tipas {type}"
    };
}