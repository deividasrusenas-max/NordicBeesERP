  "mcp": {
    "agent-guardrails": {
      "command": [
        "agent-guardrails",
        "mcp"
      ],
      "enabled": false,
      "type": "local",
      "timeout": 60000
    },
    "semgrep": {
      "command": [
        "uvx",
        "semgrep-mcp",
        "-t",
        "stdio",
        "--semgrep-path",
        "/opt/homebrew/bin/semgrep"
      ],
      "enabled": true,
      "type": "local"
    },
    "roslyn": {
      "command": [
        "npx",
        "-y",
        "sharplens-mcp"
      ],
      "environment": {
        "DOTNET_SOLUTION_PATH": "/Users/deividasru/Projects/NordicBeesERP/NordicBeesERP.sln"
      },
      "enabled": true,
      "type": "local"
    },
    "mudblazor": {
      "command": [
        "dotnet",
        "run",
        "--project",
        "/Users/deividasru/MudMCP/src/MudBlazor.Mcp/MudBlazor.Mcp.csproj",
        "--",
        "--stdio",
        "--version",
        "8.15.0"
      ],
      "enabled": true,
      "type": "local"
    },
    "microsoft-docs": {
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://learn.microsoft.com/api/mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "mempalace": {
      "command": [
        "python3",
        "-m",
        "mempalace.mcp_server"
      ],
      "enabled": true,
      "type": "local"
    },
    "nordicbees-db": {
      "command": [
        "node",
        "/Users/deividasru/mysql-mcp/server.js"
      ],
      "enabled": true,
      "type": "local"
    },
    "playwright": {
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless",
        "--timeout-action",
        "15000",
        "--timeout-navigation",
        "60000"
      ],
      "enabled": true,
      "type": "local"
    }
  },
